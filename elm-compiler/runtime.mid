defun Rt.exec-run(outfdN : val, errfdN : val, codeN : val) -> val {
  *ReadBlk blkW = rawcall malloc(72);
  if (mkbool(blkW == 0)) {
    word h = rawcall rt_halt();
    return mknil;
  } else {
    return mknum(0);
  }
  val blkN = mknum(blkW);
  word tmpW = rawcall malloc(65536);
  if (mkbool(tmpW == 0)) {
    rawcall free(blkW);
    word h = rawcall rt_halt();
    return mknil;
  } else {
    return mknum(0);
  }
  blkW->acc = 0;
  blkW->len = 0;
  blkW->cap = 0;
  word oLS = rawcall lseek(payload(outfdN, 0), 0, 0);
  if (mkbool(oLS >= 0)) {
    blkW->fd = payload(outfdN, 0);
    blkW->tmp = tmpW;
    call Rt.readFileGo(blkN);
    return mknil;
  } else {
    return mknil;
  }
  word oBuf = blkW->acc;
  word oLen = blkW->len;
  blkW->acc = 0;
  blkW->len = 0;
  blkW->cap = 0;
  word eLS = rawcall lseek(payload(errfdN, 0), 0, 0);
  if (mkbool(eLS >= 0)) {
    blkW->fd = payload(errfdN, 0);
    blkW->tmp = tmpW;
    call Rt.readFileGo(blkN);
    return mknil;
  } else {
    return mknil;
  }
  word eBuf = blkW->acc;
  word eLen = blkW->len;
  rawcall close(payload(outfdN, 0));
  rawcall close(payload(errfdN, 0));
  word oDst = allocraw(oLen + 1);
  wstore(blkW, 6, oBuf);
  wstore(blkW, 7, oDst);
  wstore(blkW, 8, oLen);
  call Rt.memGo(mknum([word](blkW) + 48), mknum(0));
  bytestore(oDst, oLen, 0);
  rawcall free(oBuf);
  val oStr = mkstr(oDst, oLen);
  word eDst = allocraw(eLen + 1);
  wstore(blkW, 6, eBuf);
  wstore(blkW, 7, eDst);
  wstore(blkW, 8, eLen);
  call Rt.memGo(mknum([word](blkW) + 48), mknum(0));
  bytestore(eDst, eLen, 0);
  rawcall free(eBuf);
  val eStr = mkstr(eDst, eLen);
  rawcall free(tmpW);
  rawcall free(blkW);
  val tagOut = call Rt.cons(call Rt.intern("string"), call Rt.cons(oStr, mknil));
  val tagErr = call Rt.cons(call Rt.intern("string"), call Rt.cons(eStr, mknil));
  val emptyV = call Rt.cons(call Rt.intern("cons"), mknil);
  val errLst = call Rt.cons(call Rt.intern("cons"), call Rt.cons(tagErr, call Rt.cons(emptyV, mknil)));
  val outLst = call Rt.cons(call Rt.intern("cons"), call Rt.cons(tagOut, call Rt.cons(errLst, mknil)));
  val tagCode = call Rt.cons(call Rt.intern("number"), call Rt.cons(mknum(payload(codeN, 0)), mknil));
  return call Rt.cons(call Rt.intern("cons"), call Rt.cons(tagCode, call Rt.cons(outLst, mknil)));
}
defun Rt.gcInit(dummy : val) -> val {
  word glob = rawcall rt_glob_addr();
  word region = wload(glob, 0);
  if (mkbool(region != 0)) {
    return mknum(region);
  } else {
    word heapBytes = rawcall rt_gc_heap_bytes();
    word regionSize = heapBytes + heapBytes / 8;
    word base = rawcall mmap(0, regionSize, 3, 34, -1, 0);
    if (mkbool(base < 0)) {
      call Rt.die(rawstr("qbe-rt: midgc: mmap failed"));
      return mknil;
    } else {
      word markEnd = 64 + ((heapBytes / 8) / 8);
      word classTable = base + markEnd * 8;
      word maxTotal = heapBytes / 8;
      word numClasses = 1 + payload((maxTotal <= 4096) ? mknum((maxTotal + 7) / 8) : mknum(512 + (maxTotal - 4096 + 4095) / 4096), 0);
      word heapStart = classTable + numClasses * 8 + 16;
      // THE MARK-STACK BOUND, AS A CHECKED INVARIANT (GC-ARC F1).  The plan
      // recorded it as a 0.05% MARGIN that "holds" — an assertion, not a
      // property.  It is a THEOREM once stated right: the sweep's smallest
      // physical block is class 1 = 8 words = 64 bytes (gcAlloc's
      // `(total+7)/8` with total >= 3), so no heap this geometry can map
      // holds more than `(regionEnd - heapStart) / 64` object bodies, and the
      // mark walk pushes at most ONE entry per body (gcMarkPtr's `marked == 0`
      // test).  Capacity is `markEnd - 64`.  The margin is therefore
      // `(markEnd - 64) - (regionEnd - heapStart)/64`, which works out to
      // heapBytes/262144 + ~72 entries — bigger than 0 at every heap size, and
      // ONLY because the mark stack and the heap are both carved from the one
      // mmap: if a later change moves the class table, shrinks the stack, or
      // changes the minimum class, this DIES AT INIT instead of overflowing a
      // stack nothing can grow.
      // MEASURED at the probe heaps: 16 MB -> 262144 cap vs 262007 bodies
      // (margin 137 = 16777216/262144 + 73); 64 MB -> 1048576 vs 1048247
      // (margin 329 = 67108864/262144 + 73).
      // probe-midgc-guards.sh is the fail-before (a halved stack trips it).
      word regionEnd = base + regionSize;
      word maxBlocks = (regionEnd - heapStart) / 64;
      if (mkbool(markEnd - 64 < maxBlocks)) {
        call Rt.die(rawstr("qbe-rt: midgc: mark stack smaller than the heap can hold"));
        return mknil;
      } else {
        return mknil;
      }
      wstore(glob, 0, base);
      wstore(base, 0, 331941693251);
      wstore(base, 1, classTable);
      wstore(base, 2, heapStart);
      wstore(base, 3, heapStart);
      wstore(base, 4, regionEnd);
      wstore(base, 5, 64);
      wstore(base, 6, markEnd);
      wstore(base, 10, heapBytes);
      wstore(base, 11, 0);
      wstore(base, 12, numClasses);
      // the stats knob, read ONCE: QBE_MIDGC_STATS=1 prints one line per
      // collect (Rt.collect -> Rt.gcNumOut).  Glob word 8 is the MIDGC-owned
      // block's first free knob slot (Rt.main uses 2, 12, 13).
      word statsKnob = rawcall getenv(rawstr("QBE_MIDGC_STATS"));
      wstore(glob, 8, statsKnob);
      return mknum(base);
    }
  }
}
defun Rt.allocVector(count : val) -> val {
  val region = call Rt.gcInit(mknum(0));
  word countW = payload(count, 0);
  return call Rt.gcAlloc(region, mknum(1), mknum(countW));
}
defun Rt.allocRaw(nbytes : val) -> val {
  val region = call Rt.gcInit(mknum(0));
  word nbytesW = payload(nbytes, 0);
  word bodyWords = (nbytesW + 7) / 8;
  return call Rt.gcAlloc(region, mknum(0), mknum(bodyWords));
}
defun Rt.gcAlloc(region : val, kind : val, count : val) -> val {
  word kindW = payload(kind, 0);
  word countW = payload(count, 0);
  *Region regionW = payload(region, 0);
  word total = 2 + (countW + 4 * countW * kindW);
  word cls = payload((total <= 4096) ? mknum((total + 7) / 8) : mknum(512 + (total - 4096 + 4095) / 4096), 0);
  word phys = payload((cls <= 512) ? mknum(cls * 8) : mknum(4096 + (cls - 512) * 4096), 0);
  word heapBytes = regionW->heapBytes;
  word allocated = regionW->allocated;
  regionW->kind = kindW;
  regionW->count = countW;
  if (mkbool(allocated > heapBytes / 4)) {
    call Rt.collect(mknum(0));
    regionW->allocated = 0;
    return mknil;
  } else {
    return mknil;
  }
  val first = call Rt.gcAllocGo(region, mknum(cls));
  word firstW = payload(first, 0);
  if (mkbool(firstW == 0)) {
    word cursor = regionW->cursor;
    word heapEnd = regionW->heapEnd;
    if (mkbool(cursor + phys * 8 < heapEnd)) {
      wstore(cursor, -2, kindW * 2 + cls * 4);
      wstore(cursor, -1, countW);
      regionW->cursor = cursor + phys * 8;
      regionW->allocated = regionW->allocated + phys * 8;
      return mknum(cursor);
    } else {
      call Rt.collect(mknum(0));
      regionW->allocated = 0;
      val retry = call Rt.gcAllocGo(region, mknum(cls));
      word retryW = payload(retry, 0);
      if (mkbool(retryW == 0)) {
        call Rt.die(rawstr("qbe-rt: midgc: out of memory"));
        return mknil;
      } else {
        regionW->allocated = regionW->allocated + phys * 8;
        return mknum(retryW);
      }
    }
  } else {
    regionW->allocated = regionW->allocated + phys * 8;
    return mknum(firstW);
  }
}
defun Rt.gcAllocGo(region : val, cls : val) -> val {
  *Region regionW = payload(region, 0);
  word table = regionW->classTab;
  word clsW = payload(cls, 0);
  word n = regionW->numClass;
  if (mkbool(clsW >= n)) {
    return mknum(0);
  } else {
    word head = wload(table, clsW);
    if (mkbool(head == 0)) {
      return mknum(0);
    } else {
      word kind = regionW->kind;
      word count = regionW->count;
      wstore(table, clsW, wload(head, 0));
      wstore(head, -2, kind * 2 + clsW * 4);
      wstore(head, -1, count);
      return mknum(head);
    }
  }
}
defun Rt.collect(dummy : val) -> val {
  word glob = rawcall rt_glob_addr();
  word regionW = wload(glob, 0);
  if (mkbool(regionW == 0)) {
    call Rt.die(rawstr("qbe-rt: midgc: collect before init (no region mapped)"));
    return mknil;
  } else {
    *Region region = regionW;
    if (mkbool(region->magic == 331941693251)) {
      rawcall clock_gettime(1, [word](region) + 104);
      region->markTop = 64;
      region->marked = 0;
      call Rt.gcMarkRoots(mknum(0));
      call Rt.gcDrain(mknum(0));
      rawcall clock_gettime(1, [word](region) + 120);
      call Rt.gcClearClasses(mknum(0));
      call Rt.gcSweep(mknum(region->heapStart));
      rawcall clock_gettime(1, [word](region) + 136);
      region->collects = region->collects + 1;
      region->sweptBytes = region->cursor - region->heapStart;
      region->markUs = (region->ts1s * 1000000 + region->ts1n / 1000) - (region->ts0s * 1000000 + region->ts0n / 1000);
      region->sweepUs = (region->ts2s * 1000000 + region->ts2n / 1000) - (region->ts1s * 1000000 + region->ts1n / 1000);
      if (mkbool(wload(glob, 8) != 0)) {
        word regW = [word](region);
        word cN = region->collects;
        word mN = region->marked;
        word sN = region->sweptBytes;
        word mU = region->markUs;
        word sU = region->sweepUs;
        call Rt.gcNumOut(mknum(rawstr("midgc: c=")), mknum(cN), mknum(regW));
        call Rt.gcNumOut(mknum(rawstr(" mark=")), mknum(mN), mknum(regW));
        call Rt.gcNumOut(mknum(rawstr(" swept=")), mknum(sN), mknum(regW));
        call Rt.gcNumOut(mknum(rawstr(" markUs=")), mknum(mU), mknum(regW));
        call Rt.gcNumOut(mknum(rawstr(" sweepUs=")), mknum(sU), mknum(regW));
        rawcall write(2, rawstr("\n"), 1);
        return mknil;
      }
      return mknil;
    } else {
      call Rt.die(rawstr("qbe-rt: midgc: collect before init (region not initialised)"));
      return mknil;
    }
  }
}
// THE STATS PRINTER (GC-ARC F1) — the INSTRUMENT half of the collector, and
// the reason it is here rather than in the driver: Rt.main is emitted on BOTH
// routes, so a print there would move the default route's bytes and the corpus
// baseline with it.  These two defuns are seeded ONLY under QBE_MIDGC=1.
//
// FRAME-FREE, hence printable from inside a collect: digits are written into
// the region's own scratch with `bytestore` and emitted with the `write`
// RAW-CALL (alloc-free, no safepoint — the same class as Rt.die's message
// path).  NOTHING here allocates, so `swept`/`markUs` can be reported from
// inside the walk without re-entering the collector.
//
// Rt.gcNum: the decimal digits of n, RIGHT-ALIGNED so the last digit lands at
// endP-1; returns the address of the first digit.  Unsigned: every caller
// passes a count or a monotonic duration.
defun Rt.gcNum(n : val, endP : val) -> val {
  word v = payload(n, 0);
  word q = v / 10;
  word p = payload(endP, 0);
  bytestore(p - 1, 0, 48 + (v - q * 10));
  if (mkbool(q == 0)) {
    return mknum(p - 1);
  }
  recur(mknum(q), mknum(p - 1));
}
// Rt.gcNumOut: `label` (a NUL-terminated static) then n, both written to stderr.
defun Rt.gcNumOut(label : val, n : val, region : val) -> val {
  word end = payload(region, 0) + 288;
  val start = call Rt.gcNum(n, mknum(end));
  val llen = call Rt.cStrLenGo(mknum(payload(label, 0)), mknum(0));
  rawcall write(2, payload(label, 0), payload(llen, 0));
  rawcall write(2, payload(start, 0), end - payload(start, 0));
  return mknil;
}
defun Rt.gcMarkRoots(i : val) -> val {
  word iW = payload(i, 0);
  word nRoots = rawcall rt_gc_roots_len();
  if (mkbool(iW >= nRoots)) {
    return mknil;
  } else {
    word kind = rawcall rt_gc_root_kind(iW);
    word slot = rawcall rt_gc_root_slot(iW);
    word np = rawcall rt_gc_root_np(iW);
    if (mkbool(kind == 0)) {
      return call Rt.gcMarkPtr(mknum(wload(slot, 0)));
    } else {
      if (mkbool(kind == 1)) {
        return call Rt.gcMarkValue(mknum(slot));
      } else {
        if (mkbool(kind == 3)) {
          return call Rt.gcMarkValue(mknum(slot));
        } else {
          if (mkbool(kind == 2)) {
            word count = byteload(np, 0) + (byteload(np, 1) * 256 + (byteload(np, 2) * 65536 + byteload(np, 3) * 16777216));
            return call Rt.gcScanValueArray(mknum(slot), mknum(count));
          } else {
            call Rt.die(rawstr("qbe-rt: midgc: unknown root kind"));
            return mknil;
          }
        }
      }
    }
    return call Rt.gcMarkRoots(mknum(iW + 1));
  }
}
defun Rt.gcScanValueArray(base : val, cnt : val) -> val {
  word baseW = payload(base, 0);
  word cntW = payload(cnt, 0);
  if (mkbool(cntW == 0)) {
    return mknil;
  } else {
    call Rt.gcMarkValue(mknum(baseW));
    return call Rt.gcScanValueArray(mknum(baseW + 40), mknum(cntW - 1));
  }
}
defun Rt.gcDrain(dummy : val) -> val {
  word glob = rawcall rt_glob_addr();
  *Region region = wload(glob, 0);
  word top = region->markTop;
  if (mkbool(top > 64)) {
    word newTop = top - 1;
    word p = wload(region, newTop);
    word flags = wload(p, -2);
    word kind = (flags >> 1) & 1;
    word count = wload(p, -1);
    region->markTop = newTop;
    if (mkbool(kind == 1)) {
      return call Rt.gcScanValueArray(mknum(p), mknum(count));
    } else {
      return mknil;
    }
    return call Rt.gcDrain(mknum(0));
  } else {
    return mknil;
  }
}
defun Rt.gcSweep(cursor : val) -> val {
  word cursorW = payload(cursor, 0);
  word glob = rawcall rt_glob_addr();
  *Region region = wload(glob, 0);
  word table = region->classTab;
  word heapCursor = region->cursor;
  if (mkbool(cursorW >= heapCursor)) {
    return mknil;
  } else {
    word flags = wload(cursorW, -2);
    word marked = flags & 1;
    word cls = flags >> 2;
    word phys = payload((cls <= 512) ? mknum(cls * 8) : mknum(4096 + (cls - 512) * 4096), 0);
    if (mkbool(marked == 1)) {
      wstore(cursorW, -2, flags - 1);
      return call Rt.gcSweep(mknum(cursorW + phys * 8));
    } else {
      wstore(cursorW, 0, wload(table, cls));
      wstore(table, cls, cursorW);
      return call Rt.gcSweep(mknum(cursorW + phys * 8));
    }
  }
}
defun Rt.gcClearClasses(i : val) -> val {
  word glob = rawcall rt_glob_addr();
  *Region region = wload(glob, 0);
  word table = region->classTab;
  word n = region->numClass;
  word iW = payload(i, 0);
  if (mkbool(iW >= n)) {
    return mknil;
  } else {
    wstore(table, iW, 0);
    return call Rt.gcClearClasses(mknum(iW + 1));
  }
}
defun Rt.gcMarkPtr(p : val) -> val {
  word ptr = payload(p, 0);
  word glob = rawcall rt_glob_addr();
  *Region region = wload(glob, 0);
  word heapStart = region->heapStart;
  word heapEnd = region->heapEnd;
  if (mkbool(ptr != 0) && (mkbool(ptr >= heapStart) && mkbool(ptr < heapEnd))) {
    word flags = wload(ptr, -2);
    word marked = flags & 1;
    word top = region->markTop;
    word markEnd = region->markEnd;
    if (mkbool(marked == 0)) {
      if (mkbool(top < markEnd)) {
        wstore(ptr, -2, flags + 1);
        wstore(region, top, ptr);
        region->markTop = top + 1;
        region->marked = region->marked + 1;
        return mknil;
      } else {
        call Rt.die(rawstr("qbe-rt: midgc: mark stack overflow"));
        return mknil;
      }
    } else {
      return mknil;
    }
  } else {
    return mknil;
  }
}
defun Rt.gcMarkValue(vaddr : val) -> val {
  word tag = byteload(payload(vaddr, 0), 0) + (byteload(payload(vaddr, 0), 1) * 256 + (byteload(payload(vaddr, 0), 2) * 65536 + byteload(payload(vaddr, 0), 3) * 16777216));
  word vaddrW = payload(vaddr, 0);
  if (mkbool(tag == 1)) {
    return call Rt.gcMarkPtr(mknum(wload(vaddrW, 1)));
  } else {
    if (mkbool(tag == 4)) {
      return call Rt.gcMarkPtr(mknum(wload(vaddrW, 1)));
    } else {
      if (mkbool(tag == 6)) {
        call Rt.gcMarkPtr(mknum(wload(vaddrW, 1)));
        return call Rt.gcMarkPtr(mknum(wload(vaddrW, 3)));
      } else {
        if (mkbool(tag == 9)) {
          return call Rt.gcMarkPtr(mknum(wload(vaddrW, 1)));
        } else {
          if (mkbool(tag == 10)) {
            return call Rt.gcMarkPtr(mknum(wload(vaddrW, 1)));
          } else {
            if (mkbool(tag == 14)) {
              call Rt.gcMarkPtr(mknum(wload(vaddrW, 1)));
              return call Rt.gcMarkPtr(mknum(wload(vaddrW, 3)));
            } else {
              if (mkbool(tag == 13)) {
                call Rt.die(rawstr("qbe-rt: midgc: unknown value tag in mark walk"));
                return mknil;
              } else {
                if (mkbool(tag > 14)) {
                  call Rt.die(rawstr("qbe-rt: midgc: unknown value tag in mark walk"));
                  return mknil;
                } else {
                  return mknil;
                }
              }
            }
          }
        }
      }
    }
  }
}
defun Rt.+(a : val, bb : val) -> val {
  if (mkbool(tagis(a, 12)) || mkbool(tagis(bb, 12))) {
    return mkflt(fload(call Rt.asF(a)) f+ fload(call Rt.asF(bb)));
  } else {
    return mknum(payload(a, 0) + payload(bb, 0));
  }
}
defun Rt.-(a : val, bb : val) -> val {
  if (mkbool(tagis(a, 12)) || mkbool(tagis(bb, 12))) {
    return mkflt(fload(call Rt.asF(a)) f- fload(call Rt.asF(bb)));
  } else {
    return mknum(payload(a, 0) - payload(bb, 0));
  }
}
defun Rt.*(a : val, bb : val) -> val {
  if (mkbool(tagis(a, 12)) || mkbool(tagis(bb, 12))) {
    return mkflt(fload(call Rt.asF(a)) f* fload(call Rt.asF(bb)));
  } else {
    return mknum(payload(a, 0) * payload(bb, 0));
  }
}
defun Rt./(a : val, bb : val) -> val {
  return mknum(payload(a, 0) / payload(bb, 0));
}
defun Rt.f/(a : val, bb : val) -> val {
  return mkflt(fload(call Rt.asF(a)) f/ fload(call Rt.asF(bb)));
}
defun Rt.<(a : val, bb : val) -> val {
  if ((mkbool(tagis(a, 0)) || mkbool(tagis(a, 12))) && (mkbool(tagis(bb, 0)) || mkbool(tagis(bb, 12)))) {
    if (mkbool(tagis(a, 12)) || mkbool(tagis(bb, 12))) {
      return mkbool(fload(call Rt.asF(a)) f< fload(call Rt.asF(bb)));
    } else {
      return mkbool(payload(a, 0) < payload(bb, 0));
    }
  } else {
    return false;
  }
}
defun Rt.<=(a : val, bb : val) -> val {
  if ((mkbool(tagis(a, 0)) || mkbool(tagis(a, 12))) && (mkbool(tagis(bb, 0)) || mkbool(tagis(bb, 12)))) {
    if (mkbool(tagis(a, 12)) || mkbool(tagis(bb, 12))) {
      return mkbool(fload(call Rt.asF(a)) f<= fload(call Rt.asF(bb)));
    } else {
      return mkbool(payload(a, 0) <= payload(bb, 0));
    }
  } else {
    return false;
  }
}
defun Rt.>(a : val, bb : val) -> val {
  if ((mkbool(tagis(a, 0)) || mkbool(tagis(a, 12))) && (mkbool(tagis(bb, 0)) || mkbool(tagis(bb, 12)))) {
    if (mkbool(tagis(a, 12)) || mkbool(tagis(bb, 12))) {
      return mkbool(fload(call Rt.asF(a)) f> fload(call Rt.asF(bb)));
    } else {
      return mkbool(payload(a, 0) > payload(bb, 0));
    }
  } else {
    return false;
  }
}
defun Rt.>=(a : val, bb : val) -> val {
  if ((mkbool(tagis(a, 0)) || mkbool(tagis(a, 12))) && (mkbool(tagis(bb, 0)) || mkbool(tagis(bb, 12)))) {
    if (mkbool(tagis(a, 12)) || mkbool(tagis(bb, 12))) {
      return mkbool(fload(call Rt.asF(a)) f>= fload(call Rt.asF(bb)));
    } else {
      return mkbool(payload(a, 0) >= payload(bb, 0));
    }
  } else {
    return false;
  }
}
defun Rt.number?(a : val) -> val {
  return mkbool(tagis(a, 0)) || (mkbool(tagis(a, 12)) || false);
}
defun Rt.string?(a : val) -> val {
  return mkbool(tagis(a, 1)) || false;
}
defun Rt.cons?(a : val) -> val {
  return mkbool(tagis(a, 4)) || false;
}
defun Rt.empty?(a : val) -> val {
  return mkbool(tagis(a, 5)) || false;
}
defun Rt.bitwise-and(a : val, bb : val) -> val {
  return mknum(payload(call Rt.toI32(a), 0) & payload(call Rt.toI32(bb), 0));
}
defun Rt.bitwise-or(a : val, bb : val) -> val {
  return mknum(payload(call Rt.toI32(a), 0) | payload(call Rt.toI32(bb), 0));
}
defun Rt.bitwise-xor(a : val, bb : val) -> val {
  return mknum(payload(call Rt.toI32(a), 0) ^ payload(call Rt.toI32(bb), 0));
}
defun Rt.bitwise-not(a : val) -> val {
  return mknum(bitnot(payload(call Rt.toI32(a), 0)));
}
defun Rt.bitwise-shift-left(count : val, value : val) -> val {
  return mknum(payload(call Rt.toI32(value), 0) << (payload(call Rt.toI32(count), 0) & 31));
}
defun Rt.bitwise-shift-right(count : val, value : val) -> val {
  return mknum(payload(call Rt.toI32(value), 0) >> (payload(call Rt.toI32(count), 0) & 31));
}
defun Rt.bitwise-shift-right-zf(count : val, value : val) -> val {
  return mknum(payload(call Rt.toI32(value), 0) >>> (payload(call Rt.toI32(count), 0) & 31));
}
defun Rt.c-strlen(s : val) -> val {
  return mknum(len32(s));
}
defun Rt.char-code(s : val, i : val) -> val {
  if (mkbool(0 <= payload(i, 0)) && mkbool(payload(i, 0) < len32(s))) {
    return mknum(strbyte(s, payload(i, 0)));
  } else {
    return mknum(-1);
  }
}
defun Rt.substring(s : val, st : val, ln : val) -> val {
  val st0 = mkbool(payload(st, 0) < 0) ? mknum(0) : (mkbool(payload(st, 0) > len32(s)) ? mknum(len32(s)) : st);
  val ln0 = mkbool(payload(ln, 0) < 0) ? mknum(0) : (mkbool((payload(st0, 0) + payload(ln, 0)) > len32(s)) ? mknum(len32(s) - payload(st0, 0)) : ln);
  val end = mknum(payload(st0, 0) + payload(ln0, 0));
  return call Rt.bytesToStr(call Rt.subGo(s, st0, end));
}
defun Rt.cn(a : val, bb : val) -> val {
  return call Rt.cn2(call Rt.strOf(a), call Rt.strOf(bb));
}
defun Rt.repeat(cnt : val, s : val) -> val {
  if (mkbool(payload(cnt, 0) <= 0) || mkbool(len32(s) <= 0)) {
    return "";
  } else {
    return call Rt.bytesToStr(call Rt.repGo(s, cnt));
  }
}
defun Rt.shen.str->bytes(s : val) -> val {
  if (mkbool(tagis(s, 1))) {
    return call Rt.bytesBuild(s, mknum(len32(s)), mknil);
  } else {
    word h = rawcall rt_halt();
    return mknil;
  }
}
defun Rt.shen.bytes->string(bs : val) -> val {
  if (mkbool(tagis(bs, 5)) || mkbool(tagis(bs, 4))) {
    return call Rt.bytesToStr(bs);
  } else {
    word h = rawcall rt_halt();
    return mknil;
  }
}
defun Rt.con(tag : val, argsPtr : val, cnt : val) -> val {
  word dataW = allocvec(payload(cnt, 0) + 1);
  word cntW = payload(cnt, 0);
  vecstore(dataW, 0, tag);
  call Rt.conFill(mknum(dataW), argsPtr, mknum(cntW));
  return mkvec(dataW, cntW + 1);
}

defun Rt.conFill(data : val, argsPtr : val, idx : val) -> val {
  word dataW = payload(data, 0);
  word argsW = payload(argsPtr, 0);
  word idxW = payload(idx, 0);
  if (mkbool(idxW == 0)) {
    return mknil;
  } else {
    vecstore(dataW, idxW, vecload(argsW, idxW - 1));
    return call Rt.conFill(mknum(dataW), mknum(argsW), mknum(idxW - 1));
  }
}

defun Rt.closure(desc : val, capBase : val, cnt : val) -> val {
  word dataW = allocvec(payload(cnt, 0));
  word cntW = payload(cnt, 0);
  word descW = payload(desc, 0);
  word arityW = wload(descW, 1);
  call Rt.closureFill(mknum(dataW), capBase, mknum(cntW));
  return mkval(6, descW, arityW, dataW, cntW);
}

defun Rt.closureFill(data : val, capBase : val, idx : val) -> val {
  word dataW = payload(data, 0);
  word capW = payload(capBase, 0);
  word idxW = payload(idx, 0);
  if (mkbool(idxW == 0)) {
    return mknil;
  } else {
    vecstore(dataW, idxW - 1, vecload(capW, idxW - 1));
    return call Rt.closureFill(mknum(dataW), mknum(capW), mknum(idxW - 1));
  }
}

defun Rt.subGo(s : val, i : val, e : val) -> val {
  if (mkbool(payload(i, 0) >= payload(e, 0))) {
    return mknil;
  } else {
    return call Rt.cons(mknum(strbyte(s, payload(i, 0))), call Rt.subGo(s, mknum(payload(i, 0) + 1), e));
  }
}

defun Rt.repGo(s : val, i : val) -> val {
  if (mkbool(payload(i, 0) <= 0)) {
    return mknil;
  } else {
    return call Rt.appendL(call Rt.bytesOf(s, mknum(0)), call Rt.repGo(s, mknum(payload(i, 0) - 1)));
  }
}

defun Rt.bytesBuild(s : val, i : val, acc : val) -> val {
  if (mkbool(payload(i, 0) <= 0)) {
    return acc;
  } else {
    return call Rt.bytesBuild(s, mknum(payload(i, 0) - 1), call Rt.cons(mknum(strbyte(s, payload(i, 0) - 1)), acc));
  }
}

defun Rt.symLess(a : val, bb : val, i : val) -> val {
  val ca = mknum(strbyte(a, payload(i, 0)));
  val cb = mknum(strbyte(bb, payload(i, 0)));
  if (mkbool(payload(ca, 0) == 0)) {
    return mkbool(payload(cb, 0) != 0);
  } else {
    if (mkbool(payload(cb, 0) == 0)) {
      return mkbool(0);
    } else {
      if (mkbool(payload(ca, 0) < payload(cb, 0))) {
        return mkbool(1);
      } else {
        if (mkbool(payload(ca, 0) > payload(cb, 0))) {
          return mkbool(0);
        } else {
          return call Rt.symLess(a, bb, mknum(payload(i, 0) + 1));
        }
      }
    }
  }
}

defun Rt.read-file-as-string(path : val) -> val {
  word lenW = payload32(path, 1);
  word bufW = allocraw(lenW + 1);
  val bufN = mknum(bufW);
  call Rt.cStrFill(bufN, path, mknum(0));
  word fdW = rawcall openat(-100, bufW, 0, 0);
  if (mkbool(fdW < 0)) {
    val msg = "runtime: cannot open file for read-file-as-string\n";
    word w12 = rawcall write(2, payload(msg, 0), payload32(msg, 1));
    return "";
  } else {
    *ReadBlk blkW = rawcall malloc(72);
    if (mkbool(blkW == 0)) {
      word h = rawcall rt_halt();
      return mknil;
    } else {
      return mknum(0);
    }
    val blkN = mknum(blkW);
    word tmpW = rawcall malloc(65536);
    if (mkbool(tmpW == 0)) {
      word f15 = rawcall free(blkW);
      word h = rawcall rt_halt();
      return mknil;
    } else {
      return mknum(0);
    }
    blkW->fd = fdW;
    blkW->tmp = tmpW;
    blkW->acc = 0;
    blkW->len = 0;
    blkW->cap = 0;
    call Rt.readFileGo(blkN);
    word len22 = blkW->len;
    word accW = blkW->acc;
    word dstW = allocraw(len22 + 1);
    wstore(blkW, 6, accW);
    wstore(blkW, 7, dstW);
    wstore(blkW, 8, len22);
    call Rt.memGo(mknum([word](blkW) + 48), mknum(0));
    bytestore(dstW, len22, 0);
    word f30 = rawcall free(accW);
    word f31 = rawcall free(tmpW);
    word f32 = rawcall free(blkW);
    word f33 = rawcall close(fdW);
    return mkstr(dstW, len22);
  }
}

defun Rt.readFileGo(blkN : val) -> val {
  word fdW = [*ReadBlk](payload(blkN, 0))->fd;
  word tmpW = [*ReadBlk](payload(blkN, 0))->tmp;
  val nV = call Rt.readFull(mknum(fdW), mknum(tmpW), mknum(65536));
  if (mkbool(payload(nV, 0) < 0)) {
    return mknil;
  }
  if (mkbool(payload(nV, 0) == 0)) {
    return mknil;
  }
  word lenW = [*ReadBlk](payload(blkN, 0))->len;
  word capW = [*ReadBlk](payload(blkN, 0))->cap;
  word neededW = lenW + payload(nV, 0);
  val growB = if (mkbool(neededW > capW)) {
    word newcapW = neededW + (capW * 2 - neededW) * (capW * 2 > neededW);
    word mW = rawcall malloc(newcapW);
    if (mkbool(mW == 0)) { return mknum(1); }
    word oldW = [*ReadBlk](payload(blkN, 0))->acc;
    wstore(payload(blkN, 0), 6, oldW);
    wstore(payload(blkN, 0), 7, mW);
    wstore(payload(blkN, 0), 8, lenW);
    call Rt.memGo(mknum(payload(blkN, 0) + 48), mknum(0));
    rawcall free(oldW);
    [*ReadBlk](payload(blkN, 0))->acc = mW;
    [*ReadBlk](payload(blkN, 0))->cap = newcapW;
    return mknum(0);
  } else {
    return mknum(0);
  };
  if (mkbool(payload(growB, 0) == 1)) {
    return mknil;
  }
  word accW = [*ReadBlk](payload(blkN, 0))->acc;
  wstore(payload(blkN, 0), 6, tmpW);
  wstore(payload(blkN, 0), 7, accW + lenW);
  wstore(payload(blkN, 0), 8, payload(nV, 0));
  call Rt.memGo(mknum(payload(blkN, 0) + 48), mknum(0));
  [*ReadBlk](payload(blkN, 0))->len = neededW;
  recur(blkN);
}

defun Rt.epCmd(e : val, stN : val, cAddrN : val) -> val {
  [*Scratch](payload(stN, 0))->lim = 8;
  val cnt = call Rt.epCount(e, stN, mknum(0));
  word cbufW = [*Scratch](payload(stN, 0))->cbuf;
  if (mkbool(payload(cnt, 0) != 3)) { return mknum(-1); }
  val argvv = call Rt.epElem(e, mknum(0), mknum(0));
  val redirsv = call Rt.epElem(e, mknum(0), mknum(1));
  val subv = call Rt.epElem(e, mknum(0), mknum(2));
  [*CmdState](payload(cAddrN, 0))->argv = 0;
  [*CmdState](payload(cAddrN, 0))->argc = 0;
  [*CmdState](payload(cAddrN, 0))->redirs = 0;
  [*CmdState](payload(cAddrN, 0))->nredirs = 0;
  [*CmdState](payload(cAddrN, 0))->subprog = 0;
  [*Scratch](payload(stN, 0))->lim = 256;
  val acnt = call Rt.epCount(argvv, stN, mknum(0));
  if (mkbool(payload(acnt, 0) < 0) || mkbool(payload(acnt, 0) > 256)) { return mknum(-1); }
  val ago = if (mkbool(payload(acnt, 0) == 0)) {
    return mknum(0);
  } else {
    word argvW = rawcall malloc(payload(acnt, 0) * 8 + 8);
    if (mkbool(argvW == 0)) {
      word h = rawcall rt_halt();
      return mknil;
    } else {
      return mknum(0);
    }
    [*CmdState](payload(cAddrN, 0))->argv = argvW;
    val agoGo = call Rt.epArgvGo(argvv, stN, cAddrN);
    if (mkbool(payload(agoGo, 0) < 0)) {
      [*CmdState](payload(cAddrN, 0))->argv = 0;
      return mknum(-1);
    }
    wstore(argvW, payload(acnt, 0), 0);
    return mknum(0);
  };
  if (mkbool(payload(ago, 0) < 0)) { return mknum(-1); }
  [*Scratch](payload(stN, 0))->lim = 64;
  val rcnt = call Rt.epCount(redirsv, stN, mknum(0));
  if (mkbool(payload(rcnt, 0) < 0) || mkbool(payload(rcnt, 0) > 64)) {
    if (mkbool([*CmdState](payload(cAddrN, 0))->argv != 0)) {
      return call Rt.epFreeArgv(mknum([*CmdState](payload(cAddrN, 0))->argv), mknum(0), mknum([*CmdState](payload(cAddrN, 0))->argc));
    } else {
      return mknil;
    }
    [*CmdState](payload(cAddrN, 0))->argv = 0;
    return mknum(-1);
  } else {
    val rgo = if (mkbool(payload(rcnt, 0) == 0)) {
      return mknum(0);
    } else {
      word redirsW = rawcall malloc(payload(rcnt, 0) * 48);
      if (mkbool(redirsW == 0)) {
        word h = rawcall rt_halt();
        return mknil;
      } else {
        return mknum(0);
      }
      [*CmdState](payload(cAddrN, 0))->redirs = redirsW;
      val rgoGo = call Rt.epRedirsGo(redirsv, stN, cAddrN);
      if (mkbool(payload(rgoGo, 0) < 0)) {
        [*CmdState](payload(cAddrN, 0))->redirs = 0;
        if (mkbool([*CmdState](payload(cAddrN, 0))->argv != 0)) {
          return call Rt.epFreeArgv(mknum([*CmdState](payload(cAddrN, 0))->argv), mknum(0), mknum([*CmdState](payload(cAddrN, 0))->argc));
        } else {
          return mknil;
        }
        [*CmdState](payload(cAddrN, 0))->argv = 0;
        return mknum(-1);
      }
      return mknum(0);
    };
    if (mkbool(payload(rgo, 0) < 0)) { return mknum(-1); }
    val subState = mkbool(tagis(subv, 4) == 0) ? mknum(2) : (mkbool(tagis(vecload(payload(subv, 0), 0), 2) == 0) ? mknum(2) : (call Rt.epSymIs(vecload(payload(subv, 0), 0), mknum(cbufW), mknum(0)) ? (mkbool(tagis(vecload(payload(subv, 0), 1), 5) != 0) ? mknum(0) : (mkbool(tagis(vecload(payload(subv, 0), 1), 4) != 0) ? mknum(1) : mknum(2))) : mknum(2)));
    if (mkbool(payload(subState, 0) == 2)) {
      if (mkbool([*CmdState](payload(cAddrN, 0))->subprog != 0)) {
        return call Rt.epFreeChains(mknum([*CmdState](payload(cAddrN, 0))->subprog), mknum([*Prog]([*CmdState](payload(cAddrN, 0))->subprog)->chains), mknum(0));
      } else {
        return mknil;
      }
      if (mkbool([*CmdState](payload(cAddrN, 0))->redirs != 0)) {
        return call Rt.epFreeRedirs(mknum([*CmdState](payload(cAddrN, 0))->redirs), mknum(0), mknum([*CmdState](payload(cAddrN, 0))->nredirs));
      } else {
        return mknil;
      }
      [*CmdState](payload(cAddrN, 0))->redirs = 0;
      if (mkbool([*CmdState](payload(cAddrN, 0))->argv != 0)) {
        return call Rt.epFreeArgv(mknum([*CmdState](payload(cAddrN, 0))->argv), mknum(0), mknum([*CmdState](payload(cAddrN, 0))->argc));
      } else {
        return mknil;
      }
      [*CmdState](payload(cAddrN, 0))->argv = 0;
      return mknum(-1);
    }
    if (mkbool(payload(subState, 0) == 0)) {
      if (mkbool([*CmdState](payload(cAddrN, 0))->argv == 0)) {
        if (mkbool([*CmdState](payload(cAddrN, 0))->subprog != 0)) {
          return call Rt.epFreeChains(mknum([*CmdState](payload(cAddrN, 0))->subprog), mknum([*Prog]([*CmdState](payload(cAddrN, 0))->subprog)->chains), mknum(0));
        } else {
          return mknil;
        }
        if (mkbool([*CmdState](payload(cAddrN, 0))->redirs != 0)) {
          return call Rt.epFreeRedirs(mknum([*CmdState](payload(cAddrN, 0))->redirs), mknum(0), mknum([*CmdState](payload(cAddrN, 0))->nredirs));
        } else {
          return mknil;
        }
        [*CmdState](payload(cAddrN, 0))->redirs = 0;
        if (mkbool([*CmdState](payload(cAddrN, 0))->argv != 0)) {
          return call Rt.epFreeArgv(mknum([*CmdState](payload(cAddrN, 0))->argv), mknum(0), mknum([*CmdState](payload(cAddrN, 0))->argc));
        } else {
          return mknil;
        }
        [*CmdState](payload(cAddrN, 0))->argv = 0;
        return mknum(-1);
      }
      val nstdin = call Rt.epCountStdin(mknum([*CmdState](payload(cAddrN, 0))->redirs), mknum([*CmdState](payload(cAddrN, 0))->nredirs), mknum(0));
      if (mkbool(payload(nstdin, 0) > 1)) {
        if (mkbool([*CmdState](payload(cAddrN, 0))->subprog != 0)) {
          return call Rt.epFreeChains(mknum([*CmdState](payload(cAddrN, 0))->subprog), mknum([*Prog]([*CmdState](payload(cAddrN, 0))->subprog)->chains), mknum(0));
        } else {
          return mknil;
        }
        if (mkbool([*CmdState](payload(cAddrN, 0))->redirs != 0)) {
          return call Rt.epFreeRedirs(mknum([*CmdState](payload(cAddrN, 0))->redirs), mknum(0), mknum([*CmdState](payload(cAddrN, 0))->nredirs));
        } else {
          return mknil;
        }
        [*CmdState](payload(cAddrN, 0))->redirs = 0;
        if (mkbool([*CmdState](payload(cAddrN, 0))->argv != 0)) {
          return call Rt.epFreeArgv(mknum([*CmdState](payload(cAddrN, 0))->argv), mknum(0), mknum([*CmdState](payload(cAddrN, 0))->argc));
        } else {
          return mknil;
        }
        [*CmdState](payload(cAddrN, 0))->argv = 0;
        return mknum(-1);
      }
      return mknum(0);
    } else {
      if (mkbool([*CmdState](payload(cAddrN, 0))->argv != 0)) {
        if (mkbool([*CmdState](payload(cAddrN, 0))->subprog != 0)) {
          return call Rt.epFreeChains(mknum([*CmdState](payload(cAddrN, 0))->subprog), mknum([*Prog]([*CmdState](payload(cAddrN, 0))->subprog)->chains), mknum(0));
        } else {
          return mknil;
        }
        if (mkbool([*CmdState](payload(cAddrN, 0))->redirs != 0)) {
          return call Rt.epFreeRedirs(mknum([*CmdState](payload(cAddrN, 0))->redirs), mknum(0), mknum([*CmdState](payload(cAddrN, 0))->nredirs));
        } else {
          return mknil;
        }
        [*CmdState](payload(cAddrN, 0))->redirs = 0;
        if (mkbool([*CmdState](payload(cAddrN, 0))->argv != 0)) {
          return call Rt.epFreeArgv(mknum([*CmdState](payload(cAddrN, 0))->argv), mknum(0), mknum([*CmdState](payload(cAddrN, 0))->argc));
        } else {
          return mknil;
        }
        [*CmdState](payload(cAddrN, 0))->argv = 0;
        return mknum(-1);
      }
      word depthW = [*Scratch](payload(stN, 0))->depth;
      if (mkbool(depthW >= 32)) {
        if (mkbool([*CmdState](payload(cAddrN, 0))->subprog != 0)) {
          return call Rt.epFreeChains(mknum([*CmdState](payload(cAddrN, 0))->subprog), mknum([*Prog]([*CmdState](payload(cAddrN, 0))->subprog)->chains), mknum(0));
        } else {
          return mknil;
        }
        if (mkbool([*CmdState](payload(cAddrN, 0))->redirs != 0)) {
          return call Rt.epFreeRedirs(mknum([*CmdState](payload(cAddrN, 0))->redirs), mknum(0), mknum([*CmdState](payload(cAddrN, 0))->nredirs));
        } else {
          return mknil;
        }
        [*CmdState](payload(cAddrN, 0))->redirs = 0;
        if (mkbool([*CmdState](payload(cAddrN, 0))->argv != 0)) {
          return call Rt.epFreeArgv(mknum([*CmdState](payload(cAddrN, 0))->argv), mknum(0), mknum([*CmdState](payload(cAddrN, 0))->argc));
        } else {
          return mknil;
        }
        [*CmdState](payload(cAddrN, 0))->argv = 0;
        return mknum(-1);
      }
      [*Scratch](payload(stN, 0))->depth = depthW + 1;
      val subN = call Rt.epProg(subv, stN);
      [*Scratch](payload(stN, 0))->depth = depthW;
      if (mkbool(payload(subN, 0) < 0)) {
        if (mkbool([*CmdState](payload(cAddrN, 0))->subprog != 0)) {
          return call Rt.epFreeChains(mknum([*CmdState](payload(cAddrN, 0))->subprog), mknum([*Prog]([*CmdState](payload(cAddrN, 0))->subprog)->chains), mknum(0));
        } else {
          return mknil;
        }
        if (mkbool([*CmdState](payload(cAddrN, 0))->redirs != 0)) {
          return call Rt.epFreeRedirs(mknum([*CmdState](payload(cAddrN, 0))->redirs), mknum(0), mknum([*CmdState](payload(cAddrN, 0))->nredirs));
        } else {
          return mknil;
        }
        [*CmdState](payload(cAddrN, 0))->redirs = 0;
        if (mkbool([*CmdState](payload(cAddrN, 0))->argv != 0)) {
          return call Rt.epFreeArgv(mknum([*CmdState](payload(cAddrN, 0))->argv), mknum(0), mknum([*CmdState](payload(cAddrN, 0))->argc));
        } else {
          return mknil;
        }
        [*CmdState](payload(cAddrN, 0))->argv = 0;
        return mknum(-1);
      }
      [*CmdState](payload(cAddrN, 0))->subprog = payload(subN, 0);
      val nstdin = call Rt.epCountStdin(mknum([*CmdState](payload(cAddrN, 0))->redirs), mknum([*CmdState](payload(cAddrN, 0))->nredirs), mknum(0));
      if (mkbool(payload(nstdin, 0) > 1)) {
        if (mkbool([*CmdState](payload(cAddrN, 0))->subprog != 0)) {
          return call Rt.epFreeChains(mknum([*CmdState](payload(cAddrN, 0))->subprog), mknum([*Prog]([*CmdState](payload(cAddrN, 0))->subprog)->chains), mknum(0));
        } else {
          return mknil;
        }
        if (mkbool([*CmdState](payload(cAddrN, 0))->redirs != 0)) {
          return call Rt.epFreeRedirs(mknum([*CmdState](payload(cAddrN, 0))->redirs), mknum(0), mknum([*CmdState](payload(cAddrN, 0))->nredirs));
        } else {
          return mknil;
        }
        [*CmdState](payload(cAddrN, 0))->redirs = 0;
        if (mkbool([*CmdState](payload(cAddrN, 0))->argv != 0)) {
          return call Rt.epFreeArgv(mknum([*CmdState](payload(cAddrN, 0))->argv), mknum(0), mknum([*CmdState](payload(cAddrN, 0))->argc));
        } else {
          return mknil;
        }
        [*CmdState](payload(cAddrN, 0))->argv = 0;
        return mknum(-1);
      }
      return mknum(0);
    }
  }
}

defun Rt.childCd(argvN : val, argcN : val, stN : val) -> val {
  word cbufW = [*Exec](payload(stN, 0))->cbuf;
  val dirN = mkbool(payload(argcN, 0) > 1) ? mknum(wload(payload(argvN, 0), 1)) : mknum(0);
  val dirN = if (mkbool(payload(dirN, 0) == 0)) {
    return call Rt.envHome(stN);
  } else {
    val ln = call Rt.cStrLenGo(dirN, mknum(0));
    if (mkbool(payload(ln, 0) == 0)) { return call Rt.envHome(stN); }
    return dirN;
  };
  val dirN = mkbool(payload(dirN, 0) == 0) ? mknum(cbufW + 139) : dirN;
  val ln = call Rt.cStrLenGo(dirN, mknum(0));
  if (mkbool(payload(ln, 0) >= 4096)) {
    return mknum(1);
  }
  word bufW = rawcall malloc(4096);
  if (mkbool(bufW == 0)) {
    word h = rawcall rt_halt();
    return mknil;
  } else {
    return mknum(0);
  }
  call Rt.cStrCopyGo(dirN, mknum(bufW), mknum(0));
  word rc = rawcall chdir(bufW);
  rawcall free(bufW);
  if (mkbool(rc == 0)) {
    return mknum(0);
  }
  call Rt.wStr(mknum(2), mknum(cbufW + 240));
  call Rt.wStr(mknum(2), dirN);
  call Rt.wRaw(mknum(2), mknum(cbufW + 173), mknum(1));
  return mknum(1);
}
// ===== the stage-6 B0 frame machinery (VERBATIM rt.zig rt_frame_enter/
// rt_frame_leave, rt.zig:225-321).  The pooled freelist-head ARRAY lives in
// the U1c globals block (RtGc: words 16..16+8192, indexed by nslots; bound
// 8192, giants never pooled).  Two further globals are needed that the RtGc
// layout comment does not name: word 1 = frame_top (the active-frame stack
// head), word 2 = no_frame_reuse (read ONCE in Rt.main, checked here — the
// rt.zig:240-249 discipline; a per-call getenv is the measured 8.4% trap).
// The header is 40 bytes = 5 words and is the file-scoped `struct FrameHdr`
// above (the ONE name -> slot table: live@0 (i32), wm@1, next@2, freeNext@3,
// _pad@4 — the rt.zig slots pointer field, which neither shape writes; the
// slots DATA starts at +40, word 5).  A Value is 40 bytes = 5 words, so
// zeroing is 5 words per slot.
// Zero-BEFORE-root: the reused block's stale slots are memset to the
// number-0 Value (tag 0, payload 0) BEFORE rootPushValueArray — otherwise
// scanValue chases freed GC pages.
//
// THE 175x FIX (stage-6 B0perf), THE ~3.4x->~1x CLOSE (stage-6 B0perf-2) and
// THE BULK-ZERO CLOSE (stage-6 P1e): the original loop stored ONE BYTE per
// iteration and re-boxed the decremented count (`mknum(...)`) on every `recur`
// — an ALLOCATION per byte, nslots*40 allocations per frame.  B0perf zeroed a
// full 40-byte SLOT (5 words) per iteration; B0perf-2 made that loop a rawAbi
// WORD defun (frameZero) so it allocated NOTHING — but it was still a LOOP,
// ~8-10 instructions per 40-byte slot.  P1e deletes the loop entirely: ONE
// `rawcall memset(base, 0, 40 * nslots)` zeroes the whole block — the exact
// `@memset(hdr.slots[0..nslots], zeroValue())` Zig emits (rt.zig:281).  Byte
// equivalence: a Value is 5 words, and the loop wrote five zero WORDS per slot
// (40 zero bytes) — memset writes the same 40*nslots zero bytes in one call.
// Header word 4 (the slots-POINTER field) is written by NEITHER shape: the Mid
// frame path never reads it (rt_root_push_value_array takes base+live
// explicitly), so the old counter seeding (wstore(hdr, 4, nslots)) drops with
// the loop.
//
// NOTE (P1e item 2 deferred): frameBlock's three `payload(mknum(..))` selects
// and frame-leave's two dead word-if binders are LEFT AS-IS.  A rawAbi WORD
// defun has NO word-join — `lowerTailWordBranches` rejects a tail If whose two
// branches both return a word (no phi), and a word-valued `?:`/`if` in a value
// slot is a loud `wordProducerMessage` — so the `mknum`-to-slot-then-`payload`
// round-trip IS the word-join-via-memory idiom, the minimal expressible form.
defun Rt.frameBlock(nslots : word) -> word {
  word bytes = 40 + 40 * nslots;
  word g = payload((nslots < 8192) ? mknum(rawcall rt_glob_addr()) : mknum(0), 0);
  *FrameHdr h = payload((g != 0) ? mknum(wload(g, 16 + nslots)) : mknum(0), 0);
  word popped = if (h != 0) {
    wstore(g, 16 + nslots, h->freeNext);
    return 0;
  } else {
    return 0;
  };
  word r = payload((h != 0) ? mknum(h) : mknum(rawcall malloc(bytes)), 0);
  return r;
}

defun Rt.frame-enter(nslots : word) -> word {
  *FrameHdr hdr = call Rt.frameBlock(nslots);
  word base = [word](hdr) + 40;
  rawcall memset(base, 0, 40 * nslots);
  hdr->live = nslots;
  word wm = rawcall rt_root_watermark();
  hdr->wm = wm;
  word glob = rawcall rt_glob_addr();
  hdr->next = wload(glob, 1);
  wstore(glob, 1, hdr);
  rawcall rt_root_push_value_array(base, hdr);
  return base;
}

defun Rt.frame-leave() -> word {
  word glob = rawcall rt_glob_addr();
  *FrameHdr hdr = wload(glob, 1);
  word bad = if (hdr == 0) {
    call Rt.die(rawstr("qbe-rt: rt_frame_leave with no frame"));
    return 0;
  } else {
    return 0;
  };
  wstore(glob, 1, hdr->next);
  rawcall rt_root_pop_to(hdr->wm);
  word n = hdr->live;
  word pooled = if (wload(glob, 2) != 0) {
    return 0;
  } else {
    if (n >= 8192) {
      return 0;
    } else {
      hdr->freeNext = wload(glob, 16 + n);
      wstore(glob, 16 + n, hdr);
      return 0;
    }
  };
  return 0;
}

defun Rt.die(msg : word) -> word {
  val len = call Rt.cStrLenGo(mknum(msg), mknum(0));
  rawcall write(2, msg, payload(len, 0));
  rawcall write(2, rawstr("\n"), 1);
  rawcall exit(1);
  return 0;
}
defun Rt.halt() -> word {
  word m = rawstr("qbe-rt: qbe-rt: halt (a Mid prim reached its halt arm)");
  val len = call Rt.cStrLenGo(mknum(m), mknum(0));
  rawcall write(2, m, payload(len, 0));
  rawcall write(2, rawstr("\n"), 1);
  rawcall exit(1);
  return 0;
}
defun Rt.cStrEq(a : word, b : word) -> word {
  val eq = call Rt.cStrEqGo(mknum(a), mknum(b), mknum(0));
  return payload(eq, 0);
}

defun Rt.cStrEqGo(a : val, b : val, i : val) -> val {
  word xa = byteload(payload(a, 0), payload(i, 0));
  word xb = byteload(payload(b, 0), payload(i, 0));
  if (mkbool(xb == 0)) {
    return mkbool(xa == 0);
  }
  if (mkbool(xa == xb)) {
    recur(a, b, mknum(payload(i, 0) + 1));
  }
  return false;
}

defun Rt.metaGo(blk : val, i : val) -> val {
  word nW = wload(payload(blk, 0), 2);
  if (mkbool(payload(i, 0) >= nW)) {
    return mkbool(0);
  }
  word baseW = wload(payload(blk, 0), 0);
  word entryW = wload(payload(blk, 0), 1);
  word row = baseW + (payload(i, 0) * 24);
  word nameW = wload(row, 0);
  word eq = call Rt.cStrEq(nameW, entryW);
  if (mkbool(eq != 0)) {
    wstore(payload(blk, 0), 3, wload(row, 1));
    wstore(payload(blk, 0), 4, wload(row, 2));
    return mkbool(1);
  }
  recur(blk, mknum(payload(i, 0) + 1));
}

defun Rt.parseArgsGo(blk : val, j : val) -> val {
  word nargsW = wload(payload(blk, 0), 2);
  if (mkbool(payload(j, 0) >= nargsW)) {
    return mknum(0);
  }
  word bufW = wload(payload(blk, 0), 0);
  word argvW = wload(payload(blk, 0), 1);
  word argPtr = bufW + (payload(j, 0) * 40);
  word argStr = wload(argvW, 2 + payload(j, 0));
  word rc = rawcall rt_parse_arg(argPtr, argStr);
  if (mkbool(rc != 0)) {
    return mknum(2);
  }
  recur(blk, mknum(payload(j, 0) + 1));
}

defun Rt.main(argc : word, argv : word) -> word {
  word usage = rawstr("usage: <prog> <entry-name> [int|float-arg ...]\n");
  word toomany = rawstr("qbe-rt: >16 entry args not supported\n");
  word u = if (mkbool(argc < 2)) {
    val len = call Rt.cStrLenGo(mknum(usage), mknum(0));
    rawcall write(2, usage, payload(len, 0));
    rawcall exit(2);
    return 0;
  } else {
    return 0;
  };
  word nargs = argc - 2;
  word argvMode = rawcall getenv(rawstr("AOTRUN_ARGV"));
  word t = if (mkbool(argvMode == 0) && mkbool(nargs > 16)) {
    val len2 = call Rt.cStrLenGo(mknum(toomany), mknum(0));
    rawcall write(2, toomany, payload(len2, 0));
    rawcall exit(2);
    return 0;
  } else {
    return 0;
  };
  word lim = rawcall malloc(16);
  word qnl = rawcall getenv(rawstr("QBE_NO_RLIMIT"));
  word rl = if (mkbool(qnl == 0)) {
    word rc = rawcall getrlimit(3, lim);
    word rl2 = if (mkbool(rc == 0)) {
      word cur = wload(lim, 0);
      word rl3 = if (mkbool(cur < 67108864)) {
