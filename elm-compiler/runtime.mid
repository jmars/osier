        rawcall close(payload(outfdW, 0));
        rawcall close(payload(errfdW, 0));
        word h = rawcall rt_halt();
        return mknil;
      } else {
        val res = call Rt.exec-run(outfdW, errfdW, codeN);
        return res;
      }
    }
