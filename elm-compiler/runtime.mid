  word a1 = abuf + 40;
  word a2 = abuf + 80;
  word a3 = abuf + 120;
  word a4 = abuf + 160;
  word a5 = abuf + 200;
  word a6 = abuf + 240;
  word a7 = abuf + 280;
  word a8 = abuf + 320;
  word a9 = abuf + 360;
  word a10 = abuf + 400;
  word a11 = abuf + 440;
  word a12 = abuf + 480;
  word a13 = abuf + 520;
  word a14 = abuf + 560;
