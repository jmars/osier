    vecstore(dataW, idxW, vecload(argsW, idxW - 1));
    return call Rt.conFill(mknum(dataW), mknum(argsW), mknum(idxW - 1));
  }
}

defun Rt.closure(desc : val, capBase : val, cnt : val) -> val {
