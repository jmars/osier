  call Rt.epFreeCmd(mknum(payload(cmdsN, 0) + (payload(iN, 0) * 40)));
  recur(pipeN, cmdsN, mknum(payload(iN, 0) + 1));
}

defun Rt.epFreeCmd(cmdAddrN : val) -> val {
  word argvW = [*CmdState](payload(cmdAddrN, 0))->argv;
  val _u11 = if (mkbool(argvW != 0)) {
    return call Rt.epFreeArgv(mknum(argvW), mknum(0), mknum([*CmdState](payload(cmdAddrN, 0))->argc));
