defun Rt.exec-run(outfdN : val, errfdN : val, codeN : val) -> val {
  *ReadBlk blkW = rawcall malloc(72);
  val _u38 = if (mkbool(blkW == 0)) {
    word h = rawcall rt_halt();
    return mknil;
  } else {
    return mknum(0);
  };
  val blkN = mknum(blkW);
  word tmpW = rawcall malloc(65536);
  val _u39 = if (mkbool(tmpW == 0)) {
    rawcall free(blkW);
    word h = rawcall rt_halt();
    return mknil;
  } else {
    return mknum(0);
  };
  blkW->acc = 0;
  blkW->len = 0;
  blkW->cap = 0;
  word oLS = rawcall lseek(payload(outfdN, 0), 0, 0);
  val _u40 = if (mkbool(oLS >= 0)) {
    blkW->fd = payload(outfdN, 0);
    blkW->tmp = tmpW;
    call Rt.readFileGo(blkN);
    return mknil;
  } else {
    return mknil;
  };
  word oBuf = blkW->acc;
  word oLen = blkW->len;
  blkW->acc = 0;
  blkW->len = 0;
  blkW->cap = 0;
  word eLS = rawcall lseek(payload(errfdN, 0), 0, 0);
  val _u41 = if (mkbool(eLS >= 0)) {
    blkW->fd = payload(errfdN, 0);
    blkW->tmp = tmpW;
    call Rt.readFileGo(blkN);
    return mknil;
  } else {
    return mknil;
  };
  word eBuf = blkW->acc;
  word eLen = blkW->len;
  rawcall close(payload(outfdN, 0));
  rawcall close(payload(errfdN, 0));
  word oDst = allocraw(oLen + 1);
  wstore(blkW, 6, oBuf);
  wstore(blkW, 7, oDst);
  wstore(blkW, 8, oLen);
  call Rt.memGo(mknum([word](blkW) + 48), mknum(0));
  bytestore(oDst, oLen, 0);
  rawcall free(oBuf);
  val oStr = mkstr(oDst, oLen);
  word eDst = allocraw(eLen + 1);
  wstore(blkW, 6, eBuf);
  wstore(blkW, 7, eDst);
  wstore(blkW, 8, eLen);
  call Rt.memGo(mknum([word](blkW) + 48), mknum(0));
  bytestore(eDst, eLen, 0);
  rawcall free(eBuf);
  val eStr = mkstr(eDst, eLen);
  rawcall free(tmpW);
  rawcall free(blkW);
  val tagOut = call Rt.cons(call Rt.intern("string"), call Rt.cons(oStr, mknil));
  val tagErr = call Rt.cons(call Rt.intern("string"), call Rt.cons(eStr, mknil));
  val emptyV = call Rt.cons(call Rt.intern("cons"), mknil);
  val errLst = call Rt.cons(call Rt.intern("cons"), call Rt.cons(tagErr, call Rt.cons(emptyV, mknil)));
  val outLst = call Rt.cons(call Rt.intern("cons"), call Rt.cons(tagOut, call Rt.cons(errLst, mknil)));
  val tagCode = call Rt.cons(call Rt.intern("number"), call Rt.cons(mknum(payload(codeN, 0)), mknil));
  return call Rt.cons(call Rt.intern("cons"), call Rt.cons(tagCode, call Rt.cons(outLst, mknil)));
}
// Rt.gcEnvNum: the DECIMAL value of a getenv string (0 for unset), stopping at
// the first non-digit.  A `recur` loop rather than a `while` with a mutable
// local on purpose: a WORD binder that is the target of an assignment becomes
// an AUTO-CELL (`allocN`, Mid.RtLang.Ast's AUTO-CELL note) — an ALLOCATING
// node — and every collector defun must stay FRAME-FREE (TestMain's
// classification row: a framed callee must never reach a safepoint, and this
// one runs inside Rt.gcInit).  State travels in the arguments, which is the
// tree's dominant loop idiom (Rt.gcSweep, Rt.gcMarkRoots, Rt.gcClearClasses).
defun Rt.gcEnvNum(p : val, acc : val) -> val {
  word pW = payload(p, 0);
  word accW = payload(acc, 0);
  if (mkbool(pW == 0) || (mkbool(byteload(pW, 0) < 48) || mkbool(byteload(pW, 0) > 57))) {
    return mknum(accW);
  } else {
    recur(mknum(pW + 1), mknum(accW * 10 + (byteload(pW, 0) - 48)));
  }
}
defun Rt.gcInit(dummy : val) -> val {
  word glob = rawcall rt_glob_addr();
  word region = wload(glob, 0);
  if (mkbool(region != 0)) {
    return mknum(region);
  } else {
    // the stats knob, read ONCE: QBE_MIDGC_STATS=1 prints one line per collect
    // (Rt.collect -> Rt.gcNumOut) AND one line per GROWTH (Rt.gcAlloc).
    // Glob word 8 is the MIDGC-owned block's first free knob slot (Rt.main
    // uses 2, 12, 13).
    word statsKnob = rawcall getenv(rawstr("QBE_MIDGC_STATS"));
    wstore(glob, 8, statsKnob);
    // QBE_MIDGC_NOREUSE (GC ARC unit 1b): read ONCE here, stored in the
    // region's slot 7 (the struct's `noreuse` field).  Rt.gcAllocGo then never
    // pops a free-list block, so a swept block is never handed out again and a
    // stale pointer cannot alias a live object.  Knob only — the environment
    // is not consulted per allocation.
    word noreuseKnob = rawcall getenv(rawstr("QBE_MIDGC_NOREUSE"));
    // QBE_MIDGC_VERIFY (GC ARC unit 2): read ONCE here, stored in the region's
    // slot 27.  Nonzero = after EVERY sweep, verify the collector's invariants
    // (Rt.gcVerify).  The per-pointer invariants (block start / not freed) are
    // checked in EVERY build — they are two map reads and they turn silent
    // corruption into a named fatal — this knob adds the O(heap) post-collect
    // walk that no default run can afford.
    word verifyKnob = rawcall getenv(rawstr("QBE_MIDGC_VERIFY"));
    // THE HEAP KNOB IS MID'S NOW (ZIGHOST Z4a): the rt_gc_heap_bytes seat is
    // deleted and this is the same parse its owner did (rt_boot: absent,
    // unparseable or 0 -> 64 MiB, else N MiB), through the Mid env reader the
    // other three knobs already use.  The Zig Gc still computes its OWN copy
    // from the same environment in rt_boot (it dies at Z5); nothing reads the
    // number across the seam any more.
    val heapArgV = call Rt.gcEnvNum(mknum(rawcall getenv(rawstr("QBE_HEAP_MB"))), mknum(0));
    word heapArg = payload(heapArgV, 0);
    word heapBytes = payload((heapArg != 0) ? mknum(heapArg * 1048576) : mknum(67108864), 0);
    // THE HEAP CEILING (GC ARC unit 4).  `heapBytes` is the INITIAL heap, not
    // the heap — the same semantics the Zig arm gives the same knob
    // (vendor/osier-rt/src/gc/heap.zig:145-176: `heap_bytes` is an initial size
    // and `grow_heap` doubles into a reservation).  MEASURED, before this unit:
    // the two 100%-live fixtures (churn 19.2 MB, vfield-rooted 25.2 MB of
    // bodies) died `qbe-rt: midgc: out of memory` at QBE_HEAP_MB=16 — not
    // churn pressure, a HARD one-shot mmap at the initial size — while the Zig
    // arm at the same number survived by growing (live_pages 14337 -> 28673).
    //
    // THE RULE (stated, not implied): ceiling = min(8 x initial, initial + 4
    // GB).  8x is the Zig arm's own effective ceiling (hostshim.zig rt_boot
    // reserves 16x the heap and grow_heap halves it, GC-FIX C), so one knob
    // means the same thing on both routes at fixture heaps; the +4 GB arm keeps
    // the RESERVE — one mmap, VAS only — inside the range this host is measured
    // to map (overcommit_memory=0, 125 GB RAM: 64 GiB maps, 128 GiB does not,
    // heap.zig:405-410), because the Mid init has no shrink loop: an
    // unmappable reserve dies loudly at 'mmap failed' instead.
    // QBE_MIDGC_MAXMB=<MB> overrides the rule (probes, and callers who want a
    // hard memory bound); it is CLAMPED UP to heapBytes, because QBE_HEAP_MB is
    // the guarantee and a ceiling below it would make the initial heap
    // unmappable.
    word capKnob = rawcall getenv(rawstr("QBE_MIDGC_MAXMB"));
    val capArgV = call Rt.gcEnvNum(mknum(capKnob), mknum(0));
    word capArg = payload(capArgV, 0);
    word ruleCap = payload((heapBytes * 8 < heapBytes + 4294967296) ? mknum(heapBytes * 8) : mknum(heapBytes + 4294967296), 0);
    word knobCap = payload((capArg != 0) ? mknum(capArg * 1048576) : mknum(ruleCap), 0);
    word capBytes = payload((knobCap < heapBytes) ? mknum(heapBytes) : mknum(knobCap), 0);
    // THE LAYOUT IS SIZED FOR THE CEILING (never the initial heap): the mark
    // stack must hold one entry per 64-byte block the LARGEST heap this region
    // can become (the F1 theorem below), and the free-list table must have a
    // class for the largest block it can hold.  Both cost VAS plus only the
    // pages actually touched (the mark stack to its depth, the table zeroed per
    // collect), and the sweep still walks the reached frontier
    // [heapStart, cursor) — never the reserve.
    word capWords = capBytes / 8;
    word markEnd = 64 + capWords / 8 + 64;
    word numClasses = 1 + payload((capWords <= 4096) ? mknum((capWords + 7) / 8) : mknum(512 + (capWords - 4096 + 4095) / 4096), 0);
    // THE BLOCK MAP (GC ARC unit 2, slot 25): one BYTE per 64-byte minimum
    // block, also sized for the CEILING.  It sits between the class table and
    // the heap, in the same mmap, and it is what lets the marker, the sweeper
    // and the verifier agree on WHERE THE BLOCKS ARE — a question the flags
    // word alone cannot answer for an interior pointer: reading `p-2` at a
    // non-start address returns another block's body word, and writing the
    // mark bit there CORRUPTS IT.  Cost: capBytes/512 bytes of VAS at 8-byte
    // granularity (2 MB at a 128 MB ceiling), of which only the pages covering
    // the reached frontier are ever touched.
    word bmBytes = capBytes / 64;
    // THE NURSERY PLAN (GC NURSERY unit) — SHARED text, present in every
    // MIDGC build, inert unless the young build's spliced-in code reads the
    // slots: youngBytes is 0 unless the ENVIRONMENT asks for the nursery
    // (QBE_MIDGC_YOUNG=1), so a plain MIDGC build reserves NOTHING young and
    // its behaviour is the pre-nursery tree's.  The DEFAULT young size is
    // clamp(heapBytes/8, 4 MB, 512 MB) — DEVIATION from gc-plan §5.2's
    // max(4 MB, heapBytes/4), on purpose: a young space is TOUCHED once per
    // cycle (the bump pointer runs through all of it), so a 4 GB young at a
    // 16 GB heap would put 4 GB of RSS under the collector for no copy-volume
    // benefit (survivors are 2.5% of it either way); 512 MB keeps the same
    // per-scavenge copy work with 8x less touched memory.  QBE_MIDGC_YOUNG_MB
    // overrides for experiments.  `=0` means OFF (the run-time escape
    // hatch); unset means ON since the flip.
    word youngKnob = rawcall getenv(rawstr("QBE_MIDGC_YOUNG"));
    // DEFAULT ON SINCE THE FLIP: the nursery runs unless the env is exactly
    // "0" (the run-time escape hatch).
    word youngOn = payload((mkbool(youngKnob != 0) && mkbool(byteload(youngKnob, 0) == 48)) ? mknum(0) : mknum(1), 0);
    word ymbKnob = rawcall getenv(rawstr("QBE_MIDGC_YOUNG_MB"));
    val ymbArgV = call Rt.gcEnvNum(mknum(ymbKnob), mknum(0));
    word ymbArg = payload(ymbArgV, 0);
    word yDiv = heapBytes / 8;
    word yDef = payload((yDiv < 536870912) ? mknum(yDiv) : mknum(536870912), 0);
    word yFloor = payload((yDef < 4194304) ? mknum(4194304) : mknum(yDef), 0);
    word yArg = payload((ymbArg != 0) ? mknum(ymbArg * 1048576) : mknum(yFloor), 0);
    word youngBytes = payload((youngOn != 0) ? mknum(yArg) : mknum(0), 0);
    // CLAMPED TO capBytes: the scavenge's SCAN QUEUE is the mark stack (one
    // entry per promoted block), so a young cycle can hold at most as many
    // blocks as the OLD ceiling — the same bound the mark-stack guard below
    // asserts.  A young bigger than the ceiling would overflow the queue into
    // the class table, so the clamp is a correctness bound, not a preference.
    word youngFit = payload((youngBytes > capBytes) ? mknum(capBytes) : mknum(youngBytes), 0);
    // THE REMEMBERED SET (slot 32): capacity capBytes/64 words — one entry per
    // 64-byte minimum block, the mark stack's own bound (an old block is
    // remembered at most once per young cycle; the RS bit dedups and is only
    // cleared by death or by a scavenge scan).  RESERVED IN EVERY MIDGC BUILD
    // (VAS only, touched only by young builds) so the LAYOUT — and therefore
    // heapStart, the block map's base and every map index — is the same
    // function of capBytes whether or not the young code is linked.
    word rsWords = capBytes / 64;
    word regionSize = markEnd * 8 + rsWords * 8 + numClasses * 8 + 16 + bmBytes + capBytes + youngFit;
    word base = rawcall mmap(0, regionSize, 3, 34, -1, 0);
    if (mkbool(base < 0)) {
      call Rt.die(rawstr("qbe-rt: midgc: mmap failed"));
      return mknil;
    } else {
      word rsBase = base + markEnd * 8;
      word classTable = rsBase + rsWords * 8;
      word bmPtr = classTable + numClasses * 8 + 16;
      word heapStart = bmPtr + bmBytes;
      // capEnd is the CEILING; heapEnd is the CURRENT limit, which starts at
      // the initial heap and is raised by Rt.gcAlloc's growth step.
      word capEnd = heapStart + capBytes;
      word heapEnd = heapStart + heapBytes;
      // THE MARK-STACK BOUND, AS A CHECKED INVARIANT (GC-ARC F1).  The plan
      // recorded it as a 0.05% MARGIN that "holds" — an assertion, not a
      // property.  It is a THEOREM once stated right: the sweep's smallest
      // physical block is class 1 = 8 words = 64 bytes (gcAlloc's
      // `(total+7)/8` with total >= 3), so no heap this geometry can map
      // holds more than `(capEnd - heapStart) / 64` object bodies, and the
      // mark walk pushes at most ONE entry per body (gcMarkPtr's `marked == 0`
      // test).  Capacity is `markEnd - 64` = capWords/8 + 64 = the largest
      // block count the CEILING can hold, PLUS 64 spare entries.  The margin is
      // therefore the constant 64 at EVERY heap size and every ceiling (it was
      // heapBytes/262144 + ~72 before this unit), and it holds ONLY because the
      // mark stack, the class table and the heap are carved from the one mmap:
      // if a later change moves the class table, shrinks the stack, or changes
      // the minimum class, this DIES AT INIT instead of overflowing a stack
      // nothing can grow.  MEASURED: 16 MB heap / 128 MB ceiling -> 2 097 216
      // capacity vs 2 097 152 bodies; 64 MB / 512 MB -> 8 388 672 vs 8 388 608.
      // probe-midgc-guards.sh is the fail-before (a halved stack trips it).
      word maxBlocks = (capEnd - heapStart) / 64;
      // ONE-SIDED (GC ARC unit 1b): the `else { return mknil; }` filler is gone.
      // The `thenDiv && not elseDiv` shape splices the continuation into the
      // FALSE path, so this means what it reads as under BOTH readings of a
      // statement-position `return` — die here, carry on there.  The old
      // both-diverging form worked ONLY because the lowerer dead-binds it and
      // continues (the landmine documented in Rt.gcAlloc's trigger below).
      if (mkbool(markEnd - 64 < maxBlocks)) {
        call Rt.die(rawstr("qbe-rt: midgc: mark stack smaller than the heap can hold"));
        return mknil;
      }
      wstore(glob, 0, base);
      wstore(base, 0, 331941693251);
      wstore(base, 1, classTable);
      wstore(base, 2, heapStart);
      wstore(base, 3, heapStart);
      wstore(base, 4, heapEnd);
      wstore(base, 5, 64);
      wstore(base, 6, markEnd);
      wstore(base, 7, noreuseKnob);
      wstore(base, 10, heapBytes);
      wstore(base, 11, 0);
      wstore(base, 12, numClasses);
      wstore(base, 24, capEnd);
      wstore(base, 25, bmPtr);
      wstore(base, 26, 0);
      wstore(base, 27, payload((verifyKnob != 0) ? mknum(1) : mknum(0), 0));
      // THE NURSERY SLOTS (GC NURSERY unit, shared text): written in every
      // MIDGC build; when the environment did not ask for the nursery,
      // youngBytes is 0, so [youngStart, youngEnd) is EMPTY and every
      // young-range test in shared code (gcMarkPtr's missing-root die) is
      // inert.  The young space sits AFTER the old-space ceiling — outside
      // [heapStart, heapEnd), outside the block map, and never walked by the
      // sweep or the verifier.
      wstore(base, 28, youngOn);
      wstore(base, 29, capEnd);
      wstore(base, 30, capEnd + youngFit);
      wstore(base, 31, capEnd);
      wstore(base, 32, rsBase);
      wstore(base, 33, 0);
      wstore(base, 34, rsBase + rsWords * 8);
      wstore(base, 35, 0);
      wstore(base, 36, 0);
      wstore(base, 37, 0);
      return mknum(base);
    }
  }
}
// THE REGION WITHOUT THE CALL (perf U3).  `Rt.gcInit`'s early exit tests
// exactly ONE predicate — `wload(rt_glob_addr(), 0) != 0`, the region word —
// and that word is written exactly once (gcInit's own `wstore(glob, 0, base)`)
// and cleared by nothing, so fetching it here is the SAME value for one load
// instead of a call plus a frame and that frame's zeroed block, on every
// allocation after the first.  The CALL stays on the null path: the region is
// legitimately absent at boot and in the window before the first allocation
// (Rt.vecStoreYoung documents the same lazy region — a vecstore can precede
// it).  Nothing downstream moves: Rt.gcAlloc receives the identical word, so
// the bump, the class, the collect trigger and the scavenge decision are the
// same arithmetic on the same input.
//
// THE PREDICATE, STATED SO IT CANNOT DRIFT: gcInit's guard is
//   `if (mkbool(region != 0)) { return mknum(region); } else { ...map... }`
// — there is no second condition (no flag, no generation, no heap-mode
// toggle) between "the word is non-null" and "return it".  If that ever gains
// one, this fast path must carry it too; probe-midgc-guards.sh's stress-preinit
// arm is the probe that keeps the null path exercised.
defun Rt.allocVector(count : val) -> val {
  word glob = rawcall rt_glob_addr();
  word regionW = wload(glob, 0);
  val region = (mkbool(regionW != 0)) ? mknum(regionW) : call Rt.gcInit(mknum(0));
  word countW = payload(count, 0);
  return call Rt.gcAlloc(region, mknum(1), mknum(countW));
}
defun Rt.allocRaw(nbytes : val) -> val {
  word glob = rawcall rt_glob_addr();
  word regionW = wload(glob, 0);
  val region = (mkbool(regionW != 0)) ? mknum(regionW) : call Rt.gcInit(mknum(0));
  word nbytesW = payload(nbytes, 0);
  word bodyWords = (nbytesW + 7) / 8;
  return call Rt.gcAlloc(region, mknum(0), mknum(bodyWords));
}
// >>> QBE_WORDVAL-ONLY
// ==================== THE GC-HEADER KIND CONTRACT (perf VR3c AREA 1) ============
// THE DEFINITION IS `Mid/RtLayout.elm`'s "THE GC-HEADER KIND CONTRACT"
// section.  This block is the runtime's own statement of the same numbers, and
// TestMain parses the rows below and compares them with RtLayout — a stale
// duplicate on either side FAILS a test instead of linking cleanly and reading
// another object's bytes at the wrong offset.
//
// Under the word arm EVERY heap object's value tag is `...001`, so WHICH object
// a pointer names is read from its 2-word GC header, whose fields do not move:
//
//   bit 0      mark          set by the marker, cleared by the sweep
//   bit 1      scan kind     1 = the body is `count` Values, 0 = raw words
//   bits 2..23 class          the size class (the ladder's own packing)
//   bits 24..27 KIND CODE     this contract
//   bit 61     RS            the remembered set
//   bit 62     FORWARDED     the young space's evacuation mark
//
// THE KIND CODE IS THE OBJECT'S VALTAG INTEGER — the same numbering the val arm
// writes into a Value's tag word — so a word-arm `tagis(v, 4)` is "read the
// header, compare the code with 4".  Code 0 means NO CODE: the val arm writes
// nothing there, so a word-arm reader that meets 0 is looking at a val-arm
// header and must refuse it BY NAME rather than mistake it for a constructor.
//
// THE SCAN BIT IS DERIVED FROM THE CODE (Rt.kindHdr below): the codes with
// Value bodies are cons, lambda, error, vector and record; strings, symbols,
// prims, streams and float cells have raw bodies.
//
// KIND-CONTRACT: shift 24
// KIND-CONTRACT: mask 15
// KIND-CONTRACT: string 1 raw
// KIND-CONTRACT: symbol 2 raw
// KIND-CONTRACT: cons 4 scanned
// KIND-CONTRACT: lambda 6 scanned
// KIND-CONTRACT: prim 8 raw
// KIND-CONTRACT: error 9 scanned
// KIND-CONTRACT: vector 10 scanned
// KIND-CONTRACT: stream 11 raw
// KIND-CONTRACT: float 12 raw
// KIND-CONTRACT: record 14 scanned
//
// THE BODY-SIZE RULE IS `2 + count` WORDS.  A body unit is ONE word, so a cons
// is 2 + 2 = 4 words = 32 B (16 B of 2-word header plus 16 B of body), a
// vector 2 + n, a string 2 + (bytes+7)/8, a float cell 2 + 1.  The val arm's
// unit is `1 + 4*kind` words (a 40-byte Value), i.e. the SAME expression with
// the layout's `valuePayloadWords` folded in — which is why gcAlloc's two
// spellings below differ by exactly that term and nothing else.
// <<< QBE_WORDVAL-ONLY
defun Rt.gcAlloc(region : val, kind : val, count : val) -> val {
  word kindW = payload(kind, 0);
  word countW = payload(count, 0);
  *Region regionW = payload(region, 0);
  word total = 2 + (countW + 4 * countW * kindW);
  word cls = payload((total <= 4096) ? mknum((total + 7) / 8) : mknum(512 + (total - 4096 + 4095) / 4096), 0);
  word phys = payload((cls <= 512) ? mknum(cls * 8) : mknum(4096 + (cls - 512) * 4096), 0);
  word heapBytes = regionW->heapBytes;
  word allocated = regionW->allocated;
  regionW->kind = kindW;
  regionW->count = countW;
  // THE COLLECT TRIGGER FOLLOWS THE HEAP (unit 4): `limit/4`, where limit is
  // heapEnd - heapStart.  At init that is exactly heapBytes/4 — the number
  // every fixture's collect count was measured at — and after a growth it keeps
  // the same 4-collects-per-heap cadence instead of collecting more often
  // against a bigger region (a fixed heapBytes/4 would multiply the O(heap)
  // sweep by the growth factor).
  // THE TRIGGER, AS A CONDITIONAL VALUE (GC ARC unit 1b).  This site read
  //   if (over) { collect; allocated = 0; return mknil; } else { return mknil; }
  // and it worked ONLY because a both-diverging statement `if` is a DEAD BIND
  // in this language: the lowerer evaluates the chosen arm's value and
  // CONTINUES (`LowerToIr.elm`'s `thenDiv && elseDiv` arm).  Under the obvious
  // reading — a `return` exits — that code collects and then RETURNS mknil
  // WITHOUT ALLOCATING: every allocation that crosses the trigger yields nil,
  // a silent-wrong answer rather than a crash.
  //
  // Neither spelling J7 admits can express "conditionally do something, then
  // carry on": a both-falling mid-block `if` is REJECTED (Mid has no join) and
  // a one-sided `if` splices the continuation into its FALSE path, so its then
  // arm would return.  The language's join-free conditional effect is the
  // conditional VALUE — the ternary the runtime already uses freely
  // (Rt.recAppendDataGo's `? vecstore(..) : ..`) — with the effect in one arm
  // and `mknil` in the other, read back through `payload` for its class.
  // Rt.collect resets `allocated` itself, so the bound word is discarded.
  word trig = payload((allocated > (regionW->heapEnd - regionW->heapStart) / 4) ? call Rt.collect(mknum(0)) : mknil, 0);
  // >>> QBE_MIDGC_YOUNG-ONLY
  // THE NURSERY PATH (GC NURSERY unit): when the young space is active, every
  // request that FITS in it bumps there (never the old free lists — the
  // nursery is a pure bump allocator, its blocks are never in the block map,
  // and nothing dead is ever walked).  On fill: ONE scavenge empties it
  // (every live young object is promoted to old space and every root slot
  // updated), and the retry then always fits — the request was <= youngBytes
  // by the dispatch test, and the young space is empty again.  Requests
  // BIGGER than the young space (and every request in a young-OFF run) fall
  // through to the old path below, untouched.
  if (mkbool(regionW->young != 0) && mkbool(phys * 8 <= regionW->youngEnd - regionW->youngStart)) {
    word yc0 = regionW->youngCursor;
    if (mkbool(yc0 + phys * 8 > regionW->youngEnd)) {
      call Rt.gcScavenge(mknum(0));
      word yc1 = regionW->youngCursor;
      wstore(yc1, -2, kindW * 2 + cls * 4);
      wstore(yc1, -1, countW);
      regionW->youngCursor = yc1 + phys * 8;
      regionW->allocated = regionW->allocated + phys * 8;
      return mknum(yc1);
    } else {
      wstore(yc0, -2, kindW * 2 + cls * 4);
      wstore(yc0, -1, countW);
      regionW->youngCursor = yc0 + phys * 8;
      regionW->allocated = regionW->allocated + phys * 8;
      return mknum(yc0);
    }
  }
  // <<< QBE_MIDGC_YOUNG-ONLY
  val first = call Rt.gcAllocGo(region, mknum(cls));
  word firstW = payload(first, 0);
  if (mkbool(firstW == 0)) {
    word cursor = regionW->cursor;
    word heapEnd = regionW->heapEnd;
    if (mkbool(cursor + phys * 8 < heapEnd)) {
      wstore(cursor, -2, kindW * 2 + cls * 4);
      wstore(cursor, -1, countW);
      // THE BLOCK MAP IS WRITTEN ON THE BUMP PATH ONLY (GC ARC unit 2): a block
      // start is a PERMANENT property of the address in a non-moving collector,
      // so a free-list pop (Rt.gcAllocGo) only flips the byte back to LIVE, and
      // the sweep flips it to FREED.  One division and one byte store.
      bytestore(regionW->bmPtr + (cursor - regionW->heapStart) / 64, 0, 1);
      regionW->cursor = cursor + phys * 8;
      regionW->allocated = regionW->allocated + phys * 8;
      return mknum(cursor);
    } else {
      call Rt.collect(mknum(0));
      val retry = call Rt.gcAllocGo(region, mknum(cls));
      word retryW = payload(retry, 0);
      if (mkbool(retryW == 0)) {
        // GROW (GC ARC unit 4).  Reclamation was tried FIRST and returned
        // nothing for this class, so the only way to satisfy the request is a
        // bigger heap.  The step is a DOUBLING of the current limit — the Zig
        // arm's grow_heap rule (heap.zig:683) — raised to the requested block
        // when one block needs more than a doubling (the Zig's own
        // max(2 x heappages, allocated + needed + slack) shape), and CLAMPED to
        // the ceiling.  Nothing moves: a mark-sweep has no forwarding, so a
        // bigger limit is just a bigger [heapStart, cursor) frontier, and the
        // marker's bound (heapEnd) grows with it.
        word heapStart = regionW->heapStart;
        word capEnd = regionW->capEnd;
        word needLim = (cursor + phys * 8) - heapStart;
        word lim = heapEnd - heapStart;
        word dbl = lim * 2;
        word limUp = payload((dbl < needLim) ? mknum(needLim) : mknum(dbl), 0);
        word capLim = capEnd - heapStart;
        word limCap = payload((limUp < capLim) ? mknum(limUp) : mknum(capLim), 0);
        word newEnd = heapStart + limCap;
        // THE GROWTH ITSELF IS A CONDITIONAL VALUE (GC ARC unit 1b): the
        // store and the stats transcript are a multi-statement effect that
        // must be followed by the bump below, and this language has no
        // both-falling mid-block `if` (J7) and no statement-position exit — so
        // the effect lives in Rt.gcGrow and is invoked from a ternary arm.
        // The old form relied on the dead-bind landmine exactly like the
        // trigger above did.
        word grew = payload((newEnd > heapEnd) ? call Rt.gcGrow(region, mknum(newEnd)) : mknil, 0);
        if (mkbool(cursor + phys * 8 < regionW->heapEnd)) {
          wstore(cursor, -2, kindW * 2 + cls * 4);
          wstore(cursor, -1, countW);
          bytestore(regionW->bmPtr + (cursor - regionW->heapStart) / 64, 0, 1);
          regionW->cursor = cursor + phys * 8;
          regionW->allocated = regionW->allocated + phys * 8;
          return mknum(cursor);
        } else {
          // THE CEILING, LOUDLY.  `heapEnd` is the ceiling here (the growth
          // above clamps to capEnd, so a request the ceiling cannot hold leaves
          // the limit AT it), and the numbers make the case actionable instead
          // of a bare "out of memory": raise QBE_MIDGC_MAXMB (or QBE_HEAP_MB,
          // which raises the ceiling with it).
          call Rt.gcNumOut(mknum(rawstr("qbe-rt: midgc: out of memory: heap at its ceiling of ")), mknum(capLim / 1048576), region);
          call Rt.gcNumOut(mknum(rawstr(" MB (initial ")), mknum(heapBytes / 1048576), region);
          rawcall write(2, rawstr(" MB)\n"), 5);
          call Rt.die(rawstr("qbe-rt: midgc: out of memory"));
          return mknil;
        }
      } else {
        regionW->allocated = regionW->allocated + phys * 8;
        return mknum(retryW);
      }
    }
  } else {
    regionW->allocated = regionW->allocated + phys * 8;
    return mknum(firstW);
  }
}
// Rt.gcGrow: RAISE the limit and, under QBE_MIDGC_STATS, print the growth
// line.  Extracted from Rt.gcAlloc by GC ARC unit 1b — a conditional effect
// that must be followed by more work is inexpressible at a mid-block `if`
// here (see gcAlloc's trigger note), so it is a DEFUN invoked from a ternary
// arm.  FRAME-FREE by construction (raw words and the region view only), the
// same class as every other collector leaf.
defun Rt.gcGrow(region : val, newEnd : val) -> val {
  *Region regionW = payload(region, 0);
  word newEndW = payload(newEnd, 0);
  word oldEndW = regionW->heapEnd;
  word heapStart = regionW->heapStart;
  word capLimW = (regionW->capEnd - heapStart) / 1048576;
  regionW->heapEnd = newEndW;
  if (mkbool(wload(rawcall rt_glob_addr(), 8) == 0)) {
    return mknil;
  }
  call Rt.gcNumOut(mknum(rawstr("midgc: grow ")), mknum((newEndW - heapStart) / 1048576), region);
  call Rt.gcNumOut(mknum(rawstr(" MB (was ")), mknum((oldEndW - heapStart) / 1048576), region);
  call Rt.gcNumOut(mknum(rawstr(" MB, ceiling ")), mknum(capLimW), region);
  rawcall write(2, rawstr(" MB)\n"), 5);
  return mknil;
}
defun Rt.gcAllocGo(region : val, cls : val) -> val {
  *Region regionW = payload(region, 0);
  word table = regionW->classTab;
  word clsW = payload(cls, 0);
  word n = regionW->numClass;
  if (mkbool(clsW >= n)) {
    return mknum(0);
  } else {
    // QBE_MIDGC_NOREUSE (GC ARC unit 1b): the sweep still LINKS every freed
    // block, but nothing ever pops one, so the heap only grows.  A stale
    // pointer then lands on a block whose word 0 is that link — an in-heap
    // address, not a value tag — which is the M1 discriminator: corruption
    // that reuse would hide behind a plausible live object becomes loud.
    // ONE-SIDED on purpose: this is the `thenDiv && not elseDiv` shape, which
    // the lowerer splices the continuation into the false path — i.e. it means
    // what it looks like under BOTH readings of a statement-position `return`
    // (plan §6.4's landmine needs both branches diverging to bite).
    if (mkbool(regionW->noreuse != 0)) {
      return mknum(0);
    }
    word head = wload(table, clsW);
    if (mkbool(head == 0)) {
      return mknum(0);
    } else {
      word kind = regionW->kind;
      word count = regionW->count;
      wstore(table, clsW, wload(head, 0));
      wstore(head, -2, kind * 2 + clsW * 4);
      wstore(head, -1, count);
      // the block start is permanent; only its STATE flips (GC ARC unit 2)
      bytestore(regionW->bmPtr + (head - regionW->heapStart) / 64, 0, 1);
      return mknum(head);
    }
  }
}
defun Rt.collect(dummy : val) -> val {
  word glob = rawcall rt_glob_addr();
  word regionW = wload(glob, 0);
  if (mkbool(regionW == 0)) {
    call Rt.die(rawstr("qbe-rt: midgc: collect before init (no region mapped)"));
    return mknil;
  } else {
    *Region region = regionW;
    if (mkbool(region->magic == 331941693251)) {
      rawcall clock_gettime(1, [word](region) + 104);
      region->markTop = 64;
      region->marked = 0;
      region->freedN = 0;
      // THE BUDGET RESET BELONGS TO THE COLLECT (GC ARC unit 1b): every caller
      // that collects must also start the trigger's window over, and a caller
      // reaching the collect through a CONDITIONAL VALUE (gcAlloc's trigger)
      // has no statement position to reset it in.
      region->allocated = 0;
      // >>> QBE_MIDGC_YOUNG-ONLY
      // THE NURSERY FIRST (GC NURSERY unit): every live young object is
      // promoted BEFORE the mark walk, so the walk sees only old-space
      // pointers (no old->young edge can survive a scavenge: the remembered
      // set walk relocated them all) and the sweep below walks the OLD
      // frontier alone.  Conditional value, the join-free spelling.
      word scav = payload((region->young != 0) ? call Rt.gcScavenge(mknum(0)) : mknil, 0);
      // <<< QBE_MIDGC_YOUNG-ONLY
      call Rt.gcMarkRoots(mknum(0));
      call Rt.gcMarkValuesTab(mknum(0));
      call Rt.gcDrain(mknum(0));
      rawcall clock_gettime(1, [word](region) + 120);
      call Rt.gcClearClasses(mknum(0));
      call Rt.gcSweep(mknum(region->heapStart));
      // THE POST-COLLECT VERIFIER (GC ARC unit 2, QBE_MIDGC_VERIFY=1): the
      // O(heap) invariant walk.  Conditional VALUE, the same join-free spelling
      // as the trigger above — the effect is in one arm, `mknil` in the other.
      word ver = payload((region->verify != 0) ? call Rt.gcVerify(mknum(region->heapStart), mknum(0)) : mknil, 0);
      rawcall clock_gettime(1, [word](region) + 136);
      region->collects = region->collects + 1;
      region->sweptBytes = region->cursor - region->heapStart;
      region->markUs = (region->ts1s * 1000000 + region->ts1n / 1000) - (region->ts0s * 1000000 + region->ts0n / 1000);
      region->sweepUs = (region->ts2s * 1000000 + region->ts2n / 1000) - (region->ts1s * 1000000 + region->ts1n / 1000);
      if (mkbool(wload(glob, 8) != 0)) {
        word regW = [word](region);
        word cN = region->collects;
        word mN = region->marked;
        word sN = region->sweptBytes;
        word mU = region->markUs;
        word sU = region->sweepUs;
        call Rt.gcNumOut(mknum(rawstr("midgc: c=")), mknum(cN), mknum(regW));
        call Rt.gcNumOut(mknum(rawstr(" mark=")), mknum(mN), mknum(regW));
        call Rt.gcNumOut(mknum(rawstr(" swept=")), mknum(sN), mknum(regW));
        call Rt.gcNumOut(mknum(rawstr(" markUs=")), mknum(mU), mknum(regW));
        call Rt.gcNumOut(mknum(rawstr(" sweepUs=")), mknum(sU), mknum(regW));
        rawcall write(2, rawstr("\n"), 1);
        return mknil;
      }
      return mknil;
    } else {
      call Rt.die(rawstr("qbe-rt: midgc: collect before init (region not initialised)"));
      return mknil;
    }
  }
}
// THE STATS PRINTER (GC-ARC F1) — the INSTRUMENT half of the collector, and
// the reason it is here rather than in the driver: Rt.main is emitted on BOTH
// routes, so a print there would move the default route's bytes and the corpus
// baseline with it.  These two defuns are seeded ONLY under QBE_MIDGC=1.
//
// FRAME-FREE, hence printable from inside a collect: digits are written into
// the region's own scratch with `bytestore` and emitted with the `write`
// RAW-CALL (alloc-free, no safepoint — the same class as Rt.die's message
// path).  NOTHING here allocates, so `swept`/`markUs` can be reported from
// inside the walk without re-entering the collector.
//
// Rt.gcNum: the decimal digits of n, RIGHT-ALIGNED so the last digit lands at
// endP-1; returns the address of the first digit.  Unsigned: every caller
// passes a count or a monotonic duration.
defun Rt.gcNum(n : val, endP : val) -> val {
  word v = payload(n, 0);
  word q = v / 10;
  word p = payload(endP, 0);
  bytestore(p - 1, 0, 48 + (v - q * 10));
  if (mkbool(q == 0)) {
    return mknum(p - 1);
  }
  recur(mknum(q), mknum(p - 1));
}
// Rt.gcNumOut: `label` (a NUL-terminated static) then n, both written to stderr.
defun Rt.gcNumOut(label : val, n : val, region : val) -> val {
  word end = payload(region, 0) + 320;
  val start = call Rt.gcNum(n, mknum(end));
  val llen = call Rt.cStrLenGo(mknum(payload(label, 0)), mknum(0));
  rawcall write(2, payload(label, 0), payload(llen, 0));
  rawcall write(2, payload(start, 0), end - payload(start, 0));
  return mknil;
}
// ==================== THE VEC-STORE SEAM (zighost Z2) ====================
// Lower has ONE RawVecStore arm and it names ONE of these two defuns: the
// YOUNG barrier when the build carries the nursery, the PLAIN store
// otherwise.  Before Z2 the writers were two Zig seats
// (tools/qbe/hostshim.zig rt_vec_store_young / rt_vec_store_plain); they are
// DELETED, so the seam has one spelling and the Mid heap has one writer.
// The retired escape route's third spelling (rt_vec_store -> the Zig
// collector's writeBarrierVectorStore) is dead code on this tree (run.js
// refuses QBE_MIDGC=0) and goes with the rest of hostshim at Z6.
//
// WHY THE STORE IS FIVE WORD STORES, not a struct copy: the DSL's `p[i] = e`
// on a `*val` IS RawVecStore — i.e. THIS seam — so using it here would be an
// infinite regress.  A Value is 40 bytes = 5 words (RtLayout.valSizeBytes),
// the vec index is a VALUE-unit index (Mid.Ir's RawVecStore contract), so the
// element address is `vec + i * 40` and the store is words 0..4 of it.
defun Rt.vecStorePlain(vec : word, i : word, val : word) -> word {
  word e = vec + i * 40;
  wstore(e, 0, wload(val, 0));
  wstore(e, 1, wload(val, 1));
  wstore(e, 2, wload(val, 2));
  wstore(e, 3, wload(val, 3));
  wstore(e, 4, wload(val, 4));
  return 0;
}
// >>> QBE_MIDGC_YOUNG-ONLY
// ==================== THE NURSERY (GC NURSERY unit) ====================
// QBE_MIDGC_YOUNG=1 BUILD-ONLY (run.js splices this whole region out unless
// the build flag is set; the knobs and slots in gcInit are shared text and
// inert without these defuns).  Every defun here is FRAME-FREE and every loop
// is SELF-recursion only (a `jmp @body`, the gcVerifyList lesson): gcScavPtr
// calls nothing recursive, and gcScavDrain/gcScavRoots/gcScavValueArray/
// gcScavRemembered/gcScavCopyWords tail-call themselves.
//
// THE HEADER BITS (see the Region table above): RS = bit 61, FORWARDED = bit
// 62, class readers mask with bits 0..60.  The surface's integer literals are
// exact only to 2^53, so the constants are PRODUCTS: RS = 2^30 * 2^31, FWD =
// 2^31 * 2^31, MASK = RS - 1.  Both bits sit above every legal class and are
// cleared by every fresh header write.
//
// Rt.vecStoreYoung: THE WRITE BARRIER'S RECORD HALF (zighost Z2) — the store
// (Rt.vecStorePlain's five words, inlined: no second spelling of the store
// lives here) and then, iff the VECTOR is an OLD LIVE VALUE-ARRAY of the Mid
// heap AND the stored Value REFERENCES the young space, one entry in the
// remembered set (slot 32/33/34) plus the block's RS bit.  The policy is the
// deleted Zig seat's, arm for arm (hostshim.zig rt_vec_store_young): a YOUNG
// vector is NOT recorded (young->young is the scavenge's own transitive
// closure) and a target outside the Mid heap (the C-heap rooted arrays, the
// frames) is not either — those are ROOTS, and the root walk already scans
// them.  NO NEW STATE: every slot this defun touches is collector state the
// Region already owns, which is what makes the port a word-op translation
// rather than a second design.
//
// THE MASK LANDMINE, SPELLED AROUND (the stage-A drain bug — the NURSERY PIN's
// register-class row): a word `&` with a constant >= 2^32 lowers to a w-CLASS
// (32-bit) op whose result TRUNCATES both operands, so `flags & 2^61` is
// IDENTICALLY ZERO and a "remembered" test written that way never fires.  So
// the RS test here is a DIVISION (flags / 2^61, exactly Rt.gcScavOne's
// spelling) and the tag read is a zero-EXTEND (uext), never an `&`.  The
// bit-WRITE is the matching ADDITION of the same product.
//
// SHAPE: a raw-word defun cannot join two word-returning branches (Lower's
// lowerTailWord), so an early `return` out of a guard is INEXPRESSIBLE here.
// Every decision is therefore either word arithmetic on the 0/1 that a bare
// comparison already IS (`a * b` = and, `a + b` = or, both exact on 0/1 —
// which is also why no `&&`/`||` appears: those are val,val operators and
// would BOX a Value per test), or a conditional-side-effect bind in the
// Rt.frame-leave shape (`word x = if (c) { work; return 0; } else { return 0; };`
// — the arm runs its effects, the bind's value is dead).  The nesting is the
// GUARD ORDER: the region, then the young-vector fast path, then the old-block
// test — so a young vector (the common case in a young build) pays no barrier
// work at all, and the two reads that could fault (the block map, the block
// header) sit inside the arms that have already proved the address is an
// in-range OLD block.
defun Rt.vecStoreYoung(vec : word, i : word, val : word) -> word {
  word e = vec + i * 40;
  wstore(e, 0, wload(val, 0));
  wstore(e, 1, wload(val, 1));
  wstore(e, 2, wload(val, 2));
  wstore(e, 3, wload(val, 3));
  wstore(e, 4, wload(val, 4));
  word regW = wload(rawcall rt_glob_addr(), 0);
  // THE REGION IS LAZY: rt_glob word 0 is 0 (the .bss zero) until the first
  // Mid allocation runs gcInit, and a vecstore can precede it (hostapply's
  // `run` arm stores into its malloc'd blob before its churn's first
  // allocraw).  The store above is already done, so a NULL region means
  // "nothing to remember yet" and is the plain-store case exactly.
  word mapped = if (regW != 0) {
    *Region region = regW;
    word ys = region->youngStart;
    word yc = region->youngCursor;
    // THE FAST PATH: the nursery off, or a YOUNG vector.  `young` is the
    // run-time knob (slot 28) — 0 in a QBE_MIDGC_YOUNG=0 BUILD's every run,
    // so the whole barrier is inert there even though the code is linked.
    word plain = if ((region->young == 0) + ((vec >= ys) * (vec < region->youngEnd)) != 0) {
      return 0;
    } else {
      word tag = uext(wload(val, 0));
      word p1 = wload(val, 1);
      // a lambda (6) and a record (14) hold a SECOND pointer payload word;
      // 1/4/9/10 (string, cons, error, vector) hold one.  p2 is multiplied
      // by the test so the other tags contribute a ZERO (never a stray
      // payload word that could land in the young range by accident).
      word isRec = (tag == 6) + (tag == 14);
      word p2 = (isRec != 0) * wload(val, 3);
      word ptrTag = (tag == 1) + (tag == 4) + (tag == 9) + (tag == 10) + isRec;
      word refs = ((p1 >= ys) * (p1 < yc)) + ((p2 >= ys) * (p2 < yc));
      word inOld = (vec >= region->heapStart) * (vec < region->cursor);
      word old = if (inOld != 0) {
        word st = byteload(region->bmPtr + (vec - region->heapStart) / 64, 0);
        word flags = wload(vec, -2);
        word kind1 = (flags >> 1) & 1;
        word rsClear = (flags / (1073741824 * 2147483648)) == 0;
        word go = ptrTag * refs * (st == 1) * kind1 * rsClear;
        word rec = if (go != 0) {
          wstore(vec, -2, flags + (1073741824 * 2147483648));
          word top = region->rsTop;
          word full = if (mkbool(top >= region->rsEnd)) {
            call Rt.die(rawstr("qbe-rt: midgc: remembered set overflow (capacity capBytes/64; raise the heap or report)"));
            return 0;
          } else {
            return 0;
          };
          wstore(region->rsBase, top, vec);
          region->rsTop = top + 1;
          return 0;
        } else {
          return 0;
        };
        return 0;
      } else {
        return 0;
      };
      return 0;
    };
    return 0;
  } else {
    return 0;
  };
  return 0;
}
//
// Rt.gcPromoteAlloc: allocate an OLD-space block for a promoted young object.
// Mirrors gcAlloc's old path WITHOUT its collect trigger (a scavenge must not
// re-enter the collector): free-list pop first (the fresh header clears RS and
// FORWARDED by construction), then the bump, then growth, then a loud die.
// Promoted bytes are charged to `allocated` — the full-collect trigger's
// window — because allocation volume is allocation volume wherever it lands.
defun Rt.gcPromoteAlloc(cls : val, kind : val, count : val) -> val {
  word glob = rawcall rt_glob_addr();
  *Region rw = wload(glob, 0);
  word clsW = payload(cls, 0);
  word kindW = payload(kind, 0);
  word countW = payload(count, 0);
  word phys = payload((clsW <= 512) ? mknum(clsW * 8) : mknum(4096 + (clsW - 512) * 4096), 0);
  word table = rw->classTab;
  word head = wload(table, clsW);
  if (mkbool(head != 0)) {
    wstore(table, clsW, wload(head, 0));
    wstore(head, -2, kindW * 2 + clsW * 4);
    wstore(head, -1, countW);
    bytestore(rw->bmPtr + (head - rw->heapStart) / 64, 0, 1);
    rw->allocated = rw->allocated + phys * 8;
    return mknum(head);
  }
  word cursor = rw->cursor;
  word heapStart = rw->heapStart;
  // BUMP FIRST (the stage-A bug was the absence of this arm): a promotion
  // that MISSES the free list must bump the cursor like gcAlloc's old path
  // does, and only GROW when the bump cannot fit.  Without this, EVERY
  // free-list miss ran the growth ladder unconditionally and doubled the
  // limit even with the cursor at offset 0 — the startup grow-to-the-ceiling
  // (reserve-only: heapEnd is a LIMIT inside the already-mapped region, so it
  // raised VAS, not RSS — the frontier stayed at the live set).
  if (mkbool(cursor + phys * 8 < rw->heapEnd)) {
    wstore(cursor, -2, kindW * 2 + clsW * 4);
    wstore(cursor, -1, countW);
    bytestore(rw->bmPtr + (cursor - rw->heapStart) / 64, 0, 1);
    rw->cursor = cursor + phys * 8;
    rw->allocated = rw->allocated + phys * 8;
    return mknum(cursor);
  }
  word needLim = (cursor + phys * 8) - heapStart;
  word lim = rw->heapEnd - heapStart;
  word dbl = lim * 2;
  word limUp = payload((dbl < needLim) ? mknum(needLim) : mknum(dbl), 0);
  word capLim = rw->capEnd - heapStart;
  word limCap = payload((limUp < capLim) ? mknum(limUp) : mknum(capLim), 0);
  word grew = payload(((heapStart + limCap) > rw->heapEnd) ? call Rt.gcGrow(mknum([word](rw)), mknum(heapStart + limCap)) : mknil, 0);
  if (mkbool(cursor + phys * 8 < rw->heapEnd)) {
    wstore(cursor, -2, kindW * 2 + clsW * 4);
    wstore(cursor, -1, countW);
    bytestore(rw->bmPtr + (cursor - rw->heapStart) / 64, 0, 1);
    rw->cursor = cursor + phys * 8;
    rw->allocated = rw->allocated + phys * 8;
    return mknum(cursor);
  }
  call Rt.gcNumOut(mknum(rawstr("qbe-rt: midgc: young promote out of memory: heap at its ceiling of ")), mknum(capLim / 1048576), mknum([word](rw)));
  call Rt.die(rawstr("qbe-rt: midgc: young promote out of memory"));
  return mknil;
}
// Rt.gcScavCopyWords: copy n WORDS from src to dst (whole blocks, headers
// included — the promote path's fresh header is overwritten with identical
// bits).  Self-recursion only.
defun Rt.gcScavCopyWords(src : val, dst : val, n : val) -> val {
  word nW = payload(n, 0);
  if (mkbool(nW == 0)) {
    return mknil;
  }
  wstore(payload(dst, 0), nW - 1, wload(payload(src, 0), nW - 1));
  return call Rt.gcScavCopyWords(mknum(payload(src, 0)), mknum(payload(dst, 0)), mknum(nW - 1));
}
// Rt.gcScavPtr: THE COPIER.  A pointer that is not in the live young range
// [youngStart, youngCursor) is returned unchanged (old space, the C heap,
// static data, null — the walk's non-young arms).  A forwarded young block
// returns its new address out of word -1.  Otherwise the block is copied into
// old space (promotion on FIRST survival — there is no second age, so no age
// byte and no survivor counter anywhere), the young original gets the
// FORWARDED bit + the forwarding address, its body word 0 is POISONED with
// tag 15 (a stale unrooted read dies in the tag dispatch), and the COPY is
// pushed onto the scan queue (the mark stack, reused — empty at scavenge
// time, and youngFit <= capBytes is the same bound the mark-stack guard
// asserts, so the queue cannot overflow).
defun Rt.gcScavPtr(p : val) -> val {
  word ptr = payload(p, 0);
  word glob = rawcall rt_glob_addr();
  *Region region = wload(glob, 0);
  if (mkbool(ptr < region->youngStart) || mkbool(ptr >= region->youngCursor)) {
    return mknum(ptr);
  }
  word flags = wload(ptr, -2);
  // THE FORWARDED TEST IS A COMPARE, NOT AN `&`: a word `&` in this surface
  // lowers to a w-CLASS and (32-bit), so `flags & 2^62` is ALWAYS ZERO -- the
  // stage-A bug: every already-forwarded body was re-copied, the re-copy
  // inherited the forwarded header (FWD | kind | class, word -1 = the first
  // copy's address), and the drain then read word -1 -- an ADDRESS -- as the
  // scan count and walked off the block into a POISONED body.  Bit 62 is set
  // iff flags >= 2^62; every legal class is < 2^21, so nothing else reaches
  // that high.  (The class reads below keep their `&`: classes live in bits
  // 2..21, the w-class truncation keeps bits 0..31, so the masked read is
  // EXACT for every class this heap can name -- stated, not luck.)
  if (mkbool(flags > ((2147483648 * 2147483648) - 1))) {
    return mknum(wload(ptr, -1));
  }
  word kind = (flags >> 1) & 1;
  word count = wload(ptr, -1);
  word cls = (flags >> 2) & ((1073741824 * 2147483648) - 1);
  word phys = payload((cls <= 512) ? mknum(cls * 8) : mknum(4096 + (cls - 512) * 4096), 0);
  val nb = call Rt.gcPromoteAlloc(mknum(cls), mknum(kind), mknum(count));
  word nw = payload(nb, 0);
  val cp = call Rt.gcScavCopyWords(mknum(ptr - 16), mknum(nw - 16), mknum(phys));
  wstore(ptr, -2, flags + (2147483648 * 2147483648));
  wstore(ptr, -1, nw);
  wstore(ptr, 0, 15);
  region->scavBytes = region->scavBytes + phys * 8;
  region->scavBodies = region->scavBodies + 1;
  word top = region->markTop;
  if (mkbool(top >= region->markEnd)) {
    call Rt.die(rawstr("qbe-rt: midgc: scavenge scan queue overflow"));
    return mknil;
  }
  wstore(region, top, nw);
  region->markTop = top + 1;
  return mknum(nw);
}
// Rt.gcScavValue: relocate ONE val cell IN PLACE — the cell itself never
// moves (it lives in a root slot, a rooted C-heap array, or a heap block's
// body); what moves is the heap block its pointer payloads name.  The tag
// table mirrors Rt.gcMarkValue exactly (1 string, 4 cons, 9 error, 10 vector:
// one pointer at word 1; 6 lambda, 14 record: words 1 and 3).  Tag 15 is the
// POISON a forwarded young body carries: reaching it here means the walk
// followed a stale reference, which is loud by design.
defun Rt.gcScavValue(vaddr : val) -> val {
  word c = payload(vaddr, 0);
  word tag = byteload(c, 0) + (byteload(c, 1) * 256 + (byteload(c, 2) * 65536 + byteload(c, 3) * 16777216));
  if (mkbool(tag == 1)) {
    wstore(c, 1, payload(call Rt.gcScavPtr(mknum(wload(c, 1))), 0));
    return mknil;
  }
  if (mkbool(tag == 4)) {
    wstore(c, 1, payload(call Rt.gcScavPtr(mknum(wload(c, 1))), 0));
    return mknil;
  }
  if (mkbool(tag == 9)) {
    wstore(c, 1, payload(call Rt.gcScavPtr(mknum(wload(c, 1))), 0));
    return mknil;
  }
  if (mkbool(tag == 10)) {
    wstore(c, 1, payload(call Rt.gcScavPtr(mknum(wload(c, 1))), 0));
    return mknil;
  }
  if (mkbool(tag == 6)) {
    wstore(c, 1, payload(call Rt.gcScavPtr(mknum(wload(c, 1))), 0));
    wstore(c, 3, payload(call Rt.gcScavPtr(mknum(wload(c, 3))), 0));
    return mknil;
  }
  if (mkbool(tag == 14)) {
    wstore(c, 1, payload(call Rt.gcScavPtr(mknum(wload(c, 1))), 0));
    wstore(c, 3, payload(call Rt.gcScavPtr(mknum(wload(c, 3))), 0));
    return mknil;
  }
  if (mkbool(tag == 15)) {
    call Rt.gcVD(mknum(rawstr("qbe-rt: midgc: scavenge read a POISONED (forwarded young) body at ")), mknum(c), mknum(wload(rawcall rt_glob_addr(), 0)));
    return mknil;
  }
  if (mkbool(tag == 13) || mkbool(tag > 14)) {
    call Rt.die(rawstr("qbe-rt: midgc: unknown value tag in scavenge walk"));
    return mknil;
  }
  return mknil;
}
// Rt.gcScavValueArray: relocate each val cell of an array — self-recursion
// only, one jmp per element (the gcScanValueArray shape).
defun Rt.gcScavValueArray(base : val, cnt : val) -> val {
  word baseW = payload(base, 0);
  word cntW = payload(cnt, 0);
  if (mkbool(cntW == 0)) {
    return mknil;
  }
  call Rt.gcScavValue(mknum(baseW));
  return call Rt.gcScavValueArray(mknum(baseW + 40), mknum(cntW - 1));
}
// Rt.gcScavRoots: THE ROOT WALK — exactly Rt.gcMarkRoots' root set, but a
// young pointer is COPIED and the slot that names it is UPDATED IN PLACE
// (that update is what makes movement visible to the language: the frame's
// val cells and the host's rooted arrays keep pointing at the live object).
// THE ROOT SET IS THE MID REGISTRY (ZIGHOST Z1): base/count from the globals
// block words 4/5, entries `{kind, slot, np}` at a 3-word stride.  Same walk,
// different source of the three words — the Zig shadow stack is GONE.
defun Rt.gcScavRoots(i : val) -> val {
  word iW = payload(i, 0);
  word glob = rawcall rt_glob_addr();
  word base = wload(glob, 4);
  word nRoots = wload(glob, 5);
  if (mkbool(iW >= nRoots)) {
    return mknil;
  }
  word kind = wload(base, iW * 3);
  word slot = wload(base, iW * 3 + 1);
  word np = wload(base, iW * 3 + 2);
  if (mkbool(kind == 0)) {
    wstore(slot, 0, payload(call Rt.gcScavPtr(mknum(wload(slot, 0))), 0));
    return call Rt.gcScavRoots(mknum(iW + 1));
  }
  if (mkbool(kind == 1)) {
    call Rt.gcScavValue(mknum(slot));
    return call Rt.gcScavRoots(mknum(iW + 1));
  }
  if (mkbool(kind == 3)) {
    call Rt.gcScavValue(mknum(slot));
    return call Rt.gcScavRoots(mknum(iW + 1));
  }
  if (mkbool(kind == 2)) {
    word count = byteload(np, 0) + (byteload(np, 1) * 256 + (byteload(np, 2) * 65536 + byteload(np, 3) * 16777216));
    call Rt.gcScavValueArray(mknum(slot), mknum(count));
    return call Rt.gcScavRoots(mknum(iW + 1));
  }
  call Rt.die(rawstr("qbe-rt: midgc: unknown root kind in scavenge"));
  return mknil;
}
// Rt.gcScavValuesTab: the values table's SCAVENGE twin — exactly
// Rt.gcMarkValuesTab's 48-byte bounded walk, relocating each live entry's
// Value IN PLACE (the entry lives on the C heap, so the slot never moves;
// what moves is the Mid-heap block its payloads name).
defun Rt.gcScavValuesTab(i : val) -> val {
  word iW = payload(i, 0);
  if (mkbool(iW >= 256)) {
    return mknil;
  }
  word tab = wload(rawcall rt_glob_addr(), 3);
  if (mkbool(tab == 0)) {
    return mknil;
  }
  word e = tab + iW * 48;
  if (mkbool(wload(e, 0) != 0)) {
    call Rt.gcScavValue(mknum(e + 8));
    return call Rt.gcScavValuesTab(mknum(iW + 1));
  }
  return call Rt.gcScavValuesTab(mknum(iW + 1));
}
// Rt.gcScavRemembered: walk the remembered set.  Each entry is an OLD BLOCK
// address the barrier recorded (an old value-array that received a store of a
// young-referencing value).  Validation before the scan, because the entry can
// be STALE: the block may since have died (block-map state 2 — drop the
// entry), or died and been RE-ISSUED (RS bit cleared by the fresh header —
// drop; a new barrier hit would have re-recorded it).  A live, bit-set entry
// must be a KIND-1 block: anything else is corruption, named.  Clearing the
// bit HERE is what keeps the set empty-able: rsTop resets to 0 in the
// scavenge epilogue and every remaining bit is clear.
// Rt.gcScavOne: ONE remembered entry — a helper because the entry's
// validation is a FALLING chain (drop stale entries) and Mid has no join:
// here every arm RETURNS, so the shapes are the legal diverging ones.
defun Rt.gcScavOne(blk : val) -> val {
  word glob = rawcall rt_glob_addr();
  *Region region = wload(glob, 0);
  word b = payload(blk, 0);
  if (mkbool(b < region->heapStart) || mkbool(b >= region->cursor)) {
    return mknil;
  }
  word state = byteload(region->bmPtr + (b - region->heapStart) / 64, 0);
  word flags = wload(b, -2);
  // RS test by DIVISION (an `&` here lowers w-class and truncates bit 61
  // away): flags / 2^61 == 1 iff RS is set and FWD is clear.
  if (mkbool(state == 1) && mkbool((flags / (1073741824 * 2147483648)) == 1)) {
    if (mkbool(((flags >> 1) & 1) != 1)) {
      call Rt.gcVD(mknum(rawstr("qbe-rt: midgc: a REMEMBERED block is not a value array at heap offset ")), mknum(b - region->heapStart), mknum([word](region)));
      return mknil;
    }
    wstore(b, -2, flags - (1073741824 * 2147483648));
    word count = wload(b, -1);
    call Rt.gcScavValueArray(mknum(b), mknum(count));
    return mknil;
  }
  return mknil;
}
defun Rt.gcScavRemembered(i : val) -> val {
  word iW = payload(i, 0);
  word glob = rawcall rt_glob_addr();
  *Region region = wload(glob, 0);
  if (mkbool(iW >= region->rsTop)) {
    return mknil;
  }
  val one = call Rt.gcScavOne(mknum(wload(region->rsBase, iW)));
  return call Rt.gcScavRemembered(mknum(iW + 1));
}
// Rt.gcScavDrain: the scan queue — pop a promoted copy, relocate the val
// cells INSIDE the copy (Cheney's breadth-first half: the copy's payload
// words are the to-scan set).  Self-recursion only.
defun Rt.gcScavDrain(dummy : val) -> val {
  word glob = rawcall rt_glob_addr();
  *Region region = wload(glob, 0);
  word top = region->markTop;
  if (mkbool(top <= 64)) {
    return mknil;
  }
  word newTop = top - 1;
  word p = wload(region, newTop);
  region->markTop = newTop;
  word flags = wload(p, -2);
  word kind = (flags >> 1) & 1;
  word count = wload(p, -1);
  word scanCount = payload((kind == 1) ? mknum(count) : mknum(0), 0);
  call Rt.gcScavValueArray(mknum(p), mknum(scanCount));
  return call Rt.gcScavDrain(mknum(0));
}
// Rt.gcScavenge: THE SCAVENGE.  Roots first (copy + update the root slots),
// then the remembered set (old blocks that received young-referencing stores
// since the last scavenge — the write barrier's other half), then the drain
// (the transitive closure inside the copies).  Epilogue: the young space is
// EMPTY again (one store — no sweep, no walk of anything dead), the
// remembered set is empty, and the stats line prints under QBE_MIDGC_STATS
// with the SAME knob and printer as the collect line.
defun Rt.gcScavenge(dummy : val) -> val {
  word glob = rawcall rt_glob_addr();
  *Region region = wload(glob, 0);
  rawcall clock_gettime(1, [word](region) + 104);
  region->markTop = 64;
  region->scavBytes = 0;
  region->scavBodies = 0;
  word rsHad = region->rsTop;
  call Rt.gcScavRoots(mknum(0));
  call Rt.gcScavValuesTab(mknum(0));
  call Rt.gcScavRemembered(mknum(0));
  call Rt.gcScavDrain(mknum(0));
  region->youngCursor = region->youngStart;
  region->rsTop = 0;
  region->scavenges = region->scavenges + 1;
  rawcall clock_gettime(1, [word](region) + 120);
  region->markUs = (region->ts1s * 1000000 + region->ts1n / 1000) - (region->ts0s * 1000000 + region->ts0n / 1000);
  if (mkbool(wload(glob, 8) != 0)) {
    word regW = [word](region);
    call Rt.gcNumOut(mknum(rawstr("midgc: scavenge s=")), mknum(region->scavenges), mknum(regW));
    call Rt.gcNumOut(mknum(rawstr(" copied=")), mknum(region->scavBytes), mknum(regW));
    call Rt.gcNumOut(mknum(rawstr(" bodies=")), mknum(region->scavBodies), mknum(regW));
    call Rt.gcNumOut(mknum(rawstr(" rs=")), mknum(rsHad), mknum(regW));
    call Rt.gcNumOut(mknum(rawstr(" us=")), mknum(region->markUs), mknum(regW));
    rawcall write(2, rawstr("\n"), 1);
    return mknil;
  }
  return mknil;
}
// <<< QBE_MIDGC_YOUNG-ONLY
defun Rt.gcMarkRoots(i : val) -> val {
  word iW = payload(i, 0);
  word glob = rawcall rt_glob_addr();
  word base = wload(glob, 4);
  word nRoots = wload(glob, 5);
  if (mkbool(iW >= nRoots)) {
    return mknil;
  }
  word kind = wload(base, iW * 3);
  word slot = wload(base, iW * 3 + 1);
  word np = wload(base, iW * 3 + 2);
  // A CHAIN OF ONE-SIDED DISPATCHES (GC ARC unit 1b).  This used to be a
  // nested `if/else` whose every arm `return`ed the mark call, with the
  // recursion to the NEXT root after the whole nest — i.e. it worked only
  // because the nest was a DEAD BIND: the chosen arm's call was evaluated for
  // its effect and its value discarded, and the walk continued.  Under the
  // obvious reading of `return` the walk would stop after the FIRST root
  // (MEASURED under the flip: `midgc: c=1 mark=0`).  Each arm now marks its
  // root and TAIL-CALLS the next one, so nothing depends on a dead bind, and
  // the die below is reached only when no kind matched.
  if (mkbool(kind == 0)) {
    call Rt.gcMarkPtr(mknum(wload(slot, 0)));
    return call Rt.gcMarkRoots(mknum(iW + 1));
  }
  if (mkbool(kind == 1)) {
    call Rt.gcMarkValue(mknum(slot));
    return call Rt.gcMarkRoots(mknum(iW + 1));
  }
  if (mkbool(kind == 3)) {
    call Rt.gcMarkValue(mknum(slot));
    return call Rt.gcMarkRoots(mknum(iW + 1));
  }
  if (mkbool(kind == 2)) {
    word count = byteload(np, 0) + (byteload(np, 1) * 256 + (byteload(np, 2) * 65536 + byteload(np, 3) * 16777216));
    call Rt.gcScanValueArray(mknum(slot), mknum(count));
    return call Rt.gcMarkRoots(mknum(iW + 1));
  }
  call Rt.die(rawstr("qbe-rt: midgc: unknown root kind"));
  return mknil;
}
// Rt.gcMarkValuesTab: THE VALUES-TABLE ROOT WALK (ZIGHOST Z1's found hole).
// The values table (globals word 3) holds `*argv*` — a Mid-heap cons chain
// built by Rt.argvInstall — plus the three host stream Values.  It was
// registered with the ZIG collector only (`registerValuesTable`, a no-op on
// this route since Z0), so before this walker NO Mid collect marked it: the
// argv chain was reclaimed by any full collect that ran between boot and its
// read, and argvrepro passed by PROMOTION AND TIMING (the scavenges inside the
// build), not by being rooted.
//
// THE STRIDE IS 48 BYTES, NOT 40: an entry is `{char *name; Value value}`
// (types.zig:303) — the name word then the 40-byte Value at +8 — so
// `Rt.gcScanValueArray`'s 40-byte walk cannot express it.  An entry is LIVE
// iff its name word is nonzero (the table is zeroed at Vm.init and the first
// free entry is the first zero name — Rt.valFreeGo's own test), and the table
// is a FIXED 256 entries (tables.zig:32), so the walk is bounded, not
// cursor-driven.
//
// It reads the base out of glob word 3, so it works under BOTH the Vm-owned
// storage (today) and the Mid-owned one (Z5).
defun Rt.gcMarkValuesTab(i : val) -> val {
  word iW = payload(i, 0);
  if (mkbool(iW >= 256)) {
    return mknil;
  }
  word tab = wload(rawcall rt_glob_addr(), 3);
  if (mkbool(tab == 0)) {
    return mknil;
  }
  word e = tab + iW * 48;
  if (mkbool(wload(e, 0) != 0)) {
    call Rt.gcMarkValue(mknum(e + 8));
    return call Rt.gcMarkValuesTab(mknum(iW + 1));
  }
  return call Rt.gcMarkValuesTab(mknum(iW + 1));
}
defun Rt.gcScanValueArray(base : val, cnt : val) -> val {
  word baseW = payload(base, 0);
  word cntW = payload(cnt, 0);
  if (mkbool(cntW == 0)) {
    return mknil;
  } else {
    call Rt.gcMarkValue(mknum(baseW));
    return call Rt.gcScanValueArray(mknum(baseW + 40), mknum(cntW - 1));
  }
}
defun Rt.gcDrain(dummy : val) -> val {
  word glob = rawcall rt_glob_addr();
  *Region region = wload(glob, 0);
  word top = region->markTop;
  // THE GUARD IS ONE-SIDED AND INVERTED (GC ARC unit 1b): the empty-stack case
  // EXITS and the work below stays at the defun's TOP LEVEL.  Two reasons, and
  // both are measured: (a) the old `if (top > 64) { ..work..; return ..; } else
  // { return mknil; }` form is the landmine shape — it worked only because a
  // both-diverging statement `if` is a dead bind; (b) a `while` nested inside a
  // then-branch emits its head LABEL TWICE in this tree, so qbe refuses the
  // whole function (`multiple definitions of block @loop_N`) — a pre-existing
  // emitter bug, reported by GC ARC unit 1b and NOT fixed here.
  if (mkbool(top <= 64)) {
    return mknil;
  }
  word newTop = top - 1;
  word p = wload(region, newTop);
  word flags = wload(p, -2);
  word kind = (flags >> 1) & 1;
  word count = wload(p, -1);
  region->markTop = newTop;
  // The conditional effect from gcAlloc's trigger, same spelling (GC ARC unit
  // 1b): the SCAN COUNT is the conditional value (0 for a raw body, whose
  // words are not values), and `gcScanValueArray` is a no-op at count 0 — so
  // the call needs no branch and the drain below runs on both paths.
  word scanCount = payload((kind == 1) ? mknum(count) : mknum(0), 0);
  call Rt.gcScanValueArray(mknum(p), mknum(scanCount));
  return call Rt.gcDrain(mknum(0));
}
defun Rt.gcSweep(cursor : val) -> val {
  word cursorW = payload(cursor, 0);
  word glob = rawcall rt_glob_addr();
  *Region region = wload(glob, 0);
  word table = region->classTab;
  word heapCursor = region->cursor;
  if (mkbool(cursorW >= heapCursor)) {
    return mknil;
  } else {
    word flags = wload(cursorW, -2);
    word marked = flags & 1;
    // THE CLASS IS MASKED (GC NURSERY unit): a LIVE block may carry the RS
    // bit (61) — it was remembered between scavenges — and FORWARDED (62)
    // never appears here (young blocks are outside the swept range), so
    // without the mask a remembered block's `flags >> 2` is astronomically
    // past its class and the sweep's advance walks into garbage.
    word cls = (flags >> 2) & ((1073741824 * 2147483648) - 1);
    word phys = payload((cls <= 512) ? mknum(cls * 8) : mknum(4096 + (cls - 512) * 4096), 0);
    if (mkbool(marked == 1)) {
      wstore(cursorW, -2, flags - 1);
      return call Rt.gcSweep(mknum(cursorW + phys * 8));
    } else {
      // A FREED block leaves the remembered set (GC NURSERY unit): clear the
      // RS bit so a stale set entry is dropped by the scavenge's state test
      // even before the block is re-issued, and the class the free list files
      // it under is the masked (true) class.  SUBTRACT, never `&`: the and
      // lowers w-class, and storel of a w temp's register stores an
      // unspecified high half.
      wstore(cursorW, -2, flags - (flags / (1073741824 * 2147483648)) * (1073741824 * 2147483648));
      wstore(cursorW, 0, wload(table, cls));
      wstore(table, cls, cursorW);
      // FREE it in the block map and COUNT it (GC ARC unit 2): the marker reads
      // the state, so a stale pointer to this block is refused by name instead
      // of being marked (which would push the free-list LINK as if it were a
      // value and write a flags word into whatever block the garbage tag led to).
      bytestore(region->bmPtr + (cursorW - region->heapStart) / 64, 0, 2);
      region->freedN = region->freedN + 1;
      return call Rt.gcSweep(mknum(cursorW + phys * 8));
    }
  }
}
defun Rt.gcClearClasses(i : val) -> val {
  word glob = rawcall rt_glob_addr();
  *Region region = wload(glob, 0);
  word table = region->classTab;
  word n = region->numClass;
  word iW = payload(i, 0);
  if (mkbool(iW >= n)) {
    return mknil;
  } else {
    wstore(table, iW, 0);
    return call Rt.gcClearClasses(mknum(iW + 1));
  }
}
defun Rt.gcMarkPtr(p : val) -> val {
  word ptr = payload(p, 0);
  word glob = rawcall rt_glob_addr();
  *Region region = wload(glob, 0);
  word heapStart = region->heapStart;
  word heapEnd = region->heapEnd;
  word regW = [word](region);
  // THE NURSERY'S MISSING-ROOT DETECTOR (GC NURSERY unit, shared text — the
  // range [youngStart, youngCursor) is EMPTY unless the young space is
  // active, so this costs two compares and never fires otherwise): a pointer
  // into the YOUNG space reaching the MARK walk is a root the scavenge did
  // not walk.  That is exactly wall B's shape (a live value the collector
  // cannot see), and under the nursery it is LOUD AT THE COLLECT instead of
  // plausible-silent: die, never skip.
  if (mkbool(ptr >= region->youngStart) && mkbool(ptr < region->youngCursor)) {
    call Rt.gcVD(mknum(rawstr("qbe-rt: midgc: VERIFY: mark of a YOUNG pointer (a root the scavenge missed) at heap offset ")), mknum(ptr - heapStart), mknum(regW));
    return mknil;
  }
  if (mkbool(ptr != 0) && (mkbool(ptr >= heapStart) && mkbool(ptr < heapEnd))) {
    // ---- THE BLOCK-START INVARIANT (GC ARC unit 2, EVERY build) ----------
    // A heap pointer handed to the marker is either the beginning of a block
    // or a bug.  `wload(p, -2)` is only a HEADER at a block start: at an
    // interior address it is another object's body word, and writing the mark
    // bit there corrupts that object — the M2 mechanism gc-plan §4.3 names
    // ("the block can end up simultaneously on a free list and marked").  The
    // map (slot 25) decides it in O(1), and the answer is DIE, not "skip":
    // skipping would leak a live object and re-hide a use-after-free.  The
    // named offsets are the whole diagnosis: the collect number says WHEN, the
    // heap offset says WHERE, and the state says WHAT (0 = interior, 2 = fired).
    word off = ptr - heapStart;
    word idx = off / 64;
    word state = byteload(region->bmPtr + idx, 0);
    word stateW = payload((state == 0) ? mknum(0) : mknum(state), 0);
    // The map is COARSE (one byte per 64-byte minimum block), so a start is
    // `state != 0` AND an offset that is a whole number of map slots: every
    // block size is a multiple of 64 bytes (class 1 = 8 words, and the >512
    // ladder is 4096-word granular), so a real start always satisfies BOTH.
    // Without the second test an INTERIOR pointer that stays inside the first
    // 64-byte slot of a block would read its block's own entry and pass.
    if (mkbool(stateW == 0) || mkbool(idx * 64 != off)) {
      call Rt.gcVD(mknum(rawstr("qbe-rt: midgc: VERIFY: mark of a NON-BLOCK-START pointer at heap offset ")), mknum(ptr - heapStart), mknum(regW));
      return mknil;
    }
    // A pointer to a FREED block is a STALE pointer: the program holds a
    // handle the collector already reclaimed.  Marking it would resurrect a
    // block whose word 0 is the free-list LINK — the marker would then read a
    // junk tag out of that link and mark a pointer that is nowhere near an
    // object.  This is the invariant that makes a use-after-free LOUD at the
    // moment of the collect instead of plausible-silent (and, in the compiler's
    // own selfhost run, 40 minutes later at a random instruction).
    if (mkbool(stateW == 2)) {
      call Rt.gcVD(mknum(rawstr("qbe-rt: midgc: VERIFY: mark of a pointer to a FREED block at heap offset ")), mknum(ptr - heapStart), mknum(regW));
      return mknil;
    }
    word flags = wload(ptr, -2);
    word marked = flags & 1;
    word top = region->markTop;
    word markEnd = region->markEnd;
    if (mkbool(marked == 0)) {
      if (mkbool(top < markEnd)) {
        wstore(ptr, -2, flags + 1);
        wstore(region, top, ptr);
        region->markTop = top + 1;
        region->marked = region->marked + 1;
        return mknil;
      } else {
        call Rt.die(rawstr("qbe-rt: midgc: mark stack overflow"));
        return mknil;
      }
    } else {
      return mknil;
    }
  } else {
    return mknil;
  }
}
defun Rt.gcMarkValue(vaddr : val) -> val {
  word tag = byteload(payload(vaddr, 0), 0) + (byteload(payload(vaddr, 0), 1) * 256 + (byteload(payload(vaddr, 0), 2) * 65536 + byteload(payload(vaddr, 0), 3) * 16777216));
  word vaddrW = payload(vaddr, 0);
  if (mkbool(tag == 1)) {
    return call Rt.gcMarkPtr(mknum(wload(vaddrW, 1)));
  } else {
    if (mkbool(tag == 4)) {
      return call Rt.gcMarkPtr(mknum(wload(vaddrW, 1)));
    } else {
      if (mkbool(tag == 6)) {
        call Rt.gcMarkPtr(mknum(wload(vaddrW, 1)));
        return call Rt.gcMarkPtr(mknum(wload(vaddrW, 3)));
      } else {
        if (mkbool(tag == 9)) {
          return call Rt.gcMarkPtr(mknum(wload(vaddrW, 1)));
        } else {
          if (mkbool(tag == 10)) {
            return call Rt.gcMarkPtr(mknum(wload(vaddrW, 1)));
          } else {
            if (mkbool(tag == 14)) {
              call Rt.gcMarkPtr(mknum(wload(vaddrW, 1)));
              return call Rt.gcMarkPtr(mknum(wload(vaddrW, 3)));
            } else {
              if (mkbool(tag == 13)) {
                call Rt.die(rawstr("qbe-rt: midgc: unknown value tag in mark walk"));
                return mknil;
              } else {
                if (mkbool(tag > 14)) {
                  call Rt.die(rawstr("qbe-rt: midgc: unknown value tag in mark walk"));
                  return mknil;
                } else {
                  return mknil;
                }
              }
            }
          }
        }
      }
    }
  }
}
// ==================== THE VERIFIER (GC ARC unit 2) ====================
// QBE_MIDGC_VERIFY=1 turns these on: after EVERY sweep, walk the swept range
// and every free list and assert the invariants the collector's correctness
// rests on.  This is the STRUCTURAL instrument; the two per-pointer invariants
// in Rt.gcMarkPtr fire in every build (they are two map reads), while this walk
// is O(heap) and therefore a knob.
//
// The invariants, and the failure each one NAMES:
//   V1  every block in [heapStart, cursor) has a block-map ENTRY (1 or 2) —
//       the sweeper's advance and the allocator's record of block starts agree.
//       A block with no entry means the sweep is standing at an address the
//       allocator never handed out: the class in the flags word has been
//       corrupted (a body write into a header), or the advance has drifted.
//   V2  the walk LANDS EXACTLY ON THE CURSOR — the block partition tiles the
//       swept range with no gap and no overlap.
//   V3  no block in the swept range is still MARKED — the sweep cleared every
//       bit it set, so the next collect starts from a clean state.
//   V4  marked + freedN == the number of blocks — EVERY block is either live or
//       exactly once on a free list.  A block counted twice (a double push, a
//       duplicate list insert) or a block counted zero times fails here.
//   V5  every free-list link is a block start, is in the state FREE, and sits
//       on the list for ITS OWN class — a list cannot be walked into a live
//       body, and a block cannot migrate between classes.
//   V6  the lists hold exactly freedN blocks, each walked with that total as a
//       BOUND — a cycle in a free list terminates as a named failure, not a
//       hang.
// Costs one extra pass over the frontier and over the freed blocks per collect.
defun Rt.gcVD(what : val, where : val, region : val) -> val {
  call Rt.gcNumOut(what, where, region);
  call Rt.gcNumOut(mknum(rawstr(" (collect ")), mknum(wload(payload(region, 0), 19)), region);
  rawcall write(2, rawstr(")\n"), 2);
  call Rt.die(rawstr("qbe-rt: midgc: VERIFY FAILED"));
  return mknil;
}
defun Rt.gcVerify(p : val, n : val) -> val {
  word pw = payload(p, 0);
  word nW = payload(n, 0);
  word glob = rawcall rt_glob_addr();
  word regW = wload(glob, 0);
  *Region region = regW;
  word heapStart = region->heapStart;
  word bm = region->bmPtr;
  word cursor = region->cursor;
  if (mkbool(pw >= cursor)) {
    // V2: the walk must land exactly on the cursor, never past it.
    if (mkbool(pw != cursor)) {
      call Rt.gcVD(mknum(rawstr("qbe-rt: midgc: VERIFY V2: the block walk ended at heap offset ")), mknum(pw - heapStart), mknum(regW));
      return mknil;
    }
    // V4: exactly-once accounting.
    word tot = region->marked + region->freedN;
    if (mkbool(tot != nW)) {
      call Rt.gcVD(mknum(rawstr("qbe-rt: midgc: VERIFY V4: marked + freed != blocks; marked+freed = ")), mknum(tot), mknum(regW));
      return mknil;
    }
    return call Rt.gcVerifyList(mknum(wload(region->classTab, 0)), mknum(0), mknum(0));
  }
  word flags = wload(pw, -2);
  // masked (GC NURSERY unit): a live remembered block carries the RS bit and
  // the unmasked shift would fail the class checks below spuriously.
  word cls = (flags >> 2) & ((1073741824 * 2147483648) - 1);
  word phys = payload((cls <= 512) ? mknum(cls * 8) : mknum(4096 + (cls - 512) * 4096), 0);
  word state = byteload(bm + (pw - heapStart) / 64, 0);
  // V1: the allocator's record of block starts must contain this address.
  if (mkbool(state == 0)) {
    call Rt.gcVD(mknum(rawstr("qbe-rt: midgc: VERIFY V1: the sweep stands on a NON-BLOCK-START at heap offset ")), mknum(pw - heapStart), mknum(regW));
    return mknil;
  }
  // V3: the sweep clears every mark bit it set.
  if (mkbool((flags & 1) != 0)) {
    call Rt.gcVD(mknum(rawstr("qbe-rt: midgc: VERIFY V3: a MARK BIT SURVIVED the sweep at heap offset ")), mknum(pw - heapStart), mknum(regW));
    return mknil;
  }
  // the class must be usable: a corrupted class makes `phys` advance wrong
  if (mkbool(cls == 0)) {
    call Rt.gcVD(mknum(rawstr("qbe-rt: midgc: VERIFY V1: block CLASS 0 (flags word corrupted) at heap offset ")), mknum(pw - heapStart), mknum(regW));
    return mknil;
  }
  if (mkbool(cls >= region->numClass)) {
    call Rt.gcVD(mknum(rawstr("qbe-rt: midgc: VERIFY V1: block CLASS OUT OF RANGE at heap offset ")), mknum(pw - heapStart), mknum(regW));
    return mknil;
  }
  return call Rt.gcVerify(mknum(pw + phys * 8), mknum(nW + 1));
}
// Rt.gcVerifyList: THE FREE-LIST WALK, one defun and one class at a time.
// `node` 0 means "this list ended, step to the next class"; `acc` is the
// running total.  SELF-RECURSION ONLY, and that is load-bearing: the lowerer
// turns `return call Rt.<self>(..)` into a `jmp @body` (MEASURED in the
// emitted .ssa — that is how Rt.gcSweep walks millions of blocks on one
// frame), so the class loop and the list walk cost ONE frame.  The first
// version of this split the two into MUTUALLY recursive defuns
// (gcVerifyLists/gcVerifyList) and SEGFAULTED on a 4 GB ceiling, where
// numClass is ~131 000: mutual recursion cannot be a jump, so the chain ran
// the C stack out.  report: probe-midgc-verify.sh arm 4 at QBE_MIDGC_MAXMB=4096.
defun Rt.gcVerifyList(node : val, cls : val, acc : val) -> val {
  word nd = payload(node, 0);
  word clsW = payload(cls, 0);
  word accW = payload(acc, 0);
  word glob = rawcall rt_glob_addr();
  word regW = wload(glob, 0);
  *Region region = regW;
  if (mkbool(nd == 0)) {
    word next = clsW + 1;
    if (mkbool(next >= region->numClass)) {
      // V6: the lists hold every freed block and nothing else.
      if (mkbool(accW != region->freedN)) {
        call Rt.gcVD(mknum(rawstr("qbe-rt: midgc: VERIFY V6: the free lists hold a different number of blocks than the sweep freed: ")), mknum(accW), mknum(regW));
        return mknil;
      }
      return mknil;
    }
    return call Rt.gcVerifyList(mknum(wload(region->classTab, next)), mknum(next), mknum(accW));
  }
  // V6: BOUND the walk — a cycle terminates as a named failure, not a hang.
  if (mkbool(accW >= region->freedN)) {
    call Rt.gcVD(mknum(rawstr("qbe-rt: midgc: VERIFY V6: a free list is LONGER than the freed count (cycle, or a block on two lists) at class ")), mknum(clsW), mknum(regW));
    return mknil;
  }
  // V5-range: a link outside [heapStart, cursor) is a corrupted link — name
  // it before the byteload/wload below can read out of bounds (a bare
  // SIGSEGV or a lucky false pass instead of the named V5 failure).
  if (mkbool(nd < region->heapStart) || mkbool(nd >= region->cursor)) {
    call Rt.gcVD(mknum(rawstr("qbe-rt: midgc: VERIFY V5: a free-list link is OUT OF RANGE (not a heap block) at heap offset ")), mknum(nd - region->heapStart), mknum(regW));
    return mknil;
  }
  // V5: every link is a block start, in the FREE state, on its OWN class.
  word state = byteload(region->bmPtr + (nd - region->heapStart) / 64, 0);
  if (mkbool(state != 2)) {
    call Rt.gcVD(mknum(rawstr("qbe-rt: midgc: VERIFY V5: a free-list link is NOT a freed block start (state) at heap offset ")), mknum(nd - region->heapStart), mknum(regW));
    return mknil;
  }
  word flags = wload(nd, -2);
  if (mkbool(((flags >> 2) & ((1073741824 * 2147483648) - 1)) != clsW)) {
    call Rt.gcVD(mknum(rawstr("qbe-rt: midgc: VERIFY V5: a free-list link is on the WRONG CLASS list at heap offset ")), mknum(nd - region->heapStart), mknum(regW));
    return mknil;
  }
  return call Rt.gcVerifyList(mknum(wload(nd, 0)), mknum(clsW), mknum(accW + 1));
}

defun Rt.+(a : val, bb : val) -> val {
  if (mkbool(tagis(a, 12)) || mkbool(tagis(bb, 12))) {
    return mkflt(fload(call Rt.asF(a)) f+ fload(call Rt.asF(bb)));
  } else {
    return mknum(payload(a, 0) + payload(bb, 0));
  }
}
defun Rt.-(a : val, bb : val) -> val {
  if (mkbool(tagis(a, 12)) || mkbool(tagis(bb, 12))) {
    return mkflt(fload(call Rt.asF(a)) f- fload(call Rt.asF(bb)));
  } else {
    return mknum(payload(a, 0) - payload(bb, 0));
  }
}
defun Rt.*(a : val, bb : val) -> val {
  if (mkbool(tagis(a, 12)) || mkbool(tagis(bb, 12))) {
    return mkflt(fload(call Rt.asF(a)) f* fload(call Rt.asF(bb)));
  } else {
    return mknum(payload(a, 0) * payload(bb, 0));
  }
}
// L3-U2 — THE TWO DIVISION CORNERS HALT BY NAME.
//
// `//` is an i64 divide, so `Rt./` is QBE's `div`, which is the hardware idiv:
// its two defined traps are a zero divisor and the one quotient that is not
// representable (INT64_MIN / -1 = 2^63).  Before this pre-check both were a
// BARE SIGFPE — exit 136, no diagnostic, nothing to assert on — which is an
// accident of the lowering, not a language decision.
//
// The decision (design §1/§2): both halt through `Rt.die`, the runtime's
// existing named-error channel (write to fd 2, exit 1).  The check costs one
// compare per divide; it is NOT gated behind a knob because a silent crash is
// exactly the class this design removes.
//
// THE INT64_MIN COMPARAND is spelled as a product because this file is parsed
// by our own frontend, whose literal range is being widened in the same unit:
// `0 - (2^30 * 2^30 * 8)` is INT64_MIN bit-for-bit (2^63 wraps to INT64_MIN,
// and `0 - INT64_MIN` is INT64_MIN again, so the value is independent of which
// side of the wrap the product lands on).
defun Rt./(a : val, bb : val) -> val {
  word n = payload(a, 0);
  word d = payload(bb, 0);
  if (mkbool(d == 0)) {
    call Rt.die(rawstr("qbe-rt: division by zero: `// 0` has no i64 value"));
    return mknil;
  } else {
    if (mkbool(d == (0 - 1)) && mkbool(n == (0 - ((1073741824 * 1073741824) * 8)))) {
      call Rt.die(rawstr("qbe-rt: division overflow: `INT64_MIN // -1` is 2^63, which is not an i64"));
      return mknil;
    } else {
      return mknum(n / d);
    }
  }
}
// L1 — THE `^` OPERATOR (`b ^ e`, Int -> Int -> Int).
//
// EXPONENTIATION BY SQUARING, as a runtime prim rather than an inline lowering
// or a desugaring: the surface has no loop form to desugar into, and a
// self-tail `recur` loop is where loops live here. One square and at most one
// multiply per exponent bit, so `e` costs O(log e) — 63 steps at worst.
//
// SEMANTICS, the same decisions L3 makes for `*` (design §1/§9):
//   * `e >= 0`  -> the exact product with i64 two's-complement WRAP, which is
//                  what `*` already does (2^64 answers 0);
//   * `0 ^ 0`   -> 1 (the loop's accumulator start, the standard convention);
//   * `e < 0`   -> a NAMED HALT, never a quiet 0: an integer power with a
//                  negative exponent has no i64 value, and a wrong-quiet answer
//                  is the class this whole unit exists to remove.
//
// The exponent is read as a WORD (`payload`) because it is an Int, and shifted
// LOGICALLY (`>>>`): the sign was rejected above, so the shift only ever sees
// non-negative bits.
defun Rt.powGo(b : val, e : val, acc : val) -> val {
  word n = payload(e, 0);
  if (mkbool(n == 0)) {
    return acc;
  } else {
    if (mkbool((n & 1) == 1)) {
      recur(mknum(payload(b, 0) * payload(b, 0)), mknum(n >>> 1), mknum(payload(acc, 0) * payload(b, 0)));
    } else {
      recur(mknum(payload(b, 0) * payload(b, 0)), mknum(n >>> 1), acc);
    }
  }
}
defun Rt.pow(b : val, e : val) -> val {
  word n = payload(e, 0);
  if (mkbool(n < 0)) {
    call Rt.die(rawstr("qbe-rt: negative exponent: `^` requires an exponent >= 0"));
    return mknil;
  }
  return call Rt.powGo(b, e, mknum(1));
}
defun Rt.f/(a : val, bb : val) -> val {
  return mkflt(fload(call Rt.asF(a)) f/ fload(call Rt.asF(bb)));
}
defun Rt.<(a : val, bb : val) -> val {
  if ((mkbool(tagis(a, 0)) || mkbool(tagis(a, 12))) && (mkbool(tagis(bb, 0)) || mkbool(tagis(bb, 12)))) {
    if (mkbool(tagis(a, 12)) || mkbool(tagis(bb, 12))) {
      return mkbool(fload(call Rt.asF(a)) f< fload(call Rt.asF(bb)));
    } else {
      return mkbool(payload(a, 0) < payload(bb, 0));
    }
  } else {
    return false;
  }
}
defun Rt.<=(a : val, bb : val) -> val {
  if ((mkbool(tagis(a, 0)) || mkbool(tagis(a, 12))) && (mkbool(tagis(bb, 0)) || mkbool(tagis(bb, 12)))) {
    if (mkbool(tagis(a, 12)) || mkbool(tagis(bb, 12))) {
      return mkbool(fload(call Rt.asF(a)) f<= fload(call Rt.asF(bb)));
    } else {
      return mkbool(payload(a, 0) <= payload(bb, 0));
    }
  } else {
    return false;
  }
}
defun Rt.>(a : val, bb : val) -> val {
  if ((mkbool(tagis(a, 0)) || mkbool(tagis(a, 12))) && (mkbool(tagis(bb, 0)) || mkbool(tagis(bb, 12)))) {
    if (mkbool(tagis(a, 12)) || mkbool(tagis(bb, 12))) {
      return mkbool(fload(call Rt.asF(a)) f> fload(call Rt.asF(bb)));
    } else {
      return mkbool(payload(a, 0) > payload(bb, 0));
    }
  } else {
    return false;
  }
}
defun Rt.>=(a : val, bb : val) -> val {
  if ((mkbool(tagis(a, 0)) || mkbool(tagis(a, 12))) && (mkbool(tagis(bb, 0)) || mkbool(tagis(bb, 12)))) {
    if (mkbool(tagis(a, 12)) || mkbool(tagis(bb, 12))) {
      return mkbool(fload(call Rt.asF(a)) f>= fload(call Rt.asF(bb)));
    } else {
      return mkbool(payload(a, 0) >= payload(bb, 0));
    }
  } else {
    return false;
  }
}
defun Rt.number?(a : val) -> val {
  return mkbool(tagis(a, 0)) || (mkbool(tagis(a, 12)) || false);
}
defun Rt.string?(a : val) -> val {
  return mkbool(tagis(a, 1)) || false;
}
defun Rt.cons?(a : val) -> val {
  return mkbool(tagis(a, 4)) || false;
}
defun Rt.empty?(a : val) -> val {
  return mkbool(tagis(a, 5)) || false;
}
defun Rt.bitwise-and(a : val, bb : val) -> val {
  return mknum(payload(call Rt.toI32(a), 0) & payload(call Rt.toI32(bb), 0));
}
defun Rt.bitwise-or(a : val, bb : val) -> val {
  return mknum(payload(call Rt.toI32(a), 0) | payload(call Rt.toI32(bb), 0));
}
defun Rt.bitwise-xor(a : val, bb : val) -> val {
  return mknum(payload(call Rt.toI32(a), 0) ^ payload(call Rt.toI32(bb), 0));
}
defun Rt.bitwise-not(a : val) -> val {
  return mknum(bitnot(payload(call Rt.toI32(a), 0)));
}
defun Rt.bitwise-shift-left(count : val, value : val) -> val {
  return mknum(payload(call Rt.toI32(value), 0) << (payload(call Rt.toI32(count), 0) & 31));
}
