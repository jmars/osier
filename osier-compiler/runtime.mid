// runtime.mid — the Mid-written runtime's surface-language text.
// This file is the moved home of osier-compiler/src/Mid/RtSource.elm's
// `source : List String`: the text below is EXACTLY
//   String.join "\n" source
// (one list element per line, in order, NO trailing newline — that join is
// the extraction's byte contract; re-ordering or re-escaping a line changes
// the surface text and turns the corpus byte-identity check RED.  A stray
// trailing newline is whitespace and is emit-inert — MEASURED, not assumed).
// The `//` header lines are comments (M0) and do not participate in emit;
// the corpus check is the proof.
//
// THE EXPORT BLOCK (M2, plan.md §2.5) — the keys the driver/seats cross into
// Osier, one line per exported defun, in Osier type syntax.  Unexported
// defuns are module-private.  The types here are the CONSERVATIVE DEFAULT:
// the surface defun headers declare only the mid-c class (`val`/`word`), so
// the Osier PAYLOAD types (a string path vs an Int, say) are not determinable
// from this file — that mapping is M4's.  `val` = the boxed value class,
// `word` = the opaque Word, `!io` = the §2.5 effect marker (carried, not
// enforced, in M2).  `Rt.malloc` is DELIBERATELY ABSENT: it is a rawcall
// seat (libc malloc), not a defun, and an export must name an existing defun.
module Rt
export Rt.read-file-as-string : val -> val
export Rt.exec-run : val -> val -> val -> val !io
export Rt.main : word -> word -> word
export Rt.frame-enter : word -> word
export Rt.frame-leave : word
// an existing defun, so it travels with the defuns it names (region 2) — a
// kept export over a dropped defun is a loud 'names no defun in the module'.
// THE APPLIER SEAT (stage 7A): (closure, arg-area, nargs) -> the applied value.
// The Mid host calls it directly (same module), and it is EXPORTED so a Mid
// PROGRAM can reach it too — the applier pin (tools/qbe/fixtures/hostapply.elm)
// is why: Rt.callArity's first real exercise must not be the selfhost, where a
// silent-wrong is a wrong answer rather than a red row. A user `.mid` may call
// only EXPORTED runtime keys (J2), so an internal spelling is unreachable for
// the pin — this is the one seat the port widens the block for.
export Rt.apply-at : val -> val -> val -> val
// ===== THE ROOT REGISTRY'S PUBLIC HALF (ZIGHOST Z1) =====
// The six WRITE seats of the Mid-owned root registry, exported for exactly the
// reason Rt.apply-at is: a Mid PROGRAM (a user `.mid` module) must be able to
// root a C-heap value array across a churn, and J2 lets a user module call
// only EXPORTED runtime keys.  The pin that needs it is
// tools/qbe/fixtures/Whost.mid / Wyoung.mid, whose arms store into a malloc'd
// array, churn 20000 allocations, and read the array back.
// The collector's walkers (Rt.gcMarkRoots/Rt.gcScavRoots) are NOT exported: no
// program roots by walking, and a program that could would be a second root
// source by construction.
export Rt.rootPushValueArray : word -> word -> word
export Rt.rootPushValue : word -> word
export Rt.rootPushPtr : word -> word
export Rt.rootPop : word
export Rt.rootWatermark : word
export Rt.rootPopTo : word -> word
// ======================= THE C FFI BOUNDARY (cffi U5) =======================
// The runtime's libc surface, DECLARED (plan §8 U5) so a `rawcall` site's
// register classes come from the C prototype instead of the all-word
// convention.  Each symbol here had its `Ast.rawcallArity` row DELETED in the
// same commit: R-08 refuses a symbol in both tables, so the table row and the
// declaration can never drift apart.
//
// WHAT THIS BUYS, MEASURED (plan §7.1): a C `int` result leaves %rax's upper
// 32 bits UNSPECIFIED.  The declared `i32` result emits `=w call` + `extsw`,
// so the value the runtime compares is the C `int` and never a 4294967295.
// Say it plainly: on THIS glibc the error branch of `openat` was already
// correct (the wrapper returns -1 in the full register), so U5 fixes no
// visible behaviour here — the LIVE bug measured on this host is `access`/
// `fstatat` (plan §7.1), neither of which this file calls.  The declarations
// are what make the NEXT reader's site checked rather than conventional.
//
// DELIBERATELY NOT DECLARED, and why each stays a `rawcallArity` row:
//   * `getpid` — the TEST SUITE's canonical undeclared `rawcall` sample: nine
//     TestMain rows pin the table MECHANISM by spelling `rawcall getpid()`
//     (J1 accept "the getpid shape", J3's arity reject, J7, the L2/L6 lower
//     rows, R-08's seat, the audit-span row, U2's "UNDECLARED is UNCHANGED"
//     pin).  Migrating it would rewrite the rows that pin the seat, to buy a
//     width fix plan §7.1 MEASURED as not needed here (this glibc's getpid is
//     pre-extended) — the trap the plan's §8 U5 risk (a) names.
//   * `malloc`/`free`/`write` — still rawcalled UNDECLARED by live gate
//     fixtures (tools/qbe/fixtures/ffiv-void.mid, Wnods.mid, Wesc.mid,
//     Iopin.mid).  A declaration here is FILE-SCOPED, so it would not type
//     those sites; the row deletion would only turn them into loud J3
//     "no signature table" errors.  Declaring the symbol and deleting the row
//     is one move, and it needs those fixtures migrated first.
//   * `mmap`/`exit` — outside the plan's migration list; leaving the rows
//     keeps today's all-word shape.
//   * `clock_gettime` — plan §8 item 5 defers it to the effect-loop port.
//     NOTE the plan's PREMISE is stale: the GC-ARC F1 stats instrument added
//     three `clock_gettime` sites (Rt.collect), so it DOES have Rt-body calls
//     today.  It is still not declared here — nothing compares its result as
//     a C `int`, so the width class that put `getrlimit`/`setrlimit` below on
//     the list does not apply to it.
//   * `getrlimit`/`setrlimit` LEFT this list: Rt.main's rlimit seat COMPARES
//     `getrlimit`'s result (`rc == 0`), which IS the measured-live class, so
//     both are DECLARED above with the C `int` — and their `rawcallArity`
//     rows in Mid.RtLang.Ast went with the declarations (R-08 refuses a
//     symbol in both tables).
//   * `fstatat`/`getdents64` — DECLARED at stage 7E, which is the unit that
//     gave them their first call sites (the listDir walk and the stat leaf);
//     the two `rawcallArity` rows went with them, since R-08 refuses a symbol
//     in both tables.  `strtod` is still a row and still has no site.
//   * every `rt_*` seat — not C: they are rt.o/Mid symbols with a WORD ABI
//     (plan §6), and declaring a word seat as a C signature would be a type
//     lie.
//
// THE ONE LINE DECLARING `__errno_location` DOES NOT FIX: `byteload(
// __errno_location(), 0)` below reads errno — a 32-bit `int` — through ONE
// BYTE.  Correct only while errno < 256 (plan §9.2 / §10.2); width-typed
// memory (cffi U6) is the fix, and it is NOT this unit's.
extern openat(dirfd : i32, path : ptr, flags : i32, mode : i32) -> i32;
extern __errno_location() -> ptr;
extern waitpid(pid : i32, status : ptr, options : i32) -> i32;
extern readdir(dirp : ptr) -> ptr;
extern opendir(name : ptr) -> ptr;
extern closedir(dirp : ptr) -> i32;
extern close(fd : i32) -> i32;
extern dup(fd : i32) -> i32;
extern dup2(oldfd : i32, newfd : i32) -> i32;
extern pipe(fds : ptr) -> i32;
extern unlink(path : ptr) -> i32;
extern mkstemp(template : ptr) -> i32;
extern fnmatch(pattern : ptr, name : ptr, flags : i32) -> i32;
extern chdir(path : ptr) -> i32;
extern getcwd(buf : ptr, size : i64) -> ptr;
extern getenv(name : ptr) -> ptr;
extern setenv(name : ptr, value : ptr, overwrite : i32) -> i32;
extern kill(pid : i32, sig : i32) -> i32;
extern execvp(file : ptr, argv : ptr) -> i32;
extern fork() -> i32;
extern read(fd : i32, buf : ptr, count : i64) -> i64;
extern lseek(fd : i32, offset : i64, whence : i32) -> i64;
extern memset(dst : ptr, c : i32, n : i64) -> ptr;
extern poll(fds : ptr, nfds : i64, timeout : i32) -> i32;
// THE RLIMIT PAIR (width fix, post-Z6 record unit): `getrlimit` returns a C
// `int` and `setrlimit` takes/returns one.  Rt.main's argv prologue is
// their ONLY site, and it COMPARES the result (`rc == 0`) — the exact class
// the header above calls measured-live, read at 64 bits through an
// undeclared all-word rawcall row.  `resource` is the C `int`
// (RLIMIT_STACK = 3), `rlim` the `struct rlimit *`.
extern getrlimit(resource : i32, rlim : ptr) -> i32;
extern setrlimit(resource : i32, rlim : ptr) -> i32;
// STAGE 7C: `fcntl` is DECLARED AS VARIADIC (plan §6 gap G-I), which is the
// shape the FFI arc made possible and pinned (tools/qbe/fixtures/ffic-vararg.mid:
// `=w call $fcntl(w 1, w 3, ..., l 0)` + `extsw`, i.e. two C `int` params and a
// WORD-class variadic one).  `Rt.hostSetNonblocking` is its only caller, and
// that seat is 7D's (the exec pipes): the readFile leaf passes O_NONBLOCK to
// `openat` itself, exactly as the Zig does, so nothing in 7C calls this.
// (`fcntl` was never a `rawcallArity` row, so R-08's both-tables refusal is not
// in play here — unlike `clock_gettime`, see the host's own note.)
// ==================== THE `return`-INSIDE-`if` SPELLING ====================
// (return-flip stage 1)  69 statements in this file used to depend on a MID-BLOCK
// `if` whose BOTH branches `return` DEAD-BINDING and the block CARRYING ON: the
// chosen arm's `return` was a VALUE the lowerer bound to a fresh binder nothing
// read (LowerToIr's `thenDiv && elseDiv` arm), and the statements after the if
// ran whatever the condition.  That is a TRAP, not a rule — the code below was
// written as if `return` exited — and it is why the language cannot spell C's
// "if/else statement": J7 rejects a mid-block `if` whose branches both FALL
// THROUGH, so a both-returning if is the ONLY way to write "run one arm, then
// carry on", and it works only by accident.
//
// Each site is now spelled as a DECLARATION:
//
//     val _uN = if (c) { <work A> return x; } else { <work B> return y; };
//     <carry on>
//
// Inside an if-EXPRESSION a branch's `return` is the BRANCH's value by L3 (a
// block's terminator IS its value), and the declaration discards it — which is
// exactly what the dead bind did, so the meaning is unchanged under EITHER
// reading of a statement `return` (MEASURED: all 159 corpus .ssa artifacts are
// byte-identical before and after the migration).  `_uN` names are throwaway;
// they exist because this language has one flat scope per defun (J5 rejects a
// duplicate declaration) and a bare `x = if ..` is not a declaration.
//
// THE OTHER TWO SPELLINGS THIS FILE ALREADY USES, and when each is right:
//   * ONE-SIDED GUARD (`if (c) { ..; return x; } <carry on>`): LEGAL beside a
//     continuation and a REAL early exit — the continuation splices into the
//     FALSE path, so it does not run when the guard is taken.  Use it when the
//     guarded work must SKIP the rest of the block (333 sites below).
//   * DISPATCH CHAIN + TAIL CALLS (Rt.gcMarkRoots): each arm does its work and
//     tail-calls the next dispatcher, so a k-way dispatch needs no join.  Use it
//     when the arms end in a call anyway.
// TestMain pins all three shapes (the SPELLING rows), and pins the count (69)
// so a site reverted to the bare form turns the row RED.
extern fcntl(fd : i32, cmd : i32, ...) -> i32;
extern _exit(code : i32) -> void;
// STAGE 7E: the two syscalls the dir/stat leaves need (plan §6 gap G-I's
// list, minus `strtod`).  Both are declared with the C prototypes' RESULT
// widths — `getdents64` is glibc's `int` (not the raw syscall's `long`), so
// the seam's `=w call` + `extsw` is what makes `n < 0` a real read-error test
// rather than a comparison against 0x00000000ffffffff.  `count` stays `i64`
// (size_t), and `flag` is AT_SYMLINK_NOFOLLOW's `int`.
extern getdents64(fd : i32, buf : ptr, count : i64) -> i32;
extern fstatat(dirfd : i32, path : ptr, buf : ptr, flag : i32) -> i32;
// O5 seat 4b: the entry-arg parser's two conversions.  `strtod` was plan §8
// item 5's last undeclared row with no call site; Rt.parseArg is that site
// now, so the declaration and the `rawcallArity` row move together (R-08).
// Both are declared with the C prototype's RESULT width — `strtod`'s `f64` is
// what makes its call a `=d call` (cffi U3) and lets `mkflt(rawcall
// strtod(..))` be a float-word producer; `strtoll`'s `i64` is an `=l call`.
// WHY LIBC AND NOT A HAND-WRITTEN DECIMAL PARSER: strtod is CORRECTLY ROUNDED,
// so it returns the same double std.fmt.parseFloat did for EVERY input
// (correct rounding is unique) and the float-arg goldens cannot move; strtoll
// gives the same i64 as std.fmt.parseInt for every in-range input and
// SATURATES on overflow, which errno=ERANGE turns back into the refusal
// parseInt produced.  A hand-rolled pair would be a cheaper analogue wearing
// the same name.
extern strtod(s : ptr, endptr : ptr) -> f64;
extern strtoll(s : ptr, endptr : ptr, base : i32) -> i64;
// ZIGHOST Z4a: the float-text formatter's two halves, both libc and both
// CORRECTLY ROUNDED (that is the whole reason this port is not a digit
// algorithm).  `strfromd(s, n, fmt, x)` renders a double through a printf
// format with the C locale's decimal point; `strtod` reads it back.  The
// fixture that proved the boundary is tools/qbe/fixtures/ffid-f64.mid (a `d`
// argument and a `w` result in ONE call).
extern strfromd(buf : ptr, n : i64, fmt : ptr, x : f64) -> i32;
// THE REGION LAYOUT (midlang-u5) — the name -> word-slot table.  Before this
// struct the offsets were `wstore(base, k, ..)` constants in Rt.gcInit and
// prose in Mid/RtGc.elm; slot 0..12 MEASURED against gcInit's writes and every
// collector access, with the hole at 7 and the staging pair at 8/9 checked
// against the code (TestMain's U5 rows pin this table to this declaration).
//
//   slot 0  magic       the init marker 331941693251 ("MIDGC"), Rt.collect's check
//   slot 1  classTab    pointer to the per-class free-list heads
//   slot 2  heapStart   first object body (the mark walk's lower bound)
//   slot 3  cursor      the bump pointer
//   slot 4  heapEnd     the end of the heap half (the mark walk's upper bound)
//   slot 5  markTop     mark-stack top; gcInit/collect set it to 64
//   slot 6  markEnd     mark-stack end (gcInit: 64 + (heapBytes/8)/8)
//   slot 7  noreuse    QBE_MIDGC_NOREUSE: nonzero = NEVER pop a free-list
//                       block (the sweep still links them, so the heap keeps
//                       growing).  The M1 DISCRIMINATOR of GC ARC unit 1b:
//                       with reuse OFF, a stale pointer can never alias a
//                       LIVE object — its block's word 0 is the free-list
//                       link (an in-heap pointer, not a value tag), so a
//                       corrupt read is loud instead of plausible.  Set once
//                       by gcInit from the environment; 0 in every normal run
//   slot 8  kind        STAGING: the object kind, written by Rt.gcAlloc and
//   slot 9  count       STAGING: the exact count, read back by Rt.gcAllocGo
//   slot 10 heapBytes   the heap budget (QBE_HEAP_MB, read by gcInit itself
//                       since ZIGHOST Z4a — the old seat is deleted)
//   slot 11 allocated   bump-path bytes charged against the budget
//   slot 12 numClass    the number of size classes
//
//   ---- THE STATS INSTRUMENT (GC-ARC F1, slots 13..23) ----------------
//   Nine words + a scratch buffer, so the two claims plan.md §2.2 records as
//   ASSERTED become CHECKABLE: (a) the collect COUNT (the 64/128 MB residual
//   is "zero collects", i.e. route cost, not GC — stage-4 review finding 2),
//   and (b) the mark-vs-sweep SPLIT of a collect's time (the 16 MB delta was
//   attributed to the O(heap) sweep with no instrument behind it).
//
//   slot 13/14  ts0     CLOCK_MONOTONIC {sec,nsec} at collect entry
//   slot 15/16  ts1     ... after the mark walk (roots + drain), before the sweep
//   slot 17/18  ts2     ... after the sweep
//   slot 19  collects   collects since init (the counter)
//   slot 20  marked     object bodies MARKED by the last collect — one push
//                       per body (gcMarkPtr's `marked == 0` test), i.e. the
//                       O(live) half of the work, and reset per collect
//   slot 21  sweptBytes heap bytes the last sweep walked (O(heap))
//   slot 22  markUs     microseconds in the last mark walk
//   slot 23  sweepUs    microseconds in the last sweep
//   byte 320 (NOT a field) the 32-byte digit scratch Rt.gcNum writes into
//                       (MOVED from byte 288 by the GC NURSERY unit: the young
//                       slots grew the struct to 38 words = byte 304, which
//                       swallowed the old scratch at 288 — the printer was
//                       writing digits into scavBytes/scavBodies)
//
//   ---- HEAP GROWTH (GC ARC unit 4, slot 24) --------------------------
//   slot 24  capEnd     the CEILING's end address: heapStart + the ceiling in
//                       bytes.  `heapEnd` (slot 4) is the CURRENT limit and is
//                       never above it; Rt.gcAlloc raises heapEnd by a doubling
//                       on exhaustion and dies loudly when the two are equal.
//                       The marker's upper bound stays heapEnd, NOT capEnd —
//                       the reserve past the limit was never handed out, so a
//                       garbage pointer must not be allowed to mark into it.
//
//   ---- THE BLOCK MAP + VERIFY (GC ARC unit 2, slots 25..27) ----------
//   slot 25  bmPtr      the BLOCK MAP: one BYTE per 64-byte minimum block,
//                       carved from the same mmap between the class table and
//                       the heap, sized for the CEILING (capBytes/64).  It is
//                       the collector's own record of WHERE THE BLOCKS ARE,
//                       and it is the only structure that makes "is this
//                       pointer the beginning of an object?" a decidable,
//                       O(1) question:
//                         0 = not a block start
//                         1 = a block start, LIVE (or on the bump path)
//                         2 = a block start, ON A FREE LIST (freed, not reused)
//                       A byte rather than a bitmap on purpose: no shift, no
//                       read-modify-write, one bytestore on the bump path
//                       (reuse keeps the entry; nothing moves, so a block start
//                       is a PERMANENT property of the address).  The marker,
//                       the sweeper and the verifier all read it, which is what
//                       makes them agree on what a block is.
//   slot 26  freedN      blocks the LAST sweep linked onto a free list — the
//                       O(1) half of the verifier's exactly-once accounting
//                       (marked + freedN == blocks in the swept range)
//   slot 27  verify      QBE_MIDGC_VERIFY=1 (read ONCE by gcInit): after every
//                       sweep, walk the heap and every free list and ASSERT the
//                       invariants (Rt.gcVerify/Rt.gcVerifyList).  Knob only.
//
//   ---- THE NURSERY (GC NURSERY unit, QBE_MIDGC_YOUNG=1 builds, slots 28..35) --
//   One young space carved AFTER capEnd in the same mmap; all allocation bumps
//   in it; on fill a SCAVENGE copies every live young object into OLD space
//   (= promotion on first survival) and resets the bump pointer.  The two
//   load-bearing header bits, both ABOVE every legal class (numClass is < 2^20
//   at any mappable ceiling) and both CLEARED by a fresh header:
//     bit 61  RS        the block is in the remembered set (set by the
//                       rt_vec_store_young barrier, cleared by the scavenge's
//                       remembered walk, by the sweep's free arm, and by every
//                       header rewrite — a free-list pop or a promotion)
//     (the surface's literals are exact only to 2^53, so the collector
//      builds the constants by multiplication at their use sites)
//     bit 62  FORWARDED a YOUNG block that was evacuated: word -1 then holds
//                       the new (old-space) address and body word 0 is
//                       poisoned with tag 15, so a stale unrooted read dies
//                       in the tag dispatch instead of returning plausible
//                       bytes (the wall-B loudness the plan asked for)
//   Class readers MASK: (flags >> 2) & ((1073741824 * 2147483648) - 1) (bits 0..60).
//
//   slot 28  young      1 = the nursery is ACTIVE (QBE_MIDGC_YOUNG=1 in the
//                       environment of a QBE_MIDGC_YOUNG=1 BUILD; the build
//                       flag gates the code's existence, this knob gates its
//                       behaviour — the in-binary A/B arm)
//   slot 29  youngStart the young space's base (= capEnd)
//   slot 30  youngEnd   youngStart + youngBytes
//   slot 31  youngCursor the young bump pointer; == youngStart when off
//   slot 32  rsBase     the REMEMBERED SET: one word per entry (an old block
//                       address), carved after the mark stack, capacity
//                       capBytes/64 — the same one-entry-per-64-byte-block
//                       bound as the mark stack (an old block is remembered
//                       at most once per young cycle: the RS bit dedups, and
//                       it is only cleared by death or by a scavenge scan)
//   slot 33  rsTop      entries in the set
//   slot 34  rsEnd      rsBase + capacity (overflow is a NAMED die)
//   slot 35  scavenges  scavenges since init (the stats counter)
//   slot 36  scavBytes  body bytes copied out of the young space by the LAST
//                       scavenge (the per-event stats pair with slot 37)
//   slot 37  scavBodies blocks copied (promoted) by the last scavenge
//
//   ---- THE STRING-STREAM REGISTRY (O5 — NOT a Region field) -----------
//   The registry lives in the GLOBALS BLOCK at words 14..15 (ssN at 15,
//   ssTab at 14 — see RtGc.elm's layout table): it is NOT collector state,
//   so a Region slot would be the wrong home for it.  The block is .bss
//   (zeroed) and rt_glob_addr is emitted UNCONDITIONALLY (finishModule), so
//   the registry is reachable before a region is mapped and after.  The former rt_ss_in/readbyte/close C seats died at O5;
//   Rt.open's ENOENT arm, Rt.read-byte's string arm and Rt.close's string
//   arm call the Mid defuns below.
//
// THE TIMESTAMPS COST THREE vDSO clock reads PER COLLECT (no branch: the knob
// only gates the PRINT — Rt.gcNumOut, from Rt.collect), because a collect is
// already an O(heap) walk and the alternative is a knob-read in the hot path.
// Reading them on every collect is also what keeps the code shape simple
// enough to stay frame-free.  A negative µs is not representable in the
// printed form (Rt.gcNum is unsigned); the clocks are monotonic, so it cannot
// arise.
//
// NOT fields, deliberately: the MARK STACK (words 64..markEnd) and every
// object body.  Those are reached by a COMPUTED word index, so they stay
// `wload(region, top)` / `wstore(region, top, ptr)` in Rt.gcDrain and
// Rt.gcMarkPtr — a `*word` view over the same region is the tier-(ii)
// spelling of that overlap, not a field of this struct.
struct Region {
  magic : word;
  classTab : *word;
  heapStart : word;
  cursor : word;
  heapEnd : word;
  markTop : word;
  markEnd : word;
  noreuse : word;
  kind : word;
  count : word;
  heapBytes : word;
  allocated : word;
  numClass : word;
  ts0s : word;
  ts0n : word;
  ts1s : word;
  ts1n : word;
  ts2s : word;
  ts2n : word;
  collects : word;
  marked : word;
  sweptBytes : word;
  markUs : word;
  sweepUs : word;
  capEnd : word;
  bmPtr : word;
  freedN : word;
  verify : word;
  young : word;
  youngStart : word;
  youngEnd : word;
  youngCursor : word;
  rsBase : word;
  rsTop : word;
  rsEnd : word;
  scavenges : word;
  scavBytes : word;
  scavBodies : word;
}
// THE FRAME HEADER LAYOUT (midlang-u6) — the name -> word-slot table.  Before
// this struct frameBlock/frame-enter/frame-leave spelled the header as
// `wload(hdr, k)` / `wstore(hdr, k, v)` constants; slots 0..3 are MEASURED
// against those four accesses, and sizeof(FrameHdr) = 5 words = the 40 bytes
// `frameBlock` computes (`40 + 40*nslots`) and `frame-enter` adds to reach the
// slots (`base = hdr + 40`).  TestMain's U6 rows pin this table to this
// declaration.
//
//   slot 0  live      the slot count written by frame-enter (rt.zig: live@0)
//   slot 1  wm        the ROOT REGISTRY watermark taken at enter; frame-leave
//                     pops TO it (`Rt.rootPopTo(hdr->wm)`, never a bare pop:
//                     the collector caches root slots above it)
//   slot 2  next      the parent frame in the frame stack (globals word 1)
//   slot 3  freeNext  the freelist link, written on leave, read on reuse
//   slot 4  _pad      the rt.zig `slots` pointer field; NOTHING in the Mid
//                     frame path reads or writes it (P1e dropped the counter
//                     seeding along with the zero loop — Rt.rootPushValueArray
//                     takes base+live explicitly), so it is a named hole
//
// NOT a field, deliberately: the SLOTS themselves.  They begin at hdr + 40
// (word 5), are variable in count, and are reached only with computed word
// offsets — `base`/`memset`/`Rt.rootPushValueArray` keep the WORD spelling.
struct FrameHdr {
  live : word;
  wm : word;
  next : word;
  freeNext : word;
  _pad : word;
}
// THE APPLY STATE BLOCK LAYOUT (midlang-u7) — the name -> word-slot table for
// the 32-byte cell Rt.apply/Rt.apply-tail malloc and Rt.applyGo/Rt.applyTailGo
// read and re-write (the over-applied arm).  Before this struct those four
// words were `wstore(state, k, v)` / `wload(sp, k)` constants; slots 0..3 are
// MEASURED against every one of those accesses, and sizeof = 4 words = the 32
// bytes both wrappers malloc.  TestMain's U7 rows pin this table to this
// declaration.
//
//   slot 0  args    the caller's args array base — the ROOT_VALUE_ARRAY base
//                   registered by
//                   `Rt.rootPushValueArray(args, [word](state) + 16)`
//   slot 1  nargs   the live args count; the over-applied arm RE-BINDS it (and
//                   `args`) to the remaining args, then `recur`s
//   slot 2  live    the element count the root SCAN reads, through the `np`
//                   pointer at this word (`[word](state) + 16`): nargs at PUSH
//                   time, deliberately NOT updated by the over-applied arm —
//                   the registration keeps scanning the ORIGINAL range, whose
//                   extra elements are live Values, so a superset is sound
//   slot 3  env     the partial arm's staging copy of the applied closure's
//                   env, rooted via `Rt.rootPushPtr([word](sp) + 24)` and
//                   RE-READ after the allocvec (the cStrFill lesson: the
//                   allocvec may have scavenged it)
struct ApplyState {
  args : word;
  nargs : word;
  live : word;
  env : word;
}
// THE 80-BYTE `:ret` LAYOUT (midlang-u7) — the Agg "ret" cell Rt.tail-known and
// both Rt.applyTailGo arms malloc, and that Rt.bounce / Rt.bounceGo chase.  The
// word offsets are an ABI in three directions at once: the builder (this file),
// the chaser (Rt.bounceGo's rt_callN switch), and Lower's @ret block, which
// blits all 80 bytes out of slot 0 and frees the block (P1a) — so no offset
// here may move.  TestMain's U7 rows pin this table; the 1e6-hop mutual-tail
// run is the behavioural half.
//
//   slot 0..4  result  the `.done` Value payload (a `val` field = 5 words);
//                      read by the chaser as a VALUE (`vecload(r, 0)` — a val
//                      field read at offset 0 is the same node).  WRITTEN
//                      WORD-WISE at all three malloc sites (five zeroing
//                      stores in the two tail arms, the five-word mkval payload
//                      in the partial arm): that is a run of RawWordStores, NOT
//                      a val field store, so those five lines keep the `wstore`
//                      spelling — re-spelling them would emit a different node
//                      sequence
//   slot 5  kind   0 = `result` is the finished Value; 1 = words 6..9 are a
//                  known tail call
//   slot 6  code   the callee's code pointer (rt_callN's first argument)
//   slot 7  e      the callee's env / captures pointer
//   slot 8  args   the staged args array base (the static tsbuf or an allocvec)
//   slot 9  arity  the callee's arity — the rt_callN switch in Rt.bounceGo
struct Ret {
  result : val;
  kind : word;
  code : word;
  e : word;
  args : word;
  arity : word;
}
// THE APPLY DISPATCH-BLOCK LAYOUT (midlang-u7) — the four words Rt.callArity
// reads out of its `disp` value's payload.  MEASURED against those reads
// (fn@0, caps@1, buf@2, arity@3).  This view is a PREFIX of the storage and its
// sizeof is NOT pinned: the block those reads were written for was a
// `malloc(32)` in the applyGo/applyTailGo arms, and the P1d "mechanism (ii)"
// rewrite (PERF-DEBT.md) deleted that writer — Rt.callArity is dead but not
// pruned, so this is now a read-only view with no in-Mid builder.  It stays a
// named word table rather than vanishing: the four offsets are what the dead
// body means, and a future caller must build exactly this shape.
struct Disp {
  fn : word;
  caps : word;
  buf : word;
  arity : word;
}
// THE PLAN-TREE BLOCKS (midlang-u8) — the four fixed-shape nodes the effect
// parser (Rt.epProg → Rt.epChain → Rt.epPipeline → Rt.epCmd) builds into
// malloc'd arrays and the exec runner / the free helpers walk.  Each one is a
// PREFIX of its allocation and is reached mostly through a `val` that boxes the
// block's ADDRESS, so the conversions spell the view `[*Prog](payload(p, 0))`
// (the J12 `word -> *T` row — checker-only, no node) where no binder holds the
// pointer, and retype the binder where one does.  Every offset below is what
// the code already wrote; TestMain's U8 rows pin the tables to these
// declarations, and the corpus pins the emitted accesses.
//
// Rt.epProg, `malloc(16)` = 2 words:
//   slot 0  nchains  chains built so far; the builder ADVANCES it
//                    (Rt.epProgGo) and Rt.epFreeChains reads it as the COUNT TO
//                    FREE — one number, two names in the old code (`iW`/`nW`)
//   slot 1  chains   the `*Chain` array, `nchains * 16` bytes
struct Prog {
  nchains : word;
  chains : word;
}
// Rt.epChain, one `*Chain` element of Prog.chains (16 bytes = 2 words):
//   slot 0  op      the connector: 0 `;`, 1 `&&`, 2 `||` (Rt.epChain) — read
//                   by Rt.execGo's chain loop to decide whether to run
//   slot 1  pipe    the Rt.epPipeline block for this chain
struct Chain {
  op : word;
  pipe : word;
}
// Rt.epPipeline, `malloc(16)` = 2 words:
//   slot 0  ncmds   commands built so far (the same advance-and-count-twice
//                   idiom as Prog.nchains); Rt.epFreeCmds frees that many
//   slot 1  cmds    the `*CmdState` array, `ncmds * 40` bytes
struct Pipe {
  ncmds : word;
  cmds : word;
}
// Rt.exec-plan's `malloc(24)` = 3 words — the RUN-STATE the plan parser carries
// through Rt.epCount/Rt.epProg/Rt.epCmd and their recursion:
//   slot 0  cbuf       the 336-byte char buffer of interned symbols (a BYTE
//                      buffer: `cbuf + <byte offset>` is word arithmetic on it
//                      everywhere, so it stays a `word`, not a field of it)
//   slot 1  depth      the sub-chain nesting depth, bounded at 32 by Rt.epCmd
//   slot 2  lim        the element cap the enclosing construct sets for
//                      Rt.epCount (8 for a chain/redirect, 64 for a pipeline,
//                      256 for a program) — a STAGING value, rewritten before
//                      each count
struct Scratch {
  cbuf : word;
  depth : word;
  lim : word;
}
// Rt.epRedir, one element of CmdState.redirs (`malloc(n * 48)` = 6 words):
//   slot 0  kind  0 `<` 1 `>` 2 `>>` 3 `<&`/`>&` (dup) 4 heredoc 5 herestring
//   slot 1  fd    the target fd
//   slot 2  path  the open path (a plain redirect's malloc'd string; 0 for a
//                 dup or a heredoc, whose body is slot 4)
//   slot 3  dupfd the source fd of a dup redirect
//   slot 4  body  the heredoc/herestring body buffer (Rt.openBodyTmpfile reads
//                 it from Rt.wireCmdGo)
//   slot 5  tmpfd the temp fd that body was written to, -1 until wired and
//                 back to -1 once consumed (Rt.closeCmdTmpfds)
struct Redir {
  kind : word;
  fd : word;
  path : word;
  dupfd : word;
  body : word;
  tmpfd : word;
}
// THE EXEC-SIDE BLOCKS (midlang-u8) — what the plan tree is DECODED into and
// what the runner carries between its mode arms.
//
// Rt.epPipeline's `malloc(n * 40)` element — ONE decoded command, 5 words:
//   slot 0  argv    the malloc'd `char*` array (`argc + 1` words, NULL-terminated)
//   slot 1  argc    args built so far — Rt.epArgvGo advances it and
//                   Rt.epFreeArgv/applyRedirects read it as the COUNT, the same
//                   one-number-two-roles idiom as Prog.nchains
//   slot 2  redirs  the `*Redir` array, `nredirs * 48` bytes
//   slot 3  nredirs redirects decoded so far (again: built-count == free-count)
//   slot 4  subprog the `*Prog` of a subshell command (`( ... )`), 0 if none —
//                   Rt.epCmd stores it and Rt.epFreeCmd/execGo chase it.  NOT
//                   a chain table: it is the block whose OWN slot 1 is the
//                   chain array, which is why it is a word here (a `*Prog`
//                   field would need a cast at every `mknum(..)` of it)
struct CmdState {
  argv : word;
  argc : word;
  redirs : word;
  nredirs : word;
  subprog : word;
}
// Rt.exec-plan's `malloc(168)` = 21 words — the runner's whole state, threaded
// as `val stN` through Rt.execGo's mode arms and every child helper:
//   slot 0  cbuf        the 336-byte interned-symbol / message buffer (a BYTE
//                       buffer, `cbuf + <byte offset>` everywhere — a word)
//   slot 1  outfd       the fd the plan's stdout goes to
//   slot 2  errfd       the fd the plan's stderr goes to
//   slot 3  inChild     1 once this process IS a subshell child
//   slot 4  subprog     the `*Prog` a subshell unwinds into (the chain loop's
//                       program, restored by the child arms)
//   slot 5  pipe        the `*Pipe` the current mode is walking
//   slot 6  code        the plan's running exit code
//   slot 7  chain       the chain index (Rt.execGo mode 0's cursor)
//   slot 8  ncmds       commands in the current pipe
//   slot 9  npipes      pipes to create for it (ncmds - 1)
//   slot 10 pfds        the `int[2*npipes]` pipe-fd array (rawcall pipe writes it)
//   slot 11 pids        the `int[ncmds]` child-pid array
//   slot 12 nforked     children forked so far (mode 6 kills exactly these)
//   slot 13 forkFailed  1 once a fork failed, so mode 6 (kill) is chosen over
//                       mode 4 (reap)
//   slot 14 status      the last stage's status; < 0 means a stage failed
//   slot 15 bodyOff     the heredoc body writer's offset
//   slot 16 bodyFd      the heredoc body writer's temp fd
//   slot 17 waitStatus  what `waitpid(pid, payload(st, 0) + 136, 0)` writes —
//                       the RAW word at 17, reached by ADDRESS arithmetic, not
//                       by a field read, which is why that call keeps its
//                       `payload(stN, 0) + 136` spelling
//   slot 18 curCmd      the command index closeOthersGo must NOT close
//   slot 19 cursor      the generic mode cursor (pipes in mode 2, commands in
//                       mode 3, reaps in mode 4, kills in mode 6)
//   slot 20 argIdx      the echo builtin's argument cursor
struct Exec {
  cbuf : word;
  outfd : word;
  errfd : word;
  inChild : word;
  subprog : word;
  pipe : word;
  code : word;
  chain : word;
  ncmds : word;
  npipes : word;
  pfds : word;
  pids : word;
  nforked : word;
  forkFailed : word;
  status : word;
  bodyOff : word;
  bodyFd : word;
  waitStatus : word;
  curCmd : word;
  cursor : word;
  argIdx : word;
}
// THE READ BLOCK (midlang-u8) — the `malloc(72)` both Rt.exec-run and
// Rt.read-file-as-string build and Rt.readFileGo fills, 6 words:
//   slot 0  fd   the fd being slurped
//   slot 1  tmp  the 65536-byte read chunk
//   slot 2  acc  the accumulator base
//   slot 3  len  bytes accumulated
//   slot 4  cap  the accumulator's capacity
//   slot 5  _pad NOTHING reads or writes it — a named hole, so a field added
//               here cannot silently shift the copy descriptor below
//
// WORDS 6..8 ARE NOT FIELDS: they are a `*CopyDesc` at `[word](blkW) + 48` —
// the 3-word descriptor `Rt.memGo` drains, written by the slurp's own three
// `wstore(blkW, 6|7|8, ..)` lines and by nothing else.  Two views over one
// allocation (the same shape as Region's mark stack): the struct stops at 5 and
// the overlap is spelled at its two sites rather than by widening this table.
struct ReadBlk {
  fd : word;
  tmp : word;
  acc : word;
  len : word;
  cap : word;
  _pad : word;
}
// Rt.memGo's argument — the (src, dst, n) copy descriptor, 3 words.  Rt.memGo
// is the runtime's bulk byte copy; most callers pass a stack/`withroots` pair,
// and the two slurps above pass the tail of their ReadBlk.
struct CopyDesc {
  src : word;
  dst : word;
  n : word;
}
// ==================== STAGE 7A: THE MID EFFECT HOST — DECLS ==============
// The host's state declarations.  They live HERE, with every other struct in
// this file, because a DECL MAY NOT FOLLOW A DEFUN: MEASURED on this tree,
// `defun ... struct ...` is `err N:1: unexpected input after the expression`
// (both in this module and in a user `.mid`), so the state block has to sit
// above the first defun.  The machine itself — its design note, the layout
// this block declares, and every host defun — is at the END of this file.
struct HostFrame {
  kind : word;
  cont : word;
}
// 7C: TaskReadFile's pending effect.  `tmp` is the 65536-byte read chunk
// (malloc'd for the effect's LIFETIME, not per read — gap G-K forbids a 64 KiB
// Mid local, and a per-iteration malloc would churn the C heap once per 64 KiB
// of input).  The accumulator is `bptr/blen/bcap`, the same three words 7B's
// readLine cell carried; the block is C heap, so the collector cannot move it
// and no raw/stale read can arise across a collect.
//
// THE UNION'S SIZE DOES NOT MOVE (the 7A pins still hold: sizeof(HostEv) 527
// words, all three members at byte 4136) — `ex` is 10 words and this member is
// now 5.
struct HostRF {
  fd : i32;
  bptr : word;
  blen : word;
  bcap : word;
  tmp : word;
}
// 7D: TaskExec's pending effect.  TWO accumulators (captured stdout and
// stderr, each a C block with the same ptr/len/cap triple 7C's readFile
// carries), the child's pid, the two read ends, and the decoded plan tree
// (`prog`, kept alive until the child is reaped AND both pipes EOF'd, which is
// what makes `argv` inside it valid for execvp's whole lifetime).
//
// `oflags` is the three booleans the Zig keeps separately, one bit each —
// out_eof 1, err_eof 2, child_exited 4, so completion is ONE compare
// `(oflags & 7) == 7` (plan §5.1).  `code` is the DECODED wait status
// (Rt.waitStatusCode's answer, 0..255); plan §5.1's struct omitted it and the
// Zig's ExecEff carries `exit_code` as its own field, so the port keeps it as
// a field rather than packing it into oflags' spare bits — the union grows by
// one word and TestMain's layout rows are the seat that says so.
struct HostEX {
  prog : word;
  pid : word;
  outfd : i32;
  errfd : i32;
  code : word;
  bptr : word;
  blen : word;
  bcap : word;
  eptr : word;
  elen : word;
  ecap : word;
  oflags : word;
}
struct HostSL {
  deadline : word;
}
// 7B: the sleep scan's loop state.  Its cursor lives in MEMORY (a self-tail
// `recur` hands back only the defun's params, and a `call Rt.*` may carry at
// most THREE args — MEASURED: `err qbe: rawCall to Rt.hostSleepScan stages
// arity 5 — the lean ABI passes 1..3 pointer args`).
struct HostScan {
  i : word;
  best : word;
  bestD : word;
  now : word;
}
struct HostEv {
  active : word;
  gen : word;
  base : word;
  nframes : word;
  frames : HostFrame[256];
  etag : word;
  union { rf : HostRF; ex : HostEX; sl : HostSL; };
}
struct Host {
  nslots : i32;
  slots : val[33031];
  nevals : word;
  nactive : word;
  quit : word;
  cur : word;
  clr : word;
  clrBase : word;
  evals : HostEv[128];
  // 7C: the fd table's LIVE COUNT and the table itself (a malloc'd
  // `struct HostPoll`).  Both append AFTER `evals` so every 7A offset — and
  // the whole eval table's stride — is untouched; `hostInit`'s malloc literal
  // grows by these two words and TestMain's LAYOUT PIN is the seat that says so.
  npoll : word;
  poll : word;
}
// ==================== STAGE 7C: THE fd TABLE ==============================
// THE KERNEL'S OWN `struct pollfd` (sys/poll.h): { int fd; short events; short
// revents; } — 8 bytes, `events`@4, `revents`@6.  THE WIDTHS ARE LOAD-BEARING
// (plan §6 gap G-H): a word-granular layout would put `revents` at bytes 8..15
// and the kernel would write bytes 6..7 of our cell, i.e. read back 0 forever.
// The layout is MEASURED against the kernel itself in tools/qbe/fixtures/
// ffim-mem.mid's arm 1 (a `storeh` at byte 4 the kernel READS, and a `revents`
// the kernel WRITES at byte 6) — that fixture is the authority for these three
// fields, not this comment.
struct Pollfd {
  fd : i32;
  events : u16;
  revents : u16;
}
// THE fd TABLE — ONE malloc'd block, three parallel 258-entry arrays, and the
// 258 is `MAX_EVALS * 2 + 2` (effectloop.zig:102: a readFile needs one fd and
// an exec two, plus two slack).  It is a SEPARATE allocation rather than a
// `struct Host` field because `&lp->pollfds[0]` is NOT expressible: `&place`
// takes a struct value or a struct FIELD, never an index (Check's J13 address
// rule), and `poll` needs a pointer.  Holding the block's address as a `word`
// makes the call site a plain `rawcall poll(lp->poll, lp->npoll, to)`.
//
// THE LIFETIME IS THE RUN (plan G-H): one malloc at hostInit, memset to zero,
// never resized and never moved — so a pointer the kernel is given stays valid
// across every collect (it is C-heap, invisible to the GC, which is why the
// collector can move Values between the rebuild and the drain).
struct HostPoll {
  fds : Pollfd[258];
  evals : word[258];
  roles : word[258];
}
// CLOCK_MONOTONIC's timespec (glibc `struct timespec`, x86_64: 16 bytes).
struct HostTs {
  sec : i64;
  nsec : i64;
}
// 7D: ONE `pipe(2)` pair.  `rawcall pipe(ptr)` writes two C `int`s, and a
// `struct` of two `i32`s is the only way this language can READ them back by
// name — a `wload` would take eight bytes at once and the halves would have to
// be split by arithmetic (Rt.execGo does that where it has no struct; here the
// fields carry the width, which is the same reason struct Pollfd exists).
struct HostPipe {
  rd : i32;
  wr : i32;
}
// 7D: what the forked child needs, in ONE pointer.  The child may not touch
// the host state (it is a copy, and the parent keeps running in the original),
// and a `call Rt.*` carries at most three pointer args (plan §6 G-A), so the
// five facts travel as one 7-word C block: the argv the decoded plan owns
// (NUL-terminated, C heap — plan §6 G-G), the four pipe ends, and the `*Exec`
// scratch whose cbuf carries the builtin names and the childW2 diagnostics.
struct HostSpawn {
  argc : word;
  argv : word;
  outr : word;
  outw : word;
  errr : word;
  errw : word;
  exec : word;
}
// ==================== STAGE 7E: THE DIR/STAT STRUCTS =====================
// The two layouts the last leaves read.  BOTH ARE C LAYOUTS, so both are
// spelled with the widths the headers declare — the cffi U6 rule, and the same
// reason `struct Pollfd` above exists (`mode`/`uid`/`gid` at 4-byte offsets
// cannot be expressed word-granularly at all).
//
// THE AUTHORITY IS tools/qbe/fixtures/ffim-mem.mid, NOT this comment: its
// `struct Stat` is byte-identical to the libc header on this host, and its
// arms 3/4 WRITE every one of these fields through the typed fields and read
// the words back (`mode`@24, `uid`@28, `gid`@32, `__pad0`@36, `rdev`@40,
// `size`@48, `blocks`@64), so the offsets are measured against values the
// libc call produced rather than re-derived here.  144 bytes = 18 words.
//
// WHY THE TIMESPECS ARE `HostTs` AND NOT A NEW STRUCT: glibc's `struct
// timespec` is exactly `{ i64 tv_sec; i64 tv_nsec; }` (ffim-mem's `Timespec`)
// and `HostTs` is that declaration already, from `clock_gettime`.  A rename
// would be a second declaration of one layout.
struct Stat {
  dev : u64;
  ino : u64;
  nlink : u64;
  mode : u32;
  uid : u32;
  gid : u32;
  pad0 : i32;
  rdev : u64;
  size : i64;
  blksize : i64;
  blocks : i64;
  atim : HostTs;
  mtim : HostTs;
  ctim : HostTs;
  reserved : word[3];
}
// LINUX `struct linux_dirent64` — the getdents64 record: ino64 8, off64 8,
// reclen u16 @16, d_type u8 @18, then a NUL-terminated name at byte 19.
//
// THE NAME TAIL IS NOT A FIELD, DELIBERATELY: a narrow array element is not
// expressible (Parse's fieldType rejects `u8[256]` naming exactly this struct),
// and it must not be — the record's STRIDE is `d_reclen`, not a fixed size, so
// the name is read in place at `base + 19` with `byteload`.  `sizeof(Dirent)`
// is therefore 24 (the four headers padded to alignment) and is NEVER the
// stride; only the four fields above it are read by name, and their offsets are
// the kernel's own.
struct Dirent {
  ino : u64;
  off : i64;
  reclen : u16;
  dtype : u8;
}
// ONE getdents64 WALK'S CURSOR.  C heap rather than defun params: a `call Rt.*`
// carries at most THREE pointer args and a self-tail hands back only the params
// (7B's HostScan note), so the four words live in memory.  `fd` keeps the width
// the kernel's openat gave it; `buf` is the reused 4096-byte chunk, which is
// C heap for gap G-K's reason (a Mid local that size is a 512-slot frame).
struct HostDir {
  fd : i32;
  buf : word;
  off : word;
  nread : word;
}
// NO extern FOR clock_gettime, DELIBERATELY: the symbol still has an
// `Ast.rawcallArity` row (cffi U5 left it, "per the brief"), and R-08 refuses
// a symbol in both tables.  Declaring it here would mean deleting that row and
// re-emitting Rt.collect's three F1-stats call sites — a corpus-wide shape
// change this unit does not own.  The undeclared row's all-word convention is
// correct for this call (its `int` result is ignored; the OUT parameter is a
// timespec pointer).  Adding the declaration + deleting the row belongs to
// whoever re-freezes the corpus.
defun Rt.getpid(dummy : val) -> val {
  return mknum(rawcall getpid());
}

defun Rt.emptylist(a : val) -> val {
  if (mkbool(tagis(a, 0)) && mkbool(payload(a, 0) == 0)) {
    return mknil;
  } else {
    word h = rawcall rt_halt();
    return mknil;
  }
}

defun Rt.cStrEqLit(ptrN : val, litN : val, i : val) -> val {
  word pb = byteload(payload(ptrN, 0), payload(i, 0));
  word lb = byteload(payload(litN, 0), payload(i, 0));
  if (mkbool(lb == 0)) {
    return mkbool(pb == 0);
  }
  if (mkbool(pb == lb)) {
    recur(ptrN, litN, mknum(payload(i, 0) + 1));
  }
  return false;
}

defun Rt.wStr(fdN : val, ptrN : val) -> val {
  val len = call Rt.cStrLenGo(ptrN, mknum(0));
  rawcall write(payload(fdN, 0), payload(ptrN, 0), payload(len, 0));
  return mknil;
}

defun Rt.wRaw(fdN : val, ptrN : val, lenN : val) -> val {
  rawcall write(payload(fdN, 0), payload(ptrN, 0), payload(lenN, 0));
  return mknil;
}

defun Rt.waitStatusCode(st : val) -> val {
  if (mkbool((payload(st, 0) & 127) == 0)) {
    return mknum((payload(st, 0) >>> 8) & 255);
  } else {
    return mknum(128 + (payload(st, 0) & 127));
  }
}

defun Rt.cStrLenGo(ptrN : val, i : val) -> val {
  word byte = byteload(payload(ptrN, 0), payload(i, 0));
  if (mkbool(byte == 0)) {
    return mknum(payload(i, 0));
  }
  recur(ptrN, mknum(payload(i, 0) + 1));
}

defun Rt.cStrCopyGo(srcN : val, dstN : val, i : val) -> val {
  word byte = byteload(payload(srcN, 0), payload(i, 0));
  if (mkbool(byte == 0)) {
    bytestore(payload(dstN, 0), payload(i, 0), 0);
    return mknil;
  } else {
    bytestore(payload(dstN, 0), payload(i, 0), byte);
    recur(srcN, dstN, mknum(payload(i, 0) + 1));
  }
}

defun Rt.cStrFill(bufN : val, str : val, i : val) -> val {
  if (mkbool(payload(i, 0) >= payload32(str, 1))) {
    bytestore(payload(bufN, 0), payload(i, 0), 0);
    return bufN;
  } else {
    bytestore(payload(bufN, 0), payload(i, 0), strbyte(str, payload(i, 0)));
    recur(bufN, str, mknum(payload(i, 0) + 1));
  }
}

defun Rt.readFull(fdN : val, bufN : val, countN : val) -> val {
  word n = rawcall read(payload(fdN, 0), payload(bufN, 0), payload(countN, 0));
  if (mkbool(n < 0)) {
    if (mkbool(byteload(rawcall __errno_location(), 0) == 4)) {
      return call Rt.readFull(fdN, bufN, countN);
    }
    return mknum(-1);
  }
  return mknum(n);
}

defun Rt.memGo(blkN : val, iN : val) -> val {
  word src = [*CopyDesc](payload(blkN, 0))->src;
  word dst = [*CopyDesc](payload(blkN, 0))->dst;
  word end = [*CopyDesc](payload(blkN, 0))->n;
  if (mkbool(payload(iN, 0) >= end)) {
    return mknil;
  }
  word b = byteload(src, payload(iN, 0));
  bytestore(dst, payload(iN, 0), b);
  recur(blkN, mknum(payload(iN, 0) + 1));
}

defun Rt.close(stream : val) -> val {
  word isStr = payload(stream, 1) > 1;
  if (mkbool(isStr)) {
    word r = payload(call Rt.ssClose(mknum(payload(stream, 0))), 0);
    if (mkbool(r == -2)) {
      word h = rawcall rt_halt();
      return mknil;
    }
    return mknil;
  } else {
    word f = payload(stream, 0);
    if (mkbool(f != 0)) {
      rawcall close(f);
      return mknil;
    }
    return mknil;
  }
}

defun Rt.write-byte(byte : val, stream : val) -> val {
  word buf = allocraw(1);
  bytestore(buf, 0, payload(byte, 0));
  rawcall write(payload(stream, 0), buf, 1);
  return byte;
}

@rec
defun Rt.deepEq(a : val, bb : val) -> val {
  if (mkbool(tagis(a, 0)) && mkbool(tagis(bb, 0))) {
    return mkbool(payload(a, 0) == payload(bb, 0));
  }
  if (mkbool(tagis(a, 1)) && mkbool(tagis(bb, 1))) {
    return mkbool(len32(a) == len32(bb)) && call Rt.bytesEqGo(a, bb, mknum(0));
  }
  if (mkbool(tagis(a, 2)) && mkbool(tagis(bb, 2))) {
    return call Rt.symEq(a, bb, mknum(0));
  }
  if (mkbool(tagis(a, 3)) && mkbool(tagis(bb, 3))) {
    return mkbool(payload32(a, 0) == payload32(bb, 0));
  }
  if (mkbool(tagis(a, 12)) && mkbool(tagis(bb, 12))) {
    return mkbool(fload(a) f== fload(bb));
  }
  if (mkbool(tagis(a, 5))) {
    return mkbool(tagis(bb, 5));
  }
  if (mkbool(tagis(a, 4)) && mkbool(tagis(bb, 4))) {
    if (mkbool(payload32(call Rt.deepEq(vecload(payload(a, 0), 0), vecload(payload(bb, 0), 0)), 0) == 0)) {
      return false;
    }
    recur(vecload(payload(a, 0), 1), vecload(payload(bb, 0), 1));
  }
  if (mkbool(tagis(a, 14)) && mkbool(tagis(bb, 14))) {
    return mkbool(len32(a) == len32(bb)) && call Rt.vecEq(a, bb, mknum(0));
  }
  if (mkbool(tagis(a, 10)) && mkbool(tagis(bb, 10))) {
    return mkbool(len32(a) == len32(bb)) && call Rt.vecEq(a, bb, mknum(0));
  }
  return false;
}

@!rec
defun Rt.deepEq(a : val, bb : val) -> val {
  if (mkbool(tagis(a, 0)) && mkbool(tagis(bb, 0))) {
    return mkbool(payload(a, 0) == payload(bb, 0));
  }
  if (mkbool(tagis(a, 1)) && mkbool(tagis(bb, 1))) {
    return mkbool(len32(a) == len32(bb)) && call Rt.bytesEqGo(a, bb, mknum(0));
  }
  if (mkbool(tagis(a, 2)) && mkbool(tagis(bb, 2))) {
    return call Rt.symEq(a, bb, mknum(0));
  }
  if (mkbool(tagis(a, 3)) && mkbool(tagis(bb, 3))) {
    return mkbool(payload32(a, 0) == payload32(bb, 0));
  }
  if (mkbool(tagis(a, 12)) && mkbool(tagis(bb, 12))) {
    return mkbool(fload(a) f== fload(bb));
  }
  if (mkbool(tagis(a, 5))) {
    return mkbool(tagis(bb, 5));
  }
  if (mkbool(tagis(a, 4)) && mkbool(tagis(bb, 4))) {
    if (mkbool(payload32(call Rt.deepEq(vecload(payload(a, 0), 0), vecload(payload(bb, 0), 0)), 0) == 0)) {
      return false;
    }
    recur(vecload(payload(a, 0), 1), vecload(payload(bb, 0), 1));
  }
  if (mkbool(tagis(a, 10)) && mkbool(tagis(bb, 10))) {
    return mkbool(len32(a) == len32(bb)) && call Rt.vecEq(a, bb, mknum(0));
  }
  return false;
}

defun Rt.bytesEqGo(a : val, bb : val, i : val) -> val {
  if (mkbool(payload(i, 0) >= len32(a))) {
    return true;
  }
  if (mkbool(strbyte(a, payload(i, 0)) != strbyte(bb, payload(i, 0)))) {
    return false;
  }
  recur(a, bb, mknum(payload(i, 0) + 1));
}

defun Rt.symEq(a : val, bb : val, i : val) -> val {
  if (mkbool(strbyte(a, payload(i, 0)) == 0)) {
    return mkbool(strbyte(bb, payload(i, 0)) == 0);
  }
  if (mkbool(strbyte(a, payload(i, 0)) != strbyte(bb, payload(i, 0)))) {
    return false;
  }
  recur(a, bb, mknum(payload(i, 0) + 1));
}

defun Rt.vecEq(a : val, bb : val, i : val) -> val {
  if (mkbool(payload(i, 0) >= len32(a))) {
    return true;
  }
  if (mkbool(payload32(call Rt.deepEq(vecload(payload(a, 0), payload(i, 0)), vecload(payload(bb, 0), payload(i, 0))), 0) == 0)) {
    return false;
  }
  recur(a, bb, mknum(payload(i, 0) + 1));
}

@rec @eqPtrFast
defun Rt.=(a : val, bb : val) -> val {
  if (mkbool(tagis(a, 0)) && mkbool(tagis(bb, 0))) {
    return mkbool(payload(a, 0) == payload(bb, 0));
  }
  if (mkbool(tagis(a, 1)) && mkbool(tagis(bb, 1))) {
    return mkbool(len32(a) == len32(bb)) && call Rt.bytesEqGo(a, bb, mknum(0));
  }
  if (mkbool(tagis(a, 2)) && mkbool(tagis(bb, 2))) {
    return mkbool(payload(a, 0) == payload(bb, 0)) || call Rt.symEq(a, bb, mknum(0));
  }
  if (mkbool(tagis(a, 3)) && mkbool(tagis(bb, 3))) {
    return mkbool(payload32(a, 0) == payload32(bb, 0));
  }
  if ((mkbool(tagis(a, 0)) || mkbool(tagis(a, 12))) && (mkbool(tagis(bb, 0)) || mkbool(tagis(bb, 12)))) {
    return mkbool(fload(call Rt.asF(a)) f== fload(call Rt.asF(bb)));
  }
  if ((mkbool(tagis(a, 4)) && mkbool(tagis(bb, 2))) || (mkbool(tagis(a, 2)) && mkbool(tagis(bb, 4)))) {
    return false;
  }
  if (mkbool(tagis(a, 2)) && mkbool(tagis(bb, 8))) {
    return mkbool(payload(a, 0) == payload(bb, 0)) || call Rt.symEq(a, bb, mknum(0));
  }
  if (mkbool(tagis(a, 8)) && mkbool(tagis(bb, 2))) {
    return mkbool(payload(a, 0) == payload(bb, 0)) || call Rt.symEq(a, bb, mknum(0));
  }
  if (mkbool(tagis(a, 4)) && mkbool(tagis(bb, 4))) {
    return call Rt.deepEq(a, bb);
  }
  if (mkbool(tagis(a, 14)) && mkbool(tagis(bb, 14))) {
    return call Rt.deepEq(a, bb);
  }
  if (mkbool(tagis(a, 10)) && mkbool(tagis(bb, 10))) {
    return call Rt.deepEq(a, bb);
  }
  return mkbool(tagis(a, 5)) && mkbool(tagis(bb, 5));
}

@rec @!eqPtrFast
defun Rt.=(a : val, bb : val) -> val {
  if (mkbool(tagis(a, 0)) && mkbool(tagis(bb, 0))) {
    return mkbool(payload(a, 0) == payload(bb, 0));
  }
  if (mkbool(tagis(a, 1)) && mkbool(tagis(bb, 1))) {
    return mkbool(len32(a) == len32(bb)) && call Rt.bytesEqGo(a, bb, mknum(0));
  }
  if (mkbool(tagis(a, 2)) && mkbool(tagis(bb, 2))) {
    return call Rt.symEq(a, bb, mknum(0));
  }
  if (mkbool(tagis(a, 3)) && mkbool(tagis(bb, 3))) {
    return mkbool(payload32(a, 0) == payload32(bb, 0));
  }
  if ((mkbool(tagis(a, 0)) || mkbool(tagis(a, 12))) && (mkbool(tagis(bb, 0)) || mkbool(tagis(bb, 12)))) {
    return mkbool(fload(call Rt.asF(a)) f== fload(call Rt.asF(bb)));
  }
  if ((mkbool(tagis(a, 4)) && mkbool(tagis(bb, 2))) || (mkbool(tagis(a, 2)) && mkbool(tagis(bb, 4)))) {
    return false;
  }
  if (mkbool(tagis(a, 2)) && mkbool(tagis(bb, 8))) {
    return call Rt.symEq(a, bb, mknum(0));
  }
  if (mkbool(tagis(a, 8)) && mkbool(tagis(bb, 2))) {
    return call Rt.symEq(a, bb, mknum(0));
  }
  if (mkbool(tagis(a, 4)) && mkbool(tagis(bb, 4))) {
    return call Rt.deepEq(a, bb);
  }
  if (mkbool(tagis(a, 14)) && mkbool(tagis(bb, 14))) {
    return call Rt.deepEq(a, bb);
  }
  if (mkbool(tagis(a, 10)) && mkbool(tagis(bb, 10))) {
    return call Rt.deepEq(a, bb);
  }
  return mkbool(tagis(a, 5)) && mkbool(tagis(bb, 5));
}

@!rec @eqPtrFast
defun Rt.=(a : val, bb : val) -> val {
  if (mkbool(tagis(a, 0)) && mkbool(tagis(bb, 0))) {
    return mkbool(payload(a, 0) == payload(bb, 0));
  }
  if (mkbool(tagis(a, 1)) && mkbool(tagis(bb, 1))) {
    return mkbool(len32(a) == len32(bb)) && call Rt.bytesEqGo(a, bb, mknum(0));
  }
  if (mkbool(tagis(a, 2)) && mkbool(tagis(bb, 2))) {
    return mkbool(payload(a, 0) == payload(bb, 0)) || call Rt.symEq(a, bb, mknum(0));
  }
  if (mkbool(tagis(a, 3)) && mkbool(tagis(bb, 3))) {
    return mkbool(payload32(a, 0) == payload32(bb, 0));
  }
  if ((mkbool(tagis(a, 0)) || mkbool(tagis(a, 12))) && (mkbool(tagis(bb, 0)) || mkbool(tagis(bb, 12)))) {
    return mkbool(fload(call Rt.asF(a)) f== fload(call Rt.asF(bb)));
  }
  if ((mkbool(tagis(a, 4)) && mkbool(tagis(bb, 2))) || (mkbool(tagis(a, 2)) && mkbool(tagis(bb, 4)))) {
    return false;
  }
  if (mkbool(tagis(a, 2)) && mkbool(tagis(bb, 8))) {
    return mkbool(payload(a, 0) == payload(bb, 0)) || call Rt.symEq(a, bb, mknum(0));
  }
  if (mkbool(tagis(a, 8)) && mkbool(tagis(bb, 2))) {
    return mkbool(payload(a, 0) == payload(bb, 0)) || call Rt.symEq(a, bb, mknum(0));
  }
  if (mkbool(tagis(a, 4)) && mkbool(tagis(bb, 4))) {
    return call Rt.deepEq(a, bb);
  }
  if (mkbool(tagis(a, 10)) && mkbool(tagis(bb, 10))) {
    return call Rt.deepEq(a, bb);
  }
  return mkbool(tagis(a, 5)) && mkbool(tagis(bb, 5));
}

@!rec @!eqPtrFast
defun Rt.=(a : val, bb : val) -> val {
  if (mkbool(tagis(a, 0)) && mkbool(tagis(bb, 0))) {
    return mkbool(payload(a, 0) == payload(bb, 0));
  }
  if (mkbool(tagis(a, 1)) && mkbool(tagis(bb, 1))) {
    return mkbool(len32(a) == len32(bb)) && call Rt.bytesEqGo(a, bb, mknum(0));
  }
  if (mkbool(tagis(a, 2)) && mkbool(tagis(bb, 2))) {
    return call Rt.symEq(a, bb, mknum(0));
  }
  if (mkbool(tagis(a, 3)) && mkbool(tagis(bb, 3))) {
    return mkbool(payload32(a, 0) == payload32(bb, 0));
  }
  if ((mkbool(tagis(a, 0)) || mkbool(tagis(a, 12))) && (mkbool(tagis(bb, 0)) || mkbool(tagis(bb, 12)))) {
    return mkbool(fload(call Rt.asF(a)) f== fload(call Rt.asF(bb)));
  }
  if ((mkbool(tagis(a, 4)) && mkbool(tagis(bb, 2))) || (mkbool(tagis(a, 2)) && mkbool(tagis(bb, 4)))) {
    return false;
  }
  if (mkbool(tagis(a, 2)) && mkbool(tagis(bb, 8))) {
    return call Rt.symEq(a, bb, mknum(0));
  }
  if (mkbool(tagis(a, 8)) && mkbool(tagis(bb, 2))) {
    return call Rt.symEq(a, bb, mknum(0));
  }
  if (mkbool(tagis(a, 4)) && mkbool(tagis(bb, 4))) {
    return call Rt.deepEq(a, bb);
  }
  if (mkbool(tagis(a, 10)) && mkbool(tagis(bb, 10))) {
    return call Rt.deepEq(a, bb);
  }
  return mkbool(tagis(a, 5)) && mkbool(tagis(bb, 5));
}

defun Rt.asF(x : val) -> val {
  if (mkbool(tagis(x, 12))) {
    return x;
  }
  return mkflt(itof(payload(x, 0)));
}

defun Rt.toI32(x : val) -> val {
  if (mkbool(tagis(x, 12))) {
    return mknum(ftoi32(fload(x)));
  }
  if (mkbool(tagis(x, 0))) {
    return x;
  }
  return mknum(0);
}

defun Rt.revGo(l : val, acc : val) -> val {
  if (mkbool(tagis(l, 4))) {
    return call Rt.revGo(vecload(payload(l, 0), 1), call Rt.cons(vecload(payload(l, 0), 0), acc));
  }
  return acc;
}

// THE TEXT PATH IS A BYTE BUFFER, NOT A CONS LIST (text-fix).  A string is
// the runtime's native string (tag 1: bytes at payload word 0, length at
// len32) everywhere the printer touches it: an integer's decimal text and a
// symbol's name are written STRAIGHT into ONE `allocraw` buffer and wrapped
// with `mkstr`, and Rt.cn2 concatenates two of them by copying two byte
// ranges into one buffer of len(a)+len(b)+1.  MEASURED (handoff-prof-fixes-
// result, handoff-osier-prof-result): the old shape built a cons cell PER
// BYTE (Rt.dgs / Rt.nameBytes / Rt.bytesOf -> Rt.cons) and then walked that
// list three more times (countL, appendL, fillGo) — 18-24% of the run in
// libc memset (4.9e9 calls, 1.25 TB, mostly 64-511-byte blocks, i.e. the cons
// cells) plus ~15% in the walks themselves.  THE RUNTIME SEMANTICS ARE
// UNCHANGED: a string is still a `val` (tag 1 over a raw block), so the val
// bridge rules and rooting are exactly as they were — the buffer is a raw
// GC block, the string a value over it, and no printer ordering moves.
//
// Rt.bytesToStr SURVIVES for the one caller whose INPUT REALLY IS a byte list
// — Rt.shen.bytes->string, i.e. Shen's bytes->string — with its walkers
// countL/countGo/fillGo.  Their depth was the LENGTH OF THE TEXT as a
// build-up recursion: MEASURED 2026-10-19 from a crash stack, the seed-built
// compiler printing ONE 26 KB emitted defun had 26 061 q_Rt.countL frames
// live when it hit the guard page at the default 8 MiB (fillGo's 440-byte
// frame reached the same wall at 64 MiB), and the printed corpus contains a
// 672 628-byte defun.  Both are accumulators over `recur` — the tree's loop
// idiom (Rt.gcEnvNum: state travels in the arguments) — so the walk costs
// O(1) native stack at any text size.
defun Rt.numText(n : val) -> val {
  word nw = payload(n, 0);
  if (nw == 0) {
    word z = allocraw(2);
    bytestore(z, 0, 48);
    bytestore(z, 1, 0);
    return mkstr(z, 1);
  }
  val cnt = call Rt.digitCount(mknum(nw), mknum(0));
  word nd = payload(cnt, 0);
  if (nw < 0) {
    word ln = nd + 1;
    word sb = allocraw(ln + 1);
    bytestore(sb, 0, 45);
    call Rt.numFill(mknum(sb + ln - 1), mknum(nw));
    bytestore(sb, ln, 0);
    return mkstr(sb, ln);
  }
  word bp = allocraw(nd + 1);
  call Rt.numFill(mknum(bp + nd - 1), mknum(nw));
  bytestore(bp, nd, 0);
  return mkstr(bp, nd);
}

// The decimal digit COUNT of n (`m / 10` truncates toward zero, so this
// terminates on a negative m too and the magnitude is never negated — for
// INT64_MIN `0 - m` would overflow).  :val params with `recur` and a `mknum`
// per step, exactly like Rt.countGo: a `mknum` is a FRAME-SLOT box (a 40-byte
// aggregate store through the destination slot), NOT a GC allocation, so this
// defun is non-allocating and therefore FRAME-FREE — which is what makes it
// safe to call with an unrooted raw buffer in hand.  (A WORD-ABI loop cannot
// do this: `raw-abi self-tail arg 0 is not the param register a0` — the word
// loop may only recur on its constant params, copyWords' malloc'd counter.)
defun Rt.digitCount(m : val, i : val) -> val {
  if (payload(m, 0) == 0) {
    return i;
  }
  recur(mknum(payload(m, 0) / 10), mknum(payload(i, 0) + 1));
}

// The digits of m, written RIGHT-TO-LEFT from `p` — the backward fill
// Rt.gcNum already does, so no index arithmetic and no second pass.
// `d + neg * (0 - 2 * d)` is |d| without a branch (`d < 0` is a 0/1 word),
// which keeps INT64_MIN's digits exact.  Non-allocating, frame-free: see
// digitCount's note.
defun Rt.numFill(p : val, m : val) -> val {
  word q = payload(m, 0) / 10;
  word d = payload(m, 0) - q * 10;
  word neg = d < 0;
  bytestore(payload(p, 0), 0, 48 + d + neg * (0 - 2 * d));
  if (q == 0) {
    return p;
  }
  recur(mknum(payload(p, 0) - 1), mknum(q));
}

defun Rt.bytesToStr(bs : val) -> val {
  val count = call Rt.countL(bs);
  word bufW = allocraw(payload(count, 0) + 1);
  val bufN = mknum(bufW);
  call Rt.fillGo(bs, bufN, mknum(0));
  return mkstr(bufW, payload(count, 0));
}

defun Rt.countL(l : val) -> val {
  return call Rt.countGo(l, mknum(0));
}

defun Rt.countGo(l : val, n : val) -> val {
  if (mkbool(tagis(l, 5))) {
    return n;
  } else {
    recur(vecload(payload(l, 0), 1), mknum(payload(n, 0) + 1));
  }
}

defun Rt.fillGo(l : val, bufN : val, i : val) -> val {
  if (mkbool(tagis(l, 5))) {
    return mknil;
  }
  bytestore(payload(bufN, 0), payload(i, 0), payload(vecload(payload(l, 0), 0), 0));
  recur(vecload(payload(l, 0), 1), bufN, mknum(payload(i, 0) + 1));
}

@consArr
defun Rt.cons(car : val, cdr : val) -> val {
  return withroots [car, cdr] {
    word pair = allocvec(2);
    vecstore(pair, 0, car);
    vecstore(pair, 1, cdr);
    return mkval(4, vecaddr(pair, 0));
  };
}

@!consArr
defun Rt.cons(car : val, cdr : val) -> val {
  return withroots [car, cdr] {
    word pair = allocvec(2);
    vecstore(pair, 0, car);
    vecstore(pair, 1, cdr);
    return mkval(4, vecaddr(pair, 0), vecaddr(pair, 1));
  };
}

@consArr
defun Rt.@p(car : val, cdr : val) -> val {
  return withroots [car, cdr] {
    word pair = allocvec(2);
    vecstore(pair, 0, car);
    vecstore(pair, 1, cdr);
    return mkval(4, vecaddr(pair, 0));
  };
}

@!consArr
defun Rt.@p(car : val, cdr : val) -> val {
  return withroots [car, cdr] {
    word pair = allocvec(2);
    vecstore(pair, 0, car);
    vecstore(pair, 1, cdr);
    return mkval(4, vecaddr(pair, 0), vecaddr(pair, 1));
  };
}

// THE CONCATENATION (text-fix): ONE buffer of len(a)+len(b)+1, TWO byte
// copies, ZERO cons cells — where this used to be bytesOf -> appendL ->
// bytesToStr, i.e. 2*(la+lb) cons cells plus four walks of the result.
// `Rt.byteCopyGo` is the loop (3 :val params, the LEAN-ABI bound), and it
// advances BOTH pointers, so the second copy starts at buf+la.
defun Rt.cn2(x : val, y : val) -> val {
  word lx = len32(x);
  word ly = len32(y);
  word buf = allocraw(lx + ly + 1);
  call Rt.byteCopyGo(mknum(buf), mknum(payload(x, 0)), mknum(lx));
  call Rt.byteCopyGo(mknum(buf + lx), mknum(payload(y, 0)), mknum(ly));
  bytestore(buf, lx + ly, 0);
  return mkstr(buf, lx + ly);
}

// n bytes from src to dst, both pointers advancing: the ONLY copy loop the
// text path needs (cn2, joinFill, substring, symToStr).  Non-allocating and
// therefore FRAME-FREE (a `mknum` is a frame-slot box, not a GC allocation —
// see digitCount), which is what lets a caller hold a freshly `allocraw`'d
// buffer across it: no safepoint, so nothing can scavenge the unrooted block
// (the cStrFill lesson).
//
// WORD-WIDE (perf U2): 8 bytes per iteration while n >= 8, then the byte tail.
// The loads/stores stay INSIDE [src, src+n) / [dst, dst+n) by construction
// (the word step is taken only when 8 bytes remain), so no overrun and no
// tail-byte special case beyond the original loop; the unaligned case is the
// x86-64 loadl/storel the emitter already produces.  The RETURN contract is
// unchanged: the ADVANCED dst (dst+n), which joinFill threads as its offset.
defun Rt.byteCopyGo(dst : val, src : val, n : val) -> val {
  if (mkbool(payload(n, 0) >= 8)) {
    wstore(payload(dst, 0), 0, wload(payload(src, 0), 0));
    recur(mknum(payload(dst, 0) + 8), mknum(payload(src, 0) + 8), mknum(payload(n, 0) - 8));
  }
  if (payload(n, 0) == 0) {
    return dst;
  }
  bytestore(payload(dst, 0), 0, byteload(payload(src, 0), 0));
  recur(mknum(payload(dst, 0) + 1), mknum(payload(src, 0) + 1), mknum(payload(n, 0) - 1));
}

// THE LINEAR JOIN (perf U1): join a LIST OF STRINGS around a separator in
// O(total) bytes — ONE length walk, ONE allocraw, ONE copy per piece into a
// running offset.  The Prelude's `join` used to be a right fold of
// String.append (Rt.cn2), which re-copies BOTH operands at every step: N
// parts of total length L copy about L*N/2 bytes into N intermediate
// buffers.  That is the quadratic emit the perf plan measured (byteCopyGo
// 52.9% of the self-emit's CPU, the per-process fixed cost's dominant term).
// Precedent: Rt.repeat's doubling rebuild (Rt.repGo), same class of fix.
//
// THE ELEMENTS ARE STRINGS.  The wrapper's scheme is String -> List String ->
// String and the checker enforces it at every call site, so this walk reads
// len32/payload directly instead of coercing through Rt.strOf: a coercion
// ALLOCATES for a number, and an allocation between `allocraw` and the copies
// would be a safepoint holding the buffer unrooted (the cStrFill lesson —
// the same reason cn2 is safe today).
//
// Three val params per defun, the LEAN-ABI bound; the separator rides as a
// param rather than needing a fourth slot.
defun Rt.join(sep : val, strs : val) -> val {
  word n = payload(call Rt.joinLen(sep, strs, mknum(0)), 0);
  word buf = allocraw(n + 1);
  bytestore(buf, n, 0);
  call Rt.joinFill(strs, mknum(buf), sep);
  return mkstr(buf, n);
}

// Pass 1: total = sum(len32(s)) + sepLen between neighbours.  The separator
// goes only BETWEEN, never after the last — the tail test here is the
// fold's `case rest of [] -> ""` arm, and it is why the accumulator can be a
// single slot (a count-plus-length pair would need a fourth param).
defun Rt.joinLen(sep : val, strs : val, acc : val) -> val {
  if (mkbool(tagis(strs, 5))) {
    return acc;
  }
  val s = vecload(payload(strs, 0), 0);
  val rest = vecload(payload(strs, 0), 1);
  if (mkbool(tagis(rest, 5))) {
    recur(sep, rest, mknum(payload(acc, 0) + len32(s)));
  }
  recur(sep, rest, mknum(payload(acc, 0) + len32(s) + len32(sep)));
}

// Pass 2: copy each piece at the running offset.  byteCopyGo RETURNS the
// advanced dst pointer, so the offset threads through the return value and
// this defun needs no fourth slot.  Frame-free (byteCopyGo and the mknum
// boxes allocate nothing), so the caller's fresh buffer is safe across it.
defun Rt.joinFill(strs : val, dstN : val, sep : val) -> val {
  if (mkbool(tagis(strs, 5))) {
    return dstN;
  }
  val s = vecload(payload(strs, 0), 0);
  val rest = vecload(payload(strs, 0), 1);
  val p = call Rt.byteCopyGo(mknum(payload(dstN, 0)), mknum(payload(s, 0)), mknum(len32(s)));
  if (mkbool(tagis(rest, 5))) {
    return p;
  }
  val q = call Rt.byteCopyGo(p, mknum(payload(sep, 0)), mknum(len32(sep)));
  recur(rest, q, sep);
}

// A symbol's name is a NUL-terminated C string (payload word 0); one buffer,
// one length walk, one copy.  The arity dropped to 1 with the cons list it
// used to thread its index through.
defun Rt.symToStr(s : val) -> val {
  val len = call Rt.cStrLenGo(mknum(payload(s, 0)), mknum(0));
  word n = payload(len, 0);
  word buf = allocraw(n + 1);
  call Rt.byteCopyGo(mknum(buf), mknum(payload(s, 0)), mknum(n));
  bytestore(buf, n, 0);
  return mkstr(buf, n);
}

defun Rt.strOf(x : val) -> val {
  if (mkbool(tagis(x, 1))) {
    return x;
  }
  if (mkbool(tagis(x, 0))) {
    return call Rt.numText(x);
  }
  if (mkbool(tagis(x, 2))) {
    return call Rt.symToStr(x);
  }
  if (mkbool(tagis(x, 3))) {
    if (mkbool(payload32(x, 0) != 0)) {
      return "true";
    }
    return "false";
  }
  if (mkbool(tagis(x, 5))) {
    return "[]";
  }
  return "[?]";
}

defun Rt.floatCopy(outN : val, bufN : val, i : val) -> val {
  if (mkbool(payload(i, 0) < 0)) {
    return mknil;
  }
  bytestore(payload(bufN, 0), payload(i, 0), byteload(payload(outN, 0) + 8, payload(i, 0)));
  return call Rt.floatCopy(outN, bufN, mknum(payload(i, 0) - 1));
}

// ===== THE FLOAT TEXT (ZIGHOST Z4a) =====
// Rt.floatText: a float Value's PRINTED form — the retired Zig seat's contract
// (values.floatText:254-268) rebuilt on libc's correctly-rounded formatter.
//
// WHY strfromd + strtod AND NOT A DIGIT ALGORITHM: the text is the SHORTEST
// ROUND-TRIP representation (what Zig's `{d}` prints), so the digit count is a
// PROPERTY of the value, not a fixed precision.  Rt.fShortest asks glibc for p
// significant digits (p = 1..17, `%.{p-1}e`) and keeps the first p whose
// strtod round-trip returns the SAME BITS — the standard shortest-repr
// definition, with both directions delegated to a correctly-rounded libc.  17
// is the guaranteed bound (no f64 needs more), so the loop terminates.
//
// THE RULES ON TOP, and where each is pinned by a committed golden:
//   * NaN / Infinity / -Infinity spelled literally — float-nan (produced by
//     0.0/0.0), float-infLit, float-negInfLit, float-infArith, float-fdivZero;
//   * a ".0" suffix on an INTEGRAL expansion — float-lit (1.5? no: it has a
//     dot) / float-tiny's neighbours: 12.0 (floatfun), 2.0 (floatlit),
//     10000000000000000000000.0 (float-big);
//   * THE EXPONENT SWITCH DOES NOT EXIST ON THIS TREE — MEASURED, and it
//     refutes the zighost plan's "exponent switch at the JS thresholds 1e-7 /
//     1e+22": Zig's `{d}` prints the full DECIMAL expansion, never an exponent
//     form.  1e-7 prints 0.0000001 (float-tiny) and 1e22 prints
//     10000000000000000000000.0 (float-big).  So this port has NO switch, and
//     the comment in tools/qbe/qbe-check.sh and the fixture that say
//     "exponential" are corrected in the same commit.
//
// THE 64-BYTE TRUNCATION IS PART OF THE CONTRACT, MEASURED, not an accident to
// be tidied away: the retired seat's buffer is 64 bytes, its `{d}` call FAILS
// for a longer expansion, and the bytes it leaves behind are the expansion
// truncated at 64.  float-maxF (17 significant digits + 47 zeros = 64) and
// float-denorm (0.0000…, 62 zeros) are exactly that, so the port truncates at
// 64 too.  A longer buffer would print the CORRECT text and turn both goldens
// red — the goldens are the specification here.
//
// THE SCRATCH is ONE malloc'd 136-byte cell, C-heap (invisible to the
// collector), because the text is assembled byte by byte:
//   +0   .. +63   the output text (the 64-byte truncation bound)
//   +64  .. +71   the printf format ("%.16e" — built per call, p varies)
//   +72  .. +111  strfromd's rendering (a %.16e of any f64 fits in 25 bytes)
//   +112          neg  (0/1)   the sign, from the rendered text's leading '-'
//   +120          p            the shortest round-trip digit count
//   +128          e            the decimal exponent (value = 0.<p digits>e^e)
// It is freed after the bytes are copied into the GC string.

// Rt.fRender: render x at p significant digits into the scratch, and return
// the RENDERING's address.  glibc's %.*e always emits exactly p digits (no
// trailing zeros are possible at the SHORTEST p, or a smaller p would have
// round-tripped), so the caller never has to count them.
defun Rt.fRender(scratchN : val, pN : val, xN : val) -> val {
  word s = payload(scratchN, 0);
  word p = payload(pN, 0);
  // THE PRECISION IS ONE OR TWO DIGITS.  `%.{p-1}e` needs p-1 decimals, and
  // p-1 reaches 16 at the shortest-round-trip bound — so a single-byte format
  // builder writes "%.@e" for every p >= 11 and glibc ABORTS on the invalid
  // conversion (MEASURED: float-maxF and every other 17-digit value died with
  // SIGABRT and no output, and the Z4a float matrix could not see it because
  // the printer was still the Zig seat then — only the printer flip routes a
  // printed float through THIS formatter).  The bytes are written
  // unconditionally at fixed offsets, with the 'e'/NUL position conditional.
  word d = p - 1;
  word two = payload((d >= 10) ? mknum(1) : mknum(0), 0);
  word fmt = s + 64;
  bytestore(fmt, 0, 37);
  bytestore(fmt, 1, 46);
  bytestore(fmt, 2, payload((two != 0) ? mknum(48 + d / 10) : mknum(48 + d), 0));
  bytestore(fmt, 3, payload((two != 0) ? mknum(48 + d - (d / 10) * 10) : mknum(101), 0));
  bytestore(fmt, 4, payload((two != 0) ? mknum(101) : mknum(0), 0));
  bytestore(fmt, 5, 0);
  word n = rawcall strfromd(s + 72, 40, fmt, fload(xN));
  return mknum(s + 72);
}

// Rt.fShortest: the shortest-round-trip search.  Each arm leaves its OWN
// rendering in the scratch, so the LAST one (the winner) is the one the caller
// reads — no second render.  A NON-FINITE value returns p = 0 (see the arm's
// comment): glibc renders it as "nan"/"inf"/"-nan"/"-inf", which no round-trip
// search can converge on, and the first letter is the test.
defun Rt.fShortest(scratchN : val, pN : val, xN : val) -> val {
  word src = payload(call Rt.fRender(scratchN, pN, xN), 0);
  // NON-FINITE FIRST, by the RENDERING's first letter ('n' or 'i', after an
  // optional '-').  This replaced a bit test on the value that was WRONG in a
  // way only a golden could show: `0.0 / 0.0` on this backend produces a NaN
  // with the SIGN BIT SET, and the exponent field read by signed division
  // (bits / 2^52) truncates toward zero for a negative word — so the seat
  // missed its own NaN arm and rendered "-n.0" (MEASURED: midgc-str printed
  // 0 instead of 100).  The text cannot lie about which of the four
  // non-finite spellings it is.
  word c0 = byteload(src, 0);
  word c = payload((c0 == 45) ? mknum(byteload(src, 1)) : mknum(c0), 0);
  if (mkbool(c == 110) || mkbool(c == 105)) {
    return mknum(0);
  }
  word back = payload(mkflt(rawcall strtod(src, 0)), 0);
  if (mkbool(back == payload(xN, 0))) {
    return pN;
  }
  return call Rt.fShortest(scratchN, mknum(payload(pN, 0) + 1), xN);
}

// Rt.fExpAt: the index just past the rendering's 'e'.  A SCAN, not arithmetic:
// `%.0e` emits NO decimal point ("1e-07") while `%.2e` does ("4.25e+01"), so
// the 'e' is not at a fixed offset — MEASURED: computing it as sign+p+1 put
// the exponent reader on the '+' for every p >= 2 and on a digit for p == 1,
// which is what turned 42.5 into 0.0000…0.
defun Rt.fExpAt(srcN : val, iN : val) -> val {
  word src = payload(srcN, 0);
  word i = payload(iN, 0);
  word c = byteload(src, i);
  if (mkbool(c == 0)) {
    return mknum(i);
  }
  if (mkbool(c == 101)) {
    return mknum(i + 1);
  }
  return call Rt.fExpAt(mknum(src), mknum(i + 1));
}

// Rt.fExpGo: the decimal exponent, read from the SIGN onward (`+` and `-` both
// occur; the digits accumulate left to right).
defun Rt.fExpGo(srcN : val, iN : val, accN : val) -> val {
  word src = payload(srcN, 0);
  word i = payload(iN, 0);
  word c = byteload(src, i);
  if (mkbool(c == 0)) {
    return accN;
  }
  if (mkbool(c == 45)) {
    return mknum(0 - payload(call Rt.fExpGo(mknum(src), mknum(i + 1), accN), 0));
  }
  if (mkbool(c == 43)) {
    return call Rt.fExpGo(mknum(src), mknum(i + 1), accN);
  }
  return call Rt.fExpGo(mknum(src), mknum(i + 1), mknum(payload(accN, 0) * 10 + (c - 48)));
}

// Rt.fDigit: digit k of the rendering.  Digit 0 sits at the rendering's start
// (after the sign), digit k>0 one byte later because of the '.' — so the byte
// offset is k for 0 and k+1 for the rest.
defun Rt.fDigit(srcN : val, idxN : val, negN : val) -> val {
  word idx = payload(idxN, 0);
  word off = payload((idx == 0) ? mknum(0) : mknum(idx + 1), 0);
  return mknum(byteload(payload(srcN, 0), payload(negN, 0) + off));
}

// Rt.fEmitByte: byte j of the DECIMAL EXPANSION — a pure function of j, so the
// writer below needs no state but the scratch's three meta words.  `lead` is
// the number of integer digits (exponent + 1):
//   lead >= p   all-integer: the digits, then zeros out to `lead`
//   0 < lead < p  digits[0..lead] '.' digits[lead..p]
//   lead <= 0    "0." then (-lead) zeros then every digit
defun Rt.fEmitByte(scratchN : val, jN : val) -> val {
  word s = payload(scratchN, 0);
  word j = payload(jN, 0);
  word neg = wload(s, 14);
  word p = wload(s, 15);
  word e = wload(s, 16);
  word lead = e + 1;
  word src = s + 72;
  if (mkbool(neg != 0) && mkbool(j == 0)) {
    return mknum(45);
  }
  word k = j - neg;
  if (mkbool(lead >= p)) {
    if (mkbool(k < p)) {
      return call Rt.fDigit(mknum(src), mknum(k), mknum(neg));
    }
    return mknum(48);
  }
  if (mkbool(lead > 0)) {
    if (mkbool(k < lead)) {
      return call Rt.fDigit(mknum(src), mknum(k), mknum(neg));
    }
    if (mkbool(k == lead)) {
      return mknum(46);
    }
    return call Rt.fDigit(mknum(src), mknum(k - 1), mknum(neg));
  }
  if (mkbool(k == 0)) {
    return mknum(48);
  }
  if (mkbool(k == 1)) {
    return mknum(46);
  }
  if (mkbool(k < 2 + (0 - lead))) {
    return mknum(48);
  }
  return call Rt.fDigit(mknum(src), mknum(k - 2 + lead), mknum(neg));
}

// Rt.fEmit: write the expansion into the scratch's output area, byte by byte,
// and return the byte count — TRUNCATED at the 64-byte bound the goldens pin.
defun Rt.fEmit(scratchN : val, jN : val) -> val {
  word s = payload(scratchN, 0);
  word j = payload(jN, 0);
  word neg = wload(s, 14);
  word p = wload(s, 15);
  word e = wload(s, 16);
  word lead = e + 1;
  word rest = payload((lead > 0) ? mknum(p + 1) : mknum(2 + (0 - lead) + p), 0);
  word totalU = payload((lead >= p) ? mknum(lead) : mknum(rest), 0);
  word total = neg + totalU;
  word bound = payload((total > 64) ? mknum(64) : mknum(total), 0);
  if (mkbool(j >= bound)) {
    return mknum(bound);
  }
  bytestore(s, j, payload(call Rt.fEmitByte(scratchN, mknum(j)), 0));
  return call Rt.fEmit(scratchN, mknum(j + 1));
}

defun Rt.floatText(xN : val) -> val {
  word s = rawcall malloc(136);
  word p = payload(call Rt.fShortest(mknum(s), mknum(1), xN), 0);
  if (mkbool(p == 0)) {
    // NON-FINITE (Rt.fShortest's own test, on the rendering): 'n' is NaN, 'i'
    // is an infinity, and the sign is the rendering's leading '-'.
    word c0 = byteload(s + 72, 0);
    word nneg = payload((c0 == 45) ? mknum(1) : mknum(0), 0);
    word c = payload((c0 == 45) ? mknum(byteload(s + 72, 1)) : mknum(c0), 0);
    rawcall free(s);
    if (mkbool(c == 110)) {
      return "NaN";
    }
    return (nneg != 0) ? "-Infinity" : "Infinity";
  }
  // The sign comes from the RENDERING, not from the bit test: it is what the
  // text carries, and -0.0 must print "-0.0" (float-negZeroInv's sibling).
  word src = s + 72;
  word sneg = payload((byteload(src, 0) == 45) ? mknum(1) : mknum(0), 0);
  word e = payload(call Rt.fExpGo(mknum(src), call Rt.fExpAt(mknum(src), mknum(0)), mknum(0)), 0);
  wstore(s, 14, sneg);
  wstore(s, 15, p);
  wstore(s, 16, e);
  word n = payload(call Rt.fEmit(mknum(s), mknum(0)), 0);
  // THE ".0" RULE: an all-integer expansion carries no '.', and the suffix is
  // written only when the seat's own bound allows it (n + 2 <= 64).  Both
  // bytes are stored unconditionally — past the text they are inside the
  // scratch and unread — and the LENGTH is the conditional value.
  bytestore(s, n, 46);
  bytestore(s, n + 1, 48);
  word lead = e + 1;
  word dot = payload((mkbool(lead >= p) && mkbool(n + 2 <= 64)) ? mknum(n + 2) : mknum(n), 0);
  word out = allocraw(dot);
  call Rt.copyWords(out, s, (dot + 7) / 8);
  rawcall free(s);
  return mkstr(out, dot);
}

// ===== THE PRINTER (ZIGHOST Z4b) =====
// Rt.printValue: the driver's output walk — values.printValue:272-319 (C:
// zincvm.c:383-404), tag for tag, into ONE malloc'd grow-by-doubling buffer
// that is written to stdout in a single call and then newline-terminated.
//
// THE CONTRACT, and why it is byte-exact rather than "close": EVERY golden in
// this repo is the program's printed output, so this walk IS the corpus oracle.
// The shapes, each the reference's:
//   number   the decimal (Rt.numText — the same i64 text primStr printed)
//   string   "…" with the RAW bytes (no escaping — the reference does not escape)
//   symbol   the name, unquoted (a NUL-terminated C string: payload word 0)
//   boolean  true / false
//   cons     [cons CAR . CDR], recursively
//   record   [record v0 v1 …] — POSITIONAL, in canonical (sorted) order
//   nil      []
//   vector   [vector N]
//   stream   [stream in|out]
//   error    [error "message"]
//   prim     [prim name]
//   mark     mark
//   float    Rt.floatText's text (Z4a — the ONE float formatter; this walk
//            does not reimplement it)
//   lambda   REFUSED BY NAME.  The reference prints "[lambda {code} {code_len}
//            env={env} {env_len}]" — two POINTER VALUES in the text, so no
//            golden could pin it and no port could reproduce it.  A program
//            whose printed result is a closure gets a named fatal instead of an
//            address that differs every run.
// Anything else (tag 13, which the collector's own walks also treat as
// unknown) is refused by name too.
//
// THE BUFFER is a {buf, len, cap} state block (malloc'd, 32 bytes) so the walk
// needs no mutable globals: Rt.pvByte/pvN/pvS/pvZ append, Rt.pvNeed doubles
// through Rt.copyWords, and the whole thing is freed after the write.  The walk
// is FRAMED (a val defun): every numText/floatText call is a GC allocation and
// the Value being printed must stay rooted across it.
defun Rt.pvNeed(stN : val, needN : val) -> val {
  word st = payload(stN, 0);
  word len = wload(st, 1);
  word cap = wload(st, 2);
  if (mkbool(len + payload(needN, 0) <= cap)) {
    return mknum(0);
  }
  word nc = payload((cap == 0) ? mknum(256) : mknum(cap * 2), 0);
  word nb = rawcall malloc(nc);
  word old = wload(st, 0);
  call Rt.copyWords(nb, old, (len + 7) / 8);
  val freed = if (old != 0) {
    rawcall free(old);
    return mknil;
  } else {
    return mknil;
  };
  wstore(st, 0, nb);
  wstore(st, 2, nc);
  return call Rt.pvNeed(stN, needN);
}

defun Rt.pvN(stN : val, pN : val, nN : val) -> val {
  word n = payload(nN, 0);
  word grown = payload(call Rt.pvNeed(stN, mknum(n)), 0);
  word st = payload(stN, 0);
  word len = wload(st, 1);
  call Rt.byteCopyGo(mknum(wload(st, 0) + len), mknum(payload(pN, 0)), mknum(n));
  wstore(st, 1, len + n);
  return mknum(0);
}

defun Rt.pvByte(stN : val, cN : val) -> val {
  word grown = payload(call Rt.pvNeed(stN, mknum(1)), 0);
  word st = payload(stN, 0);
  word len = wload(st, 1);
  bytestore(wload(st, 0), len, payload(cN, 0));
  wstore(st, 1, len + 1);
  return mknum(0);
}

// a NUL-terminated C string (a symbol's, a prim's, an error's message, or a
// static piece like "[cons ")
defun Rt.pvZ(stN : val, pN : val) -> val {
  val ln = call Rt.cStrLenGo(mknum(payload(pN, 0)), mknum(0));
  return call Rt.pvN(stN, mknum(payload(pN, 0)), ln);
}

// a Mid string Value's bytes (data at payload word 0, length at word 1's low half)
defun Rt.pvS(stN : val, vN : val) -> val {
  return call Rt.pvN(stN, mknum(payload(vN, 0)), mknum(payload32(vN, 1)));
}

defun Rt.pvRec(stN : val, vN : val, iN : val) -> val {
  word i = payload(iN, 0);
  if (mkbool(i >= reclen(vN))) {
    return mknum(0);
  }
  call Rt.pvByte(stN, mknum(32));
  call Rt.pvV(stN, vecload(payload(vN, 0), i));
  return call Rt.pvRec(stN, vN, mknum(i + 1));
}

defun Rt.pvV(stN : val, vN : val) -> val {
  if (mkbool(tagis(vN, 0))) {
    call Rt.pvS(stN, call Rt.numText(vN));
    return mknum(0);
  }
  if (mkbool(tagis(vN, 1))) {
    call Rt.pvByte(stN, mknum(34));
    call Rt.pvS(stN, vN);
    call Rt.pvByte(stN, mknum(34));
    return mknum(0);
  }
  if (mkbool(tagis(vN, 2))) {
    call Rt.pvZ(stN, mknum(payload(vN, 0)));
    return mknum(0);
  }
  if (mkbool(tagis(vN, 3))) {
    if (mkbool(payload32(vN, 0) != 0)) {
      call Rt.pvZ(stN, mknum(rawstr("true")));
      return mknum(0);
    }
    call Rt.pvZ(stN, mknum(rawstr("false")));
    return mknum(0);
  }
  if (mkbool(tagis(vN, 5))) {
    call Rt.pvZ(stN, mknum(rawstr("[]")));
    return mknum(0);
  }
  if (mkbool(tagis(vN, 4))) {
    call Rt.pvZ(stN, mknum(rawstr("[cons ")));
    call Rt.pvV(stN, vecload(payload(vN, 0), 0));
    call Rt.pvZ(stN, mknum(rawstr(" . ")));
    call Rt.pvV(stN, vecload(payload(vN, 0), 1));
    call Rt.pvZ(stN, mknum(rawstr("]")));
    return mknum(0);
  }
  if (mkbool(tagis(vN, 14))) {
    call Rt.pvZ(stN, mknum(rawstr("[record")));
    call Rt.pvRec(stN, vN, mknum(0));
    call Rt.pvZ(stN, mknum(rawstr("]")));
    return mknum(0);
  }
  if (mkbool(tagis(vN, 10))) {
    call Rt.pvZ(stN, mknum(rawstr("[vector ")));
    call Rt.pvS(stN, call Rt.numText(mknum(payload32(vN, 1))));
    call Rt.pvZ(stN, mknum(rawstr("]")));
    return mknum(0);
  }
  if (mkbool(tagis(vN, 11))) {
    if (mkbool(payload32(vN, 1) != 0)) {
      call Rt.pvZ(stN, mknum(rawstr("[stream in]")));
      return mknum(0);
    }
    call Rt.pvZ(stN, mknum(rawstr("[stream out]")));
    return mknum(0);
  }
  if (mkbool(tagis(vN, 9))) {
    call Rt.pvZ(stN, mknum(rawstr("[error \"")));
    call Rt.pvZ(stN, mknum(payload(vN, 0)));
    call Rt.pvZ(stN, mknum(rawstr("\"]")));
    return mknum(0);
  }
  if (mkbool(tagis(vN, 8))) {
    call Rt.pvZ(stN, mknum(rawstr("[prim ")));
    call Rt.pvZ(stN, mknum(payload(vN, 0)));
    call Rt.pvZ(stN, mknum(rawstr("]")));
    return mknum(0);
  }
  if (mkbool(tagis(vN, 7))) {
    call Rt.pvZ(stN, mknum(rawstr("mark")));
    return mknum(0);
  }
  if (mkbool(tagis(vN, 12))) {
    call Rt.pvS(stN, call Rt.floatText(vN));
    return mknum(0);
  }
  if (mkbool(tagis(vN, 6))) {
    call Rt.die(rawstr("qbe-rt: printValue: a lambda prints as code/env ADDRESSES, refused by name (no golden can pin an address)"));
    return mknum(0);
  }
  call Rt.die(rawstr("qbe-rt: printValue: unknown value tag"));
  return mknum(0);
}

defun Rt.printValue(xN : val) -> val {
  word st = rawcall malloc(32);
  wstore(st, 0, 0);
  wstore(st, 1, 0);
  wstore(st, 2, 0);
  call Rt.pvV(mknum(st), xN);
  rawcall write(1, wload(st, 0), wload(st, 1));
  rawcall write(1, rawstr("\n"), 1);
  word buf = wload(st, 0);
  val freed = if (buf != 0) {
    rawcall free(buf);
    return mknil;
  } else {
    return mknil;
  };
  rawcall free(st);
  // The reference returns 1 after "qbe-rt: print failed" when its ALLOCATING
  // writer fails (an OOM).  Here the buffer is libc malloc, whose failure is a
  // null deref rather than a returnable error, so the failure arm has no
  // reachable input and the code is 0 — stated, not silently dropped.
  return mknum(0);
}

defun Rt.assocGo(k : val, l : val) -> val {
  if (mkbool(tagis(l, 4))) {
    val pair = vecload(payload(l, 0), 0);
    if (mkbool(tagis(pair, 4)) && call Rt.deepEq(k, vecload(payload(pair, 0), 0))) {
      return pair;
    }
    return call Rt.assocGo(k, vecload(payload(l, 0), 1));
  }
  if (mkbool(tagis(l, 5))) {
    return mknil;
  }
  word h = rawcall rt_halt();
  return mknil;
}

defun Rt.recGet(rec : val, field : val) -> val {
  return call Rt.recGetGo(rec, field, mknum(0));
}

defun Rt.recGetGo(rec : val, field : val, i : val) -> val {
  if (mkbool(payload(i, 0) >= reclen(rec))) {
    word h = rawcall rt_halt();
    return mknil;
  }
  val nameSym = vecload(payload(rec, 2), payload(i, 0));
  if (call Rt.symEq(nameSym, field, mknum(0))) {
    return vecload(payload(rec, 0), payload(i, 0));
  }
  return call Rt.recGetGo(rec, field, mknum(payload(i, 0) + 1));
}

defun Rt.recUpd(rec : val, field : val, newv : val) -> val {
  val find = call Rt.recUpdFind(rec, field, mknum(0));
  word nd = allocvec(reclen(rec));
  val ndN = mknum(nd);
  call Rt.recUpdCopy(rec, ndN, mknum(0));
  vecstore(payload(ndN, 0), payload(find, 0), newv);
  return mkval(14, vecaddr(payload(ndN, 0), 0), reclen(rec), payload(rec, 2));
}

defun Rt.recUpdFind(rec : val, field : val, i : val) -> val {
  if (mkbool(payload(i, 0) >= reclen(rec))) {
    return mknum(-1);
  }
  val nameSym = vecload(payload(rec, 2), payload(i, 0));
  if (call Rt.symEq(nameSym, field, mknum(0))) {
    return mknum(payload(i, 0));
  }
  return call Rt.recUpdFind(rec, field, mknum(payload(i, 0) + 1));
}

defun Rt.recUpdCopy(rec : val, newdata : val, i : val) -> val {
  if (mkbool(payload(i, 0) >= reclen(rec))) {
    return mknil;
  }
  vecstore(payload(newdata, 0), payload(i, 0), vecload(payload(rec, 0), payload(i, 0)));
  return call Rt.recUpdCopy(rec, newdata, mknum(payload(i, 0) + 1));
}

defun Rt.recAppendFind(rec : val, field : val, i : val) -> val {
  if (mkbool(payload(i, 0) >= reclen(rec))) {
    return mknum(payload(i, 0));
  }
  val nameSym = vecload(payload(rec, 2), payload(i, 0));
  if (call Rt.symLess(field, nameSym, mknum(0))) {
    return mknum(payload(i, 0));
  }
  return call Rt.recAppendFind(rec, field, mknum(payload(i, 0) + 1));
}

defun Rt.recAppendDataGo(rec : val, newdata : val, packed : val) -> val {
  val j = mknum(payload(packed, 0) & 65535);
  val pos = mknum(payload(packed, 0) >>> 16);
  if (mkbool(payload(j, 0) > reclen(rec))) {
    return mknil;
  }
  val store = mkbool(payload(j, 0) < payload(pos, 0)) ? vecstore(payload(newdata, 0), payload(j, 0), vecload(payload(rec, 0), payload(j, 0))) : (mkbool(payload(j, 0) == payload(pos, 0)) ? mknil : vecstore(payload(newdata, 0), payload(j, 0), vecload(payload(rec, 0), payload(j, 0) - 1)));
  return call Rt.recAppendDataGo(rec, newdata, mknum(payload(packed, 0) + 1));
}

defun Rt.recAppendNamesGo(rec : val, newnames : val, packed : val) -> val {
  val j = mknum(payload(packed, 0) & 65535);
  val pos = mknum(payload(packed, 0) >>> 16);
  if (mkbool(payload(j, 0) > reclen(rec))) {
    return mknil;
  }
  val store = mkbool(payload(j, 0) < payload(pos, 0)) ? vecstore(payload(newnames, 0), payload(j, 0), vecload(payload(rec, 2), payload(j, 0))) : (mkbool(payload(j, 0) == payload(pos, 0)) ? mknil : vecstore(payload(newnames, 0), payload(j, 0), vecload(payload(rec, 2), payload(j, 0) - 1)));
  return call Rt.recAppendNamesGo(rec, newnames, mknum(payload(packed, 0) + 1));
}

defun Rt.recAppend(rec : val, field : val, newv : val) -> val {
  val pos = call Rt.recAppendFind(rec, field, mknum(0));
  word nd = allocvec(reclen(rec) + 1);
  val ndN = mknum(nd);
  word nn = allocvec(reclen(rec) + 1);
  val nnN = mknum(nn);
  val packed = mknum(payload(pos, 0) * 65536);
  call Rt.recAppendDataGo(rec, ndN, packed);
  call Rt.recAppendNamesGo(rec, nnN, packed);
  vecstore(payload(ndN, 0), payload(pos, 0), newv);
  vecstore(payload(nnN, 0), payload(pos, 0), field);
  return mkval(14, vecaddr(payload(ndN, 0), 0), reclen(rec) + 1, vecaddr(payload(nnN, 0), 0));
}

defun Rt.recInsert(rec : val, field : val, newv : val) -> val {
  val find = call Rt.recUpdFind(rec, field, mknum(0));
  if (mkbool(payload(find, 0) >= 0)) {
    return call Rt.recUpd(rec, field, newv);
  }
  return call Rt.recAppend(rec, field, newv);
}

defun Rt.recToChain(rec : val) -> val {
  if (mkbool(tagis(rec, 14))) {
    return call Rt.recToChainGo(rec, mknum(0), mknil);
  }
  return rec;
}

defun Rt.recToChainGo(rec : val, i : val, acc : val) -> val {
  if (mkbool(payload(i, 0) >= reclen(rec))) {
    return acc;
  }
  return call Rt.recToChainGo(rec, mknum(payload(i, 0) + 1), call Rt.cons(call Rt.@p(vecload(payload(rec, 2), payload(i, 0)), vecload(payload(rec, 0), payload(i, 0))), acc));
}

defun Rt.absvector(cnt : val) -> val {
  word vec = allocvec(payload(cnt, 0));
  return mkvec(vec, payload(cnt, 0));
}

defun Rt.address->(vec : val, i : val, x : val) -> val {
  vecstore(payload(vec, 0), payload(i, 0), x);
  return vec;
}

defun Rt.<-address(vec : val, i : val) -> val {
  return vecload(payload(vec, 0), payload(i, 0));
}

defun Rt.assoc(k : val, l : val) -> val {
  return call Rt.assocGo(k, l);
}

defun Rt.snd(x : val) -> val {
  return vecload(payload(x, 0), 1);
}

// ==================== THE STRING-STREAM REGISTRY (O5) ====================
// The C seats rt_ss_in/rt_ss_readbyte/rt_ss_close died here: the registry is
// Mid-owned now — a lazily-malloc'd C-heap table of 8 x (data, len, pos)
// cells hanging off Region slots 38/39, addressed through the same
// *Region view every collector defun uses.  NO MID-HEAP allocation and NO
// safepoint (malloc/free/bytestore only), so the three defuns stay
// FRAME-FREE and a rawcall site is interchangeable with them.
//
// ERROR PARITY (byte-same with the deleted seats): the "too many" arm
// writes the same stderr line and returns -1 (the caller routes -1 to
// rt_halt); the bad-idx arms write their line and return -2 (the caller
// routes -2 to rt_halt).  freeStringStream parity: a close frees the data
// and NULLs the cell's data word, and the COUNT NEVER DECREMENTS — the
// index stays consumed, so a later ssIn lands on the NEXT cell.

// Rt.ssTab: the table address, malloc'd on first use (8 cells x 24 bytes).
defun Rt.ssTab(dummy : val) -> val {
  word glob = rawcall rt_glob_addr();
  word tab = wload(glob, 14);
  if (mkbool(tab != 0)) {
    return mknum(tab);
  }
  word fresh = rawcall malloc(192);
  wstore(glob, 14, fresh);
  return mknum(fresh);
}
// Rt.ssIn: register data[0..len) as a string stream; the stream id is the
// cell index + 1 (0 is reserved so `mkval(11, idx, ...)` is never a null fd).
defun Rt.ssIn(ptrN : val, lenN : val) -> val {
  word glob = rawcall rt_glob_addr();
  word ptr = payload(ptrN, 0);
  word len = payload(lenN, 0);
  word n = wload(glob, 15);
  if (mkbool(n >= 8)) {
    rawcall write(2, rawstr("runtime: too many string streams\n"), 33);
    return mknum(-1);
  }
  word tab = payload(call Rt.ssTab(mknum(0)), 0);
  word data = rawcall malloc(len + 1);
  bytestore(data, payload(lenN, 0), 0);
  val cp = call Rt.ssInGo(ptrN, mknum(data), lenN);
  wstore(tab + n * 24, 0, data);
  wstore(tab + n * 24 + 8, 0, len);
  wstore(tab + n * 24 + 16, 0, 0);
  wstore(glob, 15, n + 1);
  return mknum(n + 1);
}
// Rt.ssInGo: the byte-copy self-tail (the tree's loop idiom — a word
// binder that is the target of an assignment becomes an AUTO-CELL, an
// allocating node, and these defuns must stay FRAME-FREE).  THREE params is
// the lean ABI's entire argument budget (Lower.maxDirectArity), so the walk
// carries its position IN the two pointers and only the remaining count in
// the third: the index this defun used to take is the difference the
// pointers already encode, so it never has to be passed.
defun Rt.ssInGo(ptrN : val, dataN : val, lenN : val) -> val {
  if (mkbool(payload(lenN, 0) <= 0)) {
    return mknil;
  }
  bytestore(payload(dataN, 0), 0, byteload(payload(ptrN, 0), 0));
  return call Rt.ssInGo(mknum(payload(ptrN, 0) + 1), mknum(payload(dataN, 0) + 1), mknum(payload(lenN, 0) - 1));
}

// Rt.ssReadbyte: the string-stream read arm as a word (byte 0..255,
// -1 EOF, -2 bad idx).
defun Rt.ssReadbyte(iN : val) -> val {
  word glob = rawcall rt_glob_addr();
  word idx = payload(iN, 0) - 1;
  if (mkbool(idx < 0) || mkbool(idx >= wload(glob, 15))) {
    rawcall write(2, rawstr("runtime: bad string stream idx\n"), 32);
    return mknum(-2);
  }
  word tab = wload(glob, 14);
  word data = wload(tab + idx * 24, 0);
  if (mkbool(data == 0)) {
    return mknum(-2);
  }
  word len = wload(tab + idx * 24 + 8, 0);
  word pos = wload(tab + idx * 24 + 16, 0);
  if (mkbool(pos >= len)) {
    return mknum(-1);
  }
  word b = byteload(data, pos);
  wstore(tab + idx * 24 + 16, 0, pos + 1);
  return mknum(b);
}
// Rt.ssClose: free the cell's data and NULL it (idempotent; the count
// never decrements — the index stays consumed).
defun Rt.ssClose(iN : val) -> val {
  word glob = rawcall rt_glob_addr();
  word idx = payload(iN, 0) - 1;
  if (mkbool(idx < 0) || mkbool(idx >= wload(glob, 15))) {
    rawcall write(2, rawstr("runtime: bad string stream idx\n"), 32);
    return mknum(-2);
  }
  word tab = wload(glob, 14);
  word cell = tab + idx * 24;
  word data = wload(cell, 0);
  if (mkbool(data != 0)) {
    rawcall free(data);
    wstore(cell, 0, 0);
    return mknum(0);
  }
  return mknum(0);
}

defun Rt.read-byte(stream : val) -> val {
  word isStr = payload(stream, 1) > 1;
  if (mkbool(isStr)) {
    word i = payload(stream, 0);
    word r = payload(call Rt.ssReadbyte(mknum(i)), 0);
    if (mkbool(r == -2)) {
      word h = rawcall rt_halt();
      return mknil;
    }
    return mknum(r);
  } else {
    word fd = payload(stream, 0);
    word bufW = allocraw(1);
    val nVal = call Rt.readFull(mknum(fd), mknum(bufW), mknum(1));
    return mkbool(payload(nVal, 0) == 1) ? mknum(byteload(bufW, 0)) : mknum(-1);
  }
}

defun Rt.open(path : val, dir : val) -> val {
  if (call Rt.=(dir, "in")) {
    word len = len32(path);
    word bufW = allocraw(len + 1);
    val bufN = mknum(bufW);
    call Rt.cStrFill(bufN, path, mknum(0));
    word fd = rawcall openat(-100, bufW, 0, 0);
    if (mkbool(fd < 0)) {
      if (mkbool(byteload(rawcall __errno_location(), 0) == 2)) {
        word idx = payload(call Rt.ssIn(mknum(bufW), mknum(len32(path))), 0);
        if (mkbool(idx < 0)) {
          word h = rawcall rt_halt();
          return mknil;
        }
        return mkval(11, idx, 1 + 4294967296 * 1);
      }
      return false;
    }
    return mkval(11, fd, 1 + 4294967296 * 0);
  } else {
    if (call Rt.=(dir, "out")) {
      word len = len32(path);
      word bufW = allocraw(len + 1);
      val bufN = mknum(bufW);
      call Rt.cStrFill(bufN, path, mknum(0));
      word fd = rawcall openat(-100, bufW, 577, 438);
      return mkbool(fd < 0) ? false : mkval(11, fd, 0 + 4294967296 * 0);
    }
    return mknum(0);
  }
}

// ==================== THE INTERN TABLE (O5 seat 2) =====================
// rt_sym_intern died here: the table is Mid-owned now — a lazily-malloc'd
// array of (name,len) pairs off the GLOBALS BLOCK words 8208..8210 (after the
// frame freelist; NOT collector state, so it stays reachable before a region
// is mapped).  Linear byte-compare walk, NOT the Zig table's DJB2+resize: every
// MEASURED call site is a rawstr LITERAL (16 call sites, 9 distinct names, all
// < 8 bytes — cons/string/isDir/isFile/mode/mtimeMs/name/number/size), so the
// walk is O(144) worst case and the pointer identity the old seat preserved
// (equal literals -> one canonical static) is preserved by the dedup itself.
// NO GC allocation, NO safepoint (malloc + bytestore + byteload only) — the
// defuns stay frame-free.

// Rt.intTab: the table base, lazily malloc'd (4 pairs = 8 words to start).
defun Rt.intTab(dummy : val) -> val {
  word glob = rawcall rt_glob_addr();
  word tab = wload(glob, 8208);
  if (mkbool(tab != 0)) {
    return mknum(tab);
  }
  word fresh = rawcall malloc(64);
  wstore(glob, 8208, fresh);
  wstore(glob, 8209, 0);
  wstore(glob, 8210, 4);
  return mknum(fresh);
}
// Rt.intStrCopy / intPairsCopy: the table's copy self-tails (frame-free).
// THE TERMINATOR IS THE CALLER'S (O5 seat 3, MEASURED): this walk descends
// len-1..0, so a `bytestore(dst, len, 0)` in THIS body runs on the UNWIND and
// zeroes every byte the deeper frames copied — the name came back as its first
// character only (a `(value *argv*)` miss printed `*`).  intInsertAt writes
// dst[len] once, after the copy returns.
defun Rt.intStrCopy(srcN : val, dstN : val, lenN : val) -> val {
  word src = payload(srcN, 0);
  word dst = payload(dstN, 0);
  word len = payload(lenN, 0);
  if (mkbool(len == 0)) {
    return mknil;
  }
  word i = len - 1;
  bytestore(dst, i, byteload(src, i));
  call Rt.intStrCopy(mknum(src), mknum(dst), mknum(i));
  return mknil;
}
defun Rt.intPairsCopy(freshN : val, nN : val, iN : val) -> val {
  word glob = rawcall rt_glob_addr();
  word old = wload(glob, 8208);
  word fresh = payload(freshN, 0);
  if (mkbool(payload(iN, 0) >= payload(nN, 0))) {
    return mknil;
  }
  wstore(fresh + payload(iN, 0) * 16, 0, wload(old + payload(iN, 0) * 16, 0));
  wstore(fresh + payload(iN, 0) * 16 + 8, 0, wload(old + payload(iN, 0) * 16 + 8, 0));
  return call Rt.intPairsCopy(mknum(fresh), mknum(payload(nN, 0)), mknum(payload(iN, 0) + 1));
}

// Rt.intGrow: double the table (a fresh malloc'd array of cap*32 bytes),
// copy the n live pairs in, free the old base, and return the new base.
// A helper because the caller's growth `if` must rebind `tab` — a
// both-falling mid-block if is unrepresentable and the rebased word must
// travel as the helper's RETURN.
defun Rt.intGrow(nN : val) -> val {
  word glob = rawcall rt_glob_addr();
  word tab = wload(glob, 8208);
  word cap = wload(glob, 8210);
  word fresh = rawcall malloc(cap * 32);
  val cp = call Rt.intPairsCopy(mknum(fresh), mknum(payload(nN, 0)), mknum(0));
  rawcall free(tab);
  wstore(glob, 8210, cap * 2);
  return mknum(fresh);
}

// Rt.intFindGo: the linear walk's self-tail. At each i: the pair (cand,
// candLen); a length mismatch is a miss, a match runs the byte compare. The
// byte compare's RESULT gates the recursion — a hit returns the canonical
// pointer, a miss continues the walk at i+1.
// (tabN dropped — the lean ABI passes 1..3 pointer args; the base is read
// from the glob word 8208, which is what the arg would have carried anyway)
defun Rt.intFindGo(nameN : val, lenN : val, iN : val) -> val {
  word glob = rawcall rt_glob_addr();
  word tab = wload(glob, 8208);
  word name = payload(nameN, 0);
  word len = payload(lenN, 0);
  word i = payload(iN, 0);
  word n = wload(glob, 8209);
  if (mkbool(i >= n)) {
    return mknum(0);
  }
  word cand = wload(tab + i * 16, 0);
  word candLen = wload(tab + i * 16 + 8, 0);
  if (mkbool(candLen != len)) {
    return call Rt.intFindGo(mknum(name), mknum(len), mknum(i + 1));
  }
  word eq = payload(call Rt.intBytesEq(mknum(cand), mknum(name), mknum(len)), 0);
  if (mkbool(eq == 1)) {
    return mknum(cand);
  }
  return call Rt.intFindGo(mknum(name), mknum(len), mknum(i + 1));
}
// Rt.intBytesEq: byte-compare self-tail -> 1/0 (frame-free).
defun Rt.intBytesEq(aN : val, bN : val, lenN : val) -> val {
  word a = payload(aN, 0);
  word b = payload(bN, 0);
  word len = payload(lenN, 0);
  if (mkbool(len == 0)) {
    return mknum(1);
  }
  word i = len - 1;
  if (mkbool(byteload(a, i) != byteload(b, i))) {
    return mknum(0);
  }
  return call Rt.intBytesEq(mknum(a), mknum(b), mknum(i));
}

// Rt.intInsert: the insert half, its own defun because a both-falling
// mid-block if is unrepresentable (Mid has no join): grow at the cap (the
// rebind is the growth helper's RETURN), then NUL-terminated copy into a
// fresh pair.  The pairs' strings are MALLOC'd (immortal — the old table's
// page-alloc strdup parity); nothing here allocates on the GC heap.
defun Rt.intInsert(dataPtrN : val, lenN : val) -> val {
  word glob = rawcall rt_glob_addr();
  word dataPtr = payload(dataPtrN, 0);
  word len = payload(lenN, 0);
  word tab = wload(glob, 8208);
  word n = wload(glob, 8209);
  if (mkbool(n >= wload(glob, 8210))) {
    return call Rt.intInsertGo(mknum(n), mknum(dataPtr), mknum(len));
  }
  return call Rt.intInsertAt(mknum(n), mknum(dataPtr), mknum(len));
}
// the growth arm: Rt.intGrow returns the NEW base, then the insert runs on it
defun Rt.intInsertGo(nN : val, dataPtrN : val, lenN : val) -> val {
  word glob = rawcall rt_glob_addr();
  word fresh = payload(call Rt.intGrow(mknum(payload(nN, 0))), 0);
  wstore(glob, 8208, fresh);
  return call Rt.intInsertAt(mknum(payload(nN, 0)), mknum(payload(dataPtrN, 0)), mknum(payload(lenN, 0)));
}
// the insert itself: NUL-terminated copy into a fresh (name,len) pair
defun Rt.intInsertAt(nN : val, dataPtrN : val, lenN : val) -> val {
  word glob = rawcall rt_glob_addr();
  word tab = wload(glob, 8208);
  word n = payload(nN, 0);
  word dataPtr = payload(dataPtrN, 0);
  word len = payload(lenN, 0);
  word store = rawcall malloc(len + 1);
  val sc = call Rt.intStrCopy(mknum(dataPtr), mknum(store), mknum(len));
  bytestore(store, len, 0);
  wstore(tab + n * 16, 0, store);
  wstore(tab + n * 16 + 8, 0, len);
  wstore(glob, 8209, n + 1);
  return mkval(2, store);
}

defun Rt.intern(str : val) -> val {
  word dataPtr = payload(str, 0);
  word len = len32(str);
  val tabN = call Rt.intTab(mknum(0));
  word tab = payload(tabN, 0);
  // find-or-insert: the walk first (a hit returns the CANONICAL pointer —
  // equal literals intern to one static, the pointer identity the old seat
  // preserved); a miss falls to the INSERT defun above (a both-falling
  // mid-block if is unrepresentable — Mid has no join).
  val found = call Rt.intFindGo(mknum(dataPtr), mknum(len), mknum(0));
  word hit = payload(found, 0);
  if (mkbool(hit != 0)) {
    return mkval(2, hit);
  }
  return call Rt.intInsert(mknum(dataPtr), mknum(len));
}

// ==================== THE VALUES TABLE (O5 seat 3) =====================
// rt_value_slot died here, and so did the Zig half of the table (ZIGHOST Z5
// deleted rt_boot AND the Vm).  The table ITSELF is 256 {name, value} entries
// (48 bytes each: the name pointer at +0, the 40-byte Value at +8) and it is
// MID'S: `Rt.boot` (called from Rt.main) mallocs the 12288 bytes, zeroes them,
// stores the base in the GLOBALS BLOCK at word 3 (RtGc.elm's layout table; the
// same rule the intern table follows: rt_glob_addr is emitted unconditionally
// and the block is .bss, so the word is readable before a region is mapped)
// and installs the three standard streams through `Rt.valSlot`;
// `Rt.argvInstall` writes the *argv* entry into the same table.  No other
// seat publishes it, and the two collector walkers (`Rt.gcMarkValuesTab`,
// `Rt.gcScavValuesTab`) read the word straight out of the block — the table
// needs no separate registration call.  Word 3 because
// word 1 is the frame machinery's CURRENT-FRAME pointer (frame-enter/leave
// `wstore(glob, 1, hdr)`) — a value parked there dies at the next frame push.
//
// A LINEAR 256-SLOT SCAN, not the Zig table's FNV-1a probe chain: the table
// holds at most the four host-installed names, and a full walk is a SUPERSET of
// the chain (names are unique, so it finds the same entry) — the hash is an
// optimisation, not semantics, exactly the call the intern table's walk made.
// The byte compare reuses the EXISTING Rt.cStrLenGo/Rt.intBytesEq self-tails
// (equal length, then a downward compare), so no new compare defun is needed.
// NO GC allocation, NO safepoint: this defun and its walk are frame-free, which
// is what keeps `Rt.value` out of the `allocating` set.
defun Rt.valScanGo(tabN : val, nameN : val, iN : val) -> val {
  if (mkbool(payload(iN, 0) >= 256)) {
    return mknum(0);
  }
  word e = payload(tabN, 0) + payload(iN, 0) * 48;
  word nm = wload(e, 0);
  if (mkbool(nm == 0)) {
    recur(tabN, nameN, mknum(payload(iN, 0) + 1));
  }
  word nmLen = payload(call Rt.cStrLenGo(mknum(nm), mknum(0)), 0);
  if (mkbool(nmLen != payload(call Rt.cStrLenGo(nameN, mknum(0)), 0))) {
    recur(tabN, nameN, mknum(payload(iN, 0) + 1));
  }
  if (mkbool(payload(call Rt.intBytesEq(mknum(nm), nameN, mknum(nmLen)), 0) == 1)) {
    return mknum(e + 8);
  }
  recur(tabN, nameN, mknum(payload(iN, 0) + 1));
}

// Rt.value: the `value` prim — `(value X)`, and the argvPrim thunk's
// `(value *argv*)`.  A hit returns the table's Value; a miss returns the
// interned SYMBOL, which is the deleted seat's valSymbol fallback in Mid's own
// interner (the length comes from a cStr walk because the seat's input is a
// NUL-terminated name, not a (data,len) string).
defun Rt.value(sym : val) -> val {
  word tab = wload(rawcall rt_glob_addr(), 3);
  word slot = payload(call Rt.valScanGo(mknum(tab), mknum(payload(sym, 0)), mknum(0)), 0);
  if (mkbool(slot != 0)) {
    return vecload(slot, 0);
  }
  val n = call Rt.cStrLenGo(mknum(payload(sym, 0)), mknum(0));
  return call Rt.intern(mkstr(payload(sym, 0), payload(n, 0)));
}

// ============== THE ENTRY-ARG PARSER (O5 seat 4b) =====================
// rt_parse_arg died here.  The DRIVER CONTRACT it carried (qbe-check.sh's
// err-badarg-int / err-badarg-float / float-arg rows) is now Mid's:
//
//   * the HEURISTIC is verbatim the retired rt.zig isFloatArg — an arg takes
//     the float path iff it contains '.'/'e'/'E' or is exactly one of
//     NaN/Infinity/-Infinity.  Everything else is the int path, so the former
//     VM reference and the native driver accept the same command line.
//   * the FLOAT CONVERSION is libc's `strtod`, not a hand-rolled decimal
//     parser: it is CORRECTLY ROUNDED, i.e. it returns the same double
//     std.fmt.parseFloat did for every input (correct rounding is unique), so
//     moving the seat cannot move a float-arg golden.  `strtod` was already a
//     `rawcallArity` row with no call site (plan §8 item 5); the declaration
//     below is its first site, and R-08 (no symbol in both tables) is why the
//     row is deleted in Mid/RtLang/Ast.elm.
//   * the ENDPOINTER is the strictness check std.fmt.parseFloat had: the call
//     consumed the whole string iff *endptr == 0, so `2.5.3` is a REFUSAL (the
//     pinned err-badarg-float golden) rather than a silent 2.5.  It also
//     rejects an empty conversion (endptr == arg), which is what makes a lone
//     "-" or "" an error instead of a zero.
//   * the INT CONVERSION is `strtoll` (base 10) with an ERANGE test: parseInt
//     errored on overflow, strtoll SATURATES and sets errno, so the refusal is
//     recovered from errno rather than from a hand-rolled digit walk.  A walk
//     was the first draft and it is not spellable here: the boundary constant
//     922337203685477580 is above 2^53, and this frontend refuses an integer
//     literal it cannot hold exactly (MEASURED: `err malformed number
//     literal`), so the overflow test would have to be built out of wrapping
//     arithmetic — a correctness hazard for no gain.
//   * both refusals print the SAME bytes the seat printed, through the same
//     write(2, prefix)/write(2, arg)/write(2, suffix) shape Rt.main's
//     qbe_meta error already uses.
// NO GC allocation, NO safepoint in any of these defuns (malloc + byte/word
// stores only), so they stay FRAME-FREE — which is why Rt.parseArg can be
// called with the unrooted raw abuf pointer in hand.
defun Rt.argHasFloatCh(aN : val, iN : val) -> val {
  word c = byteload(payload(aN, 0), payload(iN, 0));
  if (mkbool(c == 0)) {
    return mkbool(0);
  }
  if (mkbool(c == 46)) {
    return mkbool(1);
  }
  if (mkbool(c == 101)) {
    return mkbool(1);
  }
  if (mkbool(c == 69)) {
    return mkbool(1);
  }
  recur(aN, mknum(payload(iN, 0) + 1));
}

// The heuristic, VERBATIM the retired rt.zig isFloatArg: '.'/'e'/'E' anywhere,
// or exactly one of the three canonical non-finite tokens.  `cStrEq` is the
// existing word-ABI compare; the val wrapper is this file's mknum idiom (a
// defun whose signature mixes a `word` parameter with a `val` result is not
// spellable here — MEASURED: the word param is read as a VALUE and the lowerer
// refuses it).
defun Rt.argIsFloat(aN : val) -> val {
  word a = payload(aN, 0);
  word nan = call Rt.cStrEq(a, rawstr("NaN"));
  word inf = call Rt.cStrEq(a, rawstr("Infinity"));
  word ninf = call Rt.cStrEq(a, rawstr("-Infinity"));
  val has = call Rt.argHasFloatCh(aN, mknum(0));
  return mkbool(nan != 0) || mkbool(inf != 0) || mkbool(ninf != 0) || mkbool(payload32(has, 0) != 0);
}

// A LEADING WHITESPACE reject, because BOTH libc scanners skip it and
// `std.fmt.parseInt`/`parseFloat` do not: without this, " 5" would be accepted
// as 5 here and refused by the retired seat.
defun Rt.argWs(aN : val) -> val {
  word c = byteload(payload(aN, 0), 0);
  return mkbool(c == 32) || mkbool(c == 9) || mkbool(c == 10) || mkbool(c == 11) || mkbool(c == 12) || mkbool(c == 13);
}

// The refusal line, in the same three-write shape Rt.main's qbe_meta error
// uses.  TWO entry points rather than a `kind` selector: a word ternary is a
// VALUE position, and this DSL refuses a word binder read there (MEASURED:
// `err qbe: raw word binder read in a VALUE position`), so the suffix is a
// literal argument of each arm instead.
defun Rt.argErrGo(aN : val, sufN : val) -> val {
  word a = payload(aN, 0);
  word suf = payload(sufN, 0);
  word pre = rawstr("qbe-rt: entry arg '");
  val plen = call Rt.cStrLenGo(mknum(pre), mknum(0));
  rawcall write(2, pre, payload(plen, 0));
  val alen = call Rt.cStrLenGo(aN, mknum(0));
  rawcall write(2, a, payload(alen, 0));
  val slen = call Rt.cStrLenGo(sufN, mknum(0));
  rawcall write(2, suf, payload(slen, 0));
  return mknil;
}

defun Rt.argErrFloat(aN : val) -> val {
  return call Rt.argErrGo(aN, mknum(rawstr("' is not a float\n")));
}

defun Rt.argErrInt(aN : val) -> val {
  return call Rt.argErrGo(aN, mknum(rawstr("' is not an int (qbe slice)\n")));
}

// Rt.parseArg: ONE entry argument -> the Value the entry is called with,
// written into the 40-byte slot at `dst` (the caller's abuf entry) with the
// raw `vecstore` node.  Returns mknum(0) on success, mknum(2) after the
// refusal line — the exit code stays the driver's (Rt.parseArgsGo's rc),
// exactly as the seat had it.
//
// THE ENDPOINTER IS THE STRICTNESS: the scan consumed the whole argument iff
// *endptr == 0 and endptr != a.  That is what makes `2.5.3` a REFUSAL (the
// pinned err-badarg-float golden) instead of a silent 2.5, and `abc`/`-`/``
// refusals instead of zeros.
defun Rt.parseArg(dstN : val, argN : val) -> val {
  word dst = payload(dstN, 0);
  word a = payload(argN, 0);
  val ws = call Rt.argWs(argN);
  if (mkbool(payload32(ws, 0) != 0)) {
    call Rt.argErrInt(argN);
    return mknum(2);
  }
  word ep = rawcall malloc(8);
  wstore(ep, 0, 0);
  val isn = call Rt.argIsFloat(argN);
  if (mkbool(payload32(isn, 0) != 0)) {
    val fv = mkflt(rawcall strtod(a, ep));
    word endW = wload(ep, 0);
    rawcall free(ep);
    if (mkbool(endW != a) && mkbool(byteload(endW, 0) == 0)) {
      vecstore(dst, 0, fv);
      return mknum(0);
    }
    call Rt.argErrFloat(argN);
    return mknum(2);
  }
  rawcall memset(rawcall __errno_location(), 0, 4);
  word n = rawcall strtoll(a, ep, 10);
  word endN = wload(ep, 0);
  word err = byteload(rawcall __errno_location(), 0);
  rawcall free(ep);
  if (mkbool(err == 34) || mkbool(endN == a) || mkbool(byteload(endN, 0) != 0)) {
    call Rt.argErrInt(argN);
    return mknum(2);
  }
  vecstore(dst, 0, mknum(n));
  return mknum(0);
}

// ============== THE *argv* PSEUDO-GLOBAL (O5 seat 4b) ==================
// rt_argv_install died here.  AOTRUN_ARGV's *argv* is a plain cons LIST of
// strings (run.js's argv[2:] shape), built BACK-TO-FRONT so the list comes out
// in argv order, and stored into the host's values table — the table Mid
// already reads (Rt.value), written through the same entry layout
// (name at +0, the 40-byte Value at +8).
//
// THE ACCUMULATOR IS ROOTED ACROSS EVERY ALLOCATION, and that is the gcf1 FIX
// this seat had to carry, not decoration: the retired driver rooted only from
// inside valCons, so the accumulator was UNROOTED at the moment the STRING's
// allocation ran — a nursery scavenge there reclaims the whole tail built so
// far and *argv* comes back as garbage (MEASURED pre-fix, 60k args:
// `[GC NURSERY #1 ...] non-exhaustive case`).  HERE THE ROOT IS A C-HEAP
// 40-BYTE VALUE SLOT (`acc`), filled with nil and registered with
// Rt.rootPushValue BEFORE the first allocation; the loop only ever MOVES the
// accumulator BY WRITING THAT SLOT, so the rooted address always holds the
// current tail (the Zig's `rootValue(&acc)` — a rooted SLOT, not a rooted
// copy, because a copy would not see the rebind).  Rt.rootPop after the list
// is in the table, which is itself a registered root.
defun Rt.argvGo(blkN : val, iN : val) -> val {
  word blk = payload(blkN, 0);
  word i = payload(iN, 0);
  if (mkbool(i == 0)) {
    return mknil;
  }
  word j = i - 1;
  word raw = wload(wload(blk, 0), 2 + j);
  if (mkbool(raw == 0)) {
    word zero = rawcall malloc(1);
    bytestore(zero, 0, 0);
    call Rt.argvPush(blkN, mknum(zero));
    recur(blkN, mknum(j));
  }
  call Rt.argvPush(blkN, mknum(raw));
  recur(blkN, mknum(j));
}

// ONE argument -> one string cell prepended to the rooted accumulator.  The
// cons is written back INTO the rooted slot (vecstore(acc, 0, cons(s, load))),
// so the tail is live across the string's allocation and the cell's own.
defun Rt.argvPush(blkN : val, cstrN : val) -> val {
  word blk = payload(blkN, 0);
  word cstr = payload(cstrN, 0);
  val len = call Rt.cStrLenGo(mknum(cstr), mknum(0));
  word n = payload(len, 0);
  word buf = allocraw(n + 1);
  call Rt.cStrCopyGo(mknum(cstr), mknum(buf), mknum(0));
  val s = mkstr(buf, n);
  word acc = wload(blk, 1);
  vecstore(acc, 0, call Rt.cons(s, vecload(acc, 0)));
  return mknil;
}

// Rt.valEntry: the values-table entry for `name`, INSERTING the name into the
// first free entry when the table does not have it — that is the half of the
// deleted seat's `valueSet` the lookup side (Rt.valScanGo) never needed, and
// the reason *argv* cannot be written through Rt.value.  Returns the entry's
// Value address (e + 8), never 0: the table has 256 slots and at most four
// host-installed names.
defun Rt.valFreeGo(tabN : val, iN : val) -> val {
  if (mkbool(payload(iN, 0) >= 256)) {
    return mknum(0);
  }
  word e = payload(tabN, 0) + payload(iN, 0) * 48;
  if (mkbool(wload(e, 0) == 0)) {
    return mknum(e + 8);
  }
  recur(tabN, mknum(payload(iN, 0) + 1));
}

defun Rt.valEntry(tabN : val, nameN : val) -> val {
  val hit = call Rt.valScanGo(tabN, nameN, mknum(0));
  if (mkbool(payload(hit, 0) != 0)) {
    return hit;
  }
  word free = payload(call Rt.valFreeGo(tabN, mknum(0)), 0);
  wstore(free - 8, 0, payload(nameN, 0));
  return mknum(free);
}

defun Rt.argvInstall(modeN : val, nargsN : val, argvN : val) -> val {
  word mode = payload(modeN, 0);
  word tab = wload(rawcall rt_glob_addr(), 3);
  word ent = payload(call Rt.valEntry(mknum(tab), mknum(rawstr("*argv*"))), 0);
  if (mkbool(mode == 0)) {
    vecstore(ent, 0, mknil);
    return mknil;
  }
  word blk = rawcall malloc(24);
  word acc = rawcall malloc(40);
  vecstore(acc, 0, mknil);
  call Rt.rootPushValue(acc);
  wstore(blk, 0, payload(argvN, 0));
  wstore(blk, 1, acc);
  wstore(blk, 2, payload(nargsN, 0));
  call Rt.argvGo(mknum(blk), mknum(payload(nargsN, 0)));
  vecstore(ent, 0, vecload(acc, 0));
  call Rt.rootPop();
  return mknil;
}

// ===== THE BOOT (ZIGHOST Z5) =====
// Rt.boot: everything the driver must do before any generated code runs, now
// that the Zig host is gone from the route.  It is SMALL because the five
// services rt_boot used to provide have all moved to Mid in this arc:
//   * the heap knob        -> Rt.gcInit reads QBE_HEAP_MB itself (Z4a)
//   * the root registry    -> glob words 4/5/6 (Z1)
//   * the write barrier    -> Rt.vecStorePlain/Young (Z2)
//   * the closure cache    -> Rt.globalClosure (Z3)
//   * the float text       -> Rt.floatText (Z4a); the printer -> Rt.printValue (Z4b)
// What is LEFT is the VALUES TABLE and the three standard streams, and neither
// needs a Zig struct: the table is 256 x 48 bytes of C-heap memory that Mid
// mallocs, zeroes and publishes into globals word 3 (the word the Z1 walkers
// and Rt.value already read), and a stream is a tag-11 Value whose payload
// words are the fd and (is_input + is_string<<32) — the exact shape
// values.valStreamIn/Out build, written with raw stores.
//
// WHY NOT "Mid allocates storage for a Zig Gc/Vm": that shape needs a size
// export, an init seat and a deinit seat (>= 3 new Zig exports), keeps all
// 3,280 lines of gc/* alive, and moves no line of work — the O5 finding that
// refused the same shape for rt_boot.  Here the Gc and Vm are simply NEVER
// CONSTRUCTED: nothing on this route reads them (the six object-layer seats
// that do have no caller left — the census pins 0 emitted calls), which is
// what makes Z6's deletion act a deletion and not a re-homing.
//
// THE TABLE'S LIFETIME: malloc'd once, never freed — the same lifetime the Vm
// gave it (its deinit defer died with the Zig main at B4), and the entries are
// walked by Rt.gcMarkValuesTab on every collect.
defun Rt.valSlot(tabN : val, nameN : val) -> val {
  // The entry a name would occupy: Rt.valFreeGo's first free slot (the table
  // is zeroed, and only three names are ever installed, so it never fills).
  // It returns the VALUE's address (e + 8); the name goes one word earlier.
  word free = payload(call Rt.valFreeGo(tabN, mknum(0)), 0);
  wstore(free - 8, 0, payload(nameN, 0));
  return mknum(free - 8);
}

defun Rt.boot(dummy : val) -> val {
  word tab = rawcall malloc(12288);
  rawcall memset(tab, 0, 12288);
  wstore(rawcall rt_glob_addr(), 3, tab);
  // An entry is {char *name; Value value} — 48 bytes: the name word, then the
  // 40-byte Value at +8 (tag at +8, payload word k at +16 + 8k).
  word e1 = payload(call Rt.valSlot(mknum(tab), mknum(rawstr("*stinput*"))), 0);
  wstore(e1 + 8, 0, 11);
  wstore(e1 + 8, 1, 0);
  wstore(e1 + 8, 2, 1);
  word e2 = payload(call Rt.valSlot(mknum(tab), mknum(rawstr("*stoutput*"))), 0);
  wstore(e2 + 8, 0, 11);
  wstore(e2 + 8, 1, 1);
  wstore(e2 + 8, 2, 0);
  word e3 = payload(call Rt.valSlot(mknum(tab), mknum(rawstr("*sterror*"))), 0);
  wstore(e3 + 8, 0, 11);
  wstore(e3 + 8, 1, 2);
  wstore(e3 + 8, 2, 0);
  return mknum(0);
}

defun Rt.str(x : val) -> val {
  if (mkbool(tagis(x, 12))) {
    return call Rt.floatText(x);
  }
  if (mkbool(tagis(x, 0))) {
    return call Rt.numText(x);
  }
  word h = rawcall rt_halt();
  return mknil;
}

defun Rt.getcwd(dummy : val) -> val {
  word bufW = allocraw(4096);
  word r = rawcall getcwd(bufW, 4096);
  if (mkbool(r == 0)) {
    return "";
  }
  val len = call Rt.cStrLenGo(mknum(bufW), mknum(0));
  return mkstr(bufW, payload(len, 0));
}

defun Rt.cd(path : val) -> val {
  word len = len32(path);
  word bufW = allocraw(len + 1);
  val bufN = mknum(bufW);
  call Rt.cStrFill(bufN, path, mknum(0));
  word rc = rawcall chdir(bufW);
  return mkbool(rc == 0);
}

defun Rt.getenv(name : val) -> val {
  word len = len32(name);
  word bufW = allocraw(len + 1);
  val bufN = mknum(bufW);
  call Rt.cStrFill(bufN, name, mknum(0));
  word r = rawcall getenv(bufW);
  if (mkbool(r == 0)) {
    return "";
  }
  val len2 = call Rt.cStrLenGo(mknum(r), mknum(0));
  word dstW = allocraw(payload(len2, 0) + 1);
  val dstN = mknum(dstW);
  call Rt.cStrCopyGo(mknum(r), dstN, mknum(0));
  return mkstr(dstW, payload(len2, 0));
}

defun Rt.setenv(name : val, value : val) -> val {
  word nameLen = len32(name);
  word valueLen = len32(value);
  word bufW = allocraw(nameLen + valueLen + 2);
  val bufN = mknum(bufW);
  call Rt.cStrFill(bufN, name, mknum(0));
  word valPtrW = bufW + (nameLen + 1);
  val valPtrN = mknum(valPtrW);
  call Rt.cStrFill(valPtrN, value, mknum(0));
  rawcall setenv(bufW, valPtrW, 1);
  return true;
}

defun Rt.globLastSlash(ptrN : val, iN : val) -> val {
  if (mkbool(payload(iN, 0) < 0)) {
    return mknum(-1);
  }
  word byte = byteload(payload(ptrN, 0), payload(iN, 0));
  if (mkbool(byte == 47)) {
    return mknum(payload(iN, 0));
  }
  recur(ptrN, mknum(payload(iN, 0) - 1));
}

defun Rt.globIsDot(ptrN : val) -> val {
  word c0 = byteload(payload(ptrN, 0), 0);
  word c1 = byteload(payload(ptrN, 0), 1);
  return mkbool(c0 == 46) && mkbool(c1 == 0);
}

defun Rt.globIsDotDot(ptrN : val) -> val {
  word c0 = byteload(payload(ptrN, 0), 0);
  word c1 = byteload(payload(ptrN, 0), 1);
  word c2 = byteload(payload(ptrN, 0), 2);
  return mkbool(c0 == 46) && (mkbool(c1 == 46) && mkbool(c2 == 0));
}

defun Rt.globScanGo(stateN : val) -> val {
  word dW = wload(payload(stateN, 0), 0);
  word baseW = wload(payload(stateN, 0), 1);
  word tblW = wload(payload(stateN, 0), 2);
  word guardW = wload(payload(stateN, 0), 3);
  word nW = wload(payload(stateN, 0), 4);
  if (mkbool(nW >= 1024)) {
    return mknum(nW);
  }
  word entW = rawcall readdir(dW);
  if (mkbool(entW == 0)) {
    return mknum(nW);
  }
  word nameW = entW + 19;
  word fmW = rawcall fnmatch(baseW, nameW, 0);
  if (mkbool(fmW != 0)) {
    recur(stateN);
  }
  val nameDot = call Rt.globIsDot(mknum(nameW));
  val nameDD = call Rt.globIsDotDot(mknum(nameW));
  if ((nameDot || nameDD) && mkbool(guardW != 0)) {
    recur(stateN);
  }
  val lenN = call Rt.cStrLenGo(mknum(nameW), mknum(0));
  word pW = rawcall malloc(payload(lenN, 0) + 1);
  val _u1 = if (mkbool(pW == 0)) {
    word h = rawcall rt_halt();
    return mknil;
  } else {
    return mknum(0);
  };
  call Rt.cStrCopyGo(mknum(nameW), mknum(pW), mknum(0));
  wstore(tblW, nW, pW);
  wstore(payload(stateN, 0), 4, nW + 1);
  recur(stateN);
}

defun Rt.globStrLess(aN : val, bN : val, iN : val) -> val {
  word ca = byteload(payload(aN, 0), payload(iN, 0));
  word cb = byteload(payload(bN, 0), payload(iN, 0));
  if (mkbool(ca < cb)) {
    return true;
  }
  if (mkbool(ca > cb)) {
    return false;
  }
  if (mkbool(ca == 0)) {
    return false;
  }
  recur(aN, bN, mknum(payload(iN, 0) + 1));
}

defun Rt.globSortShift(tblN : val, jN : val, keyN : val) -> val {
  if (mkbool(payload(jN, 0) < 0)) {
    return mknum(payload(jN, 0));
  }
  word curW = wload(payload(tblN, 0), payload(jN, 0));
  val lessB = call Rt.globStrLess(keyN, mknum(curW), mknum(0));
  if (lessB) {
    wstore(payload(tblN, 0), payload(jN, 0) + 1, curW);
    recur(tblN, mknum(payload(jN, 0) - 1), keyN);
  }
  return mknum(payload(jN, 0));
}

defun Rt.globSortGo(tblN : val, iN : val, nN : val) -> val {
  if (mkbool(payload(iN, 0) >= payload(nN, 0))) {
    return mknum(payload(nN, 0));
  }
  word keyW = wload(payload(tblN, 0), payload(iN, 0));
  val jN = call Rt.globSortShift(tblN, mknum(payload(iN, 0) - 1), mknum(keyW));
  wstore(payload(tblN, 0), payload(jN, 0) + 1, keyW);
  recur(tblN, mknum(payload(iN, 0) + 1), nN);
}

defun Rt.globBuildGo(tblN : val, iN : val, acc : val) -> val {
  if (mkbool(payload(iN, 0) < 0)) {
    return acc;
  }
  word pW = wload(payload(tblN, 0), payload(iN, 0));
  val lenN = call Rt.cStrLenGo(mknum(pW), mknum(0));
  word bufW = allocraw(payload(lenN, 0) + 1);
  call Rt.cStrCopyGo(mknum(pW), mknum(bufW), mknum(0));
  rawcall free(pW);
  recur(tblN, mknum(payload(iN, 0) - 1), call Rt.cons(call Rt.intern("cons"), call Rt.cons(call Rt.cons(call Rt.intern("string"), call Rt.cons(mkstr(bufW, payload(lenN, 0)), mknil)), call Rt.cons(acc, mknil))));
}

defun Rt.glob(pattern : val) -> val {
  word len = len32(pattern);
  word patW = allocraw(len + 1);
  val patN = mknum(patW);
  call Rt.cStrFill(patN, pattern, mknum(0));
  val siN = call Rt.globLastSlash(mknum(patW), mknum(len32(pattern) - 1));
  word cbufW = rawcall malloc(8240);
  val _u2 = if (mkbool(cbufW == 0)) {
    word h = rawcall rt_halt();
    return mknil;
  } else {
    return mknum(0);
  };
  bytestore(cbufW, 0, 46);
  bytestore(cbufW, 1, 0);
  bytestore(cbufW, 2, 46);
  bytestore(cbufW, 3, 46);
  bytestore(cbufW, 4, 0);
  word tblW = cbufW + 8;
  word stateW = cbufW + 8200;
  val hasS = mkbool(payload(siN, 0) >= 0);
  val dirN = hasS ? mknum(patW) : mknum(cbufW);
  val baseN = hasS ? mknum(patW + (payload(siN, 0) + 1)) : mknum(patW);
  val _u3 = if (hasS) {
    bytestore(patW, payload(siN, 0), 0);
    return mknum(0);
  } else {
    return mknum(0);
  };
  word dW = rawcall opendir(payload(dirN, 0));
  if (mkbool(dW == 0)) {
    word fN = rawcall free(cbufW);
    return mknil;
  } else {
    val baseDot = mkbool(rawcall fnmatch(payload(baseN, 0), cbufW, 0) == 0);
    val baseDD = mkbool(rawcall fnmatch(payload(baseN, 0), cbufW + 2, 0) == 0);
    wstore(stateW, 0, dW);
    wstore(stateW, 1, payload(baseN, 0));
    wstore(stateW, 2, tblW);
    wstore(stateW, 3, payload((baseDot || baseDD) ? mknum(0) : mknum(1), 0));
    wstore(stateW, 4, 0);
    val nN = call Rt.globScanGo(mknum(stateW));
    rawcall closedir(dW);
    call Rt.globSortGo(mknum(tblW), mknum(1), nN);
    val res = call Rt.globBuildGo(mknum(tblW), mknum(payload(nN, 0) - 1), call Rt.cons(call Rt.intern("cons"), mknil));
    rawcall free(cbufW);
    return res;
  }
}

defun Rt.epSymIs(sym : val, litN : val, i : val) -> val {
  word la = strbyte(sym, payload(i, 0));
  word lb = byteload(payload(litN, 0), payload(i, 0));
  if (mkbool(lb == 0)) {
    return mkbool(la == 0);
  }
  if (mkbool(la == lb)) {
    recur(sym, litN, mknum(payload(i, 0) + 1));
  }
  return false;
}

defun Rt.epCount(vv : val, stN : val, accN : val) -> val {
  word cbufW = [*Scratch](payload(stN, 0))->cbuf;
  word limW = [*Scratch](payload(stN, 0))->lim;
  val stV = mkbool(tagis(vv, 4) == 0) ? mknum(2) : (mkbool(tagis(vecload(payload(vv, 0), 0), 2) == 0) ? mknum(2) : (call Rt.epSymIs(vecload(payload(vv, 0), 0), mknum(cbufW), mknum(0)) ? (mkbool(tagis(vecload(payload(vv, 0), 1), 5) != 0) ? mknum(0) : (mkbool(tagis(vecload(payload(vv, 0), 1), 4) != 0) ? mknum(1) : mknum(2))) : mknum(2)));
  if (mkbool(payload(stV, 0) == 2)) {
    return mknum(-1);
  }
  if (mkbool(payload(stV, 0) == 0)) {
    return accN;
  }
  val t1 = vecload(payload(vecload(payload(vv, 0), 1), 0), 1);
  if (mkbool(payload(accN, 0) > limW)) {
    return accN;
  }
  if (mkbool(tagis(t1, 4) == 0)) {
    return mknum(-1);
  }
  recur(vecload(payload(t1, 0), 0), stN, mknum(payload(accN, 0) + 1));
}

defun Rt.epElem(vv : val, iN : val, tgtN : val) -> val {
  if (mkbool(tagis(vv, 4) == 0)) {
    return mknil;
  }
  if (mkbool(tagis(vecload(payload(vv, 0), 1), 5) != 0)) {
    return mknil;
  }
  if (mkbool(tagis(vecload(payload(vv, 0), 1), 4) == 0)) {
    return mknil;
  }
  if (mkbool(payload(iN, 0) == payload(tgtN, 0))) {
    return vecload(payload(vecload(payload(vv, 0), 1), 0), 0);
  }
  val t1 = vecload(payload(vecload(payload(vv, 0), 1), 0), 1);
  if (mkbool(tagis(t1, 4) == 0)) {
    return mknil;
  }
  recur(vecload(payload(t1, 0), 0), mknum(payload(iN, 0) + 1), tgtN);
}

