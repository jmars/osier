      val nstdin = call Rt.epCountStdin(mknum([*CmdState](payload(cAddrN, 0))->redirs), mknum([*CmdState](payload(cAddrN, 0))->nredirs), mknum(0));
      if (mkbool(payload(nstdin, 0) > 1)) {
        val _u66 = if (mkbool([*CmdState](payload(cAddrN, 0))->subprog != 0)) {
          return call Rt.epFreeChains(mknum([*CmdState](payload(cAddrN, 0))->subprog), mknum([*Prog]([*CmdState](payload(cAddrN, 0))->subprog)->chains), mknum(0));
        } else {
          return mknil;
        };
        val _u67 = if (mkbool([*CmdState](payload(cAddrN, 0))->redirs != 0)) {
          return call Rt.epFreeRedirs(mknum([*CmdState](payload(cAddrN, 0))->redirs), mknum(0), mknum([*CmdState](payload(cAddrN, 0))->nredirs));
        } else {
          return mknil;
        };
        [*CmdState](payload(cAddrN, 0))->redirs = 0;
        val _u68 = if (mkbool([*CmdState](payload(cAddrN, 0))->argv != 0)) {
          return call Rt.epFreeArgv(mknum([*CmdState](payload(cAddrN, 0))->argv), mknum(0), mknum([*CmdState](payload(cAddrN, 0))->argc));
        } else {
          return mknil;
        };
        [*CmdState](payload(cAddrN, 0))->argv = 0;
        return mknum(-1);
      }
      return mknum(0);
    }
  }
}

defun Rt.childCd(argvN : val, argcN : val, stN : val) -> val {
  word cbufW = [*Exec](payload(stN, 0))->cbuf;
  val dirN = mkbool(payload(argcN, 0) > 1) ? mknum(wload(payload(argvN, 0), 1)) : mknum(0);
  val dirN = if (mkbool(payload(dirN, 0) == 0)) {
    return call Rt.envHome(stN);
  } else {
    val ln = call Rt.cStrLenGo(dirN, mknum(0));
    if (mkbool(payload(ln, 0) == 0)) { return call Rt.envHome(stN); }
    return dirN;
  };
  val dirN = mkbool(payload(dirN, 0) == 0) ? mknum(cbufW + 139) : dirN;
  val ln = call Rt.cStrLenGo(dirN, mknum(0));
  if (mkbool(payload(ln, 0) >= 4096)) {
    return mknum(1);
  }
  word bufW = rawcall malloc(4096);
  val _u69 = if (mkbool(bufW == 0)) {
    word h = rawcall rt_halt();
    return mknil;
  } else {
    return mknum(0);
  };
  call Rt.cStrCopyGo(dirN, mknum(bufW), mknum(0));
  word rc = rawcall chdir(bufW);
  rawcall free(bufW);
  if (mkbool(rc == 0)) {
    return mknum(0);
  }
  call Rt.wStr(mknum(2), mknum(cbufW + 240));
  call Rt.wStr(mknum(2), dirN);
  call Rt.wRaw(mknum(2), mknum(cbufW + 173), mknum(1));
  return mknum(1);
}
// ===== THE MID-OWNED ROOT REGISTRY (ZIGHOST Z1) =====
// The precise-root set the collector walks, owned by Mid instead of the Zig
// Gc struct's shadow stack.  The storage is a malloc'd, grow-by-doubling array
// of THREE-WORD entries `{kind, slot, np}` — the retired `GcRoot`
// (vendor/osier-rt/src/gc/roots.zig:35) word for word, so the two walkers'
// kind dispatch is unchanged and only the SOURCE of (kind, slot, np) moves.
// base/count/cap live in the globals block words 4/5/6 (RtGc's layout table):
// HERE and not in the collector's region, because a frame pushes its roots
// BEFORE the lazy `Rt.gcInit` maps anything — the block is .bss and always
// emitted, the region is not.
//
// THE KINDS (the Zig enum's numeric values, which the walkers dispatch on):
// 0 = PTR (slot is a one-word pointer variable), 1 = VALUE (slot is a 40-byte
// Value; interior pointers rewritten in place), 2 = VALUE_ARRAY (slot is the
// array base, np points at its LIVE count — read AT SCAN TIME, not at push
// time), 3 = VALUE_VOLATILE (scanned exactly like 1).  Kind 4
// (CALLFRAME_ARRAY) was VM-only and is unreachable here; the walkers' falling
// chain names it.
//
// ALLOC-FREE BY CONTRACT from the collector's view: a push may GROW the array,
// and the grow mallocs (libc, which runs no collect) — so a Mid body may call
// these under RawCallRaw's no-safepoint contract, exactly as the Zig seats'
// page_allocator grow was (roots.zig:59-83).
//
// POP-TO, NEVER A BARE POP: `Rt.rootWatermark` snapshots the depth at frame
// enter and `Rt.rootPopTo(wm)` truncates back to it at leave.  When anything
// pushed between enter and leave (a nested frame, an apply arm's env root), a
// bare pop pops the WRONG entry, the frame's ROOT_VALUE_ARRAY LEAKS, and every
// later collect scans a freed block's stale slots — the historical qbe-gcbug.
// Both truncation guards are LOUD: the Zig asserted them in Debug only
// (roots.zig:149-165), and a lost balance is exactly the class this repo turns
// from silent corruption into a named fatal.
defun Rt.rootGrow() -> word {
  word glob = rawcall rt_glob_addr();
  word cap = wload(glob, 6);
  // SHADOW_STACK_INIT_CAP parity (roots.zig:46): 64 entries, then doubling.
  word nc = payload((cap == 0) ? mknum(64) : mknum(cap * 2), 0);
  word old = wload(glob, 4);
  word n = wload(glob, 5);
  word nb = rawcall malloc(nc * 24);
  // The old array is COPIED and freed rather than realloc'd: `realloc` is in
  // no signature table this file may use, and the copy is alloc-free (libc
  // malloc/free + a word loop — no safepoint), so the contract above holds.
  word moved = if (old != 0) {
    call Rt.copyWords(nb, old, n * 3);
    rawcall free(old);
    return 0;
  } else {
    return 0;
  };
  wstore(glob, 4, nb);
  wstore(glob, 6, nc);
  return 0;
}
// The ONE push body: every push writes its three words at the live index and
// bumps the count.  Growing FIRST keeps the index in range on the entry that
// crosses the capacity.
defun Rt.rootPush(kind : word, slot : word, np : word) -> word {
  word glob = rawcall rt_glob_addr();
  word n = wload(glob, 5);
  word cap = wload(glob, 6);
  word grown = if (n >= cap) {
    call Rt.rootGrow();
    return 0;
  } else {
    return 0;
  };
  word base = wload(glob, 4);
  wstore(base, n * 3, kind);
  wstore(base, n * 3 + 1, slot);
  wstore(base, n * 3 + 2, np);
  wstore(glob, 5, n + 1);
  return 0;
}
// `slot` is the ADDRESS of a one-word pointer variable that MUST point at the
// HEAD of a GC object (gc.h:155-161): the marker reads the header at *(ptr-1),
// so an interior/tail pointer would read a garbage header.
defun Rt.rootPushPtr(slot : word) -> word {
  call Rt.rootPush(0, slot, 0);
  return 0;
}
// A by-value Value root: the walker rewrites the Value's interior pointers in
// place; the Value itself never moves.
defun Rt.rootPushValue(slot : word) -> word {
  call Rt.rootPush(1, slot, 0);
  return 0;
}
// N by-value Values rooted by base + a LIVE count pointer (`np` is the address
// of the i32 the frame's `hdr->live` / ApplyState's `live` word holds).
defun Rt.rootPushValueArray(base : word, np : word) -> word {
  call Rt.rootPush(2, base, np);
  return 0;
}
defun Rt.rootPop() -> word {
  word glob = rawcall rt_glob_addr();
  word n = wload(glob, 5);
  word bad = if (n == 0) {
    call Rt.die(rawstr("qbe-rt: midgc: root pop on an empty registry"));
    return 0;
  } else {
    return 0;
  };
  wstore(glob, 5, n - 1);
  return 0;
}
defun Rt.rootWatermark() -> word {
  return wload(rawcall rt_glob_addr(), 5);
}
defun Rt.rootPopTo(wm : word) -> word {
  word glob = rawcall rt_glob_addr();
  word n = wload(glob, 5);
  word bad = if (wm > n) {
    call Rt.die(rawstr("qbe-rt: midgc: root pop_to above the registry depth"));
    return 0;
  } else {
    return 0;
  };
  wstore(glob, 5, wm);
  return 0;
}
// ===== the stage-6 B0 frame machinery (VERBATIM rt.zig rt_frame_enter/
// rt_frame_leave, rt.zig:225-321).  The pooled freelist-head ARRAY lives in
// the U1c globals block (RtGc: words 16..16+8192, indexed by nslots; bound
// 8192, giants never pooled).  Two further globals are needed that the RtGc
// layout comment does not name: word 1 = frame_top (the active-frame stack
// head), word 2 = no_frame_reuse (read ONCE in Rt.main, checked here — the
// rt.zig:240-249 discipline; a per-call getenv is the measured 8.4% trap).
// The header is 40 bytes = 5 words and is the file-scoped `struct FrameHdr`
// above (the ONE name -> slot table: live@0 (i32), wm@1, next@2, freeNext@3,
// _pad@4 — the rt.zig slots pointer field, which neither shape writes; the
// slots DATA starts at +40, word 5).  A Value is 40 bytes = 5 words, so
// zeroing is 5 words per slot.
// Zero-BEFORE-root: the reused block's stale slots are memset to the
// number-0 Value (tag 0, payload 0) BEFORE rootPushValueArray — otherwise
// scanValue chases freed GC pages.
//
// THE 175x FIX (stage-6 B0perf), THE ~3.4x->~1x CLOSE (stage-6 B0perf-2) and
// THE BULK-ZERO CLOSE (stage-6 P1e): the original loop stored ONE BYTE per
// iteration and re-boxed the decremented count (`mknum(...)`) on every `recur`
// — an ALLOCATION per byte, nslots*40 allocations per frame.  B0perf zeroed a
// full 40-byte SLOT (5 words) per iteration; B0perf-2 made that loop a rawAbi
// WORD defun (frameZero) so it allocated NOTHING — but it was still a LOOP,
// ~8-10 instructions per 40-byte slot.  P1e deletes the loop entirely: ONE
// `rawcall memset(base, 0, 40 * nslots)` zeroes the whole block — the exact
// `@memset(hdr.slots[0..nslots], zeroValue())` Zig emits (rt.zig:281).  Byte
// equivalence: a Value is 5 words, and the loop wrote five zero WORDS per slot
// (40 zero bytes) — memset writes the same 40*nslots zero bytes in one call.
// Header word 4 (the slots-POINTER field) is written by NEITHER shape: the Mid
// frame path never reads it (Rt.rootPushValueArray takes base+live
// explicitly), so the old counter seeding (wstore(hdr, 4, nslots)) drops with
// the loop.
//
// NOTE (P1e item 2 deferred): frameBlock's three `payload(mknum(..))` selects
// and frame-leave's two dead word-if binders are LEFT AS-IS.  A rawAbi WORD
// defun has NO word-join — `lowerTailWordBranches` rejects a tail If whose two
// branches both return a word (no phi), and a word-valued `?:`/`if` in a value
// slot is a loud `wordProducerMessage` — so the `mknum`-to-slot-then-`payload`
// round-trip IS the word-join-via-memory idiom, the minimal expressible form.
defun Rt.frameBlock(nslots : word) -> word {
  word bytes = 40 + 40 * nslots;
  word g = payload((nslots < 8192) ? mknum(rawcall rt_glob_addr()) : mknum(0), 0);
  *FrameHdr h = payload((g != 0) ? mknum(wload(g, 16 + nslots)) : mknum(0), 0);
  word popped = if (h != 0) {
    wstore(g, 16 + nslots, h->freeNext);
    return 0;
  } else {
    return 0;
  };
  word r = payload((h != 0) ? mknum(h) : mknum(rawcall malloc(bytes)), 0);
  return r;
}

defun Rt.frame-enter(nslots : word) -> word {
  *FrameHdr hdr = call Rt.frameBlock(nslots);
  word base = [word](hdr) + 40;
  rawcall memset(base, 0, 40 * nslots);
  hdr->live = nslots;
  word wm = call Rt.rootWatermark();
  hdr->wm = wm;
  word glob = rawcall rt_glob_addr();
  hdr->next = wload(glob, 1);
  wstore(glob, 1, hdr);
  call Rt.rootPushValueArray(base, hdr);
  return base;
}

defun Rt.frame-leave() -> word {
  word glob = rawcall rt_glob_addr();
  *FrameHdr hdr = wload(glob, 1);
  word bad = if (hdr == 0) {
    call Rt.die(rawstr("qbe-rt: rt_frame_leave with no frame"));
    return 0;
  } else {
    return 0;
  };
  wstore(glob, 1, hdr->next);
  call Rt.rootPopTo(hdr->wm);
  word n = hdr->live;
  word pooled = if (wload(glob, 2) != 0) {
    // QBE_NO_REUSE: frame-leave never pools here, and this arm is the only
    // writer of the frame pool, so under the knob the pool stays empty and
    // every frame is malloc'd — free it, closing the per-enter leak.
    rawcall free(hdr);
    return 0;
  } else {
    if (n >= 8192) {
      // Giants are never pooled (frameBlock's g is 0), so they are always
      // malloc'd — free them, closing the documented no-free path.
      rawcall free(hdr);
      return 0;
    } else {
      hdr->freeNext = wload(glob, 16 + n);
      wstore(glob, 16 + n, hdr);
      return 0;
    }
  };
  return 0;
}

defun Rt.die(msg : word) -> word {
  val len = call Rt.cStrLenGo(mknum(msg), mknum(0));
  rawcall write(2, msg, payload(len, 0));
  rawcall write(2, rawstr("\n"), 1);
  rawcall exit(1);
  return 0;
}
defun Rt.halt() -> word {
  word m = rawstr("qbe-rt: qbe-rt: halt (a Mid prim reached its halt arm)");
  val len = call Rt.cStrLenGo(mknum(m), mknum(0));
  rawcall write(2, m, payload(len, 0));
  rawcall write(2, rawstr("\n"), 1);
  rawcall exit(1);
  return 0;
}
// THE BOOLEAN PAYLOAD IS A WORD (32 BITS), NOT A PAYLOAD WORD'S 64 BITS.  A
// bool's payload is declared `i32` in the Zig `Value` union (gc/types.zig:
// `boolean: i32`) and the Mid writers store it with a 32-bit store
// (Mid/Qbe/Lower's `lowerLit` LBoolean arm and `reboxBoolean`), so the HIGH
// HALF of that payload word is whatever the cell held before — undefined for a
// Zig-allocated Value, and the memset/kernel zeros are the only reason the
// current emit reads it as 0.  `payload32` is `loadsw`+`extsw` on that word,
// i.e. exactly the read the checker's own `:val`-cond test emits
// (Lower's unboxedValBool test: `loadw` of the payload word).  MEASURED in the
// .ssa: `false` lowers to `storew 0` and every one of these reads was `loadl`
// of the same word.
defun Rt.cStrEq(a : word, b : word) -> word {
  val eq = call Rt.cStrEqGo(mknum(a), mknum(b), mknum(0));
  return payload32(eq, 0);
}

defun Rt.cStrEqGo(a : val, b : val, i : val) -> val {
  word xa = byteload(payload(a, 0), payload(i, 0));
  word xb = byteload(payload(b, 0), payload(i, 0));
  if (mkbool(xb == 0)) {
    return mkbool(xa == 0);
  }
  if (mkbool(xa == xb)) {
    recur(a, b, mknum(payload(i, 0) + 1));
  }
  return false;
}

defun Rt.metaGo(blk : val, i : val) -> val {
  word nW = wload(payload(blk, 0), 2);
  if (mkbool(payload(i, 0) >= nW)) {
    return mkbool(0);
  }
  word baseW = wload(payload(blk, 0), 0);
  word entryW = wload(payload(blk, 0), 1);
  word row = baseW + (payload(i, 0) * 24);
  word nameW = wload(row, 0);
  word eq = call Rt.cStrEq(nameW, entryW);
  if (mkbool(eq != 0)) {
    wstore(payload(blk, 0), 3, wload(row, 1));
    wstore(payload(blk, 0), 4, wload(row, 2));
    return mkbool(1);
  }
  recur(blk, mknum(payload(i, 0) + 1));
}

defun Rt.parseArgsGo(blk : val, j : val) -> val {
  word nargsW = wload(payload(blk, 0), 2);
  if (mkbool(payload(j, 0) >= nargsW)) {
    return mknum(0);
  }
  word bufW = wload(payload(blk, 0), 0);
  word argvW = wload(payload(blk, 0), 1);
  word argPtr = bufW + (payload(j, 0) * 40);
  word argStr = wload(argvW, 2 + payload(j, 0));
  word rc = payload(call Rt.parseArg(mknum(argPtr), mknum(argStr)), 0);
  if (mkbool(rc != 0)) {
    return mknum(2);
  }
  recur(blk, mknum(payload(j, 0) + 1));
}

defun Rt.main(argc : word, argv : word) -> word {
  word usage = rawstr("usage: <prog> <entry-name> [int|float-arg ...]\n");
  word toomany = rawstr("qbe-rt: >16 entry args not supported\n");
  word u = if (mkbool(argc < 2)) {
    val len = call Rt.cStrLenGo(mknum(usage), mknum(0));
    rawcall write(2, usage, payload(len, 0));
    rawcall exit(2);
    return 0;
  } else {
    return 0;
  };
  word nargs = argc - 2;
  word argvMode = rawcall getenv(rawstr("AOTRUN_ARGV"));
  word t = if (mkbool(argvMode == 0) && mkbool(nargs > 16)) {
    val len2 = call Rt.cStrLenGo(mknum(toomany), mknum(0));
    rawcall write(2, toomany, payload(len2, 0));
    rawcall exit(2);
    return 0;
  } else {
    return 0;
  };
  word lim = rawcall malloc(16);
  word qnl = rawcall getenv(rawstr("QBE_NO_RLIMIT"));
  word rl = if (mkbool(qnl == 0)) {
    word rc = rawcall getrlimit(3, lim);
    word rl2 = if (mkbool(rc == 0)) {
      word cur = wload(lim, 0);
      word rl3 = if (mkbool(cur < 67108864)) {
        wstore(lim, 0, 67108864);
        rawcall setrlimit(3, lim);
        return 0;
      } else {
        return 0;
      };
      return 0;
    } else {
      return 0;
    };
    return 0;
  } else {
    return 0;
  };
  word entry = wload(argv, 1);
  word base = wload(rawsym("qbe_meta"), 0);
  word metaN = wload(rawsym("qbe_meta_len"), 0);
  word mblk = rawcall malloc(40);
  wstore(mblk, 0, base);
  wstore(mblk, 1, entry);
  wstore(mblk, 2, metaN);
  val found = call Rt.metaGo(mknum(mblk), mknum(0));
  word nf = if (mkbool(payload32(found, 0) == 0)) {
    word pre = rawstr("qbe-rt: entry '");
    val plen = call Rt.cStrLenGo(mknum(pre), mknum(0));
    rawcall write(2, pre, payload(plen, 0));
    val elen = call Rt.cStrLenGo(mknum(entry), mknum(0));
    rawcall write(2, entry, payload(elen, 0));
    word suf = rawstr("' not in qbe_meta\n");
    val slen = call Rt.cStrLenGo(mknum(suf), mknum(0));
    rawcall write(2, suf, payload(slen, 0));
    rawcall exit(2);
    return 0;
  } else {
    return 0;
  };
  word code = wload(mblk, 3);
  word arity = wload(mblk, 4);
  // ZIGHOST Z5: the boot is Mid's.  The old seat returned 1 after
  // "qbe-rt: gc init failed" when the Zig Gc could not map its reservation;
  // there is no Zig Gc to fail now, and a Mid malloc has no returnable
  // failure (a null deref is the failure), so there is no branch to keep.
  val booted = call Rt.boot(mknil);
  word nreuse = rawcall getenv(rawstr("QBE_NO_REUSE"));
  wstore(rawcall rt_glob_addr(), 2, nreuse != 0);
  word ntailstage = rawcall getenv(rawstr("QBE_NOTTAILSTAGE"));
  wstore(rawcall rt_glob_addr(), 13, ntailstage != 0);
  word tsbuf = rawcall malloc(120);
  wstore(rawcall rt_glob_addr(), 12, tsbuf);
  word abuf = rawcall malloc(648);
  word entry_nargs = payload(mkbool(argvMode != 0) ? mknum(0) : mknum(nargs), 0);
  word pblk = rawcall malloc(24);
  wstore(pblk, 0, abuf);
  wstore(pblk, 1, argv);
  wstore(pblk, 2, entry_nargs);
  val prc = call Rt.parseArgsGo(mknum(pblk), mknum(0));
  word pre = if (mkbool(payload(prc, 0) != 0)) { rawcall exit(2); return 0; } else { return 0; };
  wstore(abuf, 80, entry_nargs);
  call Rt.rootPushValueArray(abuf, abuf + 640);
  call Rt.argvInstall(mknum(argvMode), mknum(nargs), mknum(argv));
  word a1 = abuf + 40;
  word a2 = abuf + 80;
  word a3 = abuf + 120;
  word a4 = abuf + 160;
  word a5 = abuf + 200;
  word a6 = abuf + 240;
  word a7 = abuf + 280;
  word a8 = abuf + 320;
  word a9 = abuf + 360;
  word a10 = abuf + 400;
  word a11 = abuf + 440;
  word a12 = abuf + 480;
  word a13 = abuf + 520;
  word a14 = abuf + 560;
  word a15 = abuf + 600;
  word fslot = rawcall malloc(8);
  word modelslot = rawcall malloc(40);
  word d0 = if (mkbool(arity == 0)) {
    word r0 = aggcall ret rawsym("rt_call0")(code, 0);
    word res0 = aggcall val rawsym("q_Rt_x2ebounce")(r0);
    wstore(fslot, 0, res0);
    return 0;
  } else {
    return 0;
  };
  word d1 = if (mkbool(arity == 1)) {
    word r1 = aggcall ret rawsym("rt_call1")(code, 0, abuf);
    word res1 = aggcall val rawsym("q_Rt_x2ebounce")(r1);
    wstore(fslot, 0, res1);
    return 0;
  } else {
    return 0;
  };
  word d2 = if (mkbool(arity == 2)) {
    word r2 = aggcall ret rawsym("rt_call2")(code, 0, abuf, a1);
    word res2 = aggcall val rawsym("q_Rt_x2ebounce")(r2);
    wstore(fslot, 0, res2);
    return 0;
  } else {
    return 0;
  };
  word d3 = if (mkbool(arity == 3)) {
    word r3 = aggcall ret rawsym("rt_call3")(code, 0, abuf, a1, a2);
    word res3 = aggcall val rawsym("q_Rt_x2ebounce")(r3);
    wstore(fslot, 0, res3);
    return 0;
  } else {
    return 0;
  };
  word d4 = if (mkbool(arity == 4)) {
    word r4 = aggcall ret rawsym("rt_call4")(code, 0, abuf, a1, a2, a3);
    word res4 = aggcall val rawsym("q_Rt_x2ebounce")(r4);
    wstore(fslot, 0, res4);
    return 0;
  } else {
    return 0;
  };
  word d5 = if (mkbool(arity == 5)) {
    word r5 = aggcall ret rawsym("rt_call5")(code, 0, abuf, a1, a2, a3, a4);
    word res5 = aggcall val rawsym("q_Rt_x2ebounce")(r5);
    wstore(fslot, 0, res5);
    return 0;
  } else {
    return 0;
  };
  word d6 = if (mkbool(arity == 6)) {
    word r6 = aggcall ret rawsym("rt_call6")(code, 0, abuf, a1, a2, a3, a4, a5);
    word res6 = aggcall val rawsym("q_Rt_x2ebounce")(r6);
    wstore(fslot, 0, res6);
    return 0;
  } else {
    return 0;
  };
  word d7 = if (mkbool(arity == 7)) {
    word r7 = aggcall ret rawsym("rt_call7")(code, 0, abuf, a1, a2, a3, a4, a5, a6);
    word res7 = aggcall val rawsym("q_Rt_x2ebounce")(r7);
    wstore(fslot, 0, res7);
    return 0;
  } else {
    return 0;
  };
  word d8 = if (mkbool(arity == 8)) {
    word r8 = aggcall ret rawsym("rt_call8")(code, 0, abuf, a1, a2, a3, a4, a5, a6, a7);
    word res8 = aggcall val rawsym("q_Rt_x2ebounce")(r8);
    wstore(fslot, 0, res8);
    return 0;
  } else {
    return 0;
  };
  word d9 = if (mkbool(arity == 9)) {
    word r9 = aggcall ret rawsym("rt_call9")(code, 0, abuf, a1, a2, a3, a4, a5, a6, a7, a8);
    word res9 = aggcall val rawsym("q_Rt_x2ebounce")(r9);
    wstore(fslot, 0, res9);
    return 0;
  } else {
    return 0;
  };
  word d10 = if (mkbool(arity == 10)) {
    word r10 = aggcall ret rawsym("rt_call10")(code, 0, abuf, a1, a2, a3, a4, a5, a6, a7, a8, a9);
    word res10 = aggcall val rawsym("q_Rt_x2ebounce")(r10);
    wstore(fslot, 0, res10);
    return 0;
  } else {
    return 0;
  };
  word d11 = if (mkbool(arity == 11)) {
    word r11 = aggcall ret rawsym("rt_call11")(code, 0, abuf, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10);
    word res11 = aggcall val rawsym("q_Rt_x2ebounce")(r11);
    wstore(fslot, 0, res11);
    return 0;
  } else {
    return 0;
  };
  word d12 = if (mkbool(arity == 12)) {
    word r12 = aggcall ret rawsym("rt_call12")(code, 0, abuf, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11);
    word res12 = aggcall val rawsym("q_Rt_x2ebounce")(r12);
    wstore(fslot, 0, res12);
    return 0;
  } else {
    return 0;
  };
  word d13 = if (mkbool(arity == 13)) {
    word r13 = aggcall ret rawsym("rt_call13")(code, 0, abuf, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12);
    word res13 = aggcall val rawsym("q_Rt_x2ebounce")(r13);
    wstore(fslot, 0, res13);
    return 0;
  } else {
    return 0;
  };
  word d14 = if (mkbool(arity == 14)) {
    word r14 = aggcall ret rawsym("rt_call14")(code, 0, abuf, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13);
    word res14 = aggcall val rawsym("q_Rt_x2ebounce")(r14);
    wstore(fslot, 0, res14);
    return 0;
  } else {
    return 0;
  };
  word d15 = if (mkbool(arity == 15)) {
    word r15 = aggcall ret rawsym("rt_call15")(code, 0, abuf, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14);
    word res15 = aggcall val rawsym("q_Rt_x2ebounce")(r15);
    wstore(fslot, 0, res15);
    return 0;
  } else {
    return 0;
  };
  word d16 = if (mkbool(arity == 16)) {
    word r16 = aggcall ret rawsym("rt_call16")(code, 0, abuf, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15);
    word res16 = aggcall val rawsym("q_Rt_x2ebounce")(r16);
    wstore(fslot, 0, res16);
    return 0;
  } else {
    return 0;
  };
  word fptr = wload(fslot, 0);
  call Rt.rootPushValue(fptr);
  // THE MID HOST IS THE ONLY HOST (O4): the QBE_MIDHOST hatch — the compile-time
  // splice, the run-time getenv switch, the MIDGC refusal region, and the Zig
  // arm (the Zig effect-loop seats) — is RETIRED, and the
  // Mid arm below is UNCONDITIONAL.  The arm still prints and exits ITSELF
  // (stage 7B's measured rule: falling through into the shared epilogue ran a
  // program TWICE); non-program entries fall through to the shared print.
  word chk = if (payload32(call Rt.hostIsProgram(vecload(fptr, 0)), 0) != 0) {
    call Rt.hostRun(mknum(fptr), mknum(modelslot));
    call Rt.rootPushValue(modelslot);
    word mppc = payload(call Rt.printValue(vecload(modelslot, 0)), 0);
    word mpf = if (mkbool(mppc != 0)) {
      rawcall exit(1);
      return 0;
    } else {
      return 0;
    };
    rawcall exit(0);
    return 0;
  } else {
    return 0;
  };
  word fptr2 = wload(fslot, 0);
  word ppc = payload(call Rt.printValue(vecload(fptr2, 0)), 0);
  word pf = if (mkbool(ppc != 0)) { rawcall exit(1); return 0; } else { return 0; };
  return 0;
}
// ===== the stage-6 B1 apply family (VERBATIM rt.zig rt_apply / rt_apply_tail
// / applyGo, rt.zig:793-927).  Rt.apply / Rt.apply-tail are rawAbi WRAPPERS
// (3 word params — fslot *Value, args [*]Value, nargs) that root the caller's
// args array, then hand off to a :val LOOP (Rt.applyGo / Rt.applyTailGo —
// `recur` needs the val self-tail loop, which the rawAbi tail rejects).  The
// loop's current closure lives in its OWN (rooted) frame as a :val PARAM, not
// in the malloc'd state block — the over arm re-binds it via `recur(.., res)`
// so no raw store ever writes a Value into a non-GC buffer.  The state block
// carries the raw words — `struct ApplyState` (args/nargs/live/env) is the ONE
// table for them, above.  The PARTIAL arm's env dance (rootPushPtr + the
// RE-READ-AFTER-ALLOC, the cStrFill lesson)
// is what keeps the applied-args/captures copy pointing at the POST-scavenge
// env array.  The wrapper's `f` copy (vecload(fslot,0)) is NOT rooted: sound
// only because no collect can run between the vecload and applyGo/applyTailGo's
// param blit (scavenges are alloc-site-triggered; malloc(32)/
// Rt.rootPushValueArray/frame-pool pop are collect-free), after which `f`
// is a ROOTED frame param whose interior pointers the collector rewrites in
// place.
defun Rt.apply(fslot : word, args : word, nargs : word) -> val {
  *ApplyState state = rawcall malloc(32);
  state->args = args;
  state->nargs = nargs;
  state->live = nargs;
  call Rt.rootPushValueArray(args, [word](state) + 16);
  val f = vecload(fslot, 0);
  val r = call Rt.applyGo(mknum(state), f);
  call Rt.rootPop();
  rawcall free(state);
  return r;
}
defun Rt.apply-tail(fslot : word, args : word, nargs : word) -> val {
  *ApplyState state = rawcall malloc(32);
  state->args = args;
  state->nargs = nargs;
  state->live = nargs;
  call Rt.rootPushValueArray(args, [word](state) + 16);
  val f = vecload(fslot, 0);
  val r = call Rt.applyTailGo(mknum(state), f);
  call Rt.rootPop();
  rawcall free(state);
  return r;
}
defun Rt.applyGo(state : val, f : val) -> val {
  *ApplyState sp = payload(state, 0);
  word code = payload(f, 0);
  word fn = wload(code, 0);
  word rem = payload32(f, 1);
  word env = payload(f, 2);
  word args = sp->args;
  word nargs = sp->nargs;
  if (tagis(f, 6) == 0) {
    call Rt.die(rawstr("qbe-rt: apply of a non-function value"));
    return mknil;
  } else {
    word arity = wload(code, 1) & 4294967295;
    word napp = arity - rem;
    if (rem == nargs) {
      val chk = if (napp > 0) {
        if (env == 0) {
          call Rt.die(rawstr("qbe-rt: closure env missing for applied args"));
          return mknil;
        } else {
          return mknil;
        }
      } else {
        return mknil;
      };
      word r = aggcall ret rawsym("rt_call2r")(fn, env, napp, args, rem);
      word v = aggcall val rawsym("q_Rt_x2ebounce")(r);
      return vecload(v, 0);
    } else {
      if (rem > nargs) {
        sp->env = env;
        return call Rt.applyPartGo(state, f);
      } else {
        word r = aggcall ret rawsym("rt_call2r")(fn, env, napp, args, rem);
        word v = aggcall val rawsym("q_Rt_x2ebounce")(r);
        val res = vecload(v, 0);
        sp->args = args + rem * 40;
        sp->nargs = nargs - rem;
        recur(mknum(sp), res);
      }
    }
  }
}
defun Rt.applyTailGo(state : val, f : val) -> val {
  *ApplyState sp = payload(state, 0);
  word code = payload(f, 0);
  word fn = wload(code, 0);
  word rem = payload32(f, 1);
  word env = payload(f, 2);
  word envlen = payload32(f, 3);
  word args = sp->args;
  word nargs = sp->nargs;
  if (tagis(f, 6) == 0) {
    call Rt.die(rawstr("qbe-rt: apply of a non-function value"));
    return mknil;
  } else {
    word arity = wload(code, 1) & 4294967295;
    word napp = arity - rem;
    word capslen = envlen - napp;
    if (rem == nargs) {
      // THE .tail NO-COLLECT INVARIANT (rt.zig:956-973, stated HERE at the
      // Mid surface too): the .tail args live in the fresh `buf` allocvec
      // array below, which is UNROOTED by convention.  Sound only because the
      // callee prologue blit reads `buf` EXACTLY ONCE and NO collection runs
      // between this allocvec and that blit — the tail from here is
      // allocvec -> wstores (malloc, libc) -> return mknum(retbuf) -> the
      // Lower @ret blit -> frame-leave (pool push, no collect) -> rt_bounce ->
      // rt_callN (the generated bridge, prologue blit FIRST).  A future editor
      // adding a GC alloc AFTER this allocvec (or in the Lower @ret block)
      // breaks it SILENTLY — keep this arm alloc-free after the allocvec.
      word total = arity + capslen;
      sp->env = env;
      call Rt.rootPushPtr([word](sp) + 24);
      word buf = allocvec(total);
      word env2 = sp->env;
      val chk = if (napp > 0) {
        if (env2 == 0) {
          call Rt.die(rawstr("qbe-rt: closure env missing for applied args"));
          return mknil;
        } else {
          return mknil;
        }
      } else {
        return mknil;
      };
      call Rt.copyWords(buf, env2, napp * 5);
      call Rt.copyWords(buf + napp * 40, args, rem * 5);
      call Rt.copyWords(buf + arity * 40, env2 + napp * 40, capslen * 5);
      call Rt.rootPop();
      word e = payload((capslen > 0) ? mknum(buf + arity * 40) : mknum(0), 0);
      *Ret retbuf = rawcall malloc(80);
      wstore(retbuf, 0, 0);
      wstore(retbuf, 1, 0);
      wstore(retbuf, 2, 0);
      wstore(retbuf, 3, 0);
      wstore(retbuf, 4, 0);
      retbuf->kind = 1;
      retbuf->code = fn;
      retbuf->e = e;
      retbuf->args = buf;
      retbuf->arity = arity;
      return mknum(retbuf);
    } else {
      if (rem > nargs) {
        sp->env = env;
        val p = call Rt.applyPartGo(state, f);
        *Ret retbuf = rawcall malloc(80);
        // the ret cell's `result` is the closure value p WORD-WISE (the
        // `.done` layout's five words): kind 6, then mkval's four payload
        // words at +1 - code, the 32-bit remaining arity, env, the 32-bit
        // cell count.  The offsets are OFFSET BY ONE from mkval's argument
        // order, so they are spelled out rather than looped.
        wstore(retbuf, 0, 6);
        wstore(retbuf, 1, payload(p, 0));
        wstore(retbuf, 2, payload32(p, 1));
        wstore(retbuf, 3, payload(p, 2));
        wstore(retbuf, 4, payload32(p, 3));
        retbuf->kind = 0;
        retbuf->code = 0;
        retbuf->e = 0;
        retbuf->args = 0;
        retbuf->arity = 0;
        return mknum(retbuf);
      } else {
        word r = aggcall ret rawsym("rt_call2r")(fn, env, napp, args, rem);
        word v = aggcall val rawsym("q_Rt_x2ebounce")(r);
        val res = vecload(v, 0);
        sp->args = args + rem * 40;
        sp->nargs = nargs - rem;
        recur(mknum(sp), res);
      }
    }
  }
}
// Rt.applyPartGo — THE PARTIAL-APPLICATION SEAT, and the ONE source of the
// capture/args INTERLEAVE (stage 7 O3-fix).  `state`'s args/nargs/env are the
// closure's current application (ApplyState, above); the new closure's env is
//
//     applied(napp) ++ the new args(nargs) ++ the old captures(capslen)
//
// whose first napp + nargs cells are the params this closure now has and whose
// tail is what remains a capture — so applyGo/applyTailGo's `rem > nargs` arm
// and the HOST applier's partial arm (Rt.apply-at) build ONE shape, not three
// copies of it.  `mkval(6, code, rem - nargs, envv, total)` is the result: the
// same desc, the remaining arity reduced by what was just applied.
//
// WHY THIS IS A DEFUN AT ALL: it was spelled inline in both apply loops until
// the host applier needed it (O3-fix's bootstrap blocker), and three copies of
// a rooting dance is three chances to drift.
//
// THE ROOTING (unchanged from the arms it replaces, and load-bearing):
//   * `args` — the caller's argument area — is NOT re-read after the allocvec,
//     and must not be: it is a raw base the CALLER rooted (Rt.apply's
//     Rt.rootPushValueArray for the generated-code route; a slice of the
//     host's permanently-rooted slot array for the host route), so a scavenge
//     moves the Values INSIDE it and rewrites them in place, but the base word
//     is an address the collector never updates.
//   * `env` (the applied closure's env array) DOES move, so it is staged in
//     sp->env, registered with Rt.rootPushPtr([word](sp) + 24), and RE-READ
//     after the allocvec (the cStrFill lesson: the allocvec may have scavenged
//     it).  `code` needs no such care: a desc is static data.
defun Rt.applyPartGo(state : val, f : val) -> val {
  *ApplyState sp = payload(state, 0);
  word code = payload(f, 0);
  word rem = payload32(f, 1);
  word envlen = payload32(f, 3);
  word arity = wload(code, 1) & 4294967295;
  word napp = arity - rem;
  word capslen = envlen - napp;
  word args = sp->args;
  word nargs = sp->nargs;
  word total = napp + nargs + capslen;
  call Rt.rootPushPtr([word](sp) + 24);
  word envv = allocvec(total);
  word env2 = sp->env;
  call Rt.copyWords(envv, env2, napp * 5);
  call Rt.copyWords(envv + napp * 40, args, nargs * 5);
  call Rt.copyWords(envv + (napp + nargs) * 40, env2 + napp * 40, capslen * 5);
  call Rt.rootPop();
  return mkval(6, code, rem - nargs, envv, total);
}
defun Rt.callArity(disp : val) -> val {
  *Disp dp = payload(disp, 0);
  word code = dp->fn;
  word caps = dp->caps;
  word buf = dp->buf;
  word arity = dp->arity;
  if (mkbool(arity == 0)) {
    word r = aggcall ret rawsym("rt_call0")(code, caps);
    word v = aggcall val rawsym("q_Rt_x2ebounce")(r);
    return vecload(v, 0);
  } else {
    if (mkbool(arity == 1)) {
      word r = aggcall ret rawsym("rt_call1")(code, caps, buf);
      word v = aggcall val rawsym("q_Rt_x2ebounce")(r);
      return vecload(v, 0);
    } else {
      if (mkbool(arity == 2)) {
        word r = aggcall ret rawsym("rt_call2")(code, caps, buf, buf + 40);
        word v = aggcall val rawsym("q_Rt_x2ebounce")(r);
        return vecload(v, 0);
      } else {
        if (mkbool(arity == 3)) {
          word r = aggcall ret rawsym("rt_call3")(code, caps, buf, buf + 40, buf + 80);
          word v = aggcall val rawsym("q_Rt_x2ebounce")(r);
          return vecload(v, 0);
        } else {
          if (mkbool(arity == 4)) {
            word r = aggcall ret rawsym("rt_call4")(code, caps, buf, buf + 40, buf + 80, buf + 120);
            word v = aggcall val rawsym("q_Rt_x2ebounce")(r);
            return vecload(v, 0);
          } else {
            if (mkbool(arity == 5)) {
              word r = aggcall ret rawsym("rt_call5")(code, caps, buf, buf + 40, buf + 80, buf + 120, buf + 160);
              word v = aggcall val rawsym("q_Rt_x2ebounce")(r);
              return vecload(v, 0);
            } else {
              if (mkbool(arity == 6)) {
                word r = aggcall ret rawsym("rt_call6")(code, caps, buf, buf + 40, buf + 80, buf + 120, buf + 160, buf + 200);
                word v = aggcall val rawsym("q_Rt_x2ebounce")(r);
                return vecload(v, 0);
              } else {
                if (mkbool(arity == 7)) {
                  word r = aggcall ret rawsym("rt_call7")(code, caps, buf, buf + 40, buf + 80, buf + 120, buf + 160, buf + 200, buf + 240);
                  word v = aggcall val rawsym("q_Rt_x2ebounce")(r);
                  return vecload(v, 0);
                } else {
                  if (mkbool(arity == 8)) {
                    word r = aggcall ret rawsym("rt_call8")(code, caps, buf, buf + 40, buf + 80, buf + 120, buf + 160, buf + 200, buf + 240, buf + 280);
                    word v = aggcall val rawsym("q_Rt_x2ebounce")(r);
                    return vecload(v, 0);
                  } else {
                    if (mkbool(arity == 9)) {
                      word r = aggcall ret rawsym("rt_call9")(code, caps, buf, buf + 40, buf + 80, buf + 120, buf + 160, buf + 200, buf + 240, buf + 280, buf + 320);
                      word v = aggcall val rawsym("q_Rt_x2ebounce")(r);
                      return vecload(v, 0);
                    } else {
                      if (mkbool(arity == 10)) {
                        word r = aggcall ret rawsym("rt_call10")(code, caps, buf, buf + 40, buf + 80, buf + 120, buf + 160, buf + 200, buf + 240, buf + 280, buf + 320, buf + 360);
                        word v = aggcall val rawsym("q_Rt_x2ebounce")(r);
                        return vecload(v, 0);
                      } else {
                        if (mkbool(arity == 11)) {
                          word r = aggcall ret rawsym("rt_call11")(code, caps, buf, buf + 40, buf + 80, buf + 120, buf + 160, buf + 200, buf + 240, buf + 280, buf + 320, buf + 360, buf + 400);
                          word v = aggcall val rawsym("q_Rt_x2ebounce")(r);
                          return vecload(v, 0);
                        } else {
                          if (mkbool(arity == 12)) {
                            word r = aggcall ret rawsym("rt_call12")(code, caps, buf, buf + 40, buf + 80, buf + 120, buf + 160, buf + 200, buf + 240, buf + 280, buf + 320, buf + 360, buf + 400, buf + 440);
                            word v = aggcall val rawsym("q_Rt_x2ebounce")(r);
                            return vecload(v, 0);
                          } else {
                            if (mkbool(arity == 13)) {
                              word r = aggcall ret rawsym("rt_call13")(code, caps, buf, buf + 40, buf + 80, buf + 120, buf + 160, buf + 200, buf + 240, buf + 280, buf + 320, buf + 360, buf + 400, buf + 440, buf + 480);
                              word v = aggcall val rawsym("q_Rt_x2ebounce")(r);
                              return vecload(v, 0);
                            } else {
                              if (mkbool(arity == 14)) {
                                word r = aggcall ret rawsym("rt_call14")(code, caps, buf, buf + 40, buf + 80, buf + 120, buf + 160, buf + 200, buf + 240, buf + 280, buf + 320, buf + 360, buf + 400, buf + 440, buf + 480, buf + 520);
                                word v = aggcall val rawsym("q_Rt_x2ebounce")(r);
                                return vecload(v, 0);
                              } else {
                                if (mkbool(arity == 15)) {
                                  word r = aggcall ret rawsym("rt_call15")(code, caps, buf, buf + 40, buf + 80, buf + 120, buf + 160, buf + 200, buf + 240, buf + 280, buf + 320, buf + 360, buf + 400, buf + 440, buf + 480, buf + 520, buf + 560);
                                  word v = aggcall val rawsym("q_Rt_x2ebounce")(r);
                                  return vecload(v, 0);
                                } else {
                                  word r = aggcall ret rawsym("rt_call16")(code, caps, buf, buf + 40, buf + 80, buf + 120, buf + 160, buf + 200, buf + 240, buf + 280, buf + 320, buf + 360, buf + 400, buf + 440, buf + 480, buf + 520, buf + 560, buf + 600);
                                  word v = aggcall val rawsym("q_Rt_x2ebounce")(r);
                                  return vecload(v, 0);
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
// THE copyWords :val->WORD FIX (stage-6 B1fix): copyWords was a :val loop — a
// 40-byte blit + number boxing PER COPIED WORD (the B0perf-1 frameZero shape).
// It is now
// the rawAbi WORD defun pair Rt.copyWords/Rt.copyWordsGo: the WRAPPER is
// (dst, src, n) -> word and owns ONE malloc(8) counter cell (libc malloc,
// NOT a GC safepoint — the copy runs between two applyGo/applyTailGo
// safepoints and the cell is never a Value, so nothing can collect it), the
// LOOP is (dst, src, cnt) -> word and `recur`s on its THREE CONSTANT params
// (dst=a0, src=a1, cnt=a2 -> jmp @body) with the decrementing count held in
// the cell — exactly the frameZero discipline (state in memory, recur on
// constant params).  No :val anywhere on the path, so no per-word blit.  The
// copy is still exactly `n` words (indices n-1..0, 8 bytes each — the same
// reverse order as before; all call sites copy into a fresh non-overlapping
// buffer, so order is unobservable).
defun Rt.copyWords(dst : word, src : word, n : word) -> word {
  word cnt = rawcall malloc(8);
  wstore(cnt, 0, n);
  call Rt.copyWordsGo(dst, src, cnt);
  rawcall free(cnt);
  return 0;
}
defun Rt.copyWordsGo(dst : word, src : word, cnt : word) -> word {
  word i = wload(cnt, 0);
  if (i == 0) {
    return 0;
  } else {
    wstore(dst, i - 1, wload(src, i - 1));
    wstore(cnt, 0, i - 1);
    recur(dst, src, cnt);
  }
}
// ===== the stage-6 B2 mid-tail family (VERBATIM rt.zig rt_tail_known /
// bounce, rt.zig:932-977).  Rt.tail-known is a rawAbi WORD defun (code,
// argblock, nargs) whose RESULT is the 80-byte `:ret` (Agg "ret" — the body
// leaves mknum(retbuf) in slot 0 and the Lower @ret block blits the 80 bytes
// out, exactly Rt.apply-tail's saturated arm).  It stages the args into the
// STATIC buffer (globals word 12, malloc'd ONCE in Rt.main) for <=3 args —
// the no-allocation path, the Zig `tail_stage[3]` .bss buffer's job — or the
// GC allocvec fallback for >3 args (or QBE_NOTTAILSTAGE=1, globals word 13).
// THE SINGLE-.tail-IN-FLIGHT + NO-COLLECT INVARIANT (rt.zig:956-973, stated
// HERE at the Mid surface): the static buffer is SHARED and sound only
// because at most ONE .tail is in flight — its args are read EXACTLY ONCE by
// the callee's prologue blit, and the builder cannot run again before that
// (after tail-known returns the builder only blits the 80-byte :ret into slot
// 0, leaves its frame, and returns).  NO collection runs between the .tail
// build and that blit — the fresh allocvec array (and the static buffer's
// copies) are UNROOTED by convention and safe by it.  A future editor adding
// a GC alloc AFTER the staging copy (or in the Lower @ret blit block) breaks
// it SILENTLY — keep this defun alloc-free after the copy.
//
// Rt.bounce is a rawAbi WORD defun (one word param, the 80-byte :ret pointer)
// whose RESULT is the 40-byte `.done` Value (Agg "val").  Its body is the
// single-iteration fast path (kind==0 -> the `result` Value, `struct Ret` above)
// plus a hand-off to the :val self-tail loop Rt.bounceGo for an actual
// tail chain (kind==1).  Rt.bounceGo dispatches one hop (aggcall :ret rt_callN
// by arity — the callArityRet switch) and `recur`s on mknum(newRetPtr): the
// SAME :val self-tail Rt.applyGo uses (recur needs the val path; the rawAbi
// word tail rejects it).  CONSTANT NATIVE STACK: the loop is one C frame
// (jmp @body per hop, no recursion), exactly the Zig `bounce` trampoline.
// BOTH Mid dispatch sites route through it — Rt.main's entry dispatch and
// Rt.callArity's apply dispatch now `rawsym("q_Rt_x2ebounce")` instead of the
// Zig `rt_bounce` seat, so the clostail/1e6 mutual-tail entry chase runs the
// MID bounce loop (the unit's oracle), not a Zig seat left in mixed mode.
defun Rt.tail-known(code : word, argblock : word, nargs : word) -> val {
  word g = rawcall rt_glob_addr();
  word tsbuf = wload(g, 12);
  word noStage = wload(g, 13);
  word buf = payload((mkbool(nargs <= 3) && mkbool(noStage == 0)) ? mknum(tsbuf) : mknum(allocvec(nargs)), 0);
  call Rt.copyWords(buf, argblock, nargs * 5);
  *Ret retbuf = rawcall malloc(80);
  wstore(retbuf, 0, 0);
  wstore(retbuf, 1, 0);
  wstore(retbuf, 2, 0);
  wstore(retbuf, 3, 0);
  wstore(retbuf, 4, 0);
  retbuf->kind = 1;
  retbuf->code = code;
  retbuf->e = 0;
  retbuf->args = buf;
  retbuf->arity = nargs;
  return mknum(retbuf);
}
defun Rt.bounce(r : *Ret) -> val {
  word kind = r->kind;
  if (mkbool(kind == 0)) {
    return r->result;
  } else {
    return call Rt.bounceGo(mknum(r));
  }
}
defun Rt.bounceGo(r : val) -> val {
  *Ret rp = payload(r, 0);
  word kind = rp->kind;
  if (mkbool(kind == 0)) {
    return rp->result;
  } else {
    word f = rp->code;
    word e = rp->e;
    word args = rp->args;
    word arity = rp->arity;
    if (mkbool(arity == 0)) {
      word rr = aggcall ret rawsym("rt_call0")(f, e);
      recur(mknum(rr));
    } else {
      if (mkbool(arity == 1)) {
        word rr = aggcall ret rawsym("rt_call1")(f, e, args);
        recur(mknum(rr));
      } else {
        if (mkbool(arity == 2)) {
          word rr = aggcall ret rawsym("rt_call2")(f, e, args, args + 40);
          recur(mknum(rr));
        } else {
          if (mkbool(arity == 3)) {
            word rr = aggcall ret rawsym("rt_call3")(f, e, args, args + 40, args + 80);
            recur(mknum(rr));
          } else {
            if (mkbool(arity == 4)) {
              word rr = aggcall ret rawsym("rt_call4")(f, e, args, args + 40, args + 80, args + 120);
              recur(mknum(rr));
            } else {
              if (mkbool(arity == 5)) {
                word rr = aggcall ret rawsym("rt_call5")(f, e, args, args + 40, args + 80, args + 120, args + 160);
                recur(mknum(rr));
              } else {
                if (mkbool(arity == 6)) {
                  word rr = aggcall ret rawsym("rt_call6")(f, e, args, args + 40, args + 80, args + 120, args + 160, args + 200);
                  recur(mknum(rr));
                } else {
                  if (mkbool(arity == 7)) {
                    word rr = aggcall ret rawsym("rt_call7")(f, e, args, args + 40, args + 80, args + 120, args + 160, args + 200, args + 240);
                    recur(mknum(rr));
                  } else {
                    if (mkbool(arity == 8)) {
                      word rr = aggcall ret rawsym("rt_call8")(f, e, args, args + 40, args + 80, args + 120, args + 160, args + 200, args + 240, args + 280);
                      recur(mknum(rr));
                    } else {
                      if (mkbool(arity == 9)) {
                        word rr = aggcall ret rawsym("rt_call9")(f, e, args, args + 40, args + 80, args + 120, args + 160, args + 200, args + 240, args + 280, args + 320);
                        recur(mknum(rr));
                      } else {
                        if (mkbool(arity == 10)) {
                          word rr = aggcall ret rawsym("rt_call10")(f, e, args, args + 40, args + 80, args + 120, args + 160, args + 200, args + 240, args + 280, args + 320, args + 360);
                          recur(mknum(rr));
                        } else {
                          if (mkbool(arity == 11)) {
                            word rr = aggcall ret rawsym("rt_call11")(f, e, args, args + 40, args + 80, args + 120, args + 160, args + 200, args + 240, args + 280, args + 320, args + 360, args + 400);
                            recur(mknum(rr));
                          } else {
                            if (mkbool(arity == 12)) {
                              word rr = aggcall ret rawsym("rt_call12")(f, e, args, args + 40, args + 80, args + 120, args + 160, args + 200, args + 240, args + 280, args + 320, args + 360, args + 400, args + 440);
                              recur(mknum(rr));
                            } else {
                              if (mkbool(arity == 13)) {
                                word rr = aggcall ret rawsym("rt_call13")(f, e, args, args + 40, args + 80, args + 120, args + 160, args + 200, args + 240, args + 280, args + 320, args + 360, args + 400, args + 440, args + 480);
                                recur(mknum(rr));
                              } else {
                                if (mkbool(arity == 14)) {
                                  word rr = aggcall ret rawsym("rt_call14")(f, e, args, args + 40, args + 80, args + 120, args + 160, args + 200, args + 240, args + 280, args + 320, args + 360, args + 400, args + 440, args + 480, args + 520);
                                  recur(mknum(rr));
                                } else {
                                  if (mkbool(arity == 15)) {
                                    word rr = aggcall ret rawsym("rt_call15")(f, e, args, args + 40, args + 80, args + 120, args + 160, args + 200, args + 240, args + 280, args + 320, args + 360, args + 400, args + 440, args + 480, args + 520, args + 560);
                                    recur(mknum(rr));
                                  } else {
                                    // UNREACHABLE today: the compiler enforces
                                    // max arity 16 (the same convention as
                                    // Rt.callArity's table), so the innermost
                                    // else is arity >= 16 only when arity == 16
                                    // and routes correctly.  A HAND-BUILT :tail
                                    // with arity > 16 would land here and read
                                    // args+600..+760 PAST a smaller buffer —
                                    // silent corruption, where Zig callArityRet's
                                    // else dies loudly (rt.zig:1005).  Kept as a
                                    // documented parity gap, not a B2 regression.
                                    word rr = aggcall ret rawsym("rt_call16")(f, e, args, args + 40, args + 80, args + 120, args + 160, args + 200, args + 240, args + 280, args + 320, args + 360, args + 400, args + 440, args + 480, args + 520, args + 560, args + 600);
                                    recur(mknum(rr));
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

// ==================== STAGE 7A: THE MID EFFECT HOST =======================
// The CEK effect-manager state machine of src/effectloop.zig, PORTED (plan
// stage7-plan.md §3, §7.3's 7A row).  DEFAULT since stage 7's O2 (the ZIG host
// was the `QBE_MIDHOST=0` opt-out (RETIRED at O4 with the Zig host)
// O4 deletes it), and `Rt.main` picks between them at RUNTIME (a getenv hatch
// spliced in by run.js at COMPILE time — see the markers around that arm, and
// the comment there for why the splice is compile-time).
//
// THE STATE (plan §3.1): ONE `val[]` slot array, permanently ROOTED by
// `Rt.rootPushValueArray`, and everything else plain WORDS in one malloc'd
// C-heap blob.  The array is the Zig loop's `.slots` discipline verbatim: a
// Value that must outlive ONE host defun's frame lives in a slot and is
// re-read at the point of use (the `val` bridge's obligation 2,
// Mid/RtLang/Ast.elm's B7 header).  A Value held inside a host defun's own
// frame needs no such care: this machine's defuns are the runtime's ordinary
// VALUE ABI (lean, framed), and a framed defun's binder slots are REGISTERED
// ROOTS (Rt.frame-enter pushes `value_array(base, hdr)` and hdr->live is the
// slot count), so the collector scans and UPDATES them in place.
//
// WHY VALUE-ABI AND NOT THE rawAbi + indices SPLIT (a measured deviation from
// plan §3.3, which proposed an all-rawAbi machine): a raw-word defun's tail
// CANNOT JOIN two word-returning branches ("qbe: raw-abi defun tail If joins
// two word-returning branches ... one branch must be a self-tail recur"), so
// in a rawAbi defun a mid-block guard `if (c) { return 0; }` is refused, and
// the 20-way ctor dispatch can only be written as a 20-deep if/ELSE nest whose
// one branch recurs.  MEASURED on this tree (a 3-guard rawAbi loop and the
// plan's §3.3 snippet both fail to compile).  In a VALUE defun the dispatch is
// the natural chain Rt.deepEq already spells.  The word defuns here are the
// ones whose body IS straight-line or a single-guard loop.
//
// THE BLOB IS malloc'd, NEVER A STACK LOCAL AND NEVER ON THE MID HEAP: as a
// stack local it made a native caller's frame ~1.9 MB and SEGV'd the 8 MB
// stack (effectloop.zig:1170-1178's own measurement), and the collector needs
// the slot array's ADDRESS to stay put across collects (the root
// registration).  Raw C-heap pointers are invisible to the GC, which is what
// makes `mknum(blob)` / `payload(hN, 0)` a sound way to carry one in a Value.
//
// LAYOUT (byte offsets MEASURED against TestMain's 7A rows, which recompute
// them from THESE declarations — Mid has no `sizeof`, so hostInit's malloc
// size is an ARITHMETIC LITERAL and the pin is what keeps it honest):
//
//   @0        nslots    the count the root scan reads AT SCAN TIME
//   @8        slots     the rooted val array; slot k is at byte 8 + 40k
//   @1321248  nevals    high-water mark of the eval table (first-inactive reuse)
//   @1321256  nactive   live evaluations
//   @1321264  quit      the TaskQuit latch
//   @1321272  cur       hostStepAll's cursor (a loop cursor LIVES IN MEMORY:
//                       a self-tail `recur` may only pass its params back
//                       unchanged — "raw-abi self-tail arg 1 is not the param
//                       register" is the same rule's other face)
//   @1321280  clr       hostClearGo's cursor
//   @1321288  clrBase   hostClearGo's block base
//   @1321296  evals     HostEv[128], 4224 bytes each
//   @1860944  npoll     7C: the fd table's live count (the kernel's nfds)
//   @1860952  poll      7C: the malloc'd `struct HostPoll` (a raw C pointer —
//                       a SEPARATE allocation, see the decl's comment for why
//                       it is not a field)
//
// THE SLOT ARRAY (33031 slots = 2 + 128 x 258 + 5):
//   0        model
//   1        update (the Program's updateFn)
//   2..      per-evaluation blocks, 258 slots each: task, result, 256 frame
//            slots (a frame slot holds the continuation/handler CLOSURE; the
//            frame stack is push/pop only, so nframes indexes it directly —
//            the Zig's `cont_slot` is the same index saved one level down)
//   33026    SCR_CUR   the Cmd cons-walk cursor
//   33027    SCR_A0    the applier's argument area (contiguous: callArity
//   33028    SCR_A1    needs buf + 40k, so a slice of the rooted array IS the
//                       argument buffer — no copy, no second referee)
//   33029    SCR_RES   the applier's result cell
//   33030    SCR_TMP   the spawn/pushFrame staging cell
// The last eval block ends at slot 33025, so the five scratch cells are
// outside every block.  SCR_* are consts-by-comment (Mid has no top-level
// constants); TestMain pins the arithmetic against the declarations above.
//
// EFFECTS (plan §5.1): no sum types in Mid, so `etag` is a word (0 none,
// 1 readFile, 2 exec, 3 sleep — the Zig enum order) beside ONE anonymous
// promoted `union { ... }` block whose members are named once, globally.
// 7A only ever sets etag = 0; 7B-7E fill the unions in.
// the Rt.main arm above — KEPT by DEFAULT since O2, dropped only on
// the now-deleted QBE_MIDHOST=0 escape hatch.  With the
// region dropped the emit does not even PARSE the host, which is what makes
// `Rt.load`'s `hosted` flag — the reachability gate — a STRUCTURAL question
// ("does the surface define Rt.hostRun?") and not a text search: the selfhost
// lane's Prelude has NO `String.contains` (MEASURED: `qbe-bootstrap.sh --status`
// -> "err type error ... unknown name: String.contains").  A host-less build
// also carries no host key at all, so `rtDeps`' host entries have no phantom
// target.
// "qbe-rt: error: " + a + b + "\n", then exit 1.  The Zig host raised a
// VmError the deleted Zig host printed with this prefix; Rt.die has no prefix
// (it is the runtime's own halt), so the port carries the prefix HERE and the
// selfhost/gate rows that assert a stderr shape keep seeing it (plan §5.5,
// gap G-J).  Two parameters because both the plain error and the unported-leaf
// error share one printer.
defun Rt.hostDieErr(a : word, b : word) -> word {
  word pre = rawstr("qbe-rt: error: ");
  val plen = call Rt.cStrLenGo(mknum(pre), mknum(0));
  rawcall write(2, pre, payload(plen, 0));
  val alen = call Rt.cStrLenGo(mknum(a), mknum(0));
  rawcall write(2, a, payload(alen, 0));
  val blen = call Rt.cStrLenGo(mknum(b), mknum(0));
  rawcall write(2, b, payload(blen, 0));
  rawcall write(2, rawstr("\n"), 1);
  rawcall exit(1);
  return 0;
}
defun Rt.dieErr(msg : word) -> word {
  return call Rt.hostDieErr(rawstr(""), msg);
}
// THE UNPORTED SEAT IS GONE (stage 7E).  `Rt.hostDieUnported` existed for one
// reason — 7A-7D implemented 18 of Runtime.elm's twenty Task constructors and
// the rest had to die LOUD rather than be silently dropped — and 7E implements
// the last two.  The defun is DELETED rather than left uncalled so that the
// claim is checkable by grep: no "unported" text survives in this file, and a
// later editor who wants a porting gate back has to write one, not reopen one.
// The dispatch's tail is now the ZIG's own arm (its `unhandled Task effect`
// message, printed through hostDieErr directly).

defun Rt.hostNowMs(dummy : val) -> val {
  HostTs t;
  t.sec = 0;
  t.nsec = 0;
  rawcall clock_gettime(1, &t);           // 1 = CLOCK_MONOTONIC, an OUT param
  word s = t.sec;
  word ns = t.nsec;
  return mknum((s * 1000) + (ns / 1000000));
}

// ============== STAGE 7B: THE SYNCHRONOUS LEAVES + THE DEADLINES ==========
// The leaves that neither suspend on an fd nor fork: TaskWrite, TaskWriteFile,
// TaskReadLine (all SYNCHRONOUS in the Zig host too) and TaskSleep (the one
// SUSPENDING leaf of 7B — it holds no fd, only an absolute monotonic
// deadline), plus the six prim leaves that CALL an existing Mid defun.
//
// THE PRIM LEAVES NEED NO MACHINERY AT ALL: effectloop.zig's `leafPrim` wraps
// the arg into a fresh `ValueArray` and calls `prims.execPrimitive` by NAME
// (`runPrim` -> vaInit/vaPush, with the arg array and the stack rooted across
// both).  Here the prim IS a Mid defun (`Rt.getenv`/`Rt.setenv`/`Rt.cd`/
// `Rt.getcwd`/`Rt.getpid`/`Rt.glob`, runtime.mid's GROUP 3A/3B port), so the
// leaf is one `call` and the `runPrim`/`varray` dance does not translate — it
// DISAPPEARS (the port's one net deletion, plan §7.3's 7B row).
//
// NO RAW COPY OF A VALUE CROSSES AN ALLOCATING CALL (the `val` bridge's
// obligation 2): every leaf reads its arguments out of the rooted slot array
// (via the task vector's data pointer) BEFORE the allocating leaf call, and
// writes its result straight into the eval's result slot, whose ADDRESS is a
// slice of the C-heap-resident rooted array and therefore never moves.
//
// STRINGS ARE NUL-COPIED BEFORE A RAW CALL (plan §6 G-G), and for a stronger
// reason than "not NUL-terminated": a string's data pointer is EVACUATED by
// the collector (gc/scan.zig's scanValue: `.string => evacuate(str.data)`), so
// `payload(str, 0)` is a MOVING pointer and the runtime's idiom — allocraw(len
// + 1) + `Rt.cStrFill(bufN, str, 0)` + the rawcall — is the only shape that
// re-reads the string from a rooted binder while the copy proceeds.
defun Rt.hostWriteAll(fdN : val, ptrN : val, lenN : val) -> val {
  word fd = payload(fdN, 0);
  word ptr = payload(ptrN, 0);
  word len = payload(lenN, 0);
  if (mkbool(len <= 0)) {
    return mknum(0);
  } else {
    word n = rawcall write(fd, ptr, len);
    if (mkbool(n < 0)) {
      if (mkbool(byteload(rawcall __errno_location(), 0) == 4)) {
        recur(fdN, ptrN, lenN);            // EINTR: retry the same bytes
      } else {
        return mknum(0);                   // real error: stop (writeFdAll's
      }                                    // best-effort contract)
    } else {
      if (mkbool(n == 0)) {
        return mknum(0);
      } else {
        recur(fdN, mknum(ptr + n), mknum(len - n));
      }
    }
  }
}

// The `s -> fd` sink both TaskWrite and TaskWriteFile use.
defun Rt.hostWriteStr(fdN : val, str : val) -> val {
  word len = len32(str);
  word buf = allocraw(len + 1);
  call Rt.cStrFill(mknum(buf), str, mknum(0));
  return call Rt.hostWriteAll(fdN, mknum(buf), mknum(len));
}

// TaskWriteFile path contents — openat(WRONLY|CREAT|TRUNC, 0666) + write +
// close (the flags are Rt.open's "out" arm's own literals).  AN OPEN FAILURE
// COMPLETES SUCCESS WITH UNIT, exactly as the Zig does (`nativeio`'s sentinel
// is the fixture that depends on the swallow).
defun Rt.hostWriteFileLeaf(path : val, contents : val) -> val {
  word len = len32(path);
  word buf = allocraw(len + 2);
  call Rt.cStrFill(mknum(buf), path, mknum(0));
  word fd = rawcall openat(-100, buf, 577, 438);
  if (mkbool(fd < 0)) {
    return mknil;
  } else {
    call Rt.hostWriteStr(mknum(fd), contents);
    rawcall close(fd);
    return mknil;
  }
}

// --- TaskReadLine -------------------------------------------------------
// Sync ON PURPOSE (stdin is ONE shared fd; interleaving reads of fd 0 is
// meaningless — the Zig says so in the same words).  Byte at a time from fd 0,
// stop at 0x0A or EOF, grow the accumulator by doubling.
//
// THE ACCUMULATOR IS A C-HEAP BLOCK, NEVER A VALUE: the collector cannot see
// it, so it cannot move it, so the whole loop is free of the raw/stale class.
// Layout (32 bytes): 0 len, 8 cap, 16 buf, 24 the 1-byte read scratch.
// Growth copies through `Rt.memGo` (`struct CopyDesc` — the SAME descriptor
// read-file-as-string's grow uses) and FREES the old block, so a long-lived
// line reader does not leak.  The OOM arm returns 0 and the caller completes
// with the bytes it already has — the Zig's `catch break`.
defun Rt.hostLineGrow(cellN : val) -> val {
  word cell = payload(cellN, 0);
  word len = wload(cell, 0);
  word cap = wload(cell, 1);
  word old = wload(cell, 2);
  word ncap = cap * 2;
  word nbuf = rawcall malloc(ncap);
  if (mkbool(nbuf == 0)) {
    return mknum(0);
  } else {
    *CopyDesc d = rawcall malloc(24);
    d->src = old;
    d->dst = nbuf;
    d->n = len;
    call Rt.memGo(mknum([word](d)), mknum(0));
    wstore(cell, 1, ncap);
    wstore(cell, 2, nbuf);
    rawcall free(old);
    rawcall free(d);
    return mknum(1);
  }
}
defun Rt.hostReadLineLoop(cellN : val) -> val {
  word cell = payload(cellN, 0);
  word n = rawcall read(0, wload(cell, 3), 1);
  if (mkbool(n <= 0)) {
    return mknil;                          // EOF (0) or a read error
  } else {
    word b = byteload(wload(cell, 3), 0);
    if (mkbool(b == 10)) {
      return mknil;                        // 0x0A ends the line
    } else {
      word len = wload(cell, 0);
      val grew = if (mkbool(len >= wload(cell, 1))) {
        return call Rt.hostLineGrow(cellN);
      } else {
        return mknum(1);
      };
      if (mkbool(payload(grew, 0) == 0)) {
        return mknil;                      // OOM: deliver what we have
      } else {
        bytestore(wload(cell, 2), len, b);
        wstore(cell, 0, len + 1);
        recur(cellN);
      }
    }
  }
}
defun Rt.hostReadLine(dummy : val) -> val {
  word cell = rawcall malloc(32);
  word buf = rawcall malloc(128);
  word one = rawcall malloc(1);
  wstore(cell, 0, 0);
  wstore(cell, 1, 128);
  wstore(cell, 2, buf);
  wstore(cell, 3, one);
  call Rt.hostReadLineLoop(mknum(cell));
  word len = wload(cell, 0);
  word src = wload(cell, 2);
  word dst = allocraw(len + 1);
  *CopyDesc d = rawcall malloc(24);
  d->src = src;
  d->dst = dst;
  d->n = len;
  call Rt.memGo(mknum([word](d)), mknum(0));
  bytestore(dst, len, 0);
  val s = mkstr(dst, len);
  rawcall free(d);
  rawcall free(one);
  // THE CURRENT BUFFER, re-read from the cell — NOT the one this defun
  // malloc'd: a grow FREES the old block, so freeing `buf` here double-freed
  // it (MEASURED, and only on a line longer than the first 128-byte buffer:
  // `free(): double free detected in tcache 2`).  progio's stdin is longer
  // than one buffer so the gate walks this path every run.
  rawcall free(src);
  rawcall free(cell);
  return s;
}

// --- TaskReadFile + THE ACCUMULATOR (stage 7C) --------------------------
// The Zig's leafReadFile/readFileDrain/readFileComplete (effectloop.zig:517-555)
// — the FIRST SUSPENDING leaf that owns an fd, and the reason the poll table
// exists at all.
//
// A REGULAR FILE DRAINS TO EOF SYNCHRONOUSLY (read() on a regular file never
// returns EAGAIN), so this leaf normally finishes inside its own dispatch with
// no poll — and THAT is what lets a readFile OVERTAKE a concurrently suspended
// exec (the concurrency proof, `asyncorder`).  The SUSPENDED arm is a pipe, a
// fifo or a terminal: the fd joins the table in hostRebuildPollfds, the poll
// blocks on it, and hostDrainReady re-enters the drain.
//
// THE ACCUMULATOR IS A C-HEAP BLOCK, NEVER A VALUE (7B's readLine argument, and
// for the same reason): the collector cannot see it, so it cannot move it, so
// the whole loop is free of the raw/stale class.  Its three words live in the
// eval's own effect (`rf.bptr/blen/bcap`), so the drain needs no cell and no
// extra parameter — a `call Rt.*` carries at most THREE args.
//
// THE GROW, THE FREE ORDER AND THE OOM ARM ARE 7B's DOUBLE-FREE CLASS
// (handoff-s7-7b-result): `hostRfGrow` FREES the old block, so every caller
// re-reads `bptr` FROM THE EFFECT and never from a local taken before the
// grow, and nothing reads a block after freeing it.  `free(0)` is a documented
// no-op, which is what lets the first-grow path (bptr == 0) share the code.
defun Rt.hostRfGrow(hN : val, iN : val, needN : val) -> val {
  word h = payload(hN, 0);
  word i = payload(iN, 0);
  word need = payload(needN, 0);
  *Host lp = [*Host](h);
  if (mkbool(need <= lp->evals[i].rf.bcap)) {
    return mknil;                          // already big enough: no alloc
  }
  word ncap = 65536;                       // the first capacity: one read chunk
  while (ncap < lp->evals[i].rf.bcap) {
    ncap = ncap * 2;
  }
  while (ncap < need) {
    ncap = ncap * 2;
  }
  word nbuf = rawcall malloc(ncap);
  if (mkbool(nbuf == 0)) {
    return mknil;                          // OOM: bcap is UNCHANGED, and that
  }                                        // is the caller's failure signal
  word old = lp->evals[i].rf.bptr;
  word len = lp->evals[i].rf.blen;
  *CopyDesc d = rawcall malloc(24);
  d->src = old;
  d->dst = nbuf;
  d->n = len;                              // len == 0 on the first grow, and
  call Rt.memGo(mknum([word](d)), mknum(0)); // memGo copies nothing for n == 0
  rawcall free(d);
  rawcall free(old);                       // free(0) on the first grow: a no-op
  lp->evals[i].rf.bptr = nbuf;
  lp->evals[i].rf.bcap = ncap;
  return mknil;
}

// ONE read, then either append-and-loop (self-tail) or FINISH.  Returns
// 0 = STILL PENDING (the eval suspends), 1 = COMPLETE (EOF, a real error, or
// an OOM in the accumulator).
//
// THE WOULDBLOCK DISTINCTION IS THE POINT (plan §7.3's 7C risk): `read`
// returning -1 with errno EAGAIN (11) is NOT an error — it is "no bytes yet,
// poll again" — while any other errno completes with what has been gathered
// (the Zig's `return true`).  EINTR (4) is retried in place, which is what
// std.posix.read does internally in the Zig.
//
// THE ERRNO READ IS THE PRE-EXISTING ONE-BYTE `byteload(__errno_location(), 0)`
// (the cffi plan's `errno < 256` shape, 7B's EINTR arm beside it).  It is
// correct on Linux/x86_64 and is deliberately NOT re-spelled here — a widened
// read is its own finding, not this unit's.
//
// EACH CONDITIONAL'S BRANCH DIVERGES (return/recur), which is what makes the
// loop expressible at all: a mid-block `if` with two falling-through branches
// is J7's loud reject.
defun Rt.hostReadFileDrain(hN : val, iN : val) -> val {
  word h = payload(hN, 0);
  word i = payload(iN, 0);
  *Host lp = [*Host](h);
  word n = rawcall read(lp->evals[i].rf.fd, lp->evals[i].rf.tmp, 65536);
  if (mkbool(n == 0)) {
    return mknum(1);                       // EOF: complete with what we have
  }
  if (mkbool(n < 0)) {
    word e = byteload(rawcall __errno_location(), 0);
    if (mkbool(e == 4)) {
      recur(hN, iN);                       // EINTR: retry the same read
    } else {
      if (mkbool(e == 11)) {
        return mknum(0);                   // EAGAIN: STILL PENDING, poll again
      } else {
        return mknum(1);                   // a real error: complete as-is
      }
    }
  }
  word need = lp->evals[i].rf.blen + n;
  call Rt.hostRfGrow(hN, iN, mknum(need));
  if (mkbool(lp->evals[i].rf.bcap < need)) {
    return mknum(1);                       // OOM: complete with what we have
  }
  *CopyDesc d = rawcall malloc(24);
  d->src = lp->evals[i].rf.tmp;
  d->dst = lp->evals[i].rf.bptr + lp->evals[i].rf.blen;
  d->n = n;
  call Rt.memGo(mknum([word](d)), mknum(0));
  rawcall free(d);
  lp->evals[i].rf.blen = need;
  recur(hN, iN);
}

// The Zig's readFileComplete: close the fd, build the String out of the
// accumulator, free the accumulator AND the read chunk, clear the effect and
// complete SUCCESS.
//
// THE STRING IS BUILT BEFORE THE FREE and out of `bptr` read ONCE — the count
// is captured before the copy for the same reason (a free is not an alloc, but
// the discipline that keeps the 7B double-free out is "read the effect's words,
// use them, free last").
defun Rt.hostReadFileComplete(hN : val, iN : val) -> val {
  word h = payload(hN, 0);
  word i = payload(iN, 0);
  *Host lp = [*Host](h);
  word len = lp->evals[i].rf.blen;
  word src = lp->evals[i].rf.bptr;
  word dst = allocraw(len + 1);
  *CopyDesc d = rawcall malloc(24);
  d->src = src;
  d->dst = dst;
  d->n = len;                              // an empty file copies nothing
  call Rt.memGo(mknum([word](d)), mknum(0));
  rawcall free(d);
  bytestore(dst, len, 0);
  val s = mkstr(dst, len);
  rawcall close(lp->evals[i].rf.fd);       // the leaf opened it; it is valid
  rawcall free(src);
  rawcall free(lp->evals[i].rf.tmp);
  lp->evals[i].rf.fd = -1;
  lp->evals[i].rf.bptr = 0;
  lp->evals[i].rf.blen = 0;
  lp->evals[i].rf.bcap = 0;
  lp->evals[i].rf.tmp = 0;
  lp->evals[i].etag = 0;
  vecstore(h + 8 + ((lp->evals[i].base + 1) * 40), 0, s);
  return call Rt.hostCompleteOk(hN, iN);
}

// TaskReadFile — the leaf.  `openat(O_NONBLOCK)` (no CREAT, mode 0 — the Zig's
// `.NONBLOCK` set), drain, and either complete or SUSPEND with etag = 1.
//
// AN OPEN FAILURE COMPLETES SUCCESS WITH THE EMPTY STRING (M6 parity, the
// Zig's `catch` arm; `nativeio`'s sibling contract is the same for write).
defun Rt.hostLeafReadFile(hN : val, iN : val, pathN : val) -> val {
  word h = payload(hN, 0);
  word i = payload(iN, 0);
  *Host lp = [*Host](h);
  word len = len32(pathN);
  word buf = allocraw(len + 2);
  call Rt.cStrFill(mknum(buf), pathN, mknum(0));
  word fd = rawcall openat(-100, buf, 2048, 0);   // O_RDONLY|O_NONBLOCK
  if (mkbool(fd < 0)) {
    val empty = "";
    vecstore(h + 8 + ((lp->evals[i].base + 1) * 40), 0, empty);
    return call Rt.hostCompleteOk(hN, iN);
  }
  lp->evals[i].rf.fd = fd;
  lp->evals[i].rf.bptr = 0;
  lp->evals[i].rf.blen = 0;
  lp->evals[i].rf.bcap = 0;
  lp->evals[i].rf.tmp = rawcall malloc(65536);
  lp->evals[i].etag = 1;                   // the ladder's order: 1 readFile
  if (payload(call Rt.hostReadFileDrain(hN, iN), 0) == 0) {
    return mknil;                          // EAGAIN: the poll resumes it
  }
  return call Rt.hostReadFileComplete(hN, iN);
}

// --- the DEADLINE machinery (TaskSleep) ---------------------------------
// A sleeping evaluation stays ACTIVE with `etag = 3` and an ABSOLUTE
// monotonic deadline in `sl.deadline`; `hostStepGo`/`hostStepAllGo` skip any
// eval whose etag is non-zero, so the driver is what wakes it:
//
//   hostStepAll -> hostFlushExpiredSleeps (complete every expired sleep, in
//   deadline order) -> hostRunnableScan (any pure work left? loop) ->
//   hostPollTimeout -> poll(0 fds, timeout) -> loop.
//
// A SLEEP IS THE ONLY PENDING EFFECT 7B CAN PRODUCE, so with no fd table yet
// (7C owns it) the poll is a bounded SLEEP: poll(NULL, 0, ms) is the portable
// way to spell one, and it is exactly what the Zig's npoll == 0 branch falls
// through to.  `etag` values are the Zig enum's order (plan §5.1): 0 none,
// 1 readFile, 2 exec, 3 sleep — so 7C/7D extend the same ladder.
//
// Rt.hostSleepScan — the earliest (or earliest EXPIRED) sleep, as an INDEX
// (-1 = none).  `bestN` is the winner's index and `bestDN` its deadline, both
// carried as params (the scan is a value self-tail, hostSpawnFind's shape)
// rather than in a memory cursor, so nothing here touches `lp->cur`/`lp->clr`.
// `nowN < 0` means "no expiry filter".
defun Rt.hostSleepScan(hN : val, cellN : val) -> val {
  word h = payload(hN, 0);
  word c = payload(cellN, 0);
  *HostScan s = [*HostScan](c);
  *Host lp = [*Host](h);
  if (mkbool(s->i >= lp->nevals)) {
    return mknum(s->best);
  } else {
    word idx = s->i;
    word d = lp->evals[idx].sl.deadline;
    val earlier = mkbool(s->bestD < 0) || mkbool(d < s->bestD);
    val expired = mkbool(s->now < 0) || mkbool(d <= s->now);
    val take = if (mkbool(lp->evals[idx].etag == 3) && earlier && expired) {
      s->best = idx;
      s->bestD = d;
      return mknum(1);
    } else {
      return mknum(0);
    };
    s->i = idx + 1;
    recur(hN, cellN);
  }
}
defun Rt.hostNearestSleep(hN : val) -> val {
  word c = rawcall malloc(32);
  *HostScan s = [*HostScan](c);
  s->i = 0;
  s->best = -1;
  s->bestD = -1;
  s->now = -1;
  val idx = call Rt.hostSleepScan(hN, mknum(c));
  word i = payload(idx, 0);
  val d = mkbool(i < 0) ? mknum(-1) : mknum([*Host](payload(hN, 0))->evals[i].sl.deadline);
  rawcall free(c);
  return d;
}
// The poll timeout: the nearest deadline in ms (so a sleeping eval wakes the
// poll instead of blocking past it), 0 once it is due, and -1 = block
// indefinitely when nothing is pending.  The i32 clamp is the Zig's @min.
defun Rt.hostPollTimeout(hN : val) -> val {
  word d = payload(call Rt.hostNearestSleep(hN), 0);
  if (mkbool(d < 0)) {
    return mknum(-1);
  } else {
    word now = payload(call Rt.hostNowMs(mknil), 0);
    word remain = d - now;
    if (mkbool(remain <= 0)) {
      return mknum(0);
    } else {
      if (mkbool(remain > 2147483647)) {
        return mknum(2147483647);
      } else {
        return mknum(remain);
      }
    }
  }
}
defun Rt.hostSleepComplete(hN : val, iN : val) -> val {
  word h = payload(hN, 0);
  word i = payload(iN, 0);
  *Host lp = [*Host](h);
  lp->evals[i].etag = 0;
  vecstore(h + 8 + ((lp->evals[i].base + 1) * 40), 0, mknil);
  return call Rt.hostCompleteOk(hN, iN);
}
// Complete every expired sleep, EARLIEST FIRST; each completion may deliver
// and spawn, so the scan restarts after each one.  `now` is re-read per
// iteration (the Zig reads it once) — a completion that itself takes time can
// only make more sleeps due, never fewer, and a freshly spawned sleep's
// deadline is now+ms (strictly future for ms > 0), so this cannot livelock.
defun Rt.hostFlushExpiredSleeps(hN : val) -> val {
  word c = rawcall malloc(32);
  *HostScan s = [*HostScan](c);
  s->i = 0;
  s->best = -1;
  s->bestD = -1;
  s->now = payload(call Rt.hostNowMs(mknil), 0);
  val idx = call Rt.hostSleepScan(hN, mknum(c));
  word i = payload(idx, 0);
  rawcall free(c);
  if (mkbool(i < 0)) {
    return mknil;
  } else {
    call Rt.hostSleepComplete(hN, mknum(i));
    recur(hN);
  }
}
// Any evaluation that can make progress WITHOUT waiting (the Zig's
// hasRunnable: active and no pending effect)?
defun Rt.hostRunnableScan(hN : val, iN : val) -> val {
  word h = payload(hN, 0);
  word i = payload(iN, 0);
  *Host lp = [*Host](h);
  if (mkbool(i >= lp->nevals)) {
    return mknum(0);
  } else {
    if (mkbool(lp->evals[i].active != 0) && mkbool(lp->evals[i].etag == 0)) {
      return mknum(1);
    } else {
      recur(hN, mknum(i + 1));
    }
  }
}

// ============== STAGE 7C: THE fd TABLE + THE POLL =========================
// The Zig's rebuildPollfds/addPoll/drainReady/cleanupAll (effectloop.zig:991,
// 1010, 1081, 1115), ported for the one effect 7C makes suspendable
// (readFile); the exec roles are 7D's and are already threaded through the
// table so that unit only fills its arms in.
//
// THE LIFETIME (plan §6 gap G-H): ONE malloc'd `struct HostPoll` at hostInit,
// its address in `lp->poll`, its 258 `struct pollfd` cells given to the kernel
// every iteration.  Nothing reallocs it and nothing moves it, so the pointer
// handed to poll() is the same object for the whole run, and a collect between
// the rebuild and the drain can move every VALUE in the machine without
// touching one byte of what the kernel wrote.
//
// THREE PARALLEL ARRAYS, NOT AN ARRAY OF STRUCTS WITH A POINTER IN IT: `fds` is
// the C layout the kernel demands, `evals[k]` is the evaluation that owns fd k
// and `roles[k]` says what a readiness event on it MEANS.  The role is
// 1 readFile / 2 exec-stdout / 3 exec-stderr — the Zig's PollRole enum order.
//
// THE nfds INVARIANT: `lp->npoll` is written in exactly TWO places — set to 0
// by hostRebuildPollfds, incremented by hostAddPoll — and the value handed to
// poll() is read ONCE, in the same statement, from the field the scan just
// filled.  There is no other reader and no other writer, so "nfds matches the
// number of registered fds" is a structural property of the two defuns rather
// than a number two places agree to compute (TestMain pins both).
defun Rt.hostPollFd(hN : val, iN : val, roleN : val) -> val {
  word h = payload(hN, 0);
  word i = payload(iN, 0);
  word role = payload(roleN, 0);
  *Host lp = [*Host](h);
  if (role == 1) {
    return mknum(lp->evals[i].rf.fd);      // readFile: one fd
  }
  if (role == 2) {
    return mknum(lp->evals[i].ex.outfd);   // exec stdout (7D)
  }
  if (role == 3) {
    return mknum(lp->evals[i].ex.errfd);   // exec stderr (7D)
  }
  return mknum(-1);
}
defun Rt.hostAddPoll(hN : val, iN : val, roleN : val) -> val {
  word h = payload(hN, 0);
  word i = payload(iN, 0);
  word role = payload(roleN, 0);
  *Host lp = [*Host](h);
  *HostPoll pp = [*HostPoll](lp->poll);
  word fd = payload(call Rt.hostPollFd(hN, iN, roleN), 0);
  if (mkbool(fd < 0)) {
    return mknil;                          // no fd for this role: the Zig's
  }                                        // `if (fd >= 0)` guard, ONE place
                                           // NOTE FOR 7D: that guard rests on the
                                           // NEGATIVE sentinel.  hostInit memsets
                                           // the whole table, so a never-set
                                           // `ex.outfd`/`ex.errfd` reads 0 — a
                                           // VALID fd.  The exec leaf must write
                                           // -1 into both when it spawns (the Zig's
                                           // ExecEff defaults), or this guard
                                           // registers stdin twice.
  word n = lp->npoll;
  if (mkbool(n >= 258)) {
    call Rt.dieErr(rawstr("host: more than 258 pollfds (MAX_EVALS * 2 + 2)"));
    return mknil;
  }
  pp->fds[n].fd = fd;
  pp->fds[n].events = 1;                   // POLLIN
  pp->fds[n].revents = 0;                  // the kernel's slot, zeroed for
  pp->evals[n] = i;                        // every rebuild
  pp->roles[n] = role;
  lp->npoll = n + 1;
  return mknil;
}
// ONE eval -> its poll entries, selected by its OWN etag (the Zig's switch on
// the effect).  A runnable (0) or sleeping (3) eval registers NOTHING: a sleep
// bounds the TIMEOUT (hostPollTimeout) rather than the fd set.
defun Rt.hostRebuildPollGo(hN : val, iN : val) -> val {
  word h = payload(hN, 0);
  word i = payload(iN, 0);
  *Host lp = [*Host](h);
  if (i >= lp->nevals) {
    return mknil;
  }
  if (lp->evals[i].active == 0) {
    recur(hN, mknum(i + 1));
  }
  if (lp->evals[i].etag == 1) {
    call Rt.hostAddPoll(hN, mknum(i), mknum(1));
    recur(hN, mknum(i + 1));
  }
  if (lp->evals[i].etag == 2) {
    call Rt.hostAddPoll(hN, mknum(i), mknum(2));
    call Rt.hostAddPoll(hN, mknum(i), mknum(3));
    recur(hN, mknum(i + 1));
  }
  recur(hN, mknum(i + 1));
}
// The scan.  `npoll = 0` FIRST, then every eval appends — so the table is
// exactly the live fds after the pass, never the union with the previous pass
// (a stale entry would let the kernel report readiness on an fd the machine has
// already closed and reused).
//
// THE CURSOR IS A PARAMETER, not `lp->cur`: hostStepAll owns `cur` for its own
// pass and this scan must not disturb it.
defun Rt.hostRebuildPollfds(hN : val) -> val {
  word h = payload(hN, 0);
  *Host lp = [*Host](h);
  lp->npoll = 0;
  return call Rt.hostRebuildPollGo(hN, mknum(0));
}

// ONE ready table entry.  Every guard is an early return (J7's divergence rule)
// and each is load-bearing:
//   * revents == 0 — the entry is not ready;
//   * the eval is no longer active, or no longer carries the effect this ROLE
//     belongs to (etag 1 readFile / 2 exec) — the table is one poll old, and a
//     completion earlier in this same pass can free a slot and respawn a
//     DIFFERENT evaluation into it.  The `etag` test is stricter than the Zig's
//     bare `active` test and costs one load (7C; 7D extended it per role);
//   * role 2/3 (7D) drain the exec's captured stdout/stderr into its
//     accumulators — they do NOT complete it, because completion needs the
//     child reaped as well (hostCompleteReady's `(oflags & 7) == 7`).
// THE DRAIN IS RE-ENTERED FROM THE TABLE, NOT FROM A SAVED POINTER: the fd and
// the accumulator are read out of the eval's effect words, so nothing here can
// hold a pointer across the completion's allocations.
defun Rt.hostPollEntry(hN : val, kN : val) -> val {
  word h = payload(hN, 0);
  word k = payload(kN, 0);
  *Host lp = [*Host](h);
  *HostPoll pp = [*HostPoll](lp->poll);
  if (pp->fds[k].revents == 0) {
    return mknil;
  }
  word ev = pp->evals[k];
  word role = pp->roles[k];
  if (lp->evals[ev].active == 0) {
    return mknil;
  }
  if (role == 1) {
    if (lp->evals[ev].etag != 1) {
      return mknil;
    }
    if (payload(call Rt.hostReadFileDrain(hN, mknum(ev)), 0) == 0) {
      return mknil;                        // EAGAIN again: still suspended
    }
    return call Rt.hostReadFileComplete(hN, mknum(ev));
  }
  if (role == 2) {
    if (lp->evals[ev].etag != 2) {
      return mknil;
    }
    return call Rt.hostExecDrainOut(hN, mknum(ev));
  }
  if (role == 3) {
    if (lp->evals[ev].etag != 2) {
      return mknil;
    }
    return call Rt.hostExecDrainErr(hN, mknum(ev));
  }
  return mknil;
}
defun Rt.hostDrainReadyGo(hN : val, iN : val, nN : val) -> val {
  word i = payload(iN, 0);
  if (mkbool(i >= payload(nN, 0))) {
    return mknil;
  }
  call Rt.hostPollEntry(hN, mknum(i));
  recur(hN, mknum(i + 1), nN);
}
// The drain pass.  `n` is the SNAPSHOT of npoll the caller took (the Zig's
// `const n = self.npoll`): an eval that completes and respawns does not change
// this pass's bound — the next rebuild re-derives the table.
defun Rt.hostDrainReady(hN : val) -> val {
  *Host lp = [*Host](payload(hN, 0));
  return call Rt.hostDrainReadyGo(hN, mknum(0), mknum(lp->npoll));
}

// The Zig's cleanupAll (`defer loop.cleanupAll()`, LIFO with the root pop):
// close every fd a SUSPENDED eval still holds and free its two C-heap blocks.
// It is LOAD-BEARING exactly when the loop exits with work pending — TaskQuit
// finishing the run while another evaluation sits suspended on a readFile or
// an exec — and a no-op on the ordinary path, where a completion already
// closed and freed.
//
// IT MAY ALLOCATE (7D): the exec arm frees the decoded plan tree, and the only
// path to Rt.epFreeChains is the value ABI (`mknum(progW)` boxes the pointer).
// That is safe ONLY because Rt.hostRun copies the final model out AFTER this
// runs — while it ran BEFORE, the model sat in Rt.main's RAW `modelslot`
// (malloc(40), unscanned), and a collect here would have moved the model in the
// blob's slot 0 without updating that copy.  TestMain pins the order.
defun Rt.hostCleanupGo(hN : val, iN : val) -> val {
  word h = payload(hN, 0);
  word i = payload(iN, 0);
  *Host lp = [*Host](h);
  if (i >= lp->nevals) {
    return mknil;
  }
  if (lp->evals[i].etag == 1) {
    rawcall close(lp->evals[i].rf.fd);
    rawcall free(lp->evals[i].rf.bptr);
    rawcall free(lp->evals[i].rf.tmp);
    lp->evals[i].rf.fd = -1;
    lp->evals[i].rf.bptr = 0;
    lp->evals[i].rf.blen = 0;
    lp->evals[i].rf.bcap = 0;
    lp->evals[i].rf.tmp = 0;
    lp->evals[i].etag = 0;
    recur(hN, mknum(i + 1));
  }
  if (lp->evals[i].etag == 2) {
    call Rt.hostCloseFd(mknum(lp->evals[i].ex.outfd), mknum(0), mknum(-1));
    call Rt.hostCloseFd(mknum(lp->evals[i].ex.errfd), mknum(0), mknum(-1));
    rawcall free(lp->evals[i].ex.bptr);
    rawcall free(lp->evals[i].ex.eptr);
    call Rt.hostEpFreePlan(hN, mknum(i));
    lp->evals[i].ex.pid = 0;
    lp->evals[i].ex.outfd = -1;
    lp->evals[i].ex.errfd = -1;
    lp->evals[i].ex.bptr = 0;
    lp->evals[i].ex.blen = 0;
    lp->evals[i].ex.bcap = 0;
    lp->evals[i].ex.eptr = 0;
    lp->evals[i].ex.elen = 0;
    lp->evals[i].ex.ecap = 0;
    lp->evals[i].ex.oflags = 0;
    lp->evals[i].ex.code = 0;
    lp->evals[i].etag = 0;
    recur(hN, mknum(i + 1));
  }
  recur(hN, mknum(i + 1));
}
defun Rt.hostCleanupAll(hN : val) -> val {
  return call Rt.hostCleanupGo(hN, mknum(0));
}

// The Zig's setNonblocking (effectloop.zig:1357): GETFL, then SETFL with
// O_NONBLOCK OR-ed in, through the VARIADIC `fcntl` declaration at the top of
// this file (the FFI arc's U4 shape, pinned by tools/qbe/fixtures/ffic-vararg).
//
// NO 7C CALLER, DELIBERATELY: the readFile leaf asks `openat` for O_NONBLOCK
// itself, exactly as the Zig does, so this seat's first caller is 7D's exec
// pipes (`setNonblocking(outpipe[0])`).  It lands here because the declaration
// it needs is part of this unit's FFI surface, and TestMain pins it by text —
// an uncalled seat is invisible to a behavioural fixture.
defun Rt.hostSetNonblocking(fdN : val) -> val {
  word fd = payload(fdN, 0);
  word fl = rawcall fcntl(fd, 3, 0);       // F_GETFL
  if (fl < 0) {
    return mknil;
  }
  rawcall fcntl(fd, 4, fl | 2048);         // F_SETFL, | O_NONBLOCK (0x800)
  return mknil;
}

// ============== STAGE 7D: TaskExec — THE ASYNC EXEC =======================
// The Zig's leafExec / execDrainOut / execDrainErr / execComplete /
// registerChild / reapChildren / reapBlocking (effectloop.zig:559-679,
// 1018-1079) and the free-function child side (execChild, singleCommandArgv,
// effectloop.zig:1266-1306), ported onto the Mid decoder that already exists
// for the PRIM route (Rt.exec-plan + the Rt.ep* family, groups 3B-2a/2b/2c).
//
// WHY THE HOST DECODES THE PLAN ITSELF: the Zig host classifies the plan
// (singleCommandArgv) BEFORE running it — a single plain command becomes
// fork + piped capture + poll + waitpid, and anything else falls back to the
// SYNCHRONOUS prim runner.  Mid's synchronous runner is Rt.exec-plan, which
// decodes AND runs in one body and so cannot be asked for the tree; the leaf
// therefore decodes with the same Rt.epProg the prim route uses and, when the
// classification fails, calls Rt.exec-plan (which decodes a SECOND time — one
// extra decode on the complex path, never on the async one).
//
// THE CHILD SIDE IS COPIED FROM Rt.exec-run's CHILD ARM (runtime.mid:2645-
// 2680), not invented: Rt.childBuiltin for the six in-process builtins, then
// execvp, then the errno BYTE read, then 127/126 with the messages sitting at
// cbuf+200/209/222.  THE `_exit` RULE — the child's last act is either
// `_exit(bcode)` AFTER the builtin RETURNS, or `_exit` in the execvp-failure
// arm.  NO `_exit` may sit between the dup2s and the builtin: the builtin
// writes straight to fd 1/2 (write(2), no stdio), so exiting before it runs
// produces EMPTY output with a plausible exit code — the "silently truncated
// output" failure this unit's invariant list names, and one no gate row can
// see (a truncated capture still parses).
//
// THE ROOTING DISCIPLINE FOR THE ACCUMULATORS (7B's readLine double-free
// family): both accumulators are C-heap blocks whose three words live in the
// eval's own effect (`ex.bptr/blen/bcap`, `ex.eptr/elen/ecap`).  Every reader
// re-reads them FROM THE EFFECT after any call that allocates, and every
// grow frees the old block only after the copy is published.  The two Strings
// hostExecComplete builds are rooted by way of the eval's RESULT SLOT (a
// slice of the registered slot array): build, store, re-read, use — so a
// collect between the two allocations cannot leave a raw copy behind.

// The 336-byte symbol/diagnostic buffer the DECODER reads and the CHILD's
// messages come out of, byte-identical to the one Rt.exec-plan fills inline
// (offsets 0..334, every byte written; TestMain's 7D CBUF row pins the two
// against each other).  THE SAME BUFFER SERVES THREE READERS, which is why it
// is a defun of its own:
//   0..103   the decoder's own names — cons/string/number/symbol (0/8/16/24)
//            the chain ops seq/and/or (32/40/48), the redirect kinds
//            in/out/append/dup/hdoc/hstr (56..96).  Rt.epProg and every
//            Rt.ep* helper compare the plan's symbols against THESE bytes.
//   104..139 the child-side builtin names (echo/true/false/:/cd/pwd), "-n",
//            HOME and "/" — Rt.childBuiltin / Rt.echoGo / Rt.childPwd /
//            Rt.envHome / Rt.isChildBuiltin read them by offset.
//   141..335 childW2's diagnostics and the mkstemp templates (exec-run's
//            synchronous tail); 200/209/222 are the two this unit uses.
defun Rt.hostEpCbuf(dummy : val) -> val {
  word c = rawcall malloc(336);
  if (mkbool(c == 0)) {
    word h = rawcall rt_halt();
    return mknil;
  }
  rawcall memset(c, 0, 336);
  call Rt.cStrFill(mknum(c + 0), "cons", mknum(0));
  call Rt.cStrFill(mknum(c + 8), "string", mknum(0));
  call Rt.cStrFill(mknum(c + 16), "number", mknum(0));
  call Rt.cStrFill(mknum(c + 24), "symbol", mknum(0));
  call Rt.cStrFill(mknum(c + 32), "seq", mknum(0));
  call Rt.cStrFill(mknum(c + 40), "and", mknum(0));
  call Rt.cStrFill(mknum(c + 48), "or", mknum(0));
  call Rt.cStrFill(mknum(c + 56), "in", mknum(0));
  call Rt.cStrFill(mknum(c + 64), "out", mknum(0));
  call Rt.cStrFill(mknum(c + 72), "append", mknum(0));
  call Rt.cStrFill(mknum(c + 80), "dup", mknum(0));
  call Rt.cStrFill(mknum(c + 88), "hdoc", mknum(0));
  call Rt.cStrFill(mknum(c + 96), "hstr", mknum(0));
  call Rt.cStrFill(mknum(c + 104), "echo", mknum(0));
  call Rt.cStrFill(mknum(c + 109), "true", mknum(0));
  call Rt.cStrFill(mknum(c + 114), "false", mknum(0));
  call Rt.cStrFill(mknum(c + 120), ":", mknum(0));
  call Rt.cStrFill(mknum(c + 122), "cd", mknum(0));
  call Rt.cStrFill(mknum(c + 125), "pwd", mknum(0));
  call Rt.cStrFill(mknum(c + 129), "-n", mknum(0));
  call Rt.cStrFill(mknum(c + 132), "HOME", mknum(0));
  call Rt.cStrFill(mknum(c + 137), " ", mknum(0));
  call Rt.cStrFill(mknum(c + 139), "/", mknum(0));
  call Rt.cStrFill(mknum(c + 141), "Input redirect file not found: ", mknum(0));
  call Rt.cStrFill(mknum(c + 173), "\n", mknum(0));
  call Rt.cStrFill(mknum(c + 175), "Output redirect failed: ", mknum(0));
  call Rt.cStrFill(mknum(c + 200), "shensh: ", mknum(0));
  call Rt.cStrFill(mknum(c + 209), ": not found\n", mknum(0));
  call Rt.cStrFill(mknum(c + 222), ": cannot execute\n", mknum(0));
  call Rt.cStrFill(mknum(c + 240), "cd: ", mknum(0));
  call Rt.cStrFill(mknum(c + 245), "pwd: cannot get cwd\n", mknum(0));
  call Rt.cStrFill(mknum(c + 266), "/tmp/shensh-out.XXXXXX", mknum(0));
  call Rt.cStrFill(mknum(c + 289), "/tmp/shensh-err.XXXXXX", mknum(0));
  call Rt.cStrFill(mknum(c + 312), "/tmp/shensh-hdoc.XXXXXX", mknum(0));
  return mknum(c);
}

// The Zig's singleCommandArgv as a PREDICATE OVER THE DECODED TREE: one seq
// chain, one command, no subshell, no redirects, at least one argv entry.
// Returns the command's address (`*CmdState`) or 0.  THE PREDICATE MUST AGREE
// WITH THE ZIG'S EXACTLY (plan §7.3 7D's invariant): a plan the Zig runs
// SYNCHRONOUSLY but this runs ASYNC (or the reverse) diverges on `fastexec`
// and `asyncorder` without ever failing to compile.
//   `op` is 0 `;` / 1 `&&` / 2 `||` (Rt.epChain's codes), so "seq only" is
//   `op == 0`; `subprog != 0` is the Zig's `c.sub != null`; the argv test is
//   BOTH `argc != 0` and `argv != 0` (Rt.epCmd leaves argv at 0 when the
//   command has no words, and execvp would take a null char**).
defun Rt.hostSingleCommandArgv(progN : val) -> val {
  word progW = payload(progN, 0);
  *Prog p = [*Prog](progW);
  if (mkbool(p->nchains != 1)) {
    return mknum(0);
  }
  word chains = p->chains;
  *Chain ch = [*Chain](chains);
  if (mkbool(ch->op != 0)) {
    return mknum(0);
  }
  *Pipe pp = [*Pipe](ch->pipe);
  if (mkbool(pp->ncmds != 1)) {
    return mknum(0);
  }
  word cmds = pp->cmds;
  *CmdState c = [*CmdState](cmds);
  if (mkbool(c->subprog != 0)) {
    return mknum(0);
  }
  if (mkbool(c->nredirs != 0)) {
    return mknum(0);
  }
  if (mkbool(c->argc == 0)) {
    return mknum(0);
  }
  if (mkbool(c->argv == 0)) {
    return mknum(0);
  }
  return mknum(cmds);
}

// `close(fd)` when `fd >= low` and `fd` is not the fd named by `keep` — the
// Zig's guarded closes after the child's dup2s (`if (p[1] > 2) close(p[1])`)
// and cleanupAll's (`if (fd >= 0) close(fd)`) in one seat.  A helper because
// every BLOCK in this language must END with a terminator: `if (c) { close();
// }` with a statement after it is not parseable, and the two-arm
// `if (c) { stmt; return mknil; } else { return mknil; }` idiom (exec-run's)
// reads as a conditional RETURN in every other language.
defun Rt.hostCloseFd(fdN : val, lowN : val, keepN : val) -> val {
  word fd = payload(fdN, 0);
  word low = payload(lowN, 0);
  word keep = payload(keepN, 0);
  if (mkbool(fd >= low) && mkbool(fd != keep)) {
    rawcall close(fd);
    return mknil;
  }
  return mknil;
}

// THE IN-CHILD SEQUENCE — everything the forked child does, and NOTHING the
// parent may run.  `spN` is a `*HostSpawn`: the four pipe ends, the argv the
// decoded plan owns (a malloc'd char* array, NUL-terminated — plan §6 G-G's
// "C-heap copy the decoded blob already is") and the `*Exec` scratch
// Rt.childBuiltin reads its names out of.  There is no GC value in it and no
// arity dance: one pointer in, `_exit` or `execvp` out.
defun Rt.hostExecChild(spawnN : val) -> val {
  word sp = payload(spawnN, 0);
  *HostSpawn s = [*HostSpawn](sp);
  rawcall close(s->outr);
  rawcall close(s->errr);
  rawcall dup2(s->outw, 1);
  rawcall dup2(s->errw, 2);
  call Rt.hostCloseFd(mknum(s->outw), mknum(3), mknum(-1));
  call Rt.hostCloseFd(mknum(s->errw), mknum(3), mknum(s->outw));
  val bcode = call Rt.childBuiltin(mknum(s->argc), mknum(s->argv), mknum(s->exec));
  if (payload(bcode, 0) >= 0) {
    rawcall _exit(payload(bcode, 0));
    return mknil;
  }
  word a0 = wload(s->argv, 0);
  word cbuf = [*Exec](s->exec)->cbuf;
  rawcall execvp(a0, s->argv);
  if (mkbool(byteload(rawcall __errno_location(), 0) == 2)) {
    call Rt.wStr(mknum(2), mknum(cbuf + 200));
    call Rt.wStr(mknum(2), mknum(a0));
    call Rt.wStr(mknum(2), mknum(cbuf + 209));
    rawcall _exit(127);
    return mknil;
  }
  call Rt.wStr(mknum(2), mknum(cbuf + 200));
  call Rt.wStr(mknum(2), mknum(a0));
  call Rt.wStr(mknum(2), mknum(cbuf + 222));
  rawcall _exit(126);
  return mknil;
}

// A C block -> a Mid String.  7C's hostReadFileComplete shape, factored out
// because 7D builds TWO of them per completion (the Zig's valString over
// each accumulator).
defun Rt.hostCStrOf(ptrN : val, lenN : val) -> val {
  word src = payload(ptrN, 0);
  word len = payload(lenN, 0);
  word dst = allocraw(len + 1);
  *CopyDesc d = rawcall malloc(24);
  d->src = src;
  d->dst = dst;
  d->n = len;
  call Rt.memGo(mknum([word](d)), mknum(0));
  rawcall free(d);
  bytestore(dst, len, 0);
  return mkstr(dst, len);
}

// --- the two accumulators (7C's hostRfGrow, twice) ----------------------
// DOUBLE-AND-COPY, read the effect, copy, THEN free and republish — the exact
// order 7B's readLine got wrong.  `free(0)` is a documented no-op, so the
// first grow (bptr == 0) shares the code.  An OOM leaves bcap UNCHANGED,
// which is the caller's failure signal (it completes with what it has, the
// Zig's `catch break`).
defun Rt.hostExOutGrow(hN : val, iN : val, needN : val) -> val {
  word h = payload(hN, 0);
  word i = payload(iN, 0);
  word need = payload(needN, 0);
  *Host lp = [*Host](h);
  if (mkbool(need <= lp->evals[i].ex.bcap)) {
    return mknil;
  }
  word ncap = 65536;
  while (ncap < lp->evals[i].ex.bcap) {
    ncap = ncap * 2;
  }
  while (ncap < need) {
    ncap = ncap * 2;
  }
  word nbuf = rawcall malloc(ncap);
  if (mkbool(nbuf == 0)) {
    return mknil;
  }
  word old = lp->evals[i].ex.bptr;
  word len = lp->evals[i].ex.blen;
  *CopyDesc d = rawcall malloc(24);
  d->src = old;
  d->dst = nbuf;
  d->n = len;
  call Rt.memGo(mknum([word](d)), mknum(0));
  rawcall free(d);
  rawcall free(old);
  lp->evals[i].ex.bptr = nbuf;
  lp->evals[i].ex.bcap = ncap;
  return mknil;
}
defun Rt.hostExErrGrow(hN : val, iN : val, needN : val) -> val {
  word h = payload(hN, 0);
  word i = payload(iN, 0);
  word need = payload(needN, 0);
  *Host lp = [*Host](h);
  if (mkbool(need <= lp->evals[i].ex.ecap)) {
    return mknil;
  }
  word ncap = 65536;
  while (ncap < lp->evals[i].ex.ecap) {
    ncap = ncap * 2;
  }
  while (ncap < need) {
    ncap = ncap * 2;
  }
  word nbuf = rawcall malloc(ncap);
  if (mkbool(nbuf == 0)) {
    return mknil;
  }
  word old = lp->evals[i].ex.eptr;
  word len = lp->evals[i].ex.elen;
  *CopyDesc d = rawcall malloc(24);
  d->src = old;
  d->dst = nbuf;
  d->n = len;
  call Rt.memGo(mknum([word](d)), mknum(0));
  rawcall free(d);
  rawcall free(old);
  lp->evals[i].ex.eptr = nbuf;
  lp->evals[i].ex.ecap = ncap;
  return mknil;
}

// The two EOF arms — close ONCE (the fd becomes -1, so a second entry through
// the poll table is a no-op), set this stream's bit in oflags, and report
// COMPLETE.  One defun per stream because the fd and the bit are fields of
// different names, and a shared one would have to index the union by hand.
defun Rt.hostExOutEof(hN : val, iN : val) -> val {
  word h = payload(hN, 0);
  word i = payload(iN, 0);
  *Host lp = [*Host](h);
  call Rt.hostCloseFd(mknum(lp->evals[i].ex.outfd), mknum(0), mknum(-1));
  lp->evals[i].ex.outfd = -1;
  lp->evals[i].ex.oflags = lp->evals[i].ex.oflags | 1;
  return mknum(1);
}
defun Rt.hostExErrEof(hN : val, iN : val) -> val {
  word h = payload(hN, 0);
  word i = payload(iN, 0);
  *Host lp = [*Host](h);
  call Rt.hostCloseFd(mknum(lp->evals[i].ex.errfd), mknum(0), mknum(-1));
  lp->evals[i].ex.errfd = -1;
  lp->evals[i].ex.oflags = lp->evals[i].ex.oflags | 2;
  return mknum(1);
}

// --- the drains (the Zig's execDrainOut/execDrainErr) -------------------
// ONE fd, drained until it would block.  The 65536-byte chunk is malloc'd per
// ENTRY and freed on every exit (plan §6 G-K: a 64 KiB Mid local is a
// 1.6k-slot frame, and 7C's readFile keeps its chunk for the effect's whole
// lifetime only because a readFile is exactly one slurp).
//
// THE WOULDBLOCK DISCIPLINE IS 7C's, MEASURED THERE BY MUTATION: -1 with
// EAGAIN (11) is "no bytes yet, poll again" and leaves the fd OPEN with the
// eof bit CLEAR, any other errno closes and completes (the Zig's `break`),
// and EINTR (4) retries the SAME read.  The errno read is the pre-existing
// one-byte byteload — deliberately not widened here.
defun Rt.hostExecDrainOutGo(hN : val, iN : val, tmpN : val) -> val {
  word h = payload(hN, 0);
  word i = payload(iN, 0);
  word tmp = payload(tmpN, 0);
  *Host lp = [*Host](h);
  word n = rawcall read(lp->evals[i].ex.outfd, tmp, 65536);
  if (mkbool(n == 0)) {
    return call Rt.hostExOutEof(hN, iN);
  }
  if (mkbool(n < 0)) {
    word e = byteload(rawcall __errno_location(), 0);
    if (mkbool(e == 4)) {
      recur(hN, iN, tmpN);
    }
    if (mkbool(e == 11)) {
      return mknum(0);
    }
    return call Rt.hostExOutEof(hN, iN);
  }
  word need = lp->evals[i].ex.blen + n;
  call Rt.hostExOutGrow(hN, iN, mknum(need));
  if (mkbool(lp->evals[i].ex.bcap < need)) {
    return call Rt.hostExOutEof(hN, iN);
  }
  *CopyDesc d = rawcall malloc(24);
  d->src = tmp;
  d->dst = lp->evals[i].ex.bptr + lp->evals[i].ex.blen;
  d->n = n;
  call Rt.memGo(mknum([word](d)), mknum(0));
  rawcall free(d);
  lp->evals[i].ex.blen = need;
  recur(hN, iN, tmpN);
}
defun Rt.hostExecDrainErrGo(hN : val, iN : val, tmpN : val) -> val {
  word h = payload(hN, 0);
  word i = payload(iN, 0);
  word tmp = payload(tmpN, 0);
  *Host lp = [*Host](h);
  word n = rawcall read(lp->evals[i].ex.errfd, tmp, 65536);
  if (mkbool(n == 0)) {
    return call Rt.hostExErrEof(hN, iN);
  }
  if (mkbool(n < 0)) {
    word e = byteload(rawcall __errno_location(), 0);
    if (mkbool(e == 4)) {
      recur(hN, iN, tmpN);
    }
    if (mkbool(e == 11)) {
      return mknum(0);
    }
    return call Rt.hostExErrEof(hN, iN);
  }
  word need = lp->evals[i].ex.elen + n;
  call Rt.hostExErrGrow(hN, iN, mknum(need));
  if (mkbool(lp->evals[i].ex.ecap < need)) {
    return call Rt.hostExErrEof(hN, iN);
  }
  *CopyDesc d = rawcall malloc(24);
  d->src = tmp;
  d->dst = lp->evals[i].ex.eptr + lp->evals[i].ex.elen;
  d->n = n;
  call Rt.memGo(mknum([word](d)), mknum(0));
  rawcall free(d);
  lp->evals[i].ex.elen = need;
  recur(hN, iN, tmpN);
}
defun Rt.hostExecDrainOut(hN : val, iN : val) -> val {
  word h = payload(hN, 0);
  word i = payload(iN, 0);
  *Host lp = [*Host](h);
  if (mkbool(lp->evals[i].ex.outfd < 0)) {
    return mknum(1);
  }
  word tmp = rawcall malloc(65536);
  if (mkbool(tmp == 0)) {
    return call Rt.hostExOutEof(hN, iN);
  }
  val rc = call Rt.hostExecDrainOutGo(hN, iN, mknum(tmp));
  rawcall free(tmp);
  return rc;
}
defun Rt.hostExecDrainErr(hN : val, iN : val) -> val {
  word h = payload(hN, 0);
  word i = payload(iN, 0);
  *Host lp = [*Host](h);
  if (mkbool(lp->evals[i].ex.errfd < 0)) {
    return mknum(1);
  }
  word tmp = rawcall malloc(65536);
  if (mkbool(tmp == 0)) {
    return call Rt.hostExErrEof(hN, iN);
  }
  val rc = call Rt.hostExecDrainErrGo(hN, iN, mknum(tmp));
  rawcall free(tmp);
  return rc;
}

// --- the children table: DERIVED, not a side table ---------------------
// The Zig keeps `children: [MAX_EVALS]Child{pid, eval}` beside the eval array
// and scans it in reapChildren/reapBlocking.  Here the same information IS
// the eval's effect (`ex.pid`, with 0 meaning "no child or already reaped"),
// so a second table would be a second copy of one fact — the class of bug
// where two places must agree.  registerChild therefore has nothing to
// append to: it writes the pid into the effect, and it exists as a NAMED SEAT
// so the reap's "who owns this pid" question has one documented answer.
defun Rt.hostRegisterChild(hN : val, iN : val, pidN : val) -> val {
  word h = payload(hN, 0);
  word i = payload(iN, 0);
  word pid = payload(pidN, 0);
  *Host lp = [*Host](h);
  lp->evals[i].ex.pid = pid;
  return mknil;
}

// WNOHANG reap: does NOT block, marks the child's exit on the eval, and
// CLEARS the pid so the same pid is never waited on twice (a second waitpid
// would either be ECHILD or — after the kernel recycles the number — reap
// somebody else's child).  `stw` is an 8-byte C cell: the kernel writes FOUR
// bytes of wait status, so the cell is zeroed first and read back as a word
// (Rt.exec-run's `waitStatus = 0` before `waitpid`, same discipline, without
// the struct-slot address this language cannot spell).
defun Rt.hostReapGo(hN : val, iN : val, stN : val) -> val {
  word h = payload(hN, 0);
  word i = payload(iN, 0);
  word stw = payload(stN, 0);
  *Host lp = [*Host](h);
  if (mkbool(i >= lp->nevals)) {
    rawcall free(stw);
    return mknil;
  }
  if (lp->evals[i].active == 0) {
    recur(hN, mknum(i + 1), stN);
  }
  if (lp->evals[i].etag != 2) {
    recur(hN, mknum(i + 1), stN);
  }
  if (mkbool(lp->evals[i].ex.pid <= 0)) {
    recur(hN, mknum(i + 1), stN);
  }
  wstore(stw, 0, 0);
  word pid = lp->evals[i].ex.pid;
  word rc = rawcall waitpid(pid, stw, 1);
  if (mkbool(rc == pid)) {
    word code = payload(call Rt.waitStatusCode(mknum(wload(stw, 0))), 0);
    lp->evals[i].ex.code = code;
    lp->evals[i].ex.oflags = lp->evals[i].ex.oflags | 4;
    lp->evals[i].ex.pid = 0;
    recur(hN, mknum(i + 1), stN);
  }
  if (mkbool(rc < 0)) {
    lp->evals[i].ex.pid = 0;               // ECHILD: nothing left to wait for
    recur(hN, mknum(i + 1), stN);
  }
  recur(hN, mknum(i + 1), stN);            // rc == 0: WNOHANG, still running
}
defun Rt.hostReapChildren(hN : val) -> val {
  word stw = rawcall malloc(8);
  if (mkbool(stw == 0)) {
    return mknil;
  }
  return call Rt.hostReapGo(hN, mknum(0), mknum(stw));
}

// BLOCKING reap, and it may only ever be called when the poll table is EMPTY
// (npoll == 0): a child blocked writing into a pipe we are not draining would
// deadlock this waitpid for as long as the child lives.  That is exactly the
// state the driver reaches here — every pipe has already EOF'd, which means
// the child has closed its ends, so the zombie is either there already or a
// few microseconds away (the Zig's comment on the WNOHANG race, effectloop:1050).
// EINTR retries the SAME child; ECHILD clears the pid and moves on.
defun Rt.hostReapBlockGo(hN : val, iN : val, stN : val) -> val {
  word h = payload(hN, 0);
  word i = payload(iN, 0);
  word stw = payload(stN, 0);
  *Host lp = [*Host](h);
  if (mkbool(i >= lp->nevals)) {
    rawcall free(stw);
    return mknum(0);
  }
  if (lp->evals[i].active == 0) {
    recur(hN, mknum(i + 1), stN);
  }
  if (lp->evals[i].etag != 2) {
    recur(hN, mknum(i + 1), stN);
  }
  if (mkbool(lp->evals[i].ex.pid <= 0)) {
    recur(hN, mknum(i + 1), stN);
  }
  wstore(stw, 0, 0);
  word pid = lp->evals[i].ex.pid;
  word rc = rawcall waitpid(pid, stw, 0);
  if (mkbool(rc < 0) && mkbool(byteload(rawcall __errno_location(), 0) == 4)) {
    recur(hN, iN, stN);
  }
  if (mkbool(rc == pid)) {
    word code = payload(call Rt.waitStatusCode(mknum(wload(stw, 0))), 0);
    lp->evals[i].ex.code = code;
    lp->evals[i].ex.oflags = lp->evals[i].ex.oflags | 4;
    lp->evals[i].ex.pid = 0;
    rawcall free(stw);
    return mknum(1);
  }
  lp->evals[i].ex.pid = 0;
  recur(hN, mknum(i + 1), stN);
}
defun Rt.hostReapBlocking(hN : val) -> val {
  word stw = rawcall malloc(8);
  if (mkbool(stw == 0)) {
    return mknum(0);
  }
  return call Rt.hostReapBlockGo(hN, mknum(0), mknum(stw));
}

// Free the decoded tree and CLEAR the field, so the second caller (a
// completion and then cleanupAll on the same eval) cannot free it twice.
// The zero test is a guard rather than a `free(0)`-style no-op because the
// tree is walked through Rt.epFreeChains, which dereferences it.
defun Rt.hostEpFreePlan(hN : val, iN : val) -> val {
  word h = payload(hN, 0);
  word i = payload(iN, 0);
  *Host lp = [*Host](h);
  word progW = lp->evals[i].ex.prog;
  lp->evals[i].ex.prog = 0;
  if (mkbool(progW == 0)) {
    return mknil;
  }
  word chains = [*Prog](progW)->chains;
  return call Rt.epFreeChains(mknum(progW), mknum(chains), mknum(0));
}

// --- completion (the Zig's execComplete + completeReady) ----------------
// cons(code, cons(out, err)) — what Runtime.elm's decodeExec returns.  THE
// TWO STRINGS ARE ROOTED THROUGH THE EVAL'S RESULT SLOT: it is a slice of the
// registered slot array, so a collect between the second String's allocation
// and the first cons updates it in place, and re-reading (never reusing a
// local taken before an allocation) is 7B's rule applied to values instead of
// C blocks.
defun Rt.hostExecComplete(hN : val, iN : val) -> val {
  word h = payload(hN, 0);
  word i = payload(iN, 0);
  *Host lp = [*Host](h);
  word resAddr = h + 8 + ((lp->evals[i].base + 1) * 40);
  word code = lp->evals[i].ex.code;
  word olen = lp->evals[i].ex.blen;
  word elen = lp->evals[i].ex.elen;
  word oaddr = lp->evals[i].ex.bptr;
  word eaddr = lp->evals[i].ex.eptr;
  vecstore(resAddr, 0, call Rt.hostCStrOf(mknum(oaddr), mknum(olen)));
  val errS = call Rt.hostCStrOf(mknum(eaddr), mknum(elen));
  val inner = call Rt.cons(vecload(resAddr, 0), errS);
  vecstore(resAddr, 0, inner);
  vecstore(resAddr, 0, call Rt.cons(mknum(code), vecload(resAddr, 0)));
  rawcall free(oaddr);
  rawcall free(eaddr);
  call Rt.hostEpFreePlan(hN, iN);
  lp->evals[i].ex.pid = 0;
  lp->evals[i].ex.outfd = -1;
  lp->evals[i].ex.errfd = -1;
  lp->evals[i].ex.bptr = 0;
  lp->evals[i].ex.blen = 0;
  lp->evals[i].ex.bcap = 0;
  lp->evals[i].ex.eptr = 0;
  lp->evals[i].ex.elen = 0;
  lp->evals[i].ex.ecap = 0;
  lp->evals[i].ex.oflags = 0;
  lp->evals[i].ex.code = 0;
  lp->evals[i].etag = 0;
  return call Rt.hostCompleteOk(hN, iN);
}
// The Zig's completeReady: an exec evaluation completes when its child has
// been REAPED and both pipes have EOF'd — one predicate, `(oflags & 7) == 7`,
// over the three booleans the Zig keeps separately.  `n` is the caller's
// SNAPSHOT of nevals: a completion delivers a message, which can spawn into
// the table, and this pass must not chase what it just created.
defun Rt.hostCompleteReadyGo(hN : val, iN : val, nN : val) -> val {
  word h = payload(hN, 0);
  word i = payload(iN, 0);
  *Host lp = [*Host](h);
  if (mkbool(i >= payload(nN, 0))) {
    return mknil;
  }
  if (lp->evals[i].active == 0) {
    recur(hN, mknum(i + 1), nN);
  }
  if (lp->evals[i].etag != 2) {
    recur(hN, mknum(i + 1), nN);
  }
  if ((lp->evals[i].ex.oflags & 7) != 7) {
    recur(hN, mknum(i + 1), nN);
  }
  call Rt.hostExecComplete(hN, mknum(i));
  recur(hN, mknum(i + 1), nN);
}
defun Rt.hostCompleteReady(hN : val) -> val {
  *Host lp = [*Host](payload(hN, 0));
  return call Rt.hostCompleteReadyGo(hN, mknum(0), mknum(lp->nevals));
}

// --- THE LEAF ----------------------------------------------------------
// TaskExec: decode, classify, and either fork+execvp (async) or run the
// complex plan through the synchronous prim runner.
//
// THE NEGATIVE SENTINEL IS WRITTEN FIRST (7C handed this note over): hostInit
// memsets the state, so a never-set `ex.outfd`/`ex.errfd` reads 0 — a VALID
// fd — and hostAddPoll's `fd < 0` guard would register stdin twice.  The
// effect's whole word set is initialised before anything can fail, so every
// later arm (drain, complete, cleanup) sees a decodable state.
//
// THE PLAN VALUE IS RE-READ FROM THE ROOTED SLOT AFTER THE DECODE: Rt.epProg
// allocates (mknum boxes the tree pointer), so both the task vector and the
// plan Value can MOVE; the C pointers (cbuf, the decoded tree) cannot, which
// is why the tree is carried as a raw word and the plan as a slot re-read.
defun Rt.hostLeafExec(hN : val, iN : val, planN : val) -> val {
  word h = payload(hN, 0);
  word i = payload(iN, 0);
  *Host lp = [*Host](h);
  lp->evals[i].ex.prog = 0;
  lp->evals[i].ex.pid = 0;
  lp->evals[i].ex.outfd = -1;
  lp->evals[i].ex.errfd = -1;
  lp->evals[i].ex.bptr = 0;
  lp->evals[i].ex.blen = 0;
  lp->evals[i].ex.bcap = 0;
  lp->evals[i].ex.eptr = 0;
  lp->evals[i].ex.elen = 0;
  lp->evals[i].ex.ecap = 0;
  lp->evals[i].ex.oflags = 0;
  lp->evals[i].ex.code = 0;
  word cbuf = payload(call Rt.hostEpCbuf(mknil), 0);
  word xst = rawcall malloc(sizeof(Exec) * 8);
  rawcall memset(xst, 0, sizeof(Exec) * 8);
  [*Exec](xst)->cbuf = cbuf;
  word stw = rawcall malloc(24);
  [*Scratch](stw)->cbuf = cbuf;
  [*Scratch](stw)->depth = 0;
  [*Scratch](stw)->lim = 0;
  word progW = payload(call Rt.epProg(planN, mknum(stw)), 0);
  rawcall free(stw);
  if (mkbool(progW < 0)) {
    rawcall free(xst);
    rawcall free(cbuf);
    call Rt.hostDieErr(rawstr("exec-plan: malformed plan"), rawstr(""));
    return mknil;
  }
  word cmdAddr = payload(call Rt.hostSingleCommandArgv(mknum(progW)), 0);
  if (mkbool(cmdAddr == 0)) {
    rawcall free(xst);
    rawcall free(cbuf);
    word chains = [*Prog](progW)->chains;
    call Rt.epFreeChains(mknum(progW), mknum(chains), mknum(0));
    word tv = payload(vecload(h + 8 + (lp->evals[i].base * 40), 0), 0);
    vecstore(h + 8 + ((lp->evals[i].base + 1) * 40), 0, call Rt.exec-plan(vecload(tv, 1)));
    return call Rt.hostCompleteOk(hN, iN);
  }
  word argc = [*CmdState](cmdAddr)->argc;
  word argv = [*CmdState](cmdAddr)->argv;
  word pb = rawcall malloc(16);
  *HostPipe po = [*HostPipe](pb);
  *HostPipe pe = [*HostPipe](pb + 8);
  word rcOut = rawcall pipe(pb);
  if (mkbool(rcOut < 0)) {
    rawcall free(pb);
    rawcall free(xst);
    rawcall free(cbuf);
    word ch1 = [*Prog](progW)->chains;
    call Rt.epFreeChains(mknum(progW), mknum(ch1), mknum(0));
    call Rt.hostDieErr(rawstr("exec-plan: fork/pipe failed"), rawstr(""));
    return mknil;
  }
  word rcErr = rawcall pipe(pb + 8);
  if (mkbool(rcErr < 0)) {
    rawcall close(po->rd);
    rawcall close(po->wr);
    rawcall free(pb);
    rawcall free(xst);
    rawcall free(cbuf);
    word ch2 = [*Prog](progW)->chains;
    call Rt.epFreeChains(mknum(progW), mknum(ch2), mknum(0));
    call Rt.hostDieErr(rawstr("exec-plan: fork/pipe failed"), rawstr(""));
    return mknil;
  }
  word pid = rawcall fork();
  if (mkbool(pid < 0)) {
    rawcall close(po->rd);
    rawcall close(po->wr);
    rawcall close(pe->rd);
    rawcall close(pe->wr);
    rawcall free(pb);
    rawcall free(xst);
    rawcall free(cbuf);
    word ch3 = [*Prog](progW)->chains;
    call Rt.epFreeChains(mknum(progW), mknum(ch3), mknum(0));
    call Rt.hostDieErr(rawstr("exec-plan: fork/pipe failed"), rawstr(""));
    return mknil;
  }
  if (mkbool(pid == 0)) {
    word sp = rawcall malloc(sizeof(HostSpawn) * 8);
    [*HostSpawn](sp)->argc = argc;
    [*HostSpawn](sp)->argv = argv;
    [*HostSpawn](sp)->outr = po->rd;
    [*HostSpawn](sp)->outw = po->wr;
    [*HostSpawn](sp)->errr = pe->rd;
    [*HostSpawn](sp)->errw = pe->wr;
    [*HostSpawn](sp)->exec = xst;
    call Rt.hostExecChild(mknum(sp));
    rawcall _exit(127);                    // belt: hostExecChild never returns
    return mknil;
  }
  rawcall close(po->wr);
  rawcall close(pe->wr);
  call Rt.hostSetNonblocking(mknum(po->rd));
  call Rt.hostSetNonblocking(mknum(pe->rd));
  lp->evals[i].ex.outfd = po->rd;
  lp->evals[i].ex.errfd = pe->rd;
  lp->evals[i].ex.prog = progW;
  call Rt.hostRegisterChild(hN, mknum(i), mknum(pid));
  lp->evals[i].etag = 2;
  rawcall free(pb);
  rawcall free(xst);
  rawcall free(cbuf);
  return mknil;
}

// ===================== STAGE 7E: LISTDIR + STAT =========================
// THE LAST TWO LEAVES, and with them the unported set is EMPTY: every one of
// Runtime.elm's twenty Task constructors has a real arm in hostDispatch below,
// so nothing reaches the loud unknown-ctor seat any more (see that seat's note,
// and TestMain's 7E UNPORTED row, which asserts the ABSENCE of a porting gate
// rather than its text).
//
// BOTH LEAVES ARE SYNCHRONOUS: no etag, no poll registration, no state in the
// effect union — the Zig's leafListDir/leafStat are the same, because a
// directory walk and an fstatat never block.  What they do NOT share with the
// Zig is the SHAPE of the record builders: the Zig spelled five explicit
// rootPush/rootPop pairs per record, while here every intermediate is a `val`
// binder, which is a rooted frame slot for the whole body (Lower's WithRoots
// note: rt_frame_enter registers the pooled frame as one ROOT_VALUE_ARRAY, so
// a `val` binder survives a collect in place — that is what makes the plain
// `val p1 = call Rt.cons(..)` chain below safe across the next allocation).
//
// THE RECORDS ARE ASSOC CHAINS, not compiled vectors — the shape the Zig's
// runPrim("@p") built, and the shape `statplus` exists to pin arithmetic on.

// TaskListDir — openat(O_DIRECTORY) then the getdents64 walk.
//
// A FAILED OPEN COMPLETES SUCCESS WITH [] — the Zig's `catch` arm, and
// leafReadFile's empty-string parity: Io.listDir has no failure channel on
// this route, so an unreadable directory is an empty listing, not an error.
//
// THE FLIP: the walk visits the entries in the KERNEL'S raw fs order (never
// sorted — sorting is app-side, `dirunit` re-sorts through Set) and PREPENDS
// each record, so the accumulator ends up REVERSED; `Rt.revGo` flips it after
// the dirfd is closed.
//
// THE ONE DELIBERATE DIVERGENCE FROM THE ZIG'S STRUCTURE:  effectloop.zig
// drains the names into page_allocator storage FIRST, closes the fd, and only
// then builds the Elm list — explicitly "so no GC allocation happens while the
// fd is open".  THIS PORT BUILDS THE RECORDS DURING THE WALK, i.e. it DOES
// allocate with the dirfd open, and that is safe for a reason the split
// existed to approximate: the two raw things in play are C HEAP (the fd, an
// i32 in `struct HostDir`, and the getdents64 buffer), so the collector can
// neither see nor move them, and no Mid value describes either.  The address
// held across the record's allocations (`nptr`) is a C pointer for the same
// reason — the same class 7D's `oaddr`/`eaddr` already are.  What the split
// bought (an alloc-free window around a raw resource) holds here BY
// CONSTRUCTION rather than by ordering.  The flip stays after the close
// because it needs no resource at all.
defun Rt.hostLeafListDir(hN : val, iN : val, pathN : val) -> val {
  word h = payload(hN, 0);
  word i = payload(iN, 0);
  *Host lp = [*Host](h);
  word resAddr = h + 8 + ((lp->evals[i].base + 1) * 40);
  word len = len32(pathN);
  word pb = allocraw(len + 2);
  call Rt.cStrFill(mknum(pb), pathN, mknum(0));
  vecstore(resAddr, 0, mknil);             // the accumulator: EMPTY and ROOTED
  word fd = rawcall openat(-100, pb, 589824, 0);   // O_RDONLY|O_DIRECTORY|O_CLOEXEC
  if (mkbool(fd < 0)) {
    return call Rt.hostCompleteOk(hN, iN); // the Zig's failed-open arm: []
  }
  word cell = rawcall malloc(32);
  [*HostDir](cell)->fd = fd;
  [*HostDir](cell)->buf = rawcall malloc(4096);
  [*HostDir](cell)->off = 0;
  [*HostDir](cell)->nread = 0;
  call Rt.hostListDirDrain(hN, iN, mknum(cell));
  rawcall close(fd);
  rawcall free([*HostDir](cell)->buf);
  rawcall free(cell);
  vecstore(resAddr, 0, call Rt.revGo(vecload(resAddr, 0), mknil));
  return call Rt.hostCompleteOk(hN, iN);
}

// ONE getdents64 call per iteration; the entries inside that chunk are
// hostListDirChunk's.  THE TWO ZIG `break :drain` ARMS (a read error, and EOF)
// ARE ONE ARM HERE — both STOP THE WALK AND KEEP WHAT IS ALREADY ACCUMULATED —
// and the "stop" is simply this defun NOT recurring (gap G-B: Mid has no
// labelled break, so there is no loop label to escape and no flag to thread).
// The accumulator is not in the loop's hands at all: it lives in the eval's
// result slot, so returning early cannot lose it.
defun Rt.hostListDirDrain(hN : val, iN : val, cellN : val) -> val {
  word c = payload(cellN, 0);
  *HostDir dd = [*HostDir](c);
  word n = rawcall getdents64(dd->fd, dd->buf, 4096);
  if (mkbool(n <= 0)) {
    return mknil;                          // 0 = EOF, < 0 = a read error
  }
  dd->nread = n;
  dd->off = 0;
  call Rt.hostListDirChunk(hN, iN, cellN);
  recur(hN, iN, cellN);
}

// ONE CHUNK of entries, walked `off` to `nread`.  Returns when the chunk is
// exhausted, which is the caller's signal to ask the kernel for more.
//
// THE STRIDE IS d_reclen, NEVER A FIXED SIZE: a record is 19 bytes of headers
// plus a NUL-terminated name padded to 8, so the only correct walk is
// `off += reclen`.  The name is read IN PLACE (the buffer is reused by the next
// getdents64 call) and copied into a Mid String before the step returns.
//
// '.' AND '..' ARE SKIPPED (Go os.ReadDir parity) — the Zig's two byte tests,
// kept as one boolean because a second `if` would need a second `recur` on the
// same path.
defun Rt.hostListDirChunk(hN : val, iN : val, cellN : val) -> val {
  word h = payload(hN, 0);
  word i = payload(iN, 0);
  word c = payload(cellN, 0);
  *HostDir dd = [*HostDir](c);
  *Host lp = [*Host](h);
  word off = dd->off;
  if (mkbool(off >= dd->nread)) {
    return mknil;                          // the chunk is done
  }
  word base = dd->buf + off;
  *Dirent d = [*Dirent](base);
  word rlen = d->reclen;
  word dtype = d->dtype;
  word nptr = base + 19;                   // ino 8 + off 8 + reclen 2 + dtype 1
  word nlen = payload(call Rt.cStrLenGo(mknum(nptr), mknum(0)), 0);
  word b0 = byteload(nptr, 0);
  word b1 = byteload(nptr, 1);
  val skip = (mkbool(nlen == 1) && mkbool(b0 == 46)) || ((mkbool(nlen == 2) && mkbool(b0 == 46)) && mkbool(b1 == 46));
  if (payload32(skip, 0) != 0) {
    dd->off = off + rlen;
    recur(hN, iN, cellN);                  // '.' / '..': skipped, not listed
  }
  word resAddr = h + 8 + ((lp->evals[i].base + 1) * 40);
  val nm = call Rt.hostCStrOf(mknum(nptr), mknum(nlen));
  val isDirV = call Rt.hostDirIsDir(mknum(dd->fd), mknum(nptr), mknum(dtype));
  vecstore(resAddr, 0, call Rt.hostDirRecord(nm, isDirV, vecload(resAddr, 0)));
  dd->off = off + rlen;
  recur(hN, iN, cellN);
}

// THE d_type ARM, with the DT_UNKNOWN FALLBACK PER ENTRY (never per directory —
// one record's type says nothing about the next one's): DT_UNKNOWN (0) fstatats
// the name RELATIVE TO THE OPEN DIRFD with AT_SYMLINK_NOFOLLOW (256), which is
// Go DirEntry.IsDir's parity — a symlink TO a directory is NOT a directory here
// (the symlink-following question is TaskStat's, and it answers the other way).
//
// MEASURED GAP: this host's filesystems report real d_types for every entry the
// gate sees, so the fallback arm has NO fixture — it is pinned by TEXT (7E
// DT_UNKNOWN row) only.  Same class of stated gap as 7C's OOM arms.
defun Rt.hostDirIsDir(fdN : val, nameN : val, dtypeN : val) -> val {
  word dt = payload(dtypeN, 0);
  if (mkbool(dt != 0)) {
    return mkbool(dt == 4);                // DT_DIR, and no syscall for it
  }
  Stat st;
  word rc = rawcall fstatat(payload(fdN, 0), payload(nameN, 0), &st, 256);
  if (mkbool(rc != 0)) {
    return false;                          // the Zig's `!= 0 -> false`
  }
  return mkbool((st.mode & 61440) == 16384);   // S_IFMT == S_IFDIR
}

// ONE {name, isDir} record, pair-consed onto `tailN`.  Three params is the lean
// ABI's whole budget, and it is exactly what this needs.
//
// THE TAIL IS CONSED ON THE OUTSIDE (the Zig's dirRecord comment records the
// bug this exists for): the record's spine ends at nil, and threading the list
// tail into the isDir pair BURIES the rest of the list inside the record — then
// `assoc`/field j read the tail instead of the boolean.  So: build the record
// to nil, then cons it onto the tail.
defun Rt.hostDirRecord(nameN : val, isDirN : val, tailN : val) -> val {
  val pName = call Rt.@p(call Rt.intern("name"), nameN);
  val inner = call Rt.cons(call Rt.@p(call Rt.intern("isDir"), isDirN), mknil);
  val rec = call Rt.cons(pName, inner);
  return call Rt.cons(rec, tailN);
}

// TaskStat — fstatat(AT_FDCWD) with symlinks FOLLOWED (flag 0, Go os.Stat's
// parity), completing `{ size, mode, mtimeMs, isDir, isFile }`.
//
// A FAILED STAT COMPLETES THE ZERO RECORD, AND THE ZERO IS STRUCTURAL: the
// 144-byte block is memset to 0 BEFORE the call, so ENOENT leaves
// size = mode = mtimeMs = 0 and `mode & S_IFMT` = 0 — neither a dir nor a file.
// That is the Zig's five `if (ok)` arms with no `ok` flag to get wrong (it is
// also what `statunit`'s absent-path line pins).
defun Rt.hostLeafStat(hN : val, iN : val, pathN : val) -> val {
  word h = payload(hN, 0);
  word i = payload(iN, 0);
  *Host lp = [*Host](h);
  word len = len32(pathN);
  word pb = allocraw(len + 2);
  call Rt.cStrFill(mknum(pb), pathN, mknum(0));
  word stW = rawcall malloc(144);          // 18 words: struct Stat, U6-measured
  rawcall memset(stW, 0, 144);
  rawcall fstatat(-100, pb, stW, 0);       // AT_FDCWD, flag 0 = FOLLOW symlinks
  call Rt.hostStatRecord(hN, iN, mknum(stW));
  rawcall free(stW);
  return call Rt.hostCompleteOk(hN, iN);
}

// The {size, mode, mtimeMs, isDir, isFile} record — FIVE assoc pairs, field j
// of the source at depth j, so the list is built right-to-left and the LAST
// pair prepended is `size` (the source's first field).
//
// THE OFFSETS ARE THE U6 FIXTURE'S, not re-derived: mode @24 (byte), size @48,
// mtim @88 (sec) and @96 (nsec) out of `struct Stat` above.  `statunit` is this
// row's behavioural oracle — a wrong `size` offset breaks its `s12-ok`/`s8-ok`
// lines and a wrong `mode` offset breaks `treg-ok`/`tdir-ok`, so the field
// numbers are MEASURED by a green arm-B row, not just by this comment.
defun Rt.hostStatRecord(hN : val, iN : val, stN : val) -> val {
  word h = payload(hN, 0);
  word i = payload(iN, 0);
  *Host lp = [*Host](h);
  *Stat st = [*Stat](payload(stN, 0));
  word mode = st->mode;
  word sz = st->size;
  word ms = (st->mtim.sec * 1000) + (st->mtim.nsec / 1000000);
  val isDir = mkbool((mode & 61440) == 16384);
  val isFile = mkbool((mode & 61440) == 32768);
  val fFile = call Rt.cons(call Rt.@p(call Rt.intern("isFile"), isFile), mknil);
  val fDir = call Rt.cons(call Rt.@p(call Rt.intern("isDir"), isDir), fFile);
  val fMtime = call Rt.cons(call Rt.@p(call Rt.intern("mtimeMs"), mknum(ms)), fDir);
  val fMode = call Rt.cons(call Rt.@p(call Rt.intern("mode"), mknum(mode)), fMtime);
  val fSize = call Rt.cons(call Rt.@p(call Rt.intern("size"), mknum(sz)), fMode);
  word resAddr = h + 8 + ((lp->evals[i].base + 1) * 40);
  vecstore(resAddr, 0, fSize);
  return mknil;
}

// ========================== THE STATE ------------------------------------
// `hN` is the blob's ADDRESS boxed into a Value (`mknum(blob)`), and every
// defun below unboxes it at the top (`payload(hN, 0)`) — the runtime's own
// idiom (Rt.gcAlloc, Rt.tail-known).  Indices are boxed the same way.  It is a
// number Value, so it cannot be mistaken for a GC pointer and the collector
// never touches it.
//
// Rt.hostInit — allocate and root the state, seed the model and the update
// closure.  Returns mknum(blob).
//
// THE MALLOC SIZE IS ARITHMETIC, NOT `sizeof(struct Host)`: the blob's layout
// is what TestMain RECOMPUTES from struct Host above, so a field added without
// this line is a red row rather than a heap overflow.  The literal is
// 8 (nslots) + 33031 x 40 (the slot array) + 6 x 8 (nevals..clrBase) +
// 128 x 4224 (the eval table, sizeof(struct HostEv) = 528 words = 4224 bytes:
// 4 + 512 + 1 + the 11-word effect union, 7D's HostEX growing it by `code`) +
// 16 (7C's npoll and poll), i.e. 1861984 in stage 7D.
//
// THE fd TABLE IS A SECOND, SEPARATE ALLOCATION (7C) and it DOES use `sizeof`
// — a fresh block has no established literal-and-pin discipline to inherit, and
// `sizeof(HostPoll) * 8` cannot drift from the declaration the way a hand-added
// byte count can.  258 x 8 bytes x 3 arrays, memset to zero: `hostAddPoll`
// writes all three of `fd`/`events`/`revents` for an entry it registers, so the
// zero is the property that a NEVER-REGISTERED cell can never be polled.
defun Rt.hostInit(progAddrN : val) -> val {
  word progAddr = payload(progAddrN, 0);
  word bytes = 8 + (33031 * 40) + (6 * 8) + (128 * 4224) + 16;
  word blob = rawcall malloc(bytes);
  rawcall memset(blob, 0, bytes);
  *Host lp = [*Host](blob);
  lp->nslots = 33031;
  word pollBytes = sizeof(HostPoll) * 8;
  word pp = rawcall malloc(pollBytes);
  rawcall memset(pp, 0, pollBytes);
  lp->npoll = 0;
  lp->poll = pp;
  call Rt.rootPushValueArray(blob + 8, blob);
  val prog = vecload(progAddr, 0);
  vecstore(blob + 8, 0, vecload(payload(prog, 0), 1));
  vecstore(blob + 8 + 40, 0, vecload(payload(prog, 0), 3));
  return mknum(blob);
}

// Rt.hostIsProgram — the Program predicate (the rt_is_program C seat's
// vector[Program, m0, c0, update] whose head is the bare symbol 'Program'.
defun Rt.hostIsProgram(vN : val) -> val {
  if (tagis(vN, 10) == 0) {
    return mkbool(0);
  }
  if (payload32(vN, 1) != 4) {
    return mkbool(0);
  }
  word d = payload(vN, 0);
  if (d == 0) {
    return mkbool(0);
  }
  val head = vecload(d, 0);
  if (tagis(head, 2) == 0) {
    return mkbool(0);
  }
  return mkbool(call Rt.cStrEq(payload(head, 0), rawstr("Program")) != 0);
}

// Rt.hostArity — the EXPECTED VECTOR LENGTH of a Task ctor (len == ctor arity
// + 1), or 0 for "not a Task ctor".  The Zig's taskArity, and the guard that
// turns a malformed Task into a dropped evaluation instead of an
// out-of-bounds read of its payload.
//
// DISPATCH IS ON CONTENT, NEVER ON A SYMBOL POINTER (plan §5.2, MEASURED):
// LSymbol lowers a symbol literal to STATIC DATA, bypassing the interner, so
// the interner's canonical-pointer property does not hold between a compiled
// tag and an interned name — pointer equality would compare the tag against 20
// interned names and never match.
//
// THE TAG'S NAME IS payload(tag, 0): a symbol Value is {tag=2, name pointer at
// payload word 0} — MEASURED off the emitted IL for a ctor (`storew 2, %s3;
// storel $d3, +8`, gc/types.zig's `sym: { name }`).  NOT word 1: nothing
// writes word 1 of a symbol.
defun Rt.hostArity(tagN : val) -> val {
  word nm = payload(tagN, 0);
  if (call Rt.cStrEq(nm, rawstr("TaskSucceed")) != 0) {
    return mknum(2);
  }
  if (call Rt.cStrEq(nm, rawstr("TaskFail")) != 0) {
    return mknum(2);
  }
  if (call Rt.cStrEq(nm, rawstr("TaskAndThen")) != 0) {
    return mknum(3);
  }
  if (call Rt.cStrEq(nm, rawstr("TaskOnError")) != 0) {
    return mknum(3);
  }
  if (call Rt.cStrEq(nm, rawstr("TaskWrite")) != 0) {
    return mknum(2);
  }
  if (call Rt.cStrEq(nm, rawstr("TaskReadLine")) != 0) {
    return mknum(1);
  }
  if (call Rt.cStrEq(nm, rawstr("TaskReadFile")) != 0) {
    return mknum(2);
  }
  if (call Rt.cStrEq(nm, rawstr("TaskWriteFile")) != 0) {
    return mknum(3);
  }
  if (call Rt.cStrEq(nm, rawstr("TaskExec")) != 0) {
    return mknum(2);
  }
  if (call Rt.cStrEq(nm, rawstr("TaskGetenv")) != 0) {
    return mknum(2);
  }
  if (call Rt.cStrEq(nm, rawstr("TaskSetenv")) != 0) {
    return mknum(3);
  }
  if (call Rt.cStrEq(nm, rawstr("TaskCd")) != 0) {
    return mknum(2);
  }
  if (call Rt.cStrEq(nm, rawstr("TaskGetcwd")) != 0) {
    return mknum(1);
  }
  if (call Rt.cStrEq(nm, rawstr("TaskGetpid")) != 0) {
    return mknum(1);
  }
  if (call Rt.cStrEq(nm, rawstr("TaskGlob")) != 0) {
    return mknum(2);
  }
  if (call Rt.cStrEq(nm, rawstr("TaskNow")) != 0) {
    return mknum(1);
  }
  if (call Rt.cStrEq(nm, rawstr("TaskSleep")) != 0) {
    return mknum(2);
  }
  if (call Rt.cStrEq(nm, rawstr("TaskQuit")) != 0) {
    return mknum(1);
  }
  if (call Rt.cStrEq(nm, rawstr("TaskListDir")) != 0) {
    return mknum(2);
  }
  if (call Rt.cStrEq(nm, rawstr("TaskStat")) != 0) {
    return mknum(2);
  }
  return mknum(0);
}

// ========================== THE APPLIER ==================================
// Rt.apply-at — THE applier seat, and the ONE place the two APPLIER TRAPS
// (plan §4.1) are handled:
//
//   1. THE ENTRY IS Rt.callArity, NOT Rt.apply/Rt.applyGo.  applyGo's
//      saturated arm builds a `:ret` TAIL and returns mknum(retbuf) — an
//      UNFORCED tail, i.e. a heap address where a value is expected.  Our
//      probe printed exactly that address and then SEGV'd.  Rt.callArity
//      bounces it (rt_callN -> q_Rt_x2ebounce -> vecload(v,0)) and returns a
//      REAL value.  TestMain pins this line: `Rt.apply`/`Rt.applyGo` must not
//      appear in the host's applier.
//   2. THE Disp's `arity` IS THE CLOSURE'S STATIC ARITY (wload(desc,1)), NOT
//      `arity - rem`.  With `arity - rem` (0 for a global closure) the call
//      passes zero args and returns garbage.  This is the silent-wrong.
//   3. THE PARTIAL ARM (stage 7 O3-fix).  7A left it unported and LOUD: a
//      closure arriving with `rem != arity` (napp != 0, i.e. something had
//      already been applied) died naming the missing capture/args interleave.
//      That guard is what the seed-built compiler now trips — MEASURED at O3's
//      re-frozen seed, compiling one source: `arity=2 rem=1 nargs=1`, i.e. a
//      SATURATED call on a HALF-APPLIED closure (not `nargs < rem`: the
//      missing case was the interleave in the saturated arm).  All three
//      nargs/rem shapes are now handled:
//
//        nargs < rem   PARTIAL: hand the same (state, closure) pair to
//                      Rt.applyPartGo — the ONE source of the interleave,
//                      shared with applyGo/applyTailGo's own partial arms, so
//                      the host and the generated-code route cannot drift.
//        nargs > rem   OVER-APPLIED: apply the first `rem` through THIS seat
//                      (a recursive call, so it lands in one of the other two
//                      arms) and `recur` on the result with the rest.  `rem`
//                      is at least 1 or the loop makes no progress, so a grand
//                      total application of an ALREADY fully applied closure
//                      (rem == 0) still DIES — loudly, and it cannot arise
//                      from compiled code (a closure is built with rem ==
//                      arity and saturation returns a VALUE, so no rem == 0
//                      closure ever survives as a value).
//        nargs == rem  SATURATED: `napp == 0` is the 7A path (a Disp, the full
//                      static arity, Rt.callArity).  `napp > 0` is the arm
//                      that was missing: the params are the applied cells
//                      then the new args, which is exactly rt_call2r's
//                      two-range bridge (the same call applyGo's saturated
//                      arm makes, and NOT Rt.apply/Rt.applyGo — trap 1).
//
// THE TWO DIE MESSAGES 7A KEPT FOR THE UNPORTED CASES ARE GONE BECAUSE THE
// CASES ARE PORTED, not because they were reworded: `a partially applied
// closure reached the applier` and `the applier was handed a different number
// of arguments than the closure's arity` described states that are now normal
// input.  What remains dies by name: the non-function value, a half-applied
// closure with no env (the runtime's own message, same condition as applyGo's
// saturated arm), and the rem == 0 over-application above.
//
// `bufN` is the caller's argument area as a BOXED raw address: `nargs`
// CONTIGUOUS 40-byte cells that the caller keeps reachable from a registered
// root (Rt.callArity needs buf + 40k, which is why a slice of the rooted slot
// array IS the argument buffer — no copy, no second referee).
defun Rt.apply-at(cN : val, bufN : val, nargsN : val) -> val {
  word buf = payload(bufN, 0);
  word nargs = payload(nargsN, 0);
  if (tagis(cN, 6) == 0) {
    call Rt.dieErr(rawstr("host: apply of a non-function value"));
    return mknil;
  }
  word code = payload(cN, 0);
  word arity = wload(code, 1) & 4294967295;
  word rem = payload32(cN, 1);
  if (nargs > rem) {
    if (rem == 0) {
      call Rt.dieErr(rawstr("host: the applier was handed more arguments than an already fully applied closure"));
      return mknil;
    }
    val f2 = call Rt.apply-at(cN, bufN, mknum(rem));
    recur(f2, mknum(buf + rem * 40), mknum(nargs - rem));
  } else {
    if (nargs < rem) {
      *ApplyState sp = rawcall malloc(32);
      sp->args = buf;
      sp->nargs = nargs;
      sp->live = nargs;
      sp->env = payload(cN, 2);
      val p = call Rt.applyPartGo(mknum(sp), cN);
      rawcall free(sp);
      return p;
    } else {
      word napp = arity - rem;
      if (napp > 0) {
        word env = payload(cN, 2);
        if (env == 0) {
          call Rt.die(rawstr("qbe-rt: closure env missing for applied args"));
          return mknil;
        }
        word r = aggcall ret rawsym("rt_call2r")(wload(code, 0), env, napp, buf, rem);
        word v = aggcall val rawsym("q_Rt_x2ebounce")(r);
        return vecload(v, 0);
      } else {
        *Disp dp = rawcall malloc(32);
        dp->fn = wload(code, 0);
        dp->caps = payload(cN, 2);
        dp->buf = buf;
        dp->arity = arity;
        val r = call Rt.callArity(mknum(dp));
        rawcall free(dp);
        return r;
      }
    }
  }
}

// Rt.hostCall — the host-side wrapper: apply `contAddr`'s closure to the
// argument area (SCR_A0 ..) and leave the value in SCR_RES.  Two stages
// because the RESULT must land in a ROOTED cell before anything else can
// allocate; `r` is a frame binder (a root) and the store right after the call
// is the only thing that reads it.
defun Rt.hostCall(hN : val, contAddrN : val, nargsN : val) -> val {
  word h = payload(hN, 0);
  val r = call Rt.apply-at(vecload(payload(contAddrN, 0), 0), mknum(h + 8 + (33027 * 40)), nargsN);
  vecstore(h + 8 + (33029 * 40), 0, r);
  return mknil;
}

// ========================== THE EVAL TABLE ===============================
// Rt.hostClearGo — nil SCR_* .. `clrBase + 257`.  A loop cursor LIVES IN
// MEMORY (`lp->clr`): a self-tail `recur` may only hand its params back
// unchanged, so an incrementing counter cannot be a parameter here.
defun Rt.hostClearGo(hN : val) -> val {
  word h = payload(hN, 0);
  *Host lp = [*Host](h);
  if (lp->clr >= 258) {
    return mknil;
  } else {
    vecstore(h + 8 + ((lp->clrBase + lp->clr) * 40), 0, mknil);
    lp->clr = lp->clr + 1;
    recur(hN);
  }
}
defun Rt.hostClearFrom(hN : val, baseN : val) -> val {
  word h = payload(hN, 0);
  *Host lp = [*Host](h);
  lp->clrBase = payload(baseN, 0);
  lp->clr = 0;
  return call Rt.hostClearGo(hN);
}

// Rt.hostDeactivate — the Zig's deactivate: drop the evaluation, release every
// slot of its block (the array is permanently rooted, so a stale Value there
// would keep dead closures alive for the whole run) and forget the effect.
defun Rt.hostDeactivate(hN : val, iN : val) -> val {
  word h = payload(hN, 0);
  word i = payload(iN, 0);
  *Host lp = [*Host](h);
  lp->evals[i].active = 0;
  lp->nactive = lp->nactive - 1;
  lp->evals[i].nframes = 0;
  lp->evals[i].etag = 0;
  return call Rt.hostClearFrom(hN, mknum(2 + (i * 258)));
}

// Rt.hostSpawnAt — put `taskAddr`'s task into eval i's block.  `gen` is the
// LOGICAL-eval token (the Zig's generation counter): it is bumped on every
// spawn into this slot, and hostStepGo keeps stepping only while it is
// unchanged — a deliver() can free this slot and spawn a NEW evaluation into
// it, which the loop must not step under the stale one's state.
defun Rt.hostSpawnAt(hN : val, taskAddrN : val, iN : val) -> val {
  word h = payload(hN, 0);
  word taskAddr = payload(taskAddrN, 0);
  word i = payload(iN, 0);
  *Host lp = [*Host](h);
  word base = 2 + (i * 258);
  lp->evals[i].active = 1;
  lp->evals[i].base = base;
  lp->evals[i].gen = lp->evals[i].gen + 1;
  lp->evals[i].nframes = 0;
  lp->evals[i].etag = 0;
  lp->nactive = lp->nactive + 1;
  call Rt.hostClearFrom(hN, mknum(base));
  vecstore(h + 8 + (base * 40), 0, vecload(taskAddr, 0));
  return mknil;
}

// Rt.hostSpawnFind — first INACTIVE slot (the Zig's first-inactive reuse), or
// append.  `i` advances as a VALUE param: this is a short scan and a self-tail
// `recur` on a changed Value is the runtime's own loop shape (Rt.bounceGo).
defun Rt.hostSpawnFind(hN : val, taskAddrN : val, iN : val) -> val {
  word h = payload(hN, 0);
  word i = payload(iN, 0);
  *Host lp = [*Host](h);
  if (i >= lp->nevals) {
    if (lp->nevals >= 128) {
      call Rt.dieErr(rawstr("host: more than 128 concurrent evaluations"));
      return mknil;
    } else {
      lp->nevals = lp->nevals + 1;
      return call Rt.hostSpawnAt(hN, taskAddrN, iN);
    }
  } else {
    if (lp->evals[i].active != 0) {
      recur(hN, taskAddrN, mknum(i + 1));
    } else {
      return call Rt.hostSpawnAt(hN, taskAddrN, iN);
    }
  }
}
defun Rt.hostSpawn(hN : val, taskAddrN : val) -> val {
  return call Rt.hostSpawnFind(hN, taskAddrN, mknum(0));
}

// Rt.hostSpawnFromCmd — one evaluation per Task in a Cmd (a cons list of
// Tasks, nil-terminated).  ALLOCATION-FREE apart from the boxed index, so the
// list's interior pointers stay valid throughout; the cursor is a ROOTED slot
// (SCR_CUR), and the task is staged into SCR_TMP before the spawn so the
// cons cell is never the thing the block clear walks over.
defun Rt.hostSpawnFromCmd(hN : val, curAddrN : val) -> val {
  word h = payload(hN, 0);
  word curAddr = payload(curAddrN, 0);
  val cur = vecload(curAddr, 0);
  if (tagis(cur, 4) == 0) {
    return mknil;
  } else {
    vecstore(h + 8 + (33030 * 40), 0, vecload(payload(cur, 0), 0));
    vecstore(curAddr, 0, vecload(payload(cur, 0), 1));
    call Rt.hostSpawn(hN, mknum(h + 8 + (33030 * 40)));
    recur(hN, curAddrN);
  }
}

// ========================== THE CEK CORE =================================
// Rt.hostPushFrame — push a continuation frame.  The Zig took the closure as
// an argument; here the DISPATCH stages it into SCR_TMP first (three params is
// the whole register budget, and `kind` is one of them).
defun Rt.hostPushFrame(hN : val, iN : val, kindN : val) -> val {
  word h = payload(hN, 0);
  word i = payload(iN, 0);
  word kind = payload(kindN, 0);
  *Host lp = [*Host](h);
  word n = lp->evals[i].nframes;
  if (n >= 256) {
    call Rt.dieErr(rawstr("host: continuation stack overflow (256 frames)"));
    return mknil;
  } else {
    word slot = lp->evals[i].base + 2 + n;
    lp->evals[i].frames[n].kind = kind;
    lp->evals[i].frames[n].cont = slot;
    lp->evals[i].nframes = n + 1;
    vecstore(h + 8 + (slot * 40), 0, vecload(h + 8 + (33030 * 40), 0));
    return mknil;
  }
}

// Rt.hostDispatch — ONE step of one evaluation: the Zig's stepEval's 89-line
// dispatch chain, ctor for ctor.  `task` is the eval's task slot (read FRESH
// every step, and the slot is a ROOT, so `task` survives anything the arms do).
defun Rt.hostDispatch(hN : val, iN : val) -> val {
  word h = payload(hN, 0);
  word i = payload(iN, 0);
  *Host lp = [*Host](h);
  word base = lp->evals[i].base;
  word taskAddr = h + 8 + (base * 40);
  word resAddr = taskAddr + 40;
  val task = vecload(taskAddr, 0);
  if (tagis(task, 10) == 0) {
    return call Rt.hostDeactivate(hN, iN);
  }
  word len = payload32(task, 1);
  if (len < 1) {
    return call Rt.hostDeactivate(hN, iN);
  }
  val tag = vecload(payload(task, 0), 0);
  if (tagis(tag, 2) == 0) {
    return call Rt.hostDeactivate(hN, iN);
  }
  word nm = payload(tag, 0);
  word want = payload(call Rt.hostArity(tag), 0);
  if (mkbool(want != 0) && mkbool(len != want)) {
    return call Rt.hostDeactivate(hN, iN);
  }
  // A FRESH data pointer: the arity probe above allocates (mknum), so a raw
  // copy of the vector's data base taken before it is stale after it.
  word tv = payload(task, 0);
  if (call Rt.cStrEq(nm, rawstr("TaskSucceed")) != 0) {
    vecstore(resAddr, 0, vecload(tv, 1));
    return call Rt.hostCompleteOk(hN, iN);
  }
  if (call Rt.cStrEq(nm, rawstr("TaskFail")) != 0) {
    vecstore(resAddr, 0, vecload(tv, 1));
    return call Rt.hostCompleteErr(hN, iN);
  }
  if (call Rt.cStrEq(nm, rawstr("TaskAndThen")) != 0) {
    val cont = vecload(tv, 1);
    val inner = vecload(tv, 2);
    vecstore(h + 8 + (33030 * 40), 0, cont);
    call Rt.hostPushFrame(hN, iN, mknum(0));
    vecstore(taskAddr, 0, inner);
    return mknil;
  }
  if (call Rt.cStrEq(nm, rawstr("TaskOnError")) != 0) {
    val cont = vecload(tv, 1);
    val inner = vecload(tv, 2);
    vecstore(h + 8 + (33030 * 40), 0, cont);
    call Rt.hostPushFrame(hN, iN, mknum(1));
    vecstore(taskAddr, 0, inner);
    return mknil;
  }
  if (call Rt.cStrEq(nm, rawstr("TaskWrite")) != 0) {
    val s = vecload(tv, 1);
    call Rt.hostWriteStr(mknum(1), s);
    vecstore(resAddr, 0, mknil);
    return call Rt.hostCompleteOk(hN, iN);
  }
  if (call Rt.cStrEq(nm, rawstr("TaskReadLine")) != 0) {
    vecstore(resAddr, 0, call Rt.hostReadLine(mknil));
    return call Rt.hostCompleteOk(hN, iN);
  }
  // TaskReadFile SUSPENDS unless the file drains to EOF at once (a regular file
  // always does; a pipe does not).  The leaf owns etag/complete from here.
  if (call Rt.cStrEq(nm, rawstr("TaskReadFile")) != 0) {
    val path = vecload(tv, 1);
    return call Rt.hostLeafReadFile(hN, iN, path);
  }
  if (call Rt.cStrEq(nm, rawstr("TaskWriteFile")) != 0) {
    val path = vecload(tv, 1);
    val contents = vecload(tv, 2);
    call Rt.hostWriteFileLeaf(path, contents);
    vecstore(resAddr, 0, mknil);
    return call Rt.hostCompleteOk(hN, iN);
  }
  // THE PRIM LEAVES: one `call` each — the Zig's leafPrim/runPrim/varray
  // wrapper has no Mid counterpart (the prim IS a defun).  The argument is
  // read out of the rooted slot BEFORE the call allocates.
  if (call Rt.cStrEq(nm, rawstr("TaskGetenv")) != 0) {
    val a = vecload(tv, 1);
    vecstore(resAddr, 0, call Rt.getenv(a));
    return call Rt.hostCompleteOk(hN, iN);
  }
  if (call Rt.cStrEq(nm, rawstr("TaskSetenv")) != 0) {
    val n2 = vecload(tv, 1);
    val v2 = vecload(tv, 2);
    vecstore(resAddr, 0, call Rt.setenv(n2, v2));
    return call Rt.hostCompleteOk(hN, iN);
  }
  if (call Rt.cStrEq(nm, rawstr("TaskCd")) != 0) {
    val p3 = vecload(tv, 1);
    vecstore(resAddr, 0, call Rt.cd(p3));
    return call Rt.hostCompleteOk(hN, iN);
  }
  if (call Rt.cStrEq(nm, rawstr("TaskGetcwd")) != 0) {
    vecstore(resAddr, 0, call Rt.getcwd(mknil));
    return call Rt.hostCompleteOk(hN, iN);
  }
  if (call Rt.cStrEq(nm, rawstr("TaskGetpid")) != 0) {
    vecstore(resAddr, 0, call Rt.getpid(mknil));
    return call Rt.hostCompleteOk(hN, iN);
  }
  if (call Rt.cStrEq(nm, rawstr("TaskGlob")) != 0) {
    val g1 = vecload(tv, 1);
    vecstore(resAddr, 0, call Rt.glob(g1));
    return call Rt.hostCompleteOk(hN, iN);
  }
  if (call Rt.cStrEq(nm, rawstr("TaskNow")) != 0) {
    vecstore(resAddr, 0, call Rt.hostNowMs(mknil));
    return call Rt.hostCompleteOk(hN, iN);
  }
  // TaskSleep SUSPENDS: record the absolute deadline, leave the eval ACTIVE
  // with etag = 3 and complete NOTHING — hostStepAllGo skips it from here on
  // and the driver's flush wakes it (hostFlushExpiredSleeps -> sleepComplete).
  if (call Rt.cStrEq(nm, rawstr("TaskSleep")) != 0) {
    word ms = payload(vecload(tv, 1), 0);
    word now = payload(call Rt.hostNowMs(mknil), 0);
    lp->evals[i].etag = 3;
    lp->evals[i].sl.deadline = now + ms;
    return mknil;
  }
  if (call Rt.cStrEq(nm, rawstr("TaskExec")) != 0) {
    val plan = vecload(tv, 1);
    return call Rt.hostLeafExec(hN, iN, plan);
  }
  if (call Rt.cStrEq(nm, rawstr("TaskQuit")) != 0) {
    lp->quit = 1;
    return call Rt.hostDeactivate(hN, iN);
  }
  // 7E's TWO — the last leaves.  Both are SYNCHRONOUS, so both own the
  // completion from their leaf (the readFile/exec pattern, minus the etag: a
  // directory walk and an fstatat never suspend).
  if (call Rt.cStrEq(nm, rawstr("TaskListDir")) != 0) {
    val dp = vecload(tv, 1);
    return call Rt.hostLeafListDir(hN, iN, dp);
  }
  if (call Rt.cStrEq(nm, rawstr("TaskStat")) != 0) {
    val sp = vecload(tv, 1);
    return call Rt.hostLeafStat(hN, iN, sp);
  }
  // THE UNPORTED SET IS EMPTY (stage 7E — this unit's headline): every one of
  // Runtime.elm's TWENTY Task constructors has a real arm above, so NO porting
  // gate is left and the string "unported" appears nowhere in this file.
  //
  // WHAT SURVIVES HERE IS THE ZIG'S OWN `else`: effectloop.zig's stepEval ends
  // in `throwShen(unhandledTaskMsg(...))` for a ctor name outside taskArity's
  // twenty.  Such a name is reachable — Rt.hostArity answers 0 for it, so the
  // arity gate above skips and the chain falls through — and it must stay
  // LOUD: a silent deactivate would leave the continuation unresumed and the
  // program apparently working, which is the Zig's stated reason for the arm.
  call Rt.hostDieErr(rawstr("unhandled Task effect: "), nm);
  return mknil;
}

// Rt.hostCompleteOk — success: no frame -> deliver; OnError -> pass the
// success through (and release the frame's closure); AndThen -> apply the
// continuation to the result and step again.
//
// THE ZIG CLEARS THE FRAME SLOT BEFORE APPLYING.  THIS PORT CLEARS IT AFTER:
// the slot is the closure's ROOT for the duration of the call, and clearing
// after costs one store and removes the only window in which the applier's
// target is unreachable.
defun Rt.hostCompleteOk(hN : val, iN : val) -> val {
  word h = payload(hN, 0);
  word i = payload(iN, 0);
  *Host lp = [*Host](h);
  if (lp->evals[i].nframes == 0) {
    return call Rt.hostDeliver(hN, iN);
  } else {
    word n = lp->evals[i].nframes - 1;
    word kind = lp->evals[i].frames[n].kind;
    word cs = lp->evals[i].frames[n].cont;
    lp->evals[i].nframes = n;
    if (kind == 1) {
      vecstore(h + 8 + (cs * 40), 0, mknil);
      recur(hN, iN);
    } else {
      word contAddr = h + 8 + (cs * 40);
      vecstore(h + 8 + (33027 * 40), 0, vecload(h + 8 + ((lp->evals[i].base + 1) * 40), 0));
      call Rt.hostCall(hN, mknum(contAddr), mknum(1));
      vecstore(contAddr, 0, mknil);
      vecstore(h + 8 + (lp->evals[i].base * 40), 0, vecload(h + 8 + (33029 * 40), 0));
      return mknil;
    }
  }
}

// Rt.hostCompleteErr — the mirror: no frame -> drop the message (the Zig's
// "drop the msg"); AndThen -> the error propagates through; OnError -> apply
// the handler to the error.
defun Rt.hostCompleteErr(hN : val, iN : val) -> val {
  word h = payload(hN, 0);
  word i = payload(iN, 0);
  *Host lp = [*Host](h);
  if (lp->evals[i].nframes == 0) {
    return call Rt.hostDeactivate(hN, iN);
  } else {
    word n = lp->evals[i].nframes - 1;
    word kind = lp->evals[i].frames[n].kind;
    word cs = lp->evals[i].frames[n].cont;
    lp->evals[i].nframes = n;
    if (kind == 0) {
      vecstore(h + 8 + (cs * 40), 0, mknil);
      recur(hN, iN);
    } else {
      word contAddr = h + 8 + (cs * 40);
      vecstore(h + 8 + (33027 * 40), 0, vecload(h + 8 + ((lp->evals[i].base + 1) * 40), 0));
      call Rt.hostCall(hN, mknum(contAddr), mknum(1));
      vecstore(contAddr, 0, mknil);
      vecstore(h + 8 + (lp->evals[i].base * 40), 0, vecload(h + 8 + (33029 * 40), 0));
      return mknil;
    }
  }
}

// Rt.hostDeliver — feed a completed message to update, then respawn from the
// Cmd it returned.  `update msg model` is the ONE two-argument apply (the
// argument area is SCR_A0, SCR_A1 — contiguous, in the rooted array).
defun Rt.hostDeliver(hN : val, iN : val) -> val {
  word h = payload(hN, 0);
  word i = payload(iN, 0);
  *Host lp = [*Host](h);
  vecstore(h + 8 + (33027 * 40), 0, vecload(h + 8 + ((lp->evals[i].base + 1) * 40), 0));
  vecstore(h + 8 + (33028 * 40), 0, vecload(h + 8, 0));
  call Rt.hostCall(hN, mknum(h + 8 + 40), mknum(2));
  val pair = vecload(h + 8 + (33029 * 40), 0);
  if (tagis(pair, 4) == 0) {
    return call Rt.hostDeactivate(hN, iN);
  } else {
    vecstore(h + 8, 0, vecload(payload(pair, 0), 0));
    vecstore(h + 8 + (33026 * 40), 0, vecload(payload(pair, 0), 1));
    call Rt.hostDeactivate(hN, iN);
    return call Rt.hostSpawnFromCmd(hN, mknum(h + 8 + (33026 * 40)));
  }
}

// Rt.hostStepGo — ONE evaluation's runnable loop.  The generation check is the
// Zig's `eval.gen == start_gen`: deliver() can free this slot and spawn a NEW
// evaluation into it, and the loop must stop rather than step the new one with
// the old one's state.  `etag != 0` means the evaluation is SUSPENDED on an
// effect (no effect exists in 7A; 7C/7D make this branch load-bearing).
defun Rt.hostStepGo(hN : val, iN : val, genN : val) -> val {
  word h = payload(hN, 0);
  word i = payload(iN, 0);
  word gen = payload(genN, 0);
  *Host lp = [*Host](h);
  if (lp->evals[i].active == 0) {
    return mknil;
  }
  if (lp->evals[i].gen != gen) {
    return mknil;
  }
  if (lp->evals[i].etag != 0) {
    return mknil;
  }
  call Rt.hostDispatch(hN, iN);
  recur(hN, iN, genN);
}
defun Rt.hostStep(hN : val, iN : val) -> val {
  word h = payload(hN, 0);
  word i = payload(iN, 0);
  *Host lp = [*Host](h);
  return call Rt.hostStepGo(hN, iN, mknum(lp->evals[i].gen));
}

// Rt.hostStepAll — step every runnable evaluation once, in slot order.  The
// cursor is `lp->cur` (memory, not a param) and the bound is re-read each
// iteration, exactly as the Zig's `while (i < self.nevals)`: a spawn during
// the scan APPENDS, and a spawn into an already-passed slot is DELIBERATELY
// left for the next pass (the fixpoint drain in hostRun is what delivers it).
defun Rt.hostStepAllGo(hN : val) -> val {
  word h = payload(hN, 0);
  *Host lp = [*Host](h);
  if (lp->cur >= lp->nevals) {
    return mknil;
  } else {
    word i = lp->cur;
    lp->cur = i + 1;
    if (lp->evals[i].active == 0) {
      recur(hN);
    } else {
      if (lp->evals[i].etag != 0) {
        recur(hN);
      } else {
        call Rt.hostStep(hN, mknum(i));
        recur(hN);
      }
    }
  }
}
defun Rt.hostStepAll(hN : val) -> val {
  word h = payload(hN, 0);
  *Host lp = [*Host](h);
  lp->cur = 0;
  return call Rt.hostStepAllGo(hN);
}

// ========================== THE DRIVER ===================================
// Rt.hostRunLoop — the Zig's `while (nactive > 0 and !quit) { stepAll; ...
// reapChildren; completeReady; ... poll; ... flushExpiredSleeps }`.
//
// THE STATEMENT ORDER IS THE ZIG'S (runProgram's loop, effectloop.zig:1218-1260)
// with 7D's two pieces in place:
//
//   stepAll -> flushExpiredSleeps -> [done?] -> reapChildren -> completeReady
//   -> [done?] -> hasRunnable -> (loop at once)
//   -> rebuildPollfds -> pollTimeout
//   -> [npoll == 0 && no deadline: reapBlocking -> completeReady -> loop]
//   -> poll(fds, npoll, timeout) -> reapChildren -> drainReady -> completeReady
//   -> flushExpiredSleeps -> loop
//
// (7C's loop differed by exactly those two names and the npoll == 0 arm: with no
// children the first is a no-op and the second unreachable.)
//
// WHY A poll AND NOT A SPIN: a suspended eval (etag 1, 2 or 3) is ACTIVE, so
// hostStepAllGo skips it forever; without a wait the loop would burn the CPU for
// the effect's whole duration (nowunit sleeps 30+20+20 ms; a readFile or an
// exec waits for a writer).  `poll(NULL, 0, to)` with NO fds is still exactly
// the Zig's bounded sleep, which is the arm a sleep-only program takes.
//
// THE npoll == 0 ARM IS THE REAP RACE (effectloop.zig:1050): an exec's pipes
// EOF a moment BEFORE the exiting child becomes waitpid-able, so the WNOHANG
// reap just above can miss it and leave the exec active with both fds already
// drained — no fd to poll, no sleep deadline, and (before this unit) a LOUD
// die.  With no fd left the child cannot be blocked writing to us, so the
// BLOCKING waitpid returns promptly; then completeReady finishes it.  A second
// pass finds no child at all and the same state IS a stuck program: loud die.
//
// EVERY GUARD'S BRANCH DIVERGES (return/recur): J7 refuses a mid-block `if` with
// two falling-through branches, and that rule is what shapes this defun.
defun Rt.hostRunLoop(hN : val) -> val {
  word h = payload(hN, 0);
  *Host lp = [*Host](h);
  if (mkbool(lp->nactive == 0) || mkbool(lp->quit != 0)) {
    return mknil;
  }
  call Rt.hostStepAll(hN);
  call Rt.hostFlushExpiredSleeps(hN);
  if (mkbool(lp->nactive == 0) || mkbool(lp->quit != 0)) {
    return mknil;
  }
  call Rt.hostReapChildren(hN);
  call Rt.hostCompleteReady(hN);
  if (mkbool(lp->nactive == 0) || mkbool(lp->quit != 0)) {
    return mknil;
  }
  if (payload(call Rt.hostRunnableScan(hN, mknum(0)), 0) != 0) {
    recur(hN);                             // pure work left: no wait, loop now
  }
  call Rt.hostRebuildPollfds(hN);
  word to = payload(call Rt.hostPollTimeout(hN));
  if (mkbool(lp->npoll == 0) && mkbool(to < 0)) {
    if (payload(call Rt.hostReapBlocking(hN), 0) != 0) {
      call Rt.hostCompleteReady(hN);
      recur(hN);
    }
    call Rt.dieErr(rawstr("host: a pending effect has no pollable fd"));
    return mknil;
  }
  rawcall poll(lp->poll, lp->npoll, to);   // nfds 0 + a timeout IS a sleep
  call Rt.hostReapChildren(hN);
  call Rt.hostDrainReady(hN);
  call Rt.hostCompleteReady(hN);
  call Rt.hostFlushExpiredSleeps(hN);
  recur(hN);
}

// Rt.hostRun — drive the
// Program and leave the final MODEL in the caller's 40-byte cell.  The
// signature is deliberately the Zig seat's (value in, destination cell in,
// nothing out) so 7F's deletion of that seat is a drop-in.
//
// THE CLEANUP RUNS BEFORE THE MODEL IS COPIED OUT (7D): cleanupAll frees the
// pending effects, and the exec arm's plan free is a value-ABI call, i.e. a GC
// ALLOCATION.  `outAddr` is Rt.main's RAW `modelslot` (malloc(40), not in any
// scanned array), so a collect AFTER the copy would move the model in the
// blob's slot 0 and leave a stale pointer in the cell that Rt.printValue
// reads.  Before the copy, the model is still reachable through the registered
// slot array and a collect updates it in place — so the order is
// cleanup -> copy -> free the fd table -> pop the root.
//
// THE fd TABLE IS FREED AFTER the effects (no effect can reference it) and the
// root pop is LAST, which is the Zig's `defer` LIFO order (rootPop declared
// first, so cleanupAll runs first).
defun Rt.hostRun(progAddrN : val, outAddrN : val) -> val {
  word progAddr = payload(progAddrN, 0);
  word outAddr = payload(outAddrN, 0);
  val hN = call Rt.hostInit(progAddrN);
  word h = payload(hN, 0);
  *Host lp = [*Host](h);
  val prog = vecload(progAddr, 0);
  vecstore(h + 8 + (33026 * 40), 0, vecload(payload(prog, 0), 2));
  call Rt.hostSpawnFromCmd(hN, mknum(h + 8 + (33026 * 40)));
  call Rt.hostRunLoop(hN);
  call Rt.hostCleanupAll(hN);
  vecstore(outAddr, 0, vecload(h + 8, 0));
  rawcall free(lp->poll);
  call Rt.rootPop();
  return mknil;
}
