// Rt.globalClosure: THE PER-DESC CLOSURE CACHE (zighost Z3) — the native
// mirror of the VM's defun table (one closure per defun, built once).  The
// deleted Zig seat (hostshim.zig rt_global_closure) kept its slot in a
// page-allocator arena and pushed it on the ZIG shadow stack forever; both are
// gone with that collector, and NO ROOT IS NEEDED HERE: the slot is a malloc'd
// 40-byte Value whose payload words are a STATIC descriptor address (code), the
// descriptor's arity (code_len) and ZERO (env, env_len) — it holds no pointer
// into either heap, so there is nothing for a collector to update or keep.
// (Putting the slot in the MID heap instead and relying on `desc.cache` would
// be a second *argv*-class hole — a reachable object nothing roots; the C-heap
// slot avoids that BY CONSTRUCTION, not by discipline.)
//
// THE CACHE WORD IS desc+16 (RtLayout.descCacheOffset): the emitted descriptor
// data is `{ l fn, w arity, w ncaps, z 8 }` — 24 bytes, cache at word 2.
// The fast path is one load + one compare + a 40-byte vecload, which is what
// makes this affordable at the 832 shipped selfhost call sites: no call, no
// allocation, no root push on the hit.
//
// code_len is the FULL desc word 1 (arity | ncaps<<32) exactly as the sibling
// seat Rt.closure writes it (mkval's second word); every reader is a
// payload32, i.e. the low half, and a top-level defun's ncaps is 0.
defun Rt.globalClosure(desc : word) -> val {
  word cache = wload(desc, 2);
  if (cache != 0) {
    return vecload(cache, 0);
  }
  word slot = rawcall malloc(40);
  wstore(slot, 0, 6);
  wstore(slot, 1, desc);
  wstore(slot, 2, wload(desc, 1));
  wstore(slot, 3, 0);
  wstore(slot, 4, 0);
  wstore(desc, 2, slot);
  return vecload(slot, 0);
}

defun Rt.bytesBuild(s : val, i : val, acc : val) -> val {
  if (mkbool(payload(i, 0) <= 0)) {
    return acc;
  } else {
    return call Rt.bytesBuild(s, mknum(payload(i, 0) - 1), call Rt.cons(mknum(strbyte(s, payload(i, 0) - 1)), acc));
  }
}

defun Rt.symLess(a : val, bb : val, i : val) -> val {
  val ca = mknum(strbyte(a, payload(i, 0)));
  val cb = mknum(strbyte(bb, payload(i, 0)));
  if (mkbool(payload(ca, 0) == 0)) {
    return mkbool(payload(cb, 0) != 0);
  } else {
    if (mkbool(payload(cb, 0) == 0)) {
      return mkbool(0);
    } else {
      if (mkbool(payload(ca, 0) < payload(cb, 0))) {
        return mkbool(1);
      } else {
        if (mkbool(payload(ca, 0) > payload(cb, 0))) {
          return mkbool(0);
        } else {
          return call Rt.symLess(a, bb, mknum(payload(i, 0) + 1));
        }
      }
    }
  }
}

defun Rt.read-file-as-string(path : val) -> val {
  word lenW = payload32(path, 1);
  word bufW = allocraw(lenW + 1);
  val bufN = mknum(bufW);
  call Rt.cStrFill(bufN, path, mknum(0));
  word fdW = rawcall openat(-100, bufW, 0, 0);
  if (mkbool(fdW < 0)) {
    val msg = "runtime: cannot open file for read-file-as-string\n";
    word w12 = rawcall write(2, payload(msg, 0), payload32(msg, 1));
    return "";
  } else {
    *ReadBlk blkW = rawcall malloc(72);
    val _u42 = if (mkbool(blkW == 0)) {
      word h = rawcall rt_halt();
      return mknil;
    } else {
      return mknum(0);
    };
    val blkN = mknum(blkW);
    word tmpW = rawcall malloc(65536);
    val _u43 = if (mkbool(tmpW == 0)) {
      word f15 = rawcall free(blkW);
      word h = rawcall rt_halt();
      return mknil;
    } else {
      return mknum(0);
    };
    blkW->fd = fdW;
    blkW->tmp = tmpW;
    blkW->acc = 0;
    blkW->len = 0;
    blkW->cap = 0;
    call Rt.readFileGo(blkN);
    word len22 = blkW->len;
    word accW = blkW->acc;
    word dstW = allocraw(len22 + 1);
    wstore(blkW, 6, accW);
    wstore(blkW, 7, dstW);
    wstore(blkW, 8, len22);
    call Rt.memGo(mknum([word](blkW) + 48), mknum(0));
    bytestore(dstW, len22, 0);
    word f30 = rawcall free(accW);
    word f31 = rawcall free(tmpW);
    word f32 = rawcall free(blkW);
    word f33 = rawcall close(fdW);
    return mkstr(dstW, len22);
  }
}

defun Rt.readFileGo(blkN : val) -> val {
  word fdW = [*ReadBlk](payload(blkN, 0))->fd;
  word tmpW = [*ReadBlk](payload(blkN, 0))->tmp;
  val nV = call Rt.readFull(mknum(fdW), mknum(tmpW), mknum(65536));
  if (mkbool(payload(nV, 0) < 0)) {
    return mknil;
  }
  if (mkbool(payload(nV, 0) == 0)) {
    return mknil;
  }
  word lenW = [*ReadBlk](payload(blkN, 0))->len;
  word capW = [*ReadBlk](payload(blkN, 0))->cap;
  word neededW = lenW + payload(nV, 0);
  val growB = if (mkbool(neededW > capW)) {
    word newcapW = neededW + (capW * 2 - neededW) * (capW * 2 > neededW);
    word mW = rawcall malloc(newcapW);
    if (mkbool(mW == 0)) { return mknum(1); }
    word oldW = [*ReadBlk](payload(blkN, 0))->acc;
    wstore(payload(blkN, 0), 6, oldW);
    wstore(payload(blkN, 0), 7, mW);
    wstore(payload(blkN, 0), 8, lenW);
    call Rt.memGo(mknum(payload(blkN, 0) + 48), mknum(0));
    rawcall free(oldW);
    [*ReadBlk](payload(blkN, 0))->acc = mW;
    [*ReadBlk](payload(blkN, 0))->cap = newcapW;
    return mknum(0);
  } else {
    return mknum(0);
  };
  if (mkbool(payload(growB, 0) == 1)) {
    return mknil;
  }
  word accW = [*ReadBlk](payload(blkN, 0))->acc;
  wstore(payload(blkN, 0), 6, tmpW);
  wstore(payload(blkN, 0), 7, accW + lenW);
  wstore(payload(blkN, 0), 8, payload(nV, 0));
  call Rt.memGo(mknum(payload(blkN, 0) + 48), mknum(0));
  [*ReadBlk](payload(blkN, 0))->len = neededW;
  recur(blkN);
}

