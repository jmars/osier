  }
}

defun Rt.closePipesGo(pfdsN : val, jN : val, boundN : val) -> val {
  if (mkbool(payload(jN, 0) >= payload(boundN, 0))) {
    return mknil;
  } else {
    word w = wload(payload(pfdsN, 0), payload(jN, 0));
    rawcall close(w & 4294967295);
    rawcall close(w / 4294967296);
    recur(pfdsN, mknum(payload(jN, 0) + 1), boundN);
  }
}

defun Rt.closeOthersGo(cmdsArrN : val, stN : val, jN : val) -> val {
  if (mkbool(payload(jN, 0) >= [*Exec](payload(stN, 0))->ncmds)) {
    return mknil;
  } else {
    word cmdN = payload(cmdsArrN, 0) + (payload(jN, 0) * 40);
    val skip = mkbool(payload(jN, 0) != [*Exec](payload(stN, 0))->curCmd) ? call Rt.closeCmdTmpfds(mknum(cmdN), mknum(0)) : mknil;
    recur(cmdsArrN, stN, mknum(payload(jN, 0) + 1));
  }
}

defun Rt.runBuiltinInprocess(cmdN : val, stN : val) -> val {
  word sav0 = rawcall dup(0);
  word sav1 = rawcall dup(1);
  word sav2 = rawcall dup(2);
  if (mkbool(sav0 < 0) || (mkbool(sav1 < 0) || mkbool(sav2 < 0))) {
    val _u18 = if (mkbool(sav0 >= 0)) {
      rawcall close(sav0);
      return mknil;
    } else {
      return mknil;
    };
    val _u19 = if (mkbool(sav1 >= 0)) {
      rawcall close(sav1);
      return mknil;
    } else {
      return mknil;
    };
    val _u20 = if (mkbool(sav2 >= 0)) {
      rawcall close(sav2);
      return mknil;
    } else {
      return mknil;
    };
    return mknum(-1);
  } else {
    word outfdW = [*Exec](payload(stN, 0))->outfd;
    word errfdW = [*Exec](payload(stN, 0))->errfd;
    rawcall dup2(outfdW, 1);
    rawcall dup2(errfdW, 2);
    val rc = call Rt.applyRedirects(cmdN, stN, mknum(0));
    word argcN = [*CmdState](payload(cmdN, 0))->argc;
    word argvN = [*CmdState](payload(cmdN, 0))->argv;
    val rc2 = mkbool(payload(rc, 0) < 0) ? mknum(1) : call Rt.childBuiltin(mknum(argcN), mknum(argvN), stN);
    val fin = mkbool(payload(rc2, 0) < 0) ? mknum(127) : rc2;
    rawcall dup2(sav0, 0);
    rawcall close(sav0);
    rawcall dup2(sav1, 1);
    rawcall close(sav1);
    rawcall dup2(sav2, 2);
    rawcall close(sav2);
    return fin;
  }
}

defun Rt.execGo(stN : val, modeN : val) -> val {
  if (mkbool(payload(modeN, 0) == 0)) {
    *Prog progW = [*Exec](payload(stN, 0))->subprog;
    word nchains = progW->nchains;
    if (mkbool([*Exec](payload(stN, 0))->chain >= nchains)) {
      if (mkbool([*Exec](payload(stN, 0))->inChild == 0)) {
        return mknum([*Exec](payload(stN, 0))->code);
      } else {
        rawcall _exit([*Exec](payload(stN, 0))->code);
        return mknil;
      }
    } else {
      word chainsArr = progW->chains;
      *Chain chainN = chainsArr + ([*Exec](payload(stN, 0))->chain * 16);
      word opW = chainN->op;
      word pipeNw = chainN->pipe;
      if (mkbool([*Exec](payload(stN, 0))->chain > 0) && ((mkbool(opW == 1) && mkbool([*Exec](payload(stN, 0))->code != 0)) || (mkbool(opW == 2) && mkbool([*Exec](payload(stN, 0))->code == 0)))) {
        [*Exec](payload(stN, 0))->chain = [*Exec](payload(stN, 0))->chain + 1;
        recur(stN, mknum(0));
      } else {
        [*Exec](payload(stN, 0))->pipe = pipeNw;
        recur(stN, mknum(1));
      }
    }
  } else {
    if (mkbool(payload(modeN, 0) == 1)) {
      *Pipe pipeW = [*Exec](payload(stN, 0))->pipe;
