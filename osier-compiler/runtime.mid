      rstW->code = 0;
      rstW->chain = 0;
      val codeN = call Rt.execGo(mknum(rstW), mknum(0));
      word chainsW = [*Prog](payload(progN, 0))->chains;
      call Rt.epFreeChains(progN, mknum(chainsW), mknum(0));
      rawcall free(rstW);
      rawcall free(stW);
      rawcall free(cbufW);
