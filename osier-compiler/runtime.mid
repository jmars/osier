  }
}
// cnt copies of s by DOUBLING (text-fix): `cur` grows s, s+s, s+s+s+s, ... and
// `acc` collects the binary digits of cnt, so the whole repeat is O(log cnt)
// Rt.cn2 concatenations — O(total) bytes copied, O(log cnt) allocations —
// where the old shape built a cons cell per BYTE and reversed the list twice.
// 3 val params, the LEAN-ABI bound; the recursion is `recur` (depth = the bit
// count of cnt).
defun Rt.repGo(acc : val, cur : val, n : val) -> val {
  if (mkbool(payload(n, 0) == 0)) {
    return acc;
  }
  val bit = mknum(payload(n, 0) - (payload(n, 0) / 2) * 2);
  val acc2 = mkbool(payload(bit, 0) == 1) ? call Rt.cn2(acc, cur) : acc;
  recur(acc2, call Rt.cn2(cur, cur), mknum(payload(n, 0) / 2));
}
