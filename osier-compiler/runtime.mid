  }
}

defun Rt.closeCmdTmpfds(cmdN : val, iN : val) -> val {
  word nredirs = [*CmdState](payload(cmdN, 0))->nredirs;
  if (mkbool(payload(iN, 0) >= nredirs)) {
    return mknil;
  } else {
    word arrN = [*CmdState](payload(cmdN, 0))->redirs;
    *Redir redirN = arrN + (payload(iN, 0) * 48);
    word tmpN = redirN->tmpfd;
    val _u17 = if (mkbool(tmpN >= 0)) {
      rawcall close(tmpN);
      redirN->tmpfd = -1;
      return mknil;
    } else {
      return mknil;
    };
    recur(cmdN, mknum(payload(iN, 0) + 1));
  }
