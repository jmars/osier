  *Prog subW = [*CmdState](payload(cmdAddrN, 0))->subprog;
  val _u13 = if (mkbool(subW != 0)) {
    return call Rt.epFreeChains(mknum(subW), mknum(subW->chains), mknum(0));
  } else {
    return mknil;
  };
  return mknil;
}

defun Rt.epFreeArgv(arrN : val, jN : val, nN : val) -> val {
