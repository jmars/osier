.{
    .name = .osier,
    .version = "0.0.0",
    // Renaming the package (withe -> osier) changes this: zig derives it from
    // .name and refuses a stale value.  0x454d67aee8306770 is the value zig
    // 0.16 prints for `.name = .osier`.
    .fingerprint = 0x454d67aee8306770, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // osier-rt: the RUNTIME package (the GC + values/state/prims/varray/
        // streams/execplan) — what every backend links.  Path dependency
        // (osier owns vendor/osier-rt); vendored per the user's ruling.
        .osier_rt = .{
            .path = "vendor/osier-rt",
        },
        // zinc-vm: the ZINC interpreter package (interp/parser/hostcall),
        // which depends on osier-rt and dies at P8.
        .zinc_vm = .{
            .path = "vendor/zinc-vm",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tests",
    },
}
