.zig-cache/
zig-out/

# elm-compiler build artifacts (regenerable via elm-compiler/build.sh)
elm-compiler/elm-stuff/
elm-compiler/compiler.js
elm-compiler/test-compiler.js

# elm-fixtures generated output (iofile test writes this each gate run)
tests/elm-fixtures/out/hello.out

# zig global cache redirected onto the pool (tools/aot/aot-build.sh)
.zig-cache-global/
__pycache__/
*.pyc

# paper PDF build products.  The .tex IS committed (a referee can read what was
# typeset); the PDFs are committed too -- the GitHub/Zenodo release archives only
# what is tracked, and Zenodo cannot accept added files after publication.
docs/research/build/*
!docs/research/build/*.tex
!docs/research/build/*.pdf

# qbe native-backend build artefact (tools/qbe/qbe-mk.sh builds it on demand)
tools/qbe/rt.o
