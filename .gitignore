# (ZIGHOST Z6) the Zig build's caches are gone with the Zig runtime; the native
# build products (tools/qbe-bootstrap.sh, tools/qbe/qbe-selfhost.sh) land in out/.
out/

# osier-compiler build artifacts (regenerable via osier-compiler/build.sh)
osier-compiler/elm-stuff/
osier-compiler/compiler.js
osier-compiler/test-compiler.js

# elm-fixtures generated output (iofile test writes this each gate run)
tests/elm-fixtures/out/hello.out
# stage 7D's execfallback row: the plan's `out` redirect target (its presence IS
# the assertion — the golden bytes live in expected/execfallback.out.txt)
tests/elm-fixtures/out/execfallback.out

# zig global cache redirected onto the pool (tools/aot/aot-build.sh)
.zig-cache-global/
__pycache__/
*.pyc

# paper PDF build products.  The .tex IS committed (a referee can read what was
# typeset); the PDFs are committed too -- the GitHub/Zenodo release archives only
# what is tracked, and Zenodo cannot accept added files after publication.
docs/research/build/*
!docs/research/build/*.tex
!docs/research/build/*.pdf

# (ZIGHOST Z6) tools/qbe/rt.o — the Zig runtime object — is DELETED; the entry
# that ignored it is deleted with it, so a rebuilt object would show up in
# `git status` as a returning client.

# fetched third-party Elm sources (tools/bench/fetch-elm-corpus.sh) — the script and
# MANIFEST.tsv are the committed record; the sources are reproducible, not vendored.
tools/bench/elm-corpus/*/
tools/bench/elm-corpus/.all-packages.json
tools/bench/elm-corpus/.fetch-one.sh
tools/bench/elm-corpus/MODINDEX.tsv
tools/bench/elm-corpus/.sweep-one.sh
tools/qbe/.wip/
tests/elm-fixtures/out/progio.out
