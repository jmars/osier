# lphi-const.ssa — the IL shape that made qbe's copy elimination mistype a phi
# (the cross-rv64-lphi row in tools/qbe/qbe-check.sh; the fix and its
# provenance are recorded in THIRD-PARTY.md under "Local patch").
#
# A diamond whose two arms store the constants 0 and 1 as EIGHT-BYTE values,
# read back by an `l` load.  qbe's ssa() turns that read into an `l`-class phi
# of `$0`/`$1`, and copy.c's phicopyref() used to replace any such phi with the
# dominating `jnz` argument — a `w`-class condition — because qbe's constants
# are untyped (con01 matches a 0/1 of any class).  The result was ill-typed
# IL: a `w` temp in an `l` slot.  rv64/isel.c's fixarg asserts on it (hard
# abort); amd64/arm64 accept it and widen silently.
#
# This is HAND-WRITTEN IL, not the Mid emitter's output, so the row that runs
# it stays RED independently of any emitter change: it pins the dependency fix
# itself.  Note `%cond` must be a DERIVED 0/1 value, not a raw parameter —
# copy.c's `isw1()` guard reads widths, and a plain parameter has none.
type :val = align 8 { w, l }

export function w $f(w %x) {
@start
	%cond =w ceqw %x, 0
	%blk =l alloc8 16
	%addr =l add %blk, 8
	jnz %cond, @one, @zero
@zero
	storew 0, %blk
	storel 0, %addr
	jmp @join
@one
	storew 0, %blk
	storel 1, %addr
	jmp @join
@join
	%v =l loadl %addr
	%r =l add %v, 3
	%rw =w copy %r
	ret %rw
}
