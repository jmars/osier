// Whost.mid — THE APPLIER PIN (stage 7A): a Mid defun applying a COMPILED
// Elm closure, with its arguments in a rooted raw array, across a REAL
// collection.
//
// WHY THIS FIXTURE EXISTS (plan §7.3's 7A row, gap G-M).  The Mid host's
// applier — Rt.apply-at -> Rt.callArity — had NO CALLER anywhere in the tree
// before the host, so its first real exercise would otherwise be the selfhost,
// where a silent-wrong answer is not a red row.  This pins it in the cheapest
// place that can see the failure: a golden that is a NUMBER (not a heap
// address) and a churn arm that forces a scavenge while the closure and its
// arguments are live.
//
// WHAT EACH ARM WOULD PRINT IF IT WERE WRONG — the golden is the discriminator:
//   * Rt.apply/Rt.applyGo instead of Rt.callArity (plan §4.1's first trap):
//     applyGo's saturated arm returns mknum(:ret buffer), an UNFORCED TAIL, so
//     the arm prints a heap ADDRESS (or SEGVs) instead of 417.
//   * the Disp's `arity` = `arity - rem` (0 for a global closure) instead of
//     the closure's STATIC arity (wload(desc,1)) — the second trap: the call
//     passes ZERO args and the closure reads whatever the callee's prologue
//     left in the argument slots.  Again not 417.
//   * a root array that is not registered (or args copied out of it into an
//     unrooted buffer): after churn() has collected, the closure/message read
//     back is stale — a moving scavenge rewrites the ROOTED slots IN PLACE, so
//     the arm answers 0 or garbage at QBE_HEAP_MB=${CHURN_MB}.
//   * `caps` (the Disp's env word) dropped: runCap's closure captures its
//     multiplier, so an env of 0 makes it read a garbage capture.
//
// THE ARGUMENT AREA IS A SLICE OF THE ROOTED ARRAY (blob + 88 = slots[2]) —
// no copy, no second referee — which is what Rt.callArity's `buf + 40k` needs
// and what makes the host's argument discipline expressible at all.
module Whost

export Whost.run : val -> val -> val -> val
export Whost.runCap : val -> val -> val
export Whost.runPart : val -> val -> val -> val
export Whost.runOver : val -> val -> val -> val -> val

struct St {
  n : i32;
  slots : val[8];
}

// Garbage on the GC heap: allocraw in a loop until the collector has to run.
// `accN` is threaded only so the loop is a self-tail; nothing reads it.
defun Whost.churn(nN : val, accN : val) -> val {
  if (payload(nN, 0) == 0) {
    return accN;
  } else {
    allocraw(24);
    recur(mknum(payload(nN, 0) - 1), accN);
  }
}

// runPart closure x y  ==  (closure x) y — STAGE 7 O3-fix's two missing
// applier arms in ONE arm pair: the FIRST call is PARTIAL (nargs < rem, so the
// applier must build a half-applied closure through Rt.applyPartGo) and the
// SECOND is SATURATED on that half-applied closure (nargs == rem with
// napp > 0, so the params are the applied cell then the new arg — rt_call2r's
// two-range bridge, NOT the Disp/rt_callN route a napp == 0 closure takes).
// That second shape is EXACTLY the one the seed-built compiler tripped
// (MEASURED arity=2 rem=1 nargs=1) — so this arm is the cheap, permanent
// stand-in for the 12-minute bootstrap run.
//
// The half-applied closure is PARKED IN A ROOTED SLOT (slot 3) and a second
// 20000-allocation churn runs between building it and applying it: the partial
// arm's env array is an allocvec result, so this is the rooting oracle for the
// NEW arm (a closure whose env is collected/moved between the two calls prints
// garbage instead of the golden).
defun Whost.runPart(uN : val, xN : val, yN : val) -> val {
  word blob = rawcall malloc(400);
  *St lp = [*St](blob);
  lp->n = 6;
  call Rt.rootPushValueArray(blob + 8, blob);
  vecstore(blob + 8, 0, uN);
  vecstore(blob + 8 + 40, 0, xN);
  vecstore(blob + 8 + 80, 0, yN);
  val ch = call Whost.churn(mknum(20000), mknil);
  val part = call Rt.apply-at(vecload(blob + 8, 0), mknum(blob + 48), mknum(1));
  vecstore(blob + 8 + 120, 0, part);
  val ch2 = call Whost.churn(mknum(20000), mknil);
  val r = call Rt.apply-at(vecload(blob + 8 + 120, 0), mknum(blob + 88), mknum(1));
  call Rt.rootPop();
  return r;
}

// runOver closure a b c  ==  closure a b c, where `closure` has arity 2 and
// RETURNS A FUNCTION: the applier must saturate the first two (rem == 2) and
// then apply THAT RESULT to the third — the OVER-APPLIED arm (nargs > rem),
// which 7A refused outright (`the applier was handed a different number of
// arguments than the closure's arity`).  A wrong arm here dies or prints a
// non-123 number, never 123.
defun Whost.runOver(uN : val, aN : val, bN : val, cN : val) -> val {
  word blob = rawcall malloc(400);
  *St lp = [*St](blob);
  lp->n = 8;
  call Rt.rootPushValueArray(blob + 8, blob);
  vecstore(blob + 8, 0, uN);
  vecstore(blob + 8 + 40, 0, aN);
  vecstore(blob + 8 + 80, 0, bN);
  vecstore(blob + 8 + 120, 0, cN);
  val ch = call Whost.churn(mknum(20000), mknil);
  val r = call Rt.apply-at(vecload(blob + 8, 0), mknum(blob + 48), mknum(3));
  call Rt.rootPop();
  return r;
}

// run closure model msg  ==  closure msg model, with BOTH arguments held in
// the rooted array and the closure surviving the churn.
defun Whost.run(uN : val, mN : val, xN : val) -> val {
  word blob = rawcall malloc(400);
  *St lp = [*St](blob);
  lp->n = 6;
  call Rt.rootPushValueArray(blob + 8, blob);
  vecstore(blob + 8, 0, mN);
  vecstore(blob + 8 + 40, 0, uN);
  vecstore(blob + 8 + 80, 0, xN);
  val ch = call Whost.churn(mknum(20000), mknil);
  vecstore(blob + 8 + 120, 0, vecload(blob + 8, 0));
  val r = call Rt.apply-at(vecload(blob + 8 + 40, 0), mknum(blob + 88), mknum(2));
  call Rt.rootPop();
  return r;
}

// runCap closure x  ==  closure x, where the closure carries ONE CAPTURE
// (ncaps = 1, napp = 0 — created by an Elm-level partial application, so its
// `rem` still equals its `arity` and the applier's napp guard is satisfied).
// This is the arm that exercises the Disp's `caps` word.
defun Whost.runCap(uN : val, xN : val) -> val {
  word blob = rawcall malloc(400);
  *St lp = [*St](blob);
  lp->n = 6;
  call Rt.rootPushValueArray(blob + 8, blob);
  vecstore(blob + 8, 0, uN);
  vecstore(blob + 8 + 40, 0, xN);
  val ch = call Whost.churn(mknum(20000), mknil);
  val r = call Rt.apply-at(vecload(blob + 8, 0), mknum(blob + 48), mknum(1));
  call Rt.rootPop();
  return r;
}
