// B4 (handoff-midlang-b4) — THE WORKED EXAMPLE's .mid: the loop surface,
// imported by name from midb4.elm.  A SIBLING of Warr.mid (B3) and
// Wext.mid (B2), so neither earlier golden can be moved by a loop
// regression.
//
//   tools/qbe/qbe-mk.sh tools/qbe/fixtures/midb4.elm MidB4.main <outdir>
//   <outdir>/midb4 MidB4.main
//
// Expected stdout with top = 5:  15042106
//   = sum(15) | found(4) | oddSum(21) | tri(6)
//
// What each part pins (a bug in any one moves the number):
//   * (a) `while (i < top) { .. }` — the loop-carried WORD locals `i` and
//     `sum` are AUTO-CELLED (assigned in the body), so the sum 1..5 = 15 is
//     read from memory across the back edge; a register would need a phi.
//   * (b) `for (k = 0; k < 6; k = k + 1)` over a fixed array with an EARLY
//     `break` — `found` stops at 4 (a[4] == 5).  A break that fell through
//     to the loop top would keep scanning and a wrong index would report
//     another element.
//   * (c) a `continue` that must RUN THE STEP: both 1s in the array are
//     skipped, so oddSum = 3+4+5+9 = 21.  If `continue` jumped to the loop
//     TOP instead of running `j = j + 1`, the loop would never terminate
//     (the fixture would hang, not print a wrong number — deliberately).
//   * (d) a NESTED loop with a loop-carried word index (`r`, `c`), where `c`
//     is declared INSIDE the outer body — its cell is allocated once per
//     ENTRY to the block (the init-once rule) — giving tri = 1+2+3 = 6.
module Wloop
export Wloop.run : val -> val

defun Wloop.run(n : val) -> val {
  word top = payload(n, 0);

  word i = 0;
  word sum = 0;
  while (i < top) {
    i = i + 1;
    sum = sum + i;
  }

  word[6] a = { 3, 1, 4, 1, 5, 9 };
  word k = 0;
  word found = 99;
  for (k = 0; k < 6; k = k + 1) {
    if (a[k] == 5) {
      found = k;
      break;
    }
  }

  word oddSum = 0;
  word j = 0;
  for (j = 0; j < 6; j = j + 1) {
    if (a[j] == 1) { continue; }
    oddSum = oddSum + a[j];
  }

  word tri = 0;
  word r = 0;
  while (r < 3) {
    word c = 0;
    while (c <= r) {
      tri = tri + 1;
      c = c + 1;
    }
    r = r + 1;
  }

  return mknum((sum * 1000000) + (found * 10000) + (oddSum * 100) + tri);
}
