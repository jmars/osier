// GC NURSERY unit (stage A) — THE MINIMAL YOUNG PROBES, graded by what the
// stage-A scavenge passes.  MEASURED at QBE_MIDGC_YOUNG_MB=1, QBE_HEAP_MB=16:
//   hold / two / stale / rootNoCopy  GREEN (rooted survival across young
//                                     cycles, both slots updated, one and
//                                     two rooted objects, the stale raw copy)
//   rooted (mode 3) -> 1              The stage-A drain bug's reproducer,
//                                     FIXED: the FORWARDED test's word `&`
//     lowered w-class (32-bit), so `flags & 2^62` was identically zero, every
//     forwarded body was re-copied, and the drain read the re-copy's word -1
//     (an address) as its scan count.  Post-fix all six modes are green.
//   The `fill` (write-barrier) arm is NOT landed: stage B (the remembered
//   set) does not exist yet.
module Wyoung

export Wyoung.hold : val -> val
export Wyoung.two : val -> val
export Wyoung.stale : val -> val
export Wyoung.rooted : val -> val
export Wyoung.fill : val -> val
export Wyoung.prealloc : val -> val
export Wyoung.unbarred : val -> val
export Wyoung.rootNoCopy : val -> val
export Wyoung.rootNoRead : val -> val

struct Box { tag : word; item : val; }

// cnt one-element young vectors, dropped immediately: fills the young space.
defun Wyoung.churn(cnt : val) -> val {
  if (mkbool(payload(cnt, 0) == 0)) {
    return mknil;
  }
  word base = allocvec(1);
  vecstore(base, 0, mknum(999));
  val dead = mkvec(base, 1);
  return call Wyoung.churn(mknum(payload(cnt, 0) - 1));
}

// hold -> 424242: a ROOTED vector (frame binder) with a known element,
// churned past young cycles, read back THROUGH THE SLOT.
defun Wyoung.hold(cnt : val) -> val {
  word base = allocvec(1);
  vecstore(base, 0, mknum(424242));
  val keep = mkvec(base, 1);
  val junk = call Wyoung.churn(cnt);
  return vecload(payload(keep, 0), 0);
}

// two -> A*1000000 + B: TWO rooted vectors (the same shape valchurn's rooted
// arm holds one of), churned, both read through their slots.
defun Wyoung.two(cnt : val) -> val {
  word baseA = allocvec(1);
  vecstore(baseA, 0, mknum(11));
  val keepA = mkvec(baseA, 1);
  word baseB = allocvec(1);
  vecstore(baseB, 0, mknum(22));
  val keepB = mkvec(baseB, 1);
  val junk = call Wyoung.churn(cnt);
  return mknum(payload(vecload(payload(keepA, 0), 0), 0) * 1000000 + payload(vecload(payload(keepB, 0), 0), 0));
}

// stale: valchurn's STALE arm verbatim — a young vector whose only val copy
// lives in a STACK Slot (unrooted), read across a churn.
defun Wyoung.put(sv : val) -> val {
  *Box p = payload(sv, 0);
  word base = allocvec(1);
  vecstore(base, 0, mkbool(1));
  val v = mkvec(base, 1);
  p->item = v;
  return mknil;
}
defun Wyoung.stale(cnt : val) -> val {
  Box b;
  word sv = &b;
  val put = call Wyoung.put(mknum(sv));
  val junk = call Wyoung.churn(cnt);
  val back = b.item;
  return mknum(tagis(vecload(payload(back, 0), 0), 3));
}

defun Wyoung.mk() -> val {
  word base = allocvec(1);
  vecstore(base, 0, mkbool(1));
  return mkvec(base, 1);
}
defun Wyoung.store1(sv : val, v : val) -> val {
  *Box p = payload(sv, 0);
  p->item = v;
  return mknil;
}
defun Wyoung.rooted(cnt : val) -> val {
  Box b;
  word sv = &b;
  val keep = call Wyoung.mk();
  val st = call Wyoung.store1(mknum(sv), keep);
  val junk = call Wyoung.churn(cnt);
  val back = b.item;
  return mknum(tagis(vecload(payload(back, 0), 0), 3) * 10 + tagis(vecload(payload(keep, 0), 0), 3));
}

// rootNoCopy: keep rooted, NO raw copy in the Box.
defun Wyoung.rootNoCopy(cnt : val) -> val {
  val keep = call Wyoung.mk();
  val junk = call Wyoung.churn(cnt);
  return mknum(tagis(vecload(payload(keep, 0), 0), 3));
}
// rootNoRead: the raw copy written, but only KEEP read at the end.
defun Wyoung.rootNoRead(cnt : val) -> val {
  Box b;
  word sv = &b;
  val keep = call Wyoung.mk();
  val st = call Wyoung.store1(mknum(sv), keep);
  val junk = call Wyoung.churn(cnt);
  return mknum(tagis(vecload(payload(keep, 0), 0), 3));
}

// fill -> 0+1+...+(n-1): THE WRITE BARRIER fixture.  An n-element vector
// built ONE STORE AT A TIME with an allocating call between stores: at any
// realistic young size the space fills mid-build, the scavenge PROMOTES the
// half-filled vector, and every store after the promotion writes a YOUNG
// value into an OLD vector — the old->young edge ONLY the remembered set
// can cover (the root walk never enters old space).
defun Wyoung.fillStep(vecv : val, idx : val, cnt : val) -> val {
  if (mkbool(payload(idx, 0) >= payload(cnt, 0))) {
    return mknil;
  }
  word fresh = allocvec(1);
  vecstore(fresh, 0, mknum(payload(idx, 0)));
  val elem = mkvec(fresh, 1);
  vecstore(payload(vecv, 0), payload(idx, 0), elem);
  return call Wyoung.fillStep(vecv, mknum(payload(idx, 0) + 1), cnt);
}
defun Wyoung.fillSum(vecv : val, idx : val, cnt : val) -> val {
  if (mkbool(payload(idx, 0) >= payload(cnt, 0))) {
    return mknum(0);
  }
  val elem = vecload(payload(vecv, 0), payload(idx, 0));
  return mknum(payload(vecload(payload(elem, 0), 0), 0) + payload(call Wyoung.fillSum(vecv, mknum(payload(idx, 0) + 1), cnt), 0));
}
defun Wyoung.fill(cnt : val) -> val {
  word base = allocvec(payload(cnt, 0));
  val vecv = mkvec(base, payload(cnt, 0));
  val built = call Wyoung.fillStep(vecv, mknum(0), cnt);
  return call Wyoung.fillSum(vecv, mknum(0), cnt);
}

// unbarred -> 1 under the nursery, 0 with it off: THE DOCUMENTED UNCOVERED
// EDGE.  A young block's address stored into an OLD RAW block's body by
// WSTORE — a WORD store, not a val store: no barrier sees it (the barrier is
// the RawVecStore seam alone) and no scanner reads it (a kind-0 block holds
// no vals BY Mid.Ir's node contract).  Across a scavenge the young referent
// is promoted and the raw word goes stale; the non-moving collector leaves
// it valid.  This is B7 obligation-2's class exactly — a raw word holding a
// heap pointer across a safepoint is LEGAL TO SPELL and ILLEGAL TO RELY ON —
// and this arm PINS the hole's existence instead of pretending coverage.
// (The raw block is ROOTED through the string val so it survives BOTH
// collectors; the WORD `raw` itself is deliberately left to go stale — that
// staleness IS the observation.)
defun Wyoung.unbarred(cnt : val) -> val {
  word base = allocvec(1);
  vecstore(base, 0, mknum(77));
  val keep = mkvec(base, 1);
  word raw = allocraw(64);
  val rawv = mkstr(raw, 8);
  wstore(raw, 0, base);
  val junk = call Wyoung.churn(cnt);
  return mkbool(payload(keep, 0) != wload(raw, 0));
}

// prealloc -> 42: THE BARRIER'S LAZY-REGION PIN.  A vecstore into a MALLOC'd
// blob BEFORE any Mid allocation: the barrier reads rt_glob word 0, which is
// the .bss ZERO until the first allocation runs gcInit — dereferencing it is
// a NULL SIGSEGV (the hostapply flip blocker: Whost.run stores into its blob
// before its churn's first allocraw).  Post-fix the store is plain (the
// region is null = "nothing to remember yet").
defun Wyoung.prealloc(dummy : val) -> val {
  word blob = rawcall malloc(400);
  call Rt.rootPushValueArray(blob + 8, blob);
  vecstore(blob + 8, 0, mknum(42));
  word base = allocvec(1);
  vecstore(base, 0, vecload(blob + 8, 0));
  val keep = mkvec(base, 1);
  return vecload(payload(keep, 0), 0);
}
